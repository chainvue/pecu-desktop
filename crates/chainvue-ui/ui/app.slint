// The one thing taken from the standard widget set, and taken by name.
//
// `ListView` is the only element in Slint that builds just the rows somebody can
// see. Everything else here is drawn from scratch on this project's own tokens —
// but there is no lower-level virtualising repeater to build on, and a plain
// `for` over a real transaction history costs 2.9 seconds of frozen UI thread at
// fifty thousand rows (`examples/scroll_cost.rs`).
//
// Imported by name rather than wholesale: `std-widgets.slint` exports `Palette`,
// which collides with this project's own theme global. One name, one collision
// avoided, and the widget style reaches nothing else.
import { ListView } from "std-widgets.slint";
import { Theme, Sp, R, Typo, Motion, InputMode } from "theme/theme.slint";
import { Btn, Card, Eyebrow, Money, StatusPill, Skeleton, EmptyState, ListRow, Segmented } from "components/base.slint";
import { NavRail, TitleBar, StatusBar } from "components/shell.slint";
import { NavItem, NodeRow, KeyRow, KnownAddressRow, AssetRow, ActivityRow, SeedWord, ReviewOutput, PendingRow, ToastRow, IdentityRow, ContentEntry } from "vm/structs.slint";

// Re-exported from the compile root so `slint-build` generates Rust types for
// them. A global that is only imported here stays invisible to Rust — `Theme`
// has to be reachable so the binary can flip dark/light.
export { NavItem, NodeRow, KeyRow, KnownAddressRow, AssetRow, ActivityRow, SeedWord, ReviewOutput, PendingRow, ToastRow, IdentityRow, ContentEntry }
export { Theme, Motion, InputMode }

// ── The data the UI is given ────────────────────────────────────────────────
//
// One global per state slice, mirroring the `Event` enum on the Rust side.
// Nothing here is a handle or a key — every value is a finished view model, and
// every amount is a pre-formatted string (see `vm/structs.slint` for why money
// cannot be an `int` or a `float` in Slint).

export global WalletState {
    in property <bool> exists: false;
    in property <bool> locked: true;
    in property <string> name: "";
    // The ACTIVE key's address — what Receive shows and what Send pays from.
    in property <string> address: "";
    // The same address in four-character groups, for `accessible-value` only.
    // Never rendered: a space somebody copies is an address that fails its
    // checksum. See `chainvue_ui::spoken`.
    in property <string> address-spoken: "";
    // Every key in the vault. Readable while locked, because an address is
    // public: that is what lets someone be paid without unlocking anything.
    in property <[KeyRow]> keys: [];
    in property <string> active-key: "";
    // Which key the rename form is open on, and what is being typed into it.
    // Held here rather than inside the row so that only one row can be in edit
    // at a time, and so Rust can close the form when the rename actually lands
    // — but not when it is refused, which would take away the name someone was
    // halfway through fixing.
    in-out property <string> renaming: "";
    in-out property <string> rename-draft: "";
    in-out property <string> new-key-draft: "";
    // Why the last key operation was refused, shown on the keys section.
    in-out property <string> key-problem: "";
    in property <bool> loading: true;
    in property <bool> busy: false;
    /// Set when unlocking or creating failed, cleared on the next attempt.
    in property <string> problem: "";

    // What to write next to an amount. From the node's own chain name, never
    // a default: a screen that labels testnet coins "VRSC" has stopped being
    // able to tell you which money you are looking at.
    in property <string> ticker: "VRSC";
    in property <string> total: "0.0000 0000";
    in property <string> spendable: "0.0000 0000";
    in property <string> immature: "0.0000 0000";
    in property <string> pending: "0.0000 0000";
    // Only shown when it differs from the total — a wallet with everything
    // spendable stays calm and says nothing extra.
    in property <bool> has-breakdown: false;
    in property <string> matures-in: "";

    in property <[AssetRow]> assets: [];
    // The dashboard's short list, and the whole thing for the Activity screen.
    // Two models rather than one sliced, because Slint's `for` has no window.
    in property <[ActivityRow]> activity: [];
    in property <[ActivityRow]> history: [];
    // The scan has reached the start of the chain. Until it has, there may be
    // older transactions nobody has looked for yet — which is not the same as
    // there being none.
    in property <bool> history-complete: false;
    in property <bool> loading-history: false;
    // The chain tip, so a row can work out its own confirmations. A new block
    // updates ONE integer and every visible row recomputes itself — no model
    // mutation, no notification storm.
    in property <int> tip-height: 0;
    // Arriving: seen in the mempool, not yet mined.
    in property <string> incoming: "";
    // The figures are from an earlier read and the last one did not finish.
    // Distinct from "loading": these numbers were true, just not now.
    in property <bool> stale: false;

    /// Minutes of inactivity before the wallet locks itself; 0 means never.
    in property <int> auto-lock: 5;
    /// Where the wallet file is, for the About section.
    in property <string> vault-path: "";

    /// The receive address, as a QR code. Rendered in Rust because the module
    /// size has to be a whole number of PHYSICAL pixels — see `src/qr.rs`.
    in property <image> qr;
    /// The logical size to draw it at, so one buffer pixel is one device pixel.
    in property <length> qr-side: 240px;

    /// The label of a key whose recovery phrase nobody has written down, or
    /// empty. Persisted in the vault file, so this survives a restart — a
    /// wallet created and then closed mid-backup still finds its way back to
    /// its own words.
    in property <string> backup-key: "";
}

// The one screen that shows a recovery phrase.
//
// The words are only ever in `words` while the reveal button is physically
// held down. The rest of the time Rust has overwritten every row with bullets,
// which is why concealing is not the same as emptying the model.
export global SeedState {
    // "" (closed) | "passphrase" | "phrase" | "verify"
    //
    // The UI owns this: the screen is a place the user is, not a fact about the
    // wallet. Rust opens it (a phrase exists to show) and closes it (the backup
    // was recorded); everything in between is navigation.
    in-out property <string> step: "";
    in property <[SeedWord]> words: [];
    /// 1-based positions the confirmation step asks for. Chosen in core — a
    /// screen that picked its own could pick the same three every time.
    in property <[int]> challenge: [];
    in-out property <string> problem: "";
    in property <bool> busy: false;
}

// Sending.
//
// Nothing here is secret — an address and an amount are public the moment the
// transaction is. What is deliberately absent is the signed transaction: the UI
// holds a ticket number, and the bytes stay in the core. A UI that held them
// would be a UI that could be made to send them.
export global SendState {
    // "form" | "review" | "sent" | "uncertain"
    in-out property <string> step: "form";
    in property <bool> busy: false;

    // Verdicts from core, which owns address parsing and the fee rules.
    in property <bool> to-valid: false;
    in property <string> to-note: "";
    in property <bool> amount-valid: false;
    in property <string> amount-note: "";
    in property <bool> ready: false;

    // The review, decoded from the signed transaction.
    in property <int> ticket: 0;
    in property <[ReviewOutput]> outputs: [];
    in property <string> amount: "";
    in property <string> fee: "";
    in property <string> total: "";
    in property <string> change: "";
    in property <string> balance-after: "";
    in property <string> from-address: "";
    // This wallet has never successfully paid the recipient before. Worth
    // saying: a mistyped address that happens to be valid looks exactly like a
    // correct one, and "you have paid this before" is the only thing the wallet
    // can offer that a checksum cannot.
    in property <bool> first-time-recipient: false;
    // The VerusID name this was addressed to, when it was addressed by name.
    // Empty for an address typed out.
    //
    // Shown beside the outputs, never instead of them. Somebody who typed
    // `meineid@` has no way to check an i-address they have never seen — and
    // somebody shown only the name is being asked to trust a lookup nobody told
    // them happened. Both halves, or neither is worth anything.
    in property <string> recipient-name: "";

    // Payments handed over whose outcome is unknown. Survives a restart,
    // because the bytes do.
    in property <[PendingRow]> pending-rows: [];

    // Who this wallet has paid. On the settings screen, and consulted by the
    // recipient field — a name is only worth having where somebody is checking
    // an address they just pasted.
    in property <[KnownAddressRow]> known: [];
    // Which address the naming form is open on, and what is being typed.
    in-out property <string> naming: "";
    in-out property <string> name-draft: "";

    // The outcome.
    in property <string> txid: "";
    in-out property <string> problem: "";
}

// One transaction, opened.
// The VerusIDs screen.
//
// One list, not two. An identity somebody looked up sits beside their own, and
// `mine` on the row is what tells them apart — two lists would let the same
// identity appear twice and answer differently.
export global IdentityState {
    // Yours, and the ones somebody looked up. Two lists, because they answer
    // different questions — one is a fact about your keys, the other is what
    // you just asked about. One list forced the heading to lie about one of
    // them, and it did: a stranger's identity sat under "found by asking the
    // chain which names your keys control" until the wallet was restarted.
    in property <[IdentityRow]> rows: [];
    in property <[IdentityRow]> looked-up: [];
    in property <bool> busy: false;
    // The lookup field, kept here so Rust can clear it on success only.
    in-out property <string> lookup-draft: "";
    // Why a lookup found nothing. Empty when there is nothing to say.
    in-out property <string> lookup-problem: "";

    // ── The detail sheet ────────────────────────────────────────────────
    //
    // Open exactly when `address` is non-empty. No second flag that could
    // disagree with it, the same rule `TxState.txid` follows.
    in-out property <string> address: "";
    in property <string> name: "";
    in property <string> status: "";
    in property <string> tone: "";
    in property <[string]> primary-addresses: [];
    in property <string> signatures-required: "";
    in property <string> control-note: "";
    // Whether this wallet can sign for it. Decides which actions are offered —
    // a fact, not something read out of the sentence above.
    in property <bool> can-sign: false;
    in property <string> revocation-authority: "";
    in property <string> recovery-authority: "";
    // The identity's recovery authority is itself, which makes it
    // UNREVOKABLE — consensus refuses a revocation whose subject is its own
    // recovery authority. A fresh registration lands on exactly this by
    // default and nothing says so at the time.
    in property <bool> cannot-be-revoked: false;
    in property <string> timelock-note: "";
    in property <string> balance: "";

    // What it holds now, and everything it has ever published. Two different
    // questions with two different answers, so two lists rather than one
    // toggle over the same rows.
    in property <[ContentEntry]> content: [];
    in property <[ContentEntry]> content-history: [];
    in-out property <int> content-view: 0;

    // ── Claiming a name ─────────────────────────────────────────────────
    in-out property <string> name-draft: "";
    // Why the name will not do. Empty when it is fine.
    in property <string> name-problem: "";
    // What registering it would cost. Empty until a node has said.
    in property <string> name-fee: "";
    // Who may revoke and who may recover. Blank leaves the identity as its
    // own — which makes it unrevokable until somebody changes it.
    in-out property <string> revocation-draft: "";
    in-out property <string> recovery-draft: "";

    // A claim in progress. Empty step means there is none.
    in property <string> reg-step: "";
    in property <string> reg-name: "";
    in property <string> reg-note: "";
    // The block the claim must be registered by. This is the fact worth the
    // whole panel: the window is about twenty blocks and missing it spends
    // the fee for nothing.
    in property <string> reg-deadline: "";
    in property <string> reg-fee: "";
    in property <string> reg-address: "";
    in property <bool> reg-busy: false;
    in property <bool> reg-cannot-be-revoked: false;

    // ── Changing the open identity ──────────────────────────────────────
    in-out property <string> new-revocation: "";
    in-out property <string> new-recovery: "";
    in-out property <string> lock-blocks: "";
    // A change built and signed but not sent. A ticket of 0 means none.
    in property <int> change-ticket: 0;
    in property <string> change-description: "";
    in property <string> change-fee: "";
    in property <bool> change-busy: false;
    // Sending this one needs a word typed. Only a revocation does.
    in property <bool> change-needs-confirmation: false;
    in-out property <string> change-typed: "";

    // The try-a-key search. The forward direction is the only one there is.
    in-out property <string> key-draft: "";
    in property <string> derived-key: "";
    in property <bool> derived-present: false;
}

export global TxState {
    // Empty when nothing is open. The sheet is the txid being non-empty —
    // there is no second flag that could disagree with it.
    in-out property <string> txid: "";
    in property <string> when: "";
    in property <string> amount: "";
    in property <string> direction: "in";
    // False when the amount is already a token line naming its own currency —
    // appending the chain's ticker would read as "12 345 mambo VRSCTEST".
    in property <bool> amount-is-native: true;
    in property <string> confirmations: "";
    in property <string> height: "";
    // Empty when the node did not volunteer one. A fee is inputs minus
    // outputs, and the input values live in other transactions.
    in property <string> fee: "";
    in property <[string]> currency-lines: [];
    in property <string> explorer: "";
    // Arrives one request later, so the sheet opens instantly and this fills in.
    in property <string> raw: "";
    in-out property <bool> advanced: false;
}

export global NetworkState {
    in property <[NodeRow]> nodes: [];
    in property <string> requested: "Testnet";
    // What the active node actually reported. Only this decides anything —
    // never the URL.
    in property <string> effective: "";
    in property <string> node-state: "unknown";
    in property <string> tip: "";
    in property <string> latency: "";
    in property <string> endpoint: "not configured";
    in property <bool> mock-mode: false;
    in property <bool> allow-mainnet-spend: false;
    // The active node is behind the chain. Distinct from offline: it answers,
    // but a balance read against a stale tip is wrong in a way that only shows
    // up when a transaction is rejected.
    in property <bool> syncing: false;
    // Why the last node the user tried was refused. Shown on the network
    // screen, because that is where the button they pressed is — a refusal that
    // appears somewhere else is indistinguishable from nothing happening.
    in-out property <string> problem: "";
    // What is in the add-a-node form.
    //
    // Held here rather than inside the form so that Rust can clear it when the
    // node is actually accepted — and, more to the point, so that it is NOT
    // cleared when the node is refused. A rejected address that vanishes from
    // the field takes with it the only copy of what the person typed.
    in-out property <string> draft-url: "";
    in-out property <string> draft-label: "";
}

// The balance over time.
//
// Everything here is computed in Rust by `src/chart.rs`, which owns the
// readings and the geometry. Slint holds two path strings and a cursor
// position — no arithmetic on money happens on this side.
export global ChartState {
    // SVG path data for a given element size, in that element's own
    // coordinates. There is no viewbox, so one pixel of stroke means one pixel
    // — see `chainvue_chart::Viewport`.
    //
    // Callbacks rather than properties, and used directly in a binding: a
    // `pure callback` re-evaluates when its ARGUMENTS change, so the geometry
    // follows the element through every layout including the first. A property
    // pushed from a `changed width` handler cannot do that — the handler fires
    // only after a size exists, and only under a running event loop.
    pure callback line-at(length, length) -> string;
    // Empty when the balance never moved: a gradient fading downwards from a
    // horizontal line reads as a chart that failed to load.
    pure callback area-at(length, length) -> string;
    // Where the line ends, so the "now" dot can sit exactly on it.
    pure callback end-x-at(length, length) -> length;
    pure callback end-y-at(length, length) -> length;
    in property <bool> has-data: false;
    in property <string> ticker: "VRSC";
    // What moved across the window, and whether that is good news.
    in property <string> change: "";
    in property <string> change-tone: "neutral";
    // What the picture is of. A chart over a window the wallet has not fully
    // scanned is true about the window and silent about everything before it,
    // and that difference is invisible in the drawing.
    in property <string> caption: "";

    // Where the axis begins, in words. There are no gridlines and no tick
    // labels, so without this the chart cannot say what period it covers.
    in property <string> span-from: "";

    // -1 when the pointer is not over the chart.
    in property <int> hover: -1;
    // Where the crosshair sits: on the nearest SAMPLE, not under the pointer.
    // A dot floating between two readings points at a balance never held.
    in property <length> hover-x: 0px;
    in property <length> hover-y: 0px;
    in property <string> hover-amount: "";
    in property <string> hover-when: "";

    callback hovered(length);
    callback left();
}

// What the wallet has said and nobody has read yet.
export global ToastState {
    in property <[ToastRow]> rows: [];
    callback dismiss(int);
    // Dismiss everything. Offered once there is more than one, because a wallet
    // that has just failed six times should not need six clicks.
    callback dismiss-all();
}

export global AppInfo {
    in property <string> sdk-rev: "unknown";
    // Where the log files are. On screen because a wallet started from the
    // Finder has no terminal, so this is the only way anybody finds them.
    in property <string> log-path: "";
}

// Every UI→core call lives in this one global.
//
// Keeping the outbound API to a single readable block is what makes it possible
// to see, at a glance, which calls carry secret material — and to notice
// immediately when one is added.
export global Actions {
    // ── The secret-bearing calls ──────────────────────────────────────────
    //
    // Five, and this comment is the record. Each clears its backing property
    // inside the same callback, before returning — see `PassphraseForm.submit`,
    // `RestoreForm.submit` and `BackupPassphrase.submit`. A fifth belongs in a
    // review, not in a commit.
    callback create-wallet(string);
    callback unlock(string);
    // Restoring: the key material AND a new passphrase for this machine, in
    // one call. Both are blanked before the callback returns.
    callback restore-wallet(string, string, string);
    // The vault passphrase again, to show a phrase that was never written down.
    // Asking twice is the point: the highest-consequence read in the wallet
    // must not ride on a session someone unlocked twenty minutes ago.
    callback reveal-backup(string);
    // Old and new, in one call. Both are blanked before it returns.
    // Declared with the other Settings actions below, next to what it belongs
    // with — this list is the record of WHICH calls carry secrets, not where
    // they are written.

    // Three words the user is copying off the screen in front of them. Not
    // wrapped as secret material, and that is a judgement rather than an
    // oversight: three of twenty-four leaves twenty-one unknown words from a
    // 2048-word list. Still cleared in the same callback, like the rest.
    callback confirm-phrase(string, string, string);

    // ── The backup screen ─────────────────────────────────────────────────
    // Hold-to-reveal: press asks for the words, release throws away the copy
    // the UI was given. Leaving the screen throws away core's copy too.
    callback reveal-phrase();
    callback hide-phrase();
    callback cancel-backup();

    // Settings. `change-passphrase` carries two secrets and is the fifth
    // secret-bearing call — counted in the block above.
    callback change-passphrase(string, string);
    callback set-auto-lock(int);
    callback set-mainnet-spend(bool, string);

    // Keys. None of these carries a secret — a label is a name, and adding a
    // key needs the wallet open rather than the passphrase again.
    callback label-address(string, string);
    callback forget-address(string);
    callback add-key(string);
    callback rename-key(string, string);
    callback select-key(string);
    // How the window looks, and whether it moves. Sent so the core can write
    // them down — a preference that resets every launch is not a preference.
    callback set-appearance(bool, bool);

    // Sending. None of these carries a secret; the signed bytes never leave
    // the core, and what crosses here is a ticket number.
    callback validate-draft(string, string);
    callback prepare-send(string, string);
    callback confirm-send(int);
    callback cancel-send(int);
    // "check" | "resend" | "abandon" — for a payment whose fate is unknown.
    callback resolve-pending(int, string);
    callback load-older();
    callback open-tx(string);

    callback lock();
    callback navigate(string);
    callback refresh();
    callback probe-nodes();

    // ── VerusIDs ────────────────────────────────────────────────────────
    // None of these carries a secret. Reading an identity needs no key, and
    // the write operations that will need one are not here yet.
    callback refresh-identities();
    callback look-up-identity(string);
    callback open-identity(string);
    callback close-identity();
    callback derive-content-key(string);
    callback clear-lookups();
    callback unwatch-identity(string);
    callback check-name(string);
    callback start-registration(string, string, string);
    callback finish-registration();
    callback abandon-registration();
    callback set-identity-authorities(string, string, string);
    callback lock-identity(string, int);
    callback unlock-identity(string, int);
    callback confirm-identity-change(int, string);
    callback cancel-identity-change(int);
    callback revoke-identity(string);
    callback recover-identity(string);
    callback select-node(int);
    // Label then URL. The URL is checked in the core, by the SDK's own
    // transport — which is what refuses plaintext to anything but loopback.
    callback add-node(string, string);
    callback remove-node(int);
    callback toggle-theme();
}

// ── Screens ─────────────────────────────────────────────────────────────────

// A single-line input.
//
// Shared by every screen that takes one line of text, so the focus ring, the error border and the height cannot drift apart
// between them.
component Field inherits Rectangle {
    in property <bool> password: false;
    in property <bool> invalid: false;
    // A recovery phrase is typed VISIBLY, unlike a passphrase. Masking it would
    // make the one thing that matters here — spotting a mistyped word before
    // committing to a wallet with no funds in it — impossible, and the person
    // typing it is by definition its owner.
    in property <bool> multiline: false;
    in property <bool> mono: false;
    // Shown only while the field is empty. An example of the shape expected,
    // never a label — a placeholder that stands in for a label disappears
    // exactly when someone starts typing and needs it most.
    in property <string> placeholder: "";
    in-out property <string> text <=> input.text;
    callback accepted();
    callback edited();

    forward-focus: input;
    height: 42px;
    background: Theme.bg-inset;
    border-radius: R.md;
    border-width: 1px;
    border-color: root.invalid ? Theme.negative
        : input.has-focus ? Theme.accent
        : Theme.border-default;
    animate border-color { duration: Motion.fast; enabled: Motion.enabled; }

    // Behind the input, and non-interactive: it must never intercept a click
    // aimed at the field it is sitting in.
    if root.placeholder != "" && input.text == "": Text {
        text: root.placeholder;
        font-family: root.mono ? Typo.mono : "";
        font-size: Typo.body;
        color: Theme.text-disabled;
        x: Sp.s5;
        width: parent.width - Sp.s5 * 2;
        height: parent.height;
        vertical-alignment: root.multiline ? top : center;
        overflow: elide;
    }

    // The label a screen reader reads. The placeholder is the only description
    // most of these fields have on screen, so it is the honest source for it.
    accessible-role: AccessibleRole.text-input;
    accessible-label: root.placeholder;
    // Deliberately NOT `accessible-value: input.text` when masked. A password
    // field that publishes its contents to the accessibility tree has undone
    // the masking for anything that can read that tree.
    accessible-value: root.password ? "" : input.text;

    input := TextInput {
        // Never rendered as glyphs, and never logged.
        input-type: root.password ? InputType.password : InputType.text;
        font-family: root.mono ? Typo.mono : "";
        font-size: Typo.body;
        color: Theme.text-primary;
        single-line: !root.multiline;
        wrap: root.multiline ? TextWrap.word-wrap : TextWrap.no-wrap;
        x: Sp.s5;
        y: root.multiline ? Sp.s4 : 0;
        width: parent.width - Sp.s5 * 2;
        height: root.multiline ? parent.height - Sp.s4 * 2 : parent.height;
        vertical-alignment: root.multiline ? top : center;
        accepted => { root.accepted(); }
        edited => { root.edited(); }
    }
}

// Choosing a passphrase, or entering it again.
component PassphraseForm inherits VerticalLayout {
    // "create" | "unlock"
    in property <string> mode;
    in property <string> wallet-name;
    in property <bool> busy;
    in property <string> problem;
    callback restore();

    spacing: Sp.s7;

    VerticalLayout {
        spacing: Sp.s3;
        Text {
            text: root.mode == "create" ? "Set up ChainVue" : "Welcome back";
            font-size: Typo.title1;
            font-weight: Typo.w-semibold;
            color: Theme.text-primary;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center;
            Text {
                width: 420px;
                text: root.mode == "create"
                    ? "Choose a passphrase. It encrypts your keys on this machine, and nobody can recover it for you."
                    : root.wallet-name;
                font-size: Typo.body;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }

    HorizontalLayout {
        alignment: center;
        field := Field {
            width: 360px;
            password: true;
            // A masked box with nothing in it and no label above it is
            // indistinguishable from a box that is broken. The sentence above
            // explains what a passphrase IS; this says what to put here.
            placeholder: root.mode == "create"
                ? "A passphrase you will remember"
                : "Passphrase";
            invalid: root.problem != "";
            accepted => { root.submit(); }
        }
    }

    if root.problem != "": Text {
        text: root.problem;
        font-size: Typo.caption;
        color: Theme.negative;
        horizontal-alignment: center;
    }

    HorizontalLayout {
        alignment: center;
        Btn {
            text: root.busy
                ? "Working…"
                : root.mode == "create" ? "Create wallet" : "Unlock";
            variant: "primary";
            enabled: !root.busy && field.text != "";
            clicked => { root.submit(); }
        }
    }

    // Only offered before a wallet exists. Restoring into an existing one is a
    // different act — adding a key — and belongs with the key list, not here.
    if root.mode == "create": HorizontalLayout {
        alignment: center;
        Btn {
            text: "I already have a wallet";
            variant: "ghost";
            clicked => { root.restore(); }
        }
    }

    if root.mode == "create": Text {
        text: "ChainVue starts on testnet. Spending real coins stays off until you turn it on.";
        font-size: Typo.caption;
        color: Theme.text-tertiary;
        horizontal-alignment: center;
    }

    // Read the field, hand it over, and blank the property IN THE SAME
    // callback. Slint's `SharedString` is refcounted and cannot be wiped from
    // Rust, so clearing it here is the only reach we have — the residual is
    // documented on `chainvue_protocol::Secret`.
    function submit() {
        if (field.text == "") { return; }
        if (root.mode == "create") {
            Actions.create-wallet(field.text);
        } else {
            Actions.unlock(field.text);
        }
        field.text = "";
    }
}

// Restoring a wallet that already exists somewhere else.
component RestoreForm inherits VerticalLayout {
    in property <bool> busy;
    in property <string> problem;
    callback cancelled();

    spacing: Sp.s6;

    VerticalLayout {
        spacing: Sp.s3;
        Text {
            text: "Restore your wallet";
            font-size: Typo.title1;
            font-weight: Typo.w-semibold;
            color: Theme.text-primary;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center;
            Text {
                width: 460px;
                text: "Enter what you wrote down. ChainVue checks a recovery phrase before it creates anything, so a typo costs you a second attempt rather than an empty wallet.";
                font-size: Typo.body;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }

    HorizontalLayout {
        alignment: center;
        kind := Segmented {
            width: 420px;
            // "Free text" is offered rather than hidden because Verus hashes a
            // transparent phrase verbatim: some wallets really do hold a key
            // made from a sentence, and refusing it would strand those funds.
            options: ["Recovery phrase", "Free text", "Private key"];
        }
    }

    HorizontalLayout {
        alignment: center;
        material := Field {
            width: 420px;
            height: 92px;
            multiline: true;
            mono: true;
            invalid: root.problem != "";
        }
    }

    HorizontalLayout {
        alignment: center;
        Text {
            width: 420px;
            text: kind.index == 2
                ? "A Verus private key, starting with U."
                : kind.index == 1
                ? "Hashed exactly as typed, including spacing. Nothing can check it for you."
                : "12, 15, 18, 21 or 24 words, separated by spaces.";
            font-size: Typo.caption;
            color: Theme.text-tertiary;
            wrap: word-wrap;
        }
    }

    VerticalLayout {
        spacing: Sp.s3;
        HorizontalLayout {
            alignment: center;
            Text {
                width: 420px;
                text: "New passphrase for this machine";
                font-size: Typo.caption;
                color: Theme.text-secondary;
            }
        }
        HorizontalLayout {
            alignment: center;
            pass := Field {
                width: 420px;
                password: true;
            }
        }
    }

    if root.problem != "": HorizontalLayout {
        alignment: center;
        Text {
            width: 460px;
            text: root.problem;
            font-size: Typo.caption;
            color: Theme.negative;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }

    HorizontalLayout {
        alignment: center;
        spacing: Sp.s4;
        Btn {
            text: "Back";
            variant: "ghost";
            clicked => {
                root.clear();
                root.cancelled();
            }
        }
        Btn {
            text: root.busy ? "Working…" : "Restore wallet";
            variant: "primary";
            enabled: !root.busy && material.text != "" && pass.text != "";
            clicked => { root.submit(); }
        }
    }

    // Both secrets leave in one call and both fields are blanked before it
    // returns, same as every other secret-bearing path here.
    function submit() {
        if (material.text == "" || pass.text == "") { return; }
        Actions.restore-wallet(
            kind.index == 2 ? "wif" : kind.index == 1 ? "text" : "phrase",
            material.text,
            pass.text,
        );
        root.clear();
    }

    function clear() {
        material.text = "";
        pass.text = "";
    }
}

// The screen shown whenever there is no unlocked wallet.
// A payment we could not confirm reached the network.
//
// Given the top of the dashboard because it is the one thing in this wallet
// that is genuinely unresolved, and because the wrong move — sending again —
// is the tempting one.
component PendingPayments inherits VerticalLayout {
    spacing: Sp.s4;
    Eyebrow { text: "UNCONFIRMED"; }

    Card {
        VerticalLayout {
            padding: Sp.card-pad;
            spacing: Sp.s5;

            for row in SendState.pending-rows: VerticalLayout {
                spacing: Sp.s4;

                HorizontalLayout {
                    spacing: Sp.s5;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text {
                            text: row.state == "absent"
                                ? "This payment has not appeared on the network"
                                : "We could not confirm this payment was sent";
                            font-size: Typo.body;
                            font-weight: Typo.w-medium;
                            color: Theme.warning;
                            wrap: word-wrap;
                        }
                        Text {
                            text: row.state == "absent"
                                ? "Asked " + row.checks + " times and the node has never seen it. Sending the same transaction again is safe — it is the same bytes, so it cannot pay twice."
                                : "It may already be on its way. Do not send it again yet — that could send the money twice. ChainVue is checking.";
                            font-size: Typo.caption;
                            color: Theme.text-secondary;
                            wrap: word-wrap;
                        }
                    }
                    Money {
                        amount: row.amount;
                        currency: WalletState.ticker;
                        y: (parent.height - self.height) / 2;
                    }
                }

                Text {
                    text: row.txid;
                    font-family: Typo.mono;
                    font-size: Typo.num-sm;
                    color: Theme.text-tertiary;
                    wrap: char-wrap;
                }

                HorizontalLayout {
                    spacing: Sp.s4;
                    Btn {
                        text: "Check now";
                        clicked => { Actions.resolve-pending(row.id, "check"); }
                    }
                    // Only once the node has been asked repeatedly and never
                    // seen it. Offering this earlier would be offering the one
                    // action that can pay twice.
                    if row.state == "absent": Btn {
                        text: "Send the same transaction again";
                        variant: "primary";
                        clicked => { Actions.resolve-pending(row.id, "resend"); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Btn {
                        text: "Stop tracking";
                        variant: "ghost";
                        clicked => { Actions.resolve-pending(row.id, "abandon"); }
                    }
                }
            }
        }
    }
}

// The plotted area: two paths, a wipe, and a crosshair.
//
// Its own component because the draw-in needs a clip rectangle wrapping a
// holder pinned at full size, and because the touch area has to be able to
// address the paths — neither survives being written inline.
component ChartPlot inherits Rectangle {
    // Slint has no stroke-dasharray and no path-length animation, so the
    // draw-in is a **clip wipe**: an outer rectangle whose width animates from
    // nothing to full, containing a holder that is always the full size. The
    // paths never move; what moves is how much of them is visible. Zero
    // per-frame path work, and it works identically for the gradient.
    in-out property <float> progress: 0;

    // Runs once when the data arrives. Reversing it on every re-plot would
    // mean the chart redrew itself every fifteen seconds when the tip poll
    // finds a new block, which is a wallet fidgeting at you.
    states [
        drawn when ChartState.has-data: {
            progress: 1;
            in {
                animate progress {
                    duration: Motion.draw;
                    easing: cubic-bezier(0.22, 1, 0.36, 1);
                    enabled: Motion.enabled;
                }
            }
        }
    ]

    // The fill first, so the stroke is never drawn under it.
    Rectangle {
        width: parent.width * root.progress;
        clip: true;

        Rectangle {
            width: root.width;
            height: root.height;

            Path {
                commands: ChartState.area-at(root.width, root.height);
                // Faded to nothing at the baseline. The stroke has to stay
                // readable against the fill directly beneath it, so the fill
                // never gets close to the stroke's own weight.
                // Faded to nothing well before the baseline. A fill still
                // visible at the bottom reads as a filled shape rather than as
                // depth under a line, and it competes with the stroke it is
                // supposed to sit beneath.
                //
                // The top stop is chosen to look right **without** the fade as
                // well: the software renderer — which is what draws the
                // reference images, and what would draw the wallet on a machine
                // with no working GPU path — fills a `Path` with the first stop
                // and ignores the rest. A gradient whose top end is too strong
                // to stand on its own would then look correct in review and
                // wrong on somebody's laptop.
                fill: @linear-gradient(180deg,
                    Theme.chart-line.with-alpha(0.16) 0%,
                    Theme.chart-line.with-alpha(0.05) 60%,
                    Theme.chart-line.with-alpha(0.0) 100%);
            }

            Path {
                commands: ChartState.line-at(root.width, root.height);
                stroke: Theme.chart-line;
                stroke-width: 2px;
            }
        }
    }

    // Where the line ends — which is now. The one point on the chart that is
    // still moving, and the anchor the wipe appears to be drawn by.
    if ChartState.hover < 0: Rectangle {
        x: ChartState.end-x-at(root.width, root.height) - 4px;
        y: ChartState.end-y-at(root.width, root.height) - 4px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: Theme.chart-line;
        opacity: root.progress;
    }

    // The crosshair. Only while a pointer is actually over the chart.
    if ChartState.hover >= 0: Rectangle {
        x: ChartState.hover-x;
        width: 1px;
        y: 0;
        height: root.height;
        background: Theme.chart-grid.with-alpha(0.14);
    }

    if ChartState.hover >= 0: Rectangle {
        x: ChartState.hover-x - 5px;
        y: ChartState.hover-y - 5px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: Theme.chart-line;
        border-width: 2px;
        border-color: Theme.bg-surface;
        // Gliding between samples rather than teleporting is most of the
        // difference between this and a chart library.
        animate x { duration: 90ms; easing: ease-out; enabled: Motion.enabled; }
        animate y { duration: 90ms; easing: ease-out; enabled: Motion.enabled; }
    }

    touch := TouchArea {
        // `mouse-x` updates on hover; `moved()` only fires while pressed, so
        // this is a binding rather than a callback.
        changed mouse-x => {
            if (touch.has-hover) { ChartState.hovered(touch.mouse-x); }
        }
        changed has-hover => {
            if (!touch.has-hover) { ChartState.left(); }
        }
    }
}

// The balance over time, with its range control and its own empty state.
component BalanceChart inherits VerticalLayout {
    spacing: Sp.s4;

    Rectangle {
        height: 200px;

        ChartPlot {
            width: parent.width;
            height: parent.height;
        }
    }

    if ChartState.has-data: HorizontalLayout {
        spacing: Sp.s5;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            // While hovering, the header reads the value AT THE CURSOR. The
            // change figure keeps describing the window, which is what makes
            // the two useful together.
            Text {
                text: ChartState.hover >= 0
                    ? ChartState.hover-amount + " " + ChartState.ticker
                    : ChartState.change;
                font-family: Typo.mono;
                font-size: Typo.num-sm;
                color: ChartState.hover >= 0 ? Theme.text-primary
                    : ChartState.change-tone == "positive" ? Theme.positive
                    : ChartState.change-tone == "negative" ? Theme.negative
                    : Theme.text-secondary;
            }
            Text {
                text: ChartState.hover >= 0 ? ChartState.hover-when : ChartState.caption;
                font-size: Typo.caption;
                color: Theme.text-tertiary;
                overflow: elide;
            }
        }

        // What period this is a picture of. The chart has no gridlines and no
        // tick labels, so this is the only thing that says so — a question the
        // range buttons used to answer by implication, and which nothing
        // answered once they were gone.
        VerticalLayout {
            alignment: center;
            Text {
                text: ChartState.span-from == "" ? "" : ChartState.span-from + " → now";
                font-size: Typo.caption;
                color: Theme.text-tertiary;
                horizontal-alignment: right;
            }
        }
    }
}

component DashboardScreen inherits VerticalLayout {
    spacing: Sp.section-gap;

    if SendState.pending-rows.length > 0: PendingPayments {}

    // A wallet whose phrase has never been written down is one disk failure
    // from being gone. That is worth the top of the screen, and worth staying
    // there — it disappears when the backup is confirmed, not when dismissed.
    if WalletState.backup-key != "": Card {
        VerticalLayout {
            padding: Sp.card-pad;

            HorizontalLayout {
                spacing: Sp.s5;

                Rectangle {
                    width: 34px;
                    height: 34px;
                    y: (parent.height - self.height) / 2;
                    border-radius: R.full;
                    background: Theme.warning-soft;
                    Text {
                        text: "!";
                        font-size: 15px;
                        font-weight: Typo.w-semibold;
                        color: Theme.warning;
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: "Your recovery phrase is not written down";
                        font-size: Typo.body;
                        font-weight: Typo.w-medium;
                        color: Theme.text-primary;
                    }
                    Text {
                        text: "Without it, nothing can restore this wallet — not us, not anyone.";
                        font-size: Typo.caption;
                        color: Theme.text-secondary;
                    }
                }

                Btn {
                    text: "Back up now";
                    variant: "primary";
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        SeedState.problem = "";
                        SeedState.step = "passphrase";
                    }
                }
            }
        }
    }

    // The hero. Total first, because that is the number people quote — with the
    // breakdown directly beneath it, because a Verus balance is genuinely
    // several numbers and a wallet that shows one cannot explain "you have 500
    // but can spend 20".
    VerticalLayout {
        spacing: Sp.s4;

        HorizontalLayout {
            spacing: Sp.s4;
            alignment: start;
            Eyebrow { text: "TOTAL BALANCE"; }
            // "These numbers were true, just not now" — which is a different
            // statement from "loading", and the one worth making when a read
            // fails against a wallet that already has figures on screen.
            if WalletState.stale: Eyebrow {
                text: "· NOT UP TO DATE";
                color: Theme.warning;
            }
        }

        if WalletState.loading: Skeleton {
            width: 320px;
            height: 48px;
        }

        if !WalletState.loading: Money {
            amount: WalletState.total;
            currency: WalletState.ticker;
            size: Typo.hero;
            mono: false;
        }

        if !WalletState.loading && WalletState.has-breakdown: HorizontalLayout {
            spacing: Sp.s5;
            alignment: start;

            Text {
                text: WalletState.spendable + " spendable";
                font-size: Typo.caption;
                color: Theme.text-secondary;
            }
            Text {
                text: "·";
                font-size: Typo.caption;
                color: Theme.text-disabled;
            }
            Text {
                text: WalletState.immature + " maturing"
                    + (WalletState.matures-in == "" ? "" : " (" + WalletState.matures-in + ")");
                font-size: Typo.caption;
                color: Theme.warning;
            }

            if WalletState.incoming != "": Text {
                text: "·";
                font-size: Typo.caption;
                color: Theme.text-disabled;
            }
            if WalletState.incoming != "": Text {
                text: WalletState.incoming + " arriving";
                font-size: Typo.caption;
                color: Theme.positive;
            }
        }
    }

    // The balance over time. Directly under the figure it is a chart of, so
    // the two can be read as one statement rather than as two facts that
    // happen to share a screen.
    //
    // Absent entirely until there is something to draw. A wallet with no
    // transactions would otherwise stack three empty states — "no chart", "no
    // assets", "no transactions" — which says one thing three times and makes
    // the screen look broken rather than new. The card arriving with the first
    // transaction is information; a placeholder for it is not.
    if ChartState.has-data: Card {
        VerticalLayout {
            padding: Sp.card-pad;
            BalanceChart {}
        }
    }

    // Assets
    VerticalLayout {
        spacing: Sp.s4;
        Eyebrow { text: "ASSETS"; }

        Card {
            VerticalLayout {
                padding: Sp.s3;

                if WalletState.assets.length == 0 && !WalletState.loading: Rectangle {
                    height: 88px;
                    EmptyState {
                        glyph: "◇";
                        title: "No assets yet";
                        body: "Receive VRSC to get started.";
                    }
                }

                if WalletState.loading: Rectangle {
                    height: 64px;
                    HorizontalLayout {
                        padding: Sp.s5;
                        spacing: Sp.s5;
                        Skeleton { width: 34px; height: 34px; radius: R.full; }
                        VerticalLayout {
                            alignment: center;
                            spacing: Sp.s2;
                            Skeleton { width: 120px; height: 13px; }
                            Skeleton { width: 72px; height: 11px; }
                        }
                    }
                }

                for asset in WalletState.assets: ListRow {
                    // `◈` was here and drew nothing — the third glyph in this
                    // file to do that. `◆` is one the system font is known to
                    // carry, because it is already on screen in the nav rail.
                    glyph: asset.native ? "◆" : "◇";
                    glyph-tone: asset.native ? Theme.accent : Theme.text-secondary;
                    title: asset.name;
                    subtitle: asset.secondary;
                    interactive: false;

                    // Right-aligned, so a column of amounts lines up on the
                    // decimal point rather than floating in the middle of the
                    // row. Together with the monospace family this is what
                    // makes two balances comparable at a glance.
                    HorizontalLayout {
                        alignment: end;
                        Money {
                            amount: asset.amount;
                            show-currency: false;
                            size: Typo.num-lg;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
            }
        }
    }

    // Recent activity
    VerticalLayout {
        spacing: Sp.s4;

        HorizontalLayout {
            Eyebrow { text: "RECENT ACTIVITY"; horizontal-stretch: 1; }
        }

        Card {
            VerticalLayout {
                padding: Sp.s3;

                if WalletState.activity.length == 0 && !WalletState.loading: Rectangle {
                    height: 120px;
                    EmptyState {
                        glyph: "○";
                        title: "No transactions yet";
                        body: "Activity appears here once your wallet has been paid.";
                    }
                }

                for tx in WalletState.activity: ListRow {
                    glyph: tx.direction == "in" ? "↓" : tx.direction == "out" ? "↑" : "⇄";
                    glyph-tone: tx.direction == "in" ? Theme.positive
                        : tx.direction == "out" ? Theme.negative
                        : Theme.text-secondary;
                    title: tx.direction == "in" ? "Received" : tx.direction == "out" ? "Sent" : "Moved";
                    subtitle: tx.when;
                    interactive: true;

                    HorizontalLayout {
                        spacing: Sp.s5;
                        alignment: end;

                        // The pill goes BEFORE the amount, so a pending row
                        // does not push its figure out of the column every
                        // other row lines up in. Alignment is what makes a
                        // list of amounts readable; the pill can move.
                        if tx.pending: StatusPill {
                            state: "pending";
                            text: "Pending";
                            y: (parent.height - self.height) / 2;
                        }

                        Money {
                            amount: tx.amount;
                            show-currency: false;
                            tone: tx.direction == "in" ? "positive" : tx.direction == "out" ? "negative" : "neutral";
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
            }
        }
    }

    Rectangle { vertical-stretch: 1; }
}

// Configuring an endpoint of your own.
//
// Its own component because its two inputs have to be readable from one place —
// an input declared inside an `if` cannot be reached from outside it — and
// because the form has to be able to clear itself once the node is accepted.
component AddNodeForm inherits VerticalLayout {
    spacing: Sp.s4;

    HorizontalLayout {
        spacing: Sp.s4;

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Sp.s3;
            Text {
                text: "Address";
                font-size: Typo.caption;
                color: Theme.text-secondary;
            }
            url := Field {
                mono: true;
                placeholder: "https://my-node.example:27486";
                text <=> NetworkState.draft-url;
                accepted => { root.submit(); }
                edited => { NetworkState.problem = ""; }
            }
        }

        VerticalLayout {
            width: 200px;
            spacing: Sp.s3;
            Text {
                text: "Name (optional)";
                font-size: Typo.caption;
                color: Theme.text-secondary;
            }
            name := Field {
                placeholder: "my node";
                text <=> NetworkState.draft-label;
                accepted => { root.submit(); }
            }
        }
    }

    if NetworkState.problem != "": Text {
        text: NetworkState.problem;
        font-size: Typo.caption;
        color: Theme.negative;
        wrap: word-wrap;
    }

    HorizontalLayout {
        spacing: Sp.s5;
        Text {
            horizontal-stretch: 1;
            // The one sentence worth having here. Someone typing an address in
            // is about to be told "no" by a rule they cannot see otherwise.
            text: "ChainVue only talks to encrypted endpoints, so an https:// address is required unless the node is on this machine. It never sends a key to a node.";
            font-size: Typo.caption;
            color: Theme.text-tertiary;
            wrap: word-wrap;
            vertical-alignment: center;
        }
        Btn {
            text: "Add node";
            variant: "primary";
            enabled: url.text != "";
            y: (parent.height - self.height) / 2;
            clicked => { root.submit(); }
        }
    }

    // The fields are NOT cleared here. Rust clears them once the node has
    // actually been accepted — so a refused address is still on screen to be
    // corrected rather than retyped from memory.
    function submit() {
        if (url.text == "") { return; }
        NetworkState.problem = "";
        Actions.add-node(name.text, url.text);
    }
}

component NodesScreen inherits VerticalLayout {
    spacing: Sp.s7;

    HorizontalLayout {
        spacing: Sp.s5;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Sp.s2;
            // No screen heading here: the title bar already says "Network", and
            // the two sat one above the other. Visible in a render, invisible
            // in the source.
            Text {
                // The distinction that matters: what you asked for versus what
                // the node says it is. Only the second decides anything.
                text: NetworkState.effective == ""
                    ? "Requested " + NetworkState.requested + " · no node has answered yet"
                    : "Requested " + NetworkState.requested + " · connected to " + NetworkState.effective;
                font-size: Typo.caption;
                color: Theme.text-secondary;
            }
        }
        Btn {
            text: "Probe nodes";
            y: (parent.height - self.height) / 2;
            clicked => { Actions.probe-nodes(); }
        }
    }

    Card {
        VerticalLayout {
            padding: Sp.s3;

            if NetworkState.nodes.length == 0: Rectangle {
                height: 120px;
                EmptyState {
                    glyph: "◌";
                    title: "No nodes configured";
                    body: "ChainVue needs a Verus RPC endpoint to read the chain. It never sends a key to one.";
                }
            }

            for node in NetworkState.nodes: ListRow {
                glyph: node.active ? "●" : "○";
                glyph-tone: node.status == "online" ? Theme.positive
                    : node.status == "degraded" ? Theme.warning
                    : node.status == "offline" ? Theme.negative
                    : Theme.text-tertiary;
                title: node.label;
                subtitle: node.url;
                subtitle-mono: true;
                selected: node.active;
                clicked => { Actions.select-node(node.id); }

                HorizontalLayout {
                    spacing: Sp.s5;
                    alignment: end;

                    if node.note != "": Text {
                        text: node.note;
                        font-size: Typo.caption;
                        color: Theme.warning;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    // Which chain this node says it is on. Never derived from
                    // the URL — a hostname containing "test" proves nothing.
                    if node.network != "": Text {
                        text: node.network;
                        font-size: Typo.caption;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }

                    if node.tip != "": Text {
                        text: node.tip;
                        font-family: Typo.mono;
                        font-size: Typo.num-sm;
                        color: Theme.text-tertiary;
                        vertical-alignment: center;
                    }

                    if node.latency != "": Text {
                        text: node.latency;
                        font-family: Typo.mono;
                        font-size: Typo.num-sm;
                        color: Theme.text-tertiary;
                        vertical-alignment: center;
                    }

                    // The status word, not the chain name. Colour is never the
                    // only signal that a node is reachable — a green dot beside
                    // "Testnet" says which chain and nothing at all about
                    // whether it answered.
                    //
                    // Fixed width so the pills line up down the column. Every
                    // item before this one is optional, so without it each row
                    // ends wherever its own content happens to run out.
                    StatusPill {
                        width: 88px;
                        state: node.status;
                        text: node.status;
                        y: (parent.height - self.height) / 2;
                    }

                    // The slot is always here; the button is not. Reserving the
                    // space keeps the status column straight whether or not the
                    // row can be removed — and a column that shifts by a button
                    // width is the sort of thing that reads as unfinished
                    // without anyone being able to say why.
                    Rectangle {
                        width: 96px;

                        // Only what the user added. A built-in comes from the
                        // build, so removing one would last until the next
                        // start and then quietly undo itself — the core refuses
                        // it, and offering a button that cannot work is worse
                        // than not offering one.
                        if !node.builtin: Btn {
                            text: "Remove";
                            x: parent.width - self.width;
                            y: (parent.height - self.height) / 2;
                            clicked => { Actions.remove-node(node.id); }
                        }
                    }
                }
            }
        }
    }

    VerticalLayout {
        spacing: Sp.s4;
        Eyebrow { text: "ADD A NODE"; }
        Card {
            VerticalLayout {
                padding: Sp.card-pad;
                AddNodeForm {}
            }
        }
    }

    Rectangle { vertical-stretch: 1; }
}

// Which key the wallet is receiving to and paying from.
//
// One control, one fact. Receive and Send both act on whichever key is active,
// so a picker that meant something different on each screen would be two
// notions of "the key in use" — and the one that decides where money arrives
// must not be able to disagree with the one that decides where it leaves.
//
// Absent when there is nothing to pick: a control with one option in it is a
// question nobody asked.
component KeyPicker inherits HorizontalLayout {
    // Left, like everything else in a form. The receive screen centres it by
    // wrapping it, which is the one place the surrounding column is centred.
    alignment: start;
    spacing: Sp.s3;

    if WalletState.keys.length > 1: HorizontalLayout {
        spacing: Sp.s3;
        for entry in WalletState.keys: Btn {
            text: entry.label;
            variant: entry.active ? "primary" : "secondary";
            clicked => { Actions.select-key(entry.label); }
        }
    }
}

// What to send, and where.
//
// Its own component because its two inputs have to be readable from one place —
// an input declared inside an `if` cannot be reached from outside it.
component SendForm inherits HorizontalLayout {
    alignment: center;

    Card {
        width: 520px;
        VerticalLayout {
            padding: Sp.s8;
            spacing: Sp.s6;

            // Which key is paying. Named on the form rather than only in the
            // review, because "where is this coming from" is a question about
            // the payment somebody is composing, not about the one they are
            // being asked to confirm.
            VerticalLayout {
                spacing: Sp.s3;
                HorizontalLayout {
                    Text {
                        text: "From";
                        font-size: Typo.caption;
                        color: Theme.text-secondary;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: WalletState.active-key;
                        font-size: Typo.caption;
                        font-weight: Typo.w-medium;
                        color: Theme.text-primary;
                    }
                }
                Text {
                    text: WalletState.address;
                    font-family: Typo.mono;
                    font-size: Typo.num-sm;
                    color: Theme.text-tertiary;
                    overflow: elide;
                }
                KeyPicker {}
            }

            Rectangle { height: 1px; background: Theme.border-subtle; }

            VerticalLayout {
                spacing: Sp.s3;
                Text {
                    text: "Recipient";
                    font-size: Typo.caption;
                    color: Theme.text-secondary;
                }
                to := Field {
                    mono: true;
                    // The two shapes this accepts, so nobody has to find out by
                    // being refused. Not an example address anybody could copy:
                    // the prefix and the ellipsis are the whole point. The
                    // trailing `@` is not decoration — it is what a VerusID
                    // actually ends with.
                    placeholder: "R… or name@";
                    invalid: to.text != "" && !SendState.to-valid;
                    edited => { root.check(); }
                }
                if SendState.to-note != "": Text {
                    text: SendState.to-note;
                    font-size: Typo.caption;
                    color: SendState.to-valid ? Theme.text-tertiary : Theme.negative;
                    wrap: word-wrap;
                }
            }

            VerticalLayout {
                spacing: Sp.s3;
                HorizontalLayout {
                    Text {
                        text: "Amount";
                        font-size: Typo.caption;
                        color: Theme.text-secondary;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: WalletState.spendable + " spendable";
                        font-family: Typo.mono;
                        font-size: Typo.num-sm;
                        color: Theme.text-tertiary;
                    }
                }
                amount := Field {
                    mono: true;
                    placeholder: "0.0000 0000";
                    invalid: amount.text != "" && !SendState.amount-valid;
                    edited => { root.check(); }
                    accepted => { root.review(); }
                }
                if SendState.amount-note != "": Text {
                    text: SendState.amount-note;
                    font-size: Typo.caption;
                    color: Theme.negative;
                    wrap: word-wrap;
                }
            }

            // No "Max" button, deliberately. The fee is not known until the
            // builder has chosen coins, so a Max that filled in the whole
            // spendable balance would produce an amount that cannot be built —
            // a button that is wrong exactly when someone uses it.
            HorizontalLayout {
                alignment: end;
                Btn {
                    text: SendState.busy ? "Building…" : "Review payment";
                    variant: "primary";
                    enabled: SendState.ready && !SendState.busy;
                    clicked => { root.review(); }
                }
            }
        }
    }

    function check() {
        Actions.validate-draft(to.text, amount.text);
    }

    function review() {
        if (!SendState.ready) { return; }
        Actions.prepare-send(to.text, amount.text);
    }
}

component SendScreen inherits VerticalLayout {
    spacing: Sp.s7;

    if SendState.step == "form": SendForm {}

    // ── Step 2: what was actually built ─────────────────────────────────
    if SendState.step == "review": HorizontalLayout {
        alignment: center;
        Card {
            width: 560px;
            VerticalLayout {
                padding: Sp.s8;
                spacing: Sp.s6;

                VerticalLayout {
                    spacing: Sp.s2;
                    Text {
                        text: "Check this payment";
                        font-size: Typo.title2;
                        font-weight: Typo.w-semibold;
                        color: Theme.text-primary;
                    }
                    Text {
                        // Says exactly what it is, because that is what makes
                        // this step worth reading.
                        text: "Read back from the transaction that was signed — not from what you typed.";
                        font-size: Typo.caption;
                        color: Theme.text-tertiary;
                        wrap: word-wrap;
                    }
                }

                // Above the outputs, because it is about the one line down
                // there that matters and somebody should read it first.
                if SendState.first-time-recipient: Rectangle {
                    background: Theme.warning-soft;
                    border-radius: R.md;
                    VerticalLayout {
                        padding: Sp.s5;
                        spacing: Sp.s2;
                        Text {
                            text: "You have not paid this address before";
                            font-size: Typo.body;
                            font-weight: Typo.w-medium;
                            color: Theme.warning;
                            wrap: word-wrap;
                        }
                        Text {
                            // The one thing a wallet can check that a checksum
                            // cannot. A mistyped address that happens to be
                            // valid looks exactly like a correct one, and coins
                            // sent to it are gone.
                            text: "Check it against where you got it from. A valid address that belongs to somebody else looks exactly like the right one, and nothing can undo the payment.";
                            font-size: Typo.caption;
                            color: Theme.text-secondary;
                            wrap: word-wrap;
                        }
                    }
                }

                // What was asked for, above what was built. A VerusID is a
                // question put to a node; this is the question, and the outputs
                // below are the answer the transaction actually pays.
                if SendState.recipient-name != "": VerticalLayout {
                    spacing: Sp.s2;
                    Eyebrow { text: "ADDRESSED TO"; }
                    Text {
                        text: SendState.recipient-name;
                        font-family: Typo.mono;
                        font-size: Typo.num;
                        color: Theme.text-primary;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "Resolved by the node this wallet is connected to. The address it resolved to is below.";
                        font-size: Typo.caption;
                        color: Theme.text-tertiary;
                        wrap: word-wrap;
                    }
                }

                VerticalLayout {
                    spacing: Sp.s2;
                    Eyebrow { text: "OUTPUTS"; }

                    for output in SendState.outputs: HorizontalLayout {
                        spacing: Sp.s5;
                        padding-top: Sp.s3;
                        padding-bottom: Sp.s3;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: output.address == "" ? "Unknown destination" : output.address;
                                font-family: Typo.mono;
                                font-size: Typo.num-sm;
                                color: output.address == "" ? Theme.negative : Theme.text-primary;
                                wrap: char-wrap;
                            }
                            Text {
                                text: output.is-change ? output.kind + " · change, back to you" : output.kind;
                                font-size: Typo.caption;
                                color: Theme.text-tertiary;
                            }
                        }

                        Money {
                            amount: output.amount;
                            show-currency: false;
                            size: Typo.num;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.border-subtle;
                }

                VerticalLayout {
                    spacing: Sp.s3;
                    HorizontalLayout {
                        Text {
                            text: "Fee";
                            font-size: Typo.body;
                            color: Theme.text-secondary;
                            horizontal-stretch: 1;
                        }
                        Money { amount: SendState.fee; currency: WalletState.ticker; size: Typo.num; }
                    }
                    HorizontalLayout {
                        Text {
                            text: "Leaving your wallet";
                            font-size: Typo.body;
                            font-weight: Typo.w-medium;
                            color: Theme.text-primary;
                            horizontal-stretch: 1;
                        }
                        Money { amount: SendState.total; currency: WalletState.ticker; size: Typo.num-lg; }
                    }
                }

                if SendState.problem != "": Text {
                    text: SendState.problem;
                    font-size: Typo.caption;
                    color: Theme.negative;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: Sp.s4;
                    Btn {
                        text: "Back";
                        variant: "ghost";
                        clicked => {
                            Actions.cancel-send(SendState.ticket);
                            SendState.problem = "";
                            SendState.step = "form";
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Btn {
                        text: SendState.busy ? "Sending…" : "Send now";
                        variant: "primary";
                        enabled: !SendState.busy;
                        clicked => { Actions.confirm-send(SendState.ticket); }
                    }
                }
            }
        }
    }

    // ── Step 3: what happened ───────────────────────────────────────────
    if SendState.step == "sent" || SendState.step == "uncertain": HorizontalLayout {
        alignment: center;
        Card {
            width: 520px;
            VerticalLayout {
                padding: Sp.s8;
                spacing: Sp.s6;

                Text {
                    text: SendState.step == "sent" ? "Payment sent" : "We could not confirm your payment was sent";
                    font-size: Typo.title2;
                    font-weight: Typo.w-semibold;
                    color: SendState.step == "sent" ? Theme.positive : Theme.warning;
                    wrap: word-wrap;
                }

                // The most important paragraph in the application. Someone who
                // resends here can pay twice.
                if SendState.step == "uncertain": Text {
                    text: "It may already be on its way. ChainVue has saved the exact transaction and can check on it. Do not send it again — that could send the money twice.";
                    font-size: Typo.body;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }

                VerticalLayout {
                    spacing: Sp.s2;
                    Eyebrow { text: "TRANSACTION ID"; }
                    txid := TextInput {
                        text: SendState.txid;
                        read-only: true;
                        font-family: Typo.mono;
                        font-size: Typo.num-sm;
                        color: Theme.text-primary;
                        wrap: char-wrap;
                    }
                }

                HorizontalLayout {
                    spacing: Sp.s4;
                    Btn {
                        text: "Copy id";
                        clicked => {
                            txid.select-all();
                            txid.copy();
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Btn {
                        text: "Done";
                        variant: "primary";
                        clicked => {
                            SendState.problem = "";
                            SendState.step = "form";
                        }
                    }
                }
            }
        }
    }

    Rectangle { vertical-stretch: 1; }

}

// One labelled block of settings.
component Section inherits VerticalLayout {
    in property <string> title;
    in property <string> body;
    spacing: Sp.s4;

    VerticalLayout {
        spacing: Sp.s2;
        Eyebrow { text: root.title; }
        if root.body != "": Text {
            text: root.body;
            font-size: Typo.caption;
            color: Theme.text-tertiary;
            wrap: word-wrap;
        }
    }

    Card {
        VerticalLayout {
            padding: Sp.card-pad;
            spacing: Sp.s5;
            @children
        }
    }
}

// The typing-the-word half, separate so its field is addressable — an input
// declared inside an `if` cannot be reached from outside it.
component MainnetArm inherits HorizontalLayout {
    spacing: Sp.s4;

    confirm := Field {
        horizontal-stretch: 1;
        mono: true;
        placeholder: "mainnet";
        accepted => { root.arm(); }
    }
    Btn {
        // The word is checked in the CORE, not here. A confirmation the UI
        // could skip would be theatre.
        text: "Type mainnet to enable";
        enabled: confirm.text != "";
        y: (parent.height - self.height) / 2;
        clicked => { root.arm(); }
    }

    function arm() {
        if (confirm.text == "") { return; }
        Actions.set-mainnet-spend(true, confirm.text);
        confirm.text = "";
    }
}

// Turning on the one thing that can lose real money.
component MainnetToggle inherits VerticalLayout {
    spacing: Sp.s4;

    HorizontalLayout {
        spacing: Sp.s5;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: NetworkState.allow-mainnet-spend
                    ? "Spending on mainnet is ON"
                    : "Spending on mainnet is off";
                font-size: Typo.body;
                font-weight: Typo.w-medium;
                color: NetworkState.allow-mainnet-spend ? Theme.warning : Theme.text-primary;
            }
            Text {
                text: "Reading a mainnet balance is always allowed. This is only about signing away real coins, and it turns itself off again every time ChainVue starts.";
                font-size: Typo.caption;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }
        }

        if NetworkState.allow-mainnet-spend: Btn {
            text: "Turn off";
            variant: "destructive";
            y: (parent.height - self.height) / 2;
            clicked => { Actions.set-mainnet-spend(false, ""); }
        }
    }

    if !NetworkState.allow-mainnet-spend: MainnetArm {}
}

// Replacing the passphrase. Costs two key derivations and re-seals 32 bytes —
// no key is re-encrypted, which is why this is cheap regardless of how many
// keys the wallet holds.
component PassphraseChange inherits VerticalLayout {
    spacing: Sp.s4;

    VerticalLayout {
        spacing: Sp.s3;
        Text {
            text: "Current passphrase";
            font-size: Typo.caption;
            color: Theme.text-secondary;
        }
        current := Field {
            password: true;
            placeholder: "Passphrase";
        }
    }

    VerticalLayout {
        spacing: Sp.s3;
        Text {
            text: "New passphrase";
            font-size: Typo.caption;
            color: Theme.text-secondary;
        }
        fresh := Field {
            password: true;
            placeholder: "A new passphrase";
            accepted => { root.submit(); }
        }
    }

    HorizontalLayout {
        alignment: end;
        Btn {
            text: "Change passphrase";
            variant: "primary";
            enabled: current.text != "" && fresh.text != "";
            clicked => { root.submit(); }
        }
    }

    // Both secrets leave in one call and both fields are blanked before it
    // returns — the same discipline as every other secret-bearing path here.
    function submit() {
        if (current.text == "" || fresh.text == "") { return; }
        Actions.change-passphrase(current.text, fresh.text);
        current.text = "";
        fresh.text = "";
    }
}

// Renaming one key.
//
// Its own component because its input has to be addressable, and because the
// form has to be able to submit from two places — the button and the Return
// key — without duplicating the guard.
component RenameKeyForm inherits VerticalLayout {
    in property <string> label;
    spacing: Sp.s3;

    HorizontalLayout {
        spacing: Sp.s4;

        field := Field {
            horizontal-stretch: 1;
            mono: true;
            placeholder: "savings";
            text <=> WalletState.rename-draft;
            accepted => { root.submit(); }
        }

        Btn {
            text: "Save";
            variant: "primary";
            enabled: field.text != "" && field.text != root.label;
            y: (parent.height - self.height) / 2;
            clicked => { root.submit(); }
        }

        Btn {
            text: "Cancel";
            variant: "ghost";
            y: (parent.height - self.height) / 2;
            clicked => {
                WalletState.renaming = "";
                WalletState.key-problem = "";
            }
        }
    }

    // Under the form, not at the foot of the list. A refusal that appears
    // three rows away from the field it is about is one someone has to go
    // looking for.
    if WalletState.key-problem != "": Text {
        text: WalletState.key-problem;
        font-size: Typo.caption;
        color: Theme.negative;
        wrap: word-wrap;
    }

    // The form is not closed here. Rust closes it when the rename actually
    // lands — a name the vault refuses must not vanish off the screen along
    // with the message explaining why.
    function submit() {
        if (field.text == "" || field.text == root.label) { return; }
        WalletState.key-problem = "";
        Actions.rename-key(root.label, field.text);
    }
}

// Adding a key to a wallet that already exists.
component AddKeyForm inherits HorizontalLayout {
    spacing: Sp.s4;

    field := Field {
        horizontal-stretch: 1;
        mono: true;
        placeholder: "savings";
        text <=> WalletState.new-key-draft;
        accepted => { root.submit(); }
    }

    Btn {
        text: "Generate a key";
        enabled: field.text != "";
        y: (parent.height - self.height) / 2;
        clicked => { root.submit(); }
    }

    function submit() {
        if (field.text == "") { return; }
        WalletState.key-problem = "";
        Actions.add-key(field.text);
    }
}

// One key in the list.
//
// Its own component for the usual reason: the rename form lives inside an `if`,
// and an element declared inside one cannot be reached from outside it.
component KeyRowItem inherits VerticalLayout {
    in property <KeyRow> entry;
    spacing: Sp.s3;

    ListRow {
        // Filled for the active key, hollow for the rest — the same shape the
        // node list uses, so "this is the one in use" reads the same way in
        // both places.
        glyph: root.entry.active ? "●" : "○";
        glyph-tone: root.entry.active ? Theme.accent : Theme.text-tertiary;
        title: root.entry.label;
        subtitle: root.entry.address;
        subtitle-mono: true;
        selected: root.entry.active;
        clicked => { Actions.select-key(root.entry.label); }

        HorizontalLayout {
            spacing: Sp.s5;
            alignment: end;

            // A key whose phrase nobody has written down is one power cut away
            // from being gone. Worth saying on the row, not only on a banner
            // somebody has already dismissed.
            if !root.entry.backed-up: StatusPill {
                state: "pending";
                text: "not backed up";
                y: (parent.height - self.height) / 2;
            }

            // A WIF import never had a phrase, so there is nothing to write
            // down and nothing to warn about. Saying it once here is what
            // stops it reading as a missing backup.
            if root.entry.origin == "wif": Text {
                text: "no recovery phrase";
                font-size: Typo.caption;
                color: Theme.text-tertiary;
                vertical-alignment: center;
            }

            // Bordered, like Remove on the node list. A bare word at the end
            // of a row reads as a label, and the two lists should not disagree
            // about what a row-level action looks like.
            Rectangle {
                width: 100px;
                Btn {
                    text: "Rename";
                    x: parent.width - self.width;
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        WalletState.key-problem = "";
                        WalletState.renaming = root.entry.label;
                        WalletState.rename-draft = root.entry.label;
                    }
                }
            }
        }
    }

    if WalletState.renaming == root.entry.label: RenameKeyForm {
        label: root.entry.label;
    }
}

// Naming one address.
//
// Its own component because its input has to be addressable, and because a
// form that lives inside an `if` cannot be reached from outside it.
component NameAddressForm inherits HorizontalLayout {
    in property <string> address;
    spacing: Sp.s4;

    field := Field {
        horizontal-stretch: 1;
        placeholder: "the exchange";
        text <=> SendState.name-draft;
        accepted => { root.submit(); }
    }

    Btn {
        text: "Save";
        variant: "primary";
        y: (parent.height - self.height) / 2;
        clicked => { root.submit(); }
    }

    Btn {
        text: "Cancel";
        variant: "ghost";
        y: (parent.height - self.height) / 2;
        clicked => { SendState.naming = ""; }
    }

    // An empty name is allowed, and it means "forget the name" rather than
    // "forget the address" — the wallet still knows it was paid, which is what
    // stops the review warning about it again.
    function submit() {
        Actions.label-address(root.address, field.text);
    }
}

// One address the wallet has paid.
component KnownAddressItem inherits VerticalLayout {
    in property <KnownAddressRow> entry;
    spacing: Sp.s3;

    ListRow {
        // The name where there is one, the address where there is not. An
        // unnamed row must not read as an empty row.
        title: root.entry.label == "" ? root.entry.address : root.entry.label;
        title-mono: root.entry.label == "";
        subtitle: root.entry.label == "" ? root.entry.summary : root.entry.address;
        subtitle-mono: root.entry.label != "";
        interactive: false;

        HorizontalLayout {
            spacing: Sp.s5;
            alignment: end;

            if root.entry.label != "": Text {
                text: root.entry.summary;
                font-size: Typo.caption;
                color: Theme.text-tertiary;
                vertical-alignment: center;
            }

            Rectangle {
                width: 88px;
                Btn {
                    text: root.entry.label == "" ? "Name" : "Rename";
                    x: parent.width - self.width;
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        SendState.naming = root.entry.address;
                        SendState.name-draft = root.entry.label;
                    }
                }
            }

            Rectangle {
                width: 88px;
                Btn {
                    // Not destructive-red. Forgetting an address costs nothing
                    // and undoes nothing — the payment already happened and is
                    // on the chain. What it does is make the review warn about
                    // that address again, which is what somebody removing it
                    // is asking for.
                    text: "Forget";
                    x: parent.width - self.width;
                    y: (parent.height - self.height) / 2;
                    clicked => { Actions.forget-address(root.entry.address); }
                }
            }
        }
    }

    if SendState.naming == root.entry.address: NameAddressForm {
        address: root.entry.address;
    }
}

component SettingsScreen inherits VerticalLayout {
    spacing: Sp.section-gap;
    property <[int]> lock-choices: [1, 5, 15, 60, 0];

    // Applied here AND sent to be written down. Applying it locally rather than
    // waiting for the core to echo it back is what keeps the button feeling
    // immediate; the core's copy is only read at the next start.
    function appearance(dark: bool, reduce: bool) {
        Theme.dark = dark;
        Motion.enabled = !reduce;
        Actions.set-appearance(dark, reduce);
    }

    Section {
        title: "SECURITY";

        VerticalLayout {
            spacing: Sp.s3;
            Text {
                text: "Lock after";
                font-size: Typo.body;
                font-weight: Typo.w-medium;
                color: Theme.text-primary;
            }
            Text {
                text: "Locking drops the key that decrypts your wallet, so every key in it becomes unreadable until you enter the passphrase again.";
                font-size: Typo.caption;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: Sp.s3;
                alignment: start;
                for minutes in root.lock-choices: Btn {
                    text: minutes == 0 ? "Never"
                        : minutes == 60 ? "1 hour"
                        : minutes + " min";
                    variant: WalletState.auto-lock == minutes ? "primary" : "secondary";
                    clicked => { Actions.set-auto-lock(minutes); }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border-subtle; }

        PassphraseChange {}
    }

    Section {
        title: "KEYS";
        body: "A ChainVue wallet holds any number of keys, and the dashboard adds up all of them. One passphrase protects the lot — adding a key does not ask for it again.";

        for entry in WalletState.keys: KeyRowItem {
            entry: entry;
        }

        Rectangle { height: 1px; background: Theme.border-subtle; }

        VerticalLayout {
            spacing: Sp.s3;
            Text {
                text: "Add a key";
                font-size: Typo.body;
                font-weight: Typo.w-medium;
                color: Theme.text-primary;
            }
            Text {
                // Verus transparent keys are not hierarchical-deterministic:
                // one phrase is one key. Somebody who expects a second key to
                // fall out of the phrase they already wrote down needs to hear
                // otherwise before they generate one, not after.
                text: "A new key comes with its own recovery phrase, and you will be asked to write it down. Verus keys are not derived from one another — the phrase you already have does not restore this one.";
                font-size: Typo.caption;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }
            AddKeyForm {}

            // Only when no rename is open — that form shows its own copy under
            // itself, and one message rendered twice reads as two problems.
            if WalletState.key-problem != "" && WalletState.renaming == "": Text {
                text: WalletState.key-problem;
                font-size: Typo.caption;
                color: Theme.negative;
                wrap: word-wrap;
            }
        }
    }

    Section {
        title: "ADDRESSES";
        body: "Who this wallet has paid. ChainVue records a recipient once a node has accepted the payment, so it can tell you when you are paying somewhere new — the one check it can make that a checksum cannot.";

        if SendState.known.length == 0: Text {
            text: "Nothing yet. An address appears here the first time you pay it.";
            font-size: Typo.caption;
            color: Theme.text-tertiary;
        }

        for entry in SendState.known: KnownAddressItem {
            entry: entry;
        }
    }

    Section {
        title: "APPEARANCE";

        VerticalLayout {
            spacing: Sp.s3;
            Text {
                text: "Theme";
                font-size: Typo.body;
                font-weight: Typo.w-medium;
                color: Theme.text-primary;
            }
            HorizontalLayout {
                spacing: Sp.s3;
                alignment: start;
                Btn {
                    text: "Dark";
                    variant: Theme.dark ? "primary" : "secondary";
                    clicked => { root.appearance(true, !Motion.enabled); }
                }
                Btn {
                    text: "Light";
                    variant: Theme.dark ? "secondary" : "primary";
                    clicked => { root.appearance(false, !Motion.enabled); }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border-subtle; }

        VerticalLayout {
            spacing: Sp.s3;
            Text {
                text: "Motion";
                font-size: Typo.body;
                font-weight: Typo.w-medium;
                color: Theme.text-primary;
            }
            Text {
                // What "reduced" actually means here, because the usual
                // implementation of this switch is "nothing happens at all"
                // and that is not what this one does.
                text: "Reduced motion removes movement, scaling and the chart's draw-in. Cross-fades stay: opacity is not a vestibular trigger, and a hard swap is jarring for motion-sensitive people too.";
                font-size: Typo.caption;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: Sp.s3;
                alignment: start;
                Btn {
                    text: "Full motion";
                    variant: Motion.enabled ? "primary" : "secondary";
                    clicked => { root.appearance(Theme.dark, false); }
                }
                Btn {
                    text: "Reduced";
                    variant: Motion.enabled ? "secondary" : "primary";
                    clicked => { root.appearance(Theme.dark, true); }
                }
            }
        }
    }

    Section {
        title: "NETWORK";
        MainnetToggle {}
    }

    Section {
        title: "ABOUT";

        VerticalLayout {
            spacing: Sp.s4;

            HorizontalLayout {
                Text {
                    text: "Wallet file";
                    font-size: Typo.body;
                    color: Theme.text-secondary;
                    horizontal-stretch: 1;
                }
                Text {
                    text: WalletState.vault-path;
                    font-family: Typo.mono;
                    font-size: Typo.num-sm;
                    color: Theme.text-tertiary;
                    overflow: elide;
                }
            }

            HorizontalLayout {
                Text {
                    text: "Logs";
                    font-size: Typo.body;
                    color: Theme.text-secondary;
                    horizontal-stretch: 1;
                }
                Text {
                    text: AppInfo.log-path;
                    font-family: Typo.mono;
                    font-size: Typo.num-sm;
                    color: Theme.text-tertiary;
                    overflow: elide;
                }
            }

            // The fonts are compiled into this binary, and the SIL Open Font
            // License requires its notice to travel with them — which means it
            // travels with the executable, not just with the source tree. This
            // line is that notice. See `ui/fonts/README.md`.
            HorizontalLayout {
                Text {
                    text: "Typeset in";
                    font-size: Typo.body;
                    color: Theme.text-secondary;
                    horizontal-stretch: 1;
                }
                Text {
                    text: "Inter and IBM Plex Mono · SIL OFL 1.1";
                    font-size: Typo.caption;
                    color: Theme.text-tertiary;
                }
            }

            HorizontalLayout {
                Text {
                    text: "Verus SDK";
                    font-size: Typo.body;
                    color: Theme.text-secondary;
                    horizontal-stretch: 1;
                }
                Text {
                    // Which revision is in the build is a fact worth being able
                    // to read off a screen rather than out of a lock file.
                    text: AppInfo.sdk-rev;
                    font-family: Typo.mono;
                    font-size: Typo.num-sm;
                    color: Theme.text-tertiary;
                }
            }
        }
    }

    Rectangle { vertical-stretch: 1; }
}

// One transaction, in the list.
component ActivityRowItem inherits VerticalLayout {
    in property <ActivityRow> entry;
    // Mined, and therefore in a block with a time and a depth.
    property <bool> settled: !root.entry.pending && root.entry.height > 0;
    // Depth, guarded and capped.
    //
    // Guarded because a tip that is briefly behind a block — during a reorg, or
    // between a new block arriving and the next poll — would otherwise print a
    // negative count. Capped because past a thousand the exact number carries
    // no information anybody uses: what matters is 1 (it is in a block) and
    // 100 (a coinbase has matured), and "1 187 402 confirmations" is a figure
    // that only makes the useful ones harder to read.
    property <int> depth: max(0, WalletState.tip-height - root.entry.height + 1);
    spacing: Sp.s2;

    // The day heading, above the first row of that day. Its own layout so the
    // breathing room above it is padding rather than a Text property that
    // silently does nothing.
    if root.entry.group != "": VerticalLayout {
        padding-top: Sp.s5;
        padding-left: Sp.s5;
        padding-bottom: Sp.s2;
        Text {
            text: root.entry.group;
            font-size: Typo.micro;
            font-weight: Typo.w-medium;
            letter-spacing: 0.6px;
            color: Theme.text-tertiary;
        }
    }

    ListRow {
        glyph: root.entry.direction == "in" ? "↓" : root.entry.direction == "out" ? "↑" : "⇄";
        glyph-tone: root.entry.direction == "in" ? Theme.positive
            : root.entry.direction == "out" ? Theme.negative
            : Theme.text-secondary;
        title: root.entry.direction == "in" ? "Received"
            : root.entry.direction == "out" ? "Sent"
            : "Moved";
        subtitle: root.entry.txid-short;
        subtitle-mono: true;
        interactive: true;
        clicked => { Actions.open-tx(root.entry.txid); }

        HorizontalLayout {
            spacing: Sp.s5;
            alignment: end;

            VerticalLayout {
                alignment: center;
                spacing: 2px;

                // A settled transaction has a time and a depth. An unsettled
                // one has neither, and saying "pending" above "unconfirmed"
                // was one fact printed twice.
                if root.settled: Text {
                    text: root.entry.when;
                    font-size: Typo.caption;
                    color: Theme.text-tertiary;
                    horizontal-alignment: right;
                }
                if root.settled: Text {
                    // Derived, never stored: `tip - height + 1`. A new block
                    // changes one number and every row here follows.
                    text: WalletState.tip-height == 0 ? ""
                        : root.depth == 1 ? "1 confirmation"
                        : root.depth > 999 ? "999+ confirmations"
                        : root.depth + " confirmations";
                    font-size: Typo.micro;
                    color: Theme.text-disabled;
                    horizontal-alignment: right;
                }
                if !root.settled: Text {
                    text: "unconfirmed";
                    font-size: Typo.caption;
                    color: Theme.warning;
                    horizontal-alignment: right;
                }
            }

            Money {
                amount: root.entry.amount;
                show-currency: false;
                tone: root.entry.direction == "in" ? "positive"
                    : root.entry.direction == "out" ? "negative"
                    : "neutral";
                y: (parent.height - self.height) / 2;
            }
        }
    }
}

// The one screen that scrolls itself.
//
// # Why it is not inside the shared page scroller
//
// Every other screen is a page of a known height, and one `Flickable` around all
// of them is right. This one is as long as somebody's history — and it used to
// be a plain `for`, which builds every row as a live component whether or not
// anybody can see it. Measured, release build, in `examples/scroll_cost.rs`:
//
// | rows | build + layout |
// |-----:|---------------:|
// |  100 |        17.6 ms |
// | 1000 |        56.6 ms |
// | 10k  |         552 ms |
// | 50k  |          2.9 s |
//
// Linear, and paid on the thread the interface answers on. Slint's software
// renderer will not even draw past about a thousand rows: it works in i16
// fixed-point coordinates and a column that tall overflows them.
//
// `ListView` builds only what is visible. It is also a scroller, and a scroller
// inside a `Flickable` is two of them fighting over one wheel — which is why
// this screen is hoisted out of the shared one rather than dropped into it.
// Looking one up: anyone's identity, not only your own.
component LookUpForm inherits VerticalLayout {
    spacing: Sp.s3;

    function submit() {
        if (field.text == "") { return; }
        IdentityState.lookup-problem = "";
        Actions.look-up-identity(field.text);
    }

    HorizontalLayout {
        spacing: Sp.s4;
        field := Field {
            horizontal-stretch: 1;
            mono: true;
            placeholder: "name@ or i-address";
            text <=> IdentityState.lookup-draft;
            invalid: IdentityState.lookup-problem != "";
            accepted => { root.submit(); }
        }
        Btn {
            text: "Look up";
            y: (parent.height - self.height) / 2;
            clicked => { root.submit(); }
        }
    }

    if IdentityState.lookup-problem != "": Text {
        text: IdentityState.lookup-problem;
        font-size: Typo.caption;
        color: Theme.negative;
        wrap: word-wrap;
    }
}

// Claiming a name: the form, and then the claim in progress.
component RegisterForm inherits VerticalLayout {
    spacing: Sp.s5;

    VerticalLayout {
        spacing: Sp.s3;
        Text {
            text: "Name";
            font-size: Typo.caption;
            color: Theme.text-secondary;
        }
        name := Field {
            mono: true;
            placeholder: "lowercase, digits, _ and -";
            text <=> IdentityState.name-draft;
            invalid: name.text != "" && IdentityState.name-problem != "";
            edited => { Actions.check-name(name.text); }
        }
        if IdentityState.name-problem != "": Text {
            text: IdentityState.name-problem;
            font-size: Typo.caption;
            color: Theme.negative;
            wrap: word-wrap;
        }
        if IdentityState.name-problem == "" && IdentityState.name-fee != "": Text {
            text: "Free to claim · costs " + IdentityState.name-fee + " " + WalletState.ticker;
            font-size: Typo.caption;
            color: Theme.text-tertiary;
            wrap: word-wrap;
        }
    }

    // Not buried in an "advanced" fold, because the default is the dangerous
    // one and this is the only moment it is free to change.
    VerticalLayout {
        spacing: Sp.s3;
        Eyebrow { text: "WHO CAN TAKE IT AWAY"; }
        Text {
            text: "Leave these blank and the identity becomes its own authority — which means it cannot be revoked, because the chain refuses a revocation whose subject is its own recovery authority. You can change that later with your own keys, but it costs another transaction.";
            font-size: Typo.caption;
            color: Theme.text-secondary;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: Sp.s4;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Sp.s2;
                Text {
                    text: "Revocation";
                    font-size: Typo.caption;
                    color: Theme.text-secondary;
                }
                revocation := Field {
                    mono: true;
                    placeholder: "name@ or i-address";
                    text <=> IdentityState.revocation-draft;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Sp.s2;
                Text {
                    text: "Recovery";
                    font-size: Typo.caption;
                    color: Theme.text-secondary;
                }
                recovery := Field {
                    mono: true;
                    placeholder: "name@ or i-address";
                    text <=> IdentityState.recovery-draft;
                }
            }
        }
    }

    HorizontalLayout {
        alignment: end;
        Btn {
            text: IdentityState.reg-busy ? "Working…" : "Claim this name";
            variant: "primary";
            enabled: !IdentityState.reg-busy
                && IdentityState.name-draft != ""
                && IdentityState.name-problem == "";
            clicked => {
                Actions.start-registration(
                    IdentityState.name-draft,
                    IdentityState.revocation-draft,
                    IdentityState.recovery-draft,
                );
            }
        }
    }
}

// A claim that is under way. Two transactions with a deadline between them.
component RegistrationPanel inherits VerticalLayout {
    spacing: Sp.s4;

    Text {
        text: IdentityState.reg-name;
        font-family: Typo.mono;
        font-size: Typo.title3;
        color: Theme.text-primary;
        wrap: char-wrap;
    }

    Text {
        text: IdentityState.reg-note;
        font-size: Typo.body;
        color: Theme.text-secondary;
        wrap: word-wrap;
    }

    // The deadline, in the shape the send screen uses for a warning — because
    // it is one. The window is about twenty blocks and it cannot be extended:
    // the expiry is inside the bytes the claim was signed with.
    if IdentityState.reg-deadline != "": Rectangle {
        background: Theme.warning-soft;
        border-radius: R.md;
        VerticalLayout {
            padding: Sp.s5;
            spacing: Sp.s2;
            Text {
                text: IdentityState.reg-deadline;
                font-size: Typo.body;
                font-weight: Typo.w-medium;
                color: Theme.warning;
                wrap: word-wrap;
            }
            Text {
                text: "Safe to close ChainVue — the claim is written down and will be picked up. Do not start the same name again; that would spend a second fee.";
                font-size: Typo.caption;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }
        }
    }

    if IdentityState.reg-address != "": VerticalLayout {
        spacing: Sp.s2;
        Eyebrow { text: "ITS ADDRESS"; }
        Text {
            text: IdentityState.reg-address;
            font-family: Typo.mono;
            font-size: Typo.num-sm;
            color: Theme.text-primary;
            wrap: char-wrap;
        }
    }

    if IdentityState.reg-step == "done" && IdentityState.reg-cannot-be-revoked: Rectangle {
        background: Theme.warning-soft;
        border-radius: R.md;
        VerticalLayout {
            padding: Sp.s5;
            spacing: Sp.s2;
            Text {
                text: "This VerusID cannot be revoked yet";
                font-size: Typo.body;
                font-weight: Typo.w-medium;
                color: Theme.warning;
                wrap: word-wrap;
            }
            Text {
                text: "It is its own recovery authority. Pointing recovery at another identity is what makes revocation work, and your keys can still do that.";
                font-size: Typo.caption;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }
        }
    }

    HorizontalLayout {
        spacing: Sp.s4;
        alignment: end;
        if IdentityState.reg-step != "done": Btn {
            text: "Abandon";
            variant: "ghost";
            enabled: !IdentityState.reg-busy;
            clicked => { Actions.abandon-registration(); }
        }
        if IdentityState.reg-step == "ready": Btn {
            text: IdentityState.reg-busy ? "Registering…" : "Register the name";
            variant: "primary";
            enabled: !IdentityState.reg-busy;
            clicked => { Actions.finish-registration(); }
        }
        if IdentityState.reg-step == "done": Btn {
            text: "Done";
            variant: "primary";
            clicked => { Actions.abandon-registration(); }
        }
    }
}

component IdentitiesScreen inherits VerticalLayout {
    spacing: Sp.s7;

    HorizontalLayout {
        spacing: Sp.s5;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Sp.s2;
            Text {
                // Describes the list below it and nothing else. The looked-up
                // section has its own heading and its own count, because this
                // sentence is a claim about your keys and would be false over
                // anything that is not yours.
                text: IdentityState.rows.length == 0
                    ? "Found by asking the chain which names your keys control"
                    : "Found by asking the chain which names your keys control · "
                        + IdentityState.rows.length;
                font-size: Typo.caption;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }
        }
        Btn {
            text: IdentityState.busy ? "Reading…" : "Refresh";
            enabled: !IdentityState.busy;
            y: (parent.height - self.height) / 2;
            clicked => { Actions.refresh-identities(); }
        }
    }

    Card {
        VerticalLayout {
            padding: Sp.s3;

            if IdentityState.rows.length == 0 && !IdentityState.busy: Rectangle {
                height: 120px;
                EmptyState {
                    glyph: "◇";
                    title: "No VerusIDs yet";
                    body: "A VerusID is a name you own on the chain. It can receive payments, hold currencies, and publish data. You can also look up anybody else's below.";
                }
            }

            for row in IdentityState.rows: ListRow {
                glyph: "◇";
                glyph-tone: row.tone == "online" ? Theme.positive
                    : row.tone == "degraded" ? Theme.warning
                    : row.tone == "offline" ? Theme.negative
                    : Theme.text-tertiary;
                title: row.name;
                subtitle: row.address;
                subtitle-mono: true;
                interactive: true;
                clicked => { Actions.open-identity(row.address); }

                HorizontalLayout {
                    spacing: Sp.s5;
                    alignment: end;

                    // Fixed, so the pills line up down the column. Left to size
                    // themselves they follow the note beneath, and four rows
                    // with four different notes put four pills in four places.
                    VerticalLayout {
                        width: 260px;
                        alignment: center;
                        spacing: 2px;
                        HorizontalLayout {
                            alignment: end;
                            StatusPill {
                                state: row.tone;
                                text: row.status;
                            }
                        }
                        if row.note != "": Text {
                            text: row.note;
                            font-size: Typo.micro;
                            color: Theme.text-tertiary;
                            horizontal-alignment: right;
                            wrap: word-wrap;
                        }
                    }

                }
            }
        }
    }

    // A claim in progress replaces the form: there is deliberately only ever
    // one, because each carries its own deadline and two clocks running at once
    // is one more than anybody can watch.
    VerticalLayout {
        spacing: Sp.s4;
        Eyebrow {
            text: IdentityState.reg-step == "" ? "CLAIM A NAME" : "CLAIMING A NAME";
        }
        Card {
            VerticalLayout {
                padding: Sp.card-pad;
                if IdentityState.reg-step == "": RegisterForm {}
                if IdentityState.reg-step != "": RegistrationPanel {}
            }
        }
    }

    VerticalLayout {
        spacing: Sp.s4;
        Eyebrow { text: "LOOK ONE UP"; }
        Card {
            VerticalLayout {
                padding: Sp.card-pad;
                LookUpForm {}
            }
        }
    }

    // Anything looked up that is not yours. Its own section, its own heading,
    // and a way to be rid of it — an aside, not a second list competing with
    // the one above.
    if IdentityState.looked-up.length > 0: VerticalLayout {
        spacing: Sp.s4;
        HorizontalLayout {
            spacing: Sp.s5;
            Eyebrow {
                text: "LOOKED UP · NOT YOURS";
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Btn {
                text: "Clear";
                variant: "ghost";
                y: (parent.height - self.height) / 2;
                clicked => { Actions.clear-lookups(); }
            }
        }
        Card {
            VerticalLayout {
                padding: Sp.s3;
                for row in IdentityState.looked-up: ListRow {
                    glyph: "◇";
                    glyph-tone: Theme.text-tertiary;
                    title: row.name;
                    subtitle: row.address;
                    subtitle-mono: true;
                    interactive: true;
                    clicked => { Actions.open-identity(row.address); }

                    HorizontalLayout {
                        spacing: Sp.s5;
                        alignment: end;
                        VerticalLayout {
                            width: 260px;
                            alignment: center;
                            spacing: 2px;
                            HorizontalLayout {
                                alignment: end;
                                StatusPill {
                                    state: row.tone;
                                    text: row.status;
                                }
                            }
                            if row.note != "": Text {
                                text: row.note;
                                font-size: Typo.micro;
                                color: Theme.text-tertiary;
                                horizontal-alignment: right;
                                wrap: word-wrap;
                            }
                        }
                        // One at a time, beside Clear for all of them. A list
                        // that can only be emptied wholesale makes keeping one
                        // entry cost keeping every entry.
                        Rectangle {
                            width: 88px;
                            Btn {
                                text: "Remove";
                                variant: "ghost";
                                x: parent.width - self.width;
                                y: (parent.height - self.height) / 2;
                                clicked => { Actions.unwatch-identity(row.address); }
                            }
                        }
                    }
                }
            }
        }
    }

    Rectangle { vertical-stretch: 1; }
}

component ActivityScreen inherits VerticalLayout {
    padding: Sp.screen-pad;
    // Both were the shared page layout's job until this screen left it.
    max-width: Sp.content-max;
    spacing: Sp.s5;

    if WalletState.history.length == 0 && !WalletState.loading: Card {
        VerticalLayout {
            padding: Sp.s11;
            EmptyState {
                glyph: "○";
                title: "No transactions yet";
                body: "Everything this wallet has ever sent or received appears here.";
            }
        }
    }

    if WalletState.history.length > 0: Card {
        // Takes whatever the footer leaves, so a long history fills the window
        // and "Load older" stays reachable rather than being pushed off the end
        // of a list that grows every time it is pressed.
        // And fills it, rather than hugging its contents.
        //
        // A `ListView` cannot size to what is in it: knowing the content height
        // means laying the content out, and not laying out what nobody can see
        // is the entire point. Binding the card to `viewport-height` compiles to
        // a binding loop, which is the compiler saying the same thing.
        //
        // So the list occupies the pane the way a list does everywhere else —
        // rows at the top, the rest empty on a short history. The footer below
        // it is better off for it: "Load older" now sits at a fixed place
        // instead of after a list that grows every time it is pressed.
        vertical-stretch: 1;
        VerticalLayout {
            padding: Sp.s3;
            // Every transaction, newest first, and only the visible ones built.
            // The day headings ride along inside the row that starts a day —
            // computed in core, which can see the row before this one — so this
            // stays one flat model rather than a tree the list cannot page.
            list := ListView {
                for item in WalletState.history: ActivityRowItem {
                    entry: item;
                }
            }
        }
    }

    // Offered until the scan has actually reached the start of the chain.
    // History is fetched in windows of blocks, so an empty stretch is not the
    // end of the list — and a wallet that stopped at the first quiet week would
    // simply be hiding transactions.
    if WalletState.history.length > 0 && !WalletState.history-complete: HorizontalLayout {
        alignment: center;
        Btn {
            text: WalletState.loading-history ? "Reading…" : "Load older transactions";
            enabled: !WalletState.loading-history;
            clicked => { Actions.load-older(); }
        }
    }

    if WalletState.history.length > 0 && WalletState.history-complete: Text {
        text: "That is everything on the chain for this wallet.";
        font-size: Typo.caption;
        color: Theme.text-tertiary;
        horizontal-alignment: center;
    }

    // No trailing spacer here, unlike the other screens. The list above is what
    // takes the leftover height — a spacer competing for it would split the
    // difference and leave the list half a window tall with empty space beneath.
    if WalletState.history.length == 0: Rectangle { vertical-stretch: 1; }
}

// Where to look a transaction up.
//
// Shown, not opened. Launching a browser is a capability a wallet does not
// otherwise have, and it is one process spawn away from being a way to run
// something else.
component ExplorerLink inherits VerticalLayout {
    spacing: Sp.s3;
    Eyebrow { text: "LOOK IT UP"; }

    HorizontalLayout {
        spacing: Sp.s4;
        link := TextInput {
            horizontal-stretch: 1;
            text: TxState.explorer;
            read-only: true;
            font-family: Typo.mono;
            font-size: Typo.num-sm;
            color: Theme.text-secondary;
            wrap: char-wrap;
        }
        Btn {
            text: "Copy link";
            y: 0;
            clicked => {
                link.select-all();
                link.copy();
            }
        }
    }
}

// One transaction, over whatever is behind it.
//
// A sheet rather than a screen: it is a detour, and coming back should not need
// a decision about where you were.
// One key's worth of published content.
//
// Its own component because the key heading is drawn only on the first row of
// each key, and an element declared inside an `if` cannot be addressed from
// outside it.
component ContentRow inherits VerticalLayout {
    in property <ContentEntry> entry;
    spacing: Sp.s2;

    if root.entry.first: VerticalLayout {
        padding-top: Sp.s4;
        spacing: 2px;
        Text {
            text: root.entry.name != "" ? root.entry.name : "Unnamed key";
            font-size: Typo.caption;
            font-weight: Typo.w-medium;
            color: Theme.text-primary;
        }
        Text {
            text: root.entry.key;
            font-family: Typo.mono;
            font-size: Typo.micro;
            color: Theme.text-tertiary;
            wrap: char-wrap;
        }
        if root.entry.name == "": Text {
            // Not "we could not look it up yet". A VDXF key is a one-way hash
            // of a name, so for a key somebody else published there is nothing
            // to look up and never will be.
            text: "This key's name cannot be recovered — VDXF keys are one-way hashes.";
            font-size: Typo.micro;
            color: Theme.text-tertiary;
            wrap: word-wrap;
        }
    }

    Rectangle {
        background: Theme.bg-inset;
        border-radius: R.md;
        VerticalLayout {
            padding: Sp.s4;
            spacing: Sp.s2;

            if root.entry.structured != "": Text {
                // The daemon recognised the key and rendered it. The only
                // structure anybody gets for free.
                text: root.entry.structured;
                font-family: Typo.mono;
                font-size: Typo.micro;
                color: Theme.text-primary;
                wrap: word-wrap;
            }

            if root.entry.text != "": Text {
                text: root.entry.text;
                font-size: Typo.body;
                color: Theme.text-primary;
                wrap: word-wrap;
            }

            if root.entry.hex != "": Text {
                // Always shown, under the reading rather than instead of it:
                // the text is an interpretation, the bytes are the fact.
                text: root.entry.hex;
                font-family: Typo.mono;
                font-size: Typo.micro;
                color: root.entry.text != "" ? Theme.text-tertiary : Theme.text-primary;
                wrap: char-wrap;
            }

            if root.entry.text == "" && root.entry.size != "": Text {
                text: root.entry.size;
                font-size: Typo.micro;
                color: Theme.text-tertiary;
            }
        }
    }
}

// Deriving a key from a name, which is the only direction that exists.
component TryKeyForm inherits VerticalLayout {
    spacing: Sp.s3;

    Text {
        // Says plainly what it is. The SDK's own words: trying candidate names
        // against the derivation is a search, not a lookup.
        text: "A key is a hash of a name, so it cannot be read backwards. Type a name you expect and see whether this identity published under it.";
        font-size: Typo.caption;
        color: Theme.text-secondary;
        wrap: word-wrap;
    }

    HorizontalLayout {
        spacing: Sp.s4;
        key := Field {
            horizontal-stretch: 1;
            mono: true;
            placeholder: "vrsc::identity.profile";
            text <=> IdentityState.key-draft;
            accepted => { Actions.derive-content-key(key.text); }
        }
        Btn {
            text: "Try it";
            y: (parent.height - self.height) / 2;
            clicked => { Actions.derive-content-key(key.text); }
        }
    }

    if IdentityState.derived-key != "": VerticalLayout {
        spacing: 2px;
        Text {
            text: IdentityState.derived-key;
            font-family: Typo.mono;
            font-size: Typo.num-sm;
            color: Theme.text-primary;
            wrap: char-wrap;
        }
        Text {
            text: IdentityState.derived-present
                ? "This identity has published under that name."
                : "This identity has nothing under that name.";
            font-size: Typo.caption;
            color: IdentityState.derived-present ? Theme.positive : Theme.text-tertiary;
            wrap: word-wrap;
        }
    }
}

// One VerusID, in full.
//
// Sections in order of consequence rather than in the order the fields arrive:
// who can sign, who can take it away, whether it is held, and only then what it
// has published.
// A change built and signed, waiting to be sent.
//
// Its own layer over the sheet rather than a section inside it, for the reason
// the send review is its own step: this is the last moment before something
// irreversible, and it should not be one heading among eight.
component IdentityChangeReview inherits Rectangle {
    background: Theme.dark ? #0B0C0EE0 : #FBFBFCE0;
    TouchArea {}

    Card {
        width: 520px;
        height: content.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        content := VerticalLayout {
            padding: Sp.s8;
            spacing: Sp.s5;

            Text {
                text: "Check this change";
                font-size: Typo.title2;
                font-weight: Typo.w-semibold;
                color: Theme.text-primary;
            }
            Text {
                text: IdentityState.change-description;
                font-size: Typo.body;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }

            HorizontalLayout {
                Text {
                    text: "Fee";
                    font-size: Typo.caption;
                    color: Theme.text-secondary;
                    horizontal-stretch: 1;
                }
                Money {
                    amount: IdentityState.change-fee;
                    currency: WalletState.ticker;
                    size: Typo.num;
                }
            }

            // A word, for the one change nobody can undo. The same shape the
            // mainnet spending switch uses — and checked in the core, not here,
            // so a different interface cannot skip it.
            if IdentityState.change-needs-confirmation: VerticalLayout {
                spacing: Sp.s3;
                Rectangle {
                    background: Theme.negative-soft;
                    border-radius: R.md;
                    VerticalLayout {
                        padding: Sp.s5;
                        spacing: Sp.s2;
                        Text {
                            text: "This cannot be undone from here";
                            font-size: Typo.body;
                            font-weight: Typo.w-medium;
                            color: Theme.negative;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "Only the recovery authority can bring a revoked identity back — and if that authority is the identity itself, nobody can.";
                            font-size: Typo.caption;
                            color: Theme.text-secondary;
                            wrap: word-wrap;
                        }
                    }
                }
                Text {
                    text: "Type revoke to confirm";
                    font-size: Typo.caption;
                    color: Theme.text-secondary;
                }
                typed := Field {
                    mono: true;
                    placeholder: "revoke";
                    text <=> IdentityState.change-typed;
                }
            }

            HorizontalLayout {
                spacing: Sp.s4;
                alignment: end;
                Btn {
                    text: "Back";
                    variant: "ghost";
                    clicked => { Actions.cancel-identity-change(IdentityState.change-ticket); }
                }
                Btn {
                    text: IdentityState.change-busy ? "Sending…" : "Send it";
                    variant: IdentityState.change-needs-confirmation ? "destructive" : "primary";
                    enabled: !IdentityState.change-busy;
                    clicked => {
                        Actions.confirm-identity-change(
                            IdentityState.change-ticket,
                            IdentityState.change-typed,
                        );
                    }
                }
            }
        }
    }
}

component IdentitySheet inherits Rectangle {
    background: Theme.dark ? #0B0C0EC0 : #FBFBFCC0;

    // Swallows clicks on the scrim and closes.
    TouchArea {
        clicked => { Actions.close-identity(); }
    }

    Card {
        width: 640px;
        height: min(root.height - Sp.s11 * 2, content.preferred-height);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        // The card itself must not close it.
        TouchArea {}

        Flickable {
            viewport-height: content.preferred-height;

            content := VerticalLayout {
                padding: Sp.s8;
                spacing: Sp.s6;

                HorizontalLayout {
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: Sp.s2;
                        Text {
                            text: IdentityState.name;
                            font-size: Typo.title2;
                            font-weight: Typo.w-semibold;
                            color: Theme.text-primary;
                            wrap: word-wrap;
                        }
                        Text {
                            text: IdentityState.address;
                            font-family: Typo.mono;
                            font-size: Typo.num-sm;
                            color: Theme.text-tertiary;
                            wrap: char-wrap;
                        }
                    }
                    Btn {
                        text: "Close";
                        y: 0;
                        clicked => { Actions.close-identity(); }
                    }
                }

                HorizontalLayout {
                    spacing: Sp.s5;
                    StatusPill {
                        state: IdentityState.tone;
                        text: IdentityState.status;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Money {
                        amount: IdentityState.balance;
                        currency: WalletState.ticker;
                        size: Typo.num;
                    }
                }

                // ── The warning that outranks everything on this screen ──
                if IdentityState.cannot-be-revoked: Rectangle {
                    background: Theme.warning-soft;
                    border-radius: R.md;
                    VerticalLayout {
                        padding: Sp.s5;
                        spacing: Sp.s2;
                        Text {
                            text: "This VerusID cannot be revoked";
                            font-size: Typo.body;
                            font-weight: Typo.w-medium;
                            color: Theme.warning;
                            wrap: word-wrap;
                        }
                        Text {
                            // The default a fresh registration lands on, and
                            // the one nobody is told about at the time.
                            text: "Its recovery authority is itself, and the chain refuses a revocation whose subject is its own recovery authority. Setting a different recovery authority is what makes it revocable.";
                            font-size: Typo.caption;
                            color: Theme.text-secondary;
                            wrap: word-wrap;
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.border-subtle; }

                VerticalLayout {
                    spacing: Sp.s3;
                    Eyebrow { text: "WHO CAN SIGN"; }
                    for address in IdentityState.primary-addresses: Text {
                        text: address;
                        font-family: Typo.mono;
                        font-size: Typo.num-sm;
                        color: Theme.text-primary;
                        wrap: char-wrap;
                    }
                    Text {
                        text: IdentityState.signatures-required + " signatures required";
                        font-size: Typo.caption;
                        color: Theme.text-tertiary;
                    }
                    Text {
                        text: IdentityState.control-note;
                        font-size: Typo.caption;
                        color: Theme.text-secondary;
                        wrap: word-wrap;
                    }
                }

                Rectangle { height: 1px; background: Theme.border-subtle; }

                VerticalLayout {
                    spacing: Sp.s3;
                    Eyebrow { text: "WHO CAN TAKE IT AWAY"; }
                    HorizontalLayout {
                        spacing: Sp.s5;
                        Text {
                            text: "Revocation";
                            font-size: Typo.caption;
                            color: Theme.text-secondary;
                            width: 96px;
                        }
                        Text {
                            text: IdentityState.revocation-authority;
                            font-family: Typo.mono;
                            font-size: Typo.num-sm;
                            color: Theme.text-primary;
                            horizontal-stretch: 1;
                            wrap: char-wrap;
                        }
                    }
                    HorizontalLayout {
                        spacing: Sp.s5;
                        Text {
                            text: "Recovery";
                            font-size: Typo.caption;
                            color: Theme.text-secondary;
                            width: 96px;
                        }
                        Text {
                            text: IdentityState.recovery-authority;
                            font-family: Typo.mono;
                            font-size: Typo.num-sm;
                            color: Theme.text-primary;
                            horizontal-stretch: 1;
                            wrap: char-wrap;
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.border-subtle; }

                // Only offered where this wallet can actually sign. A button
                // that builds a transaction the chain will refuse is worse than
                // no button: it costs a fee to learn.
                if IdentityState.can-sign: VerticalLayout {
                    spacing: Sp.s3;
                    Eyebrow { text: "POINT THE AUTHORITIES SOMEWHERE ELSE"; }
                    Text {
                        text: "Whoever you name here can take this identity from you, and this wallet cannot take it back. That is the point of them — and the reason it is worth being sure.";
                        font-size: Typo.caption;
                        color: Theme.text-secondary;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: Sp.s4;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: Sp.s2;
                            Text {
                                text: "Revocation";
                                font-size: Typo.caption;
                                color: Theme.text-secondary;
                            }
                            Field {
                                mono: true;
                                placeholder: "i-address";
                                text <=> IdentityState.new-revocation;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: Sp.s2;
                            Text {
                                text: "Recovery";
                                font-size: Typo.caption;
                                color: Theme.text-secondary;
                            }
                            Field {
                                mono: true;
                                placeholder: "i-address";
                                text <=> IdentityState.new-recovery;
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        Btn {
                            text: "Review this change";
                            enabled: !IdentityState.change-busy
                                && (IdentityState.new-revocation != ""
                                    || IdentityState.new-recovery != "");
                            clicked => {
                                Actions.set-identity-authorities(
                                    IdentityState.address,
                                    IdentityState.new-revocation,
                                    IdentityState.new-recovery,
                                );
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.border-subtle; }

                VerticalLayout {
                    spacing: Sp.s3;
                    Eyebrow { text: "TIMELOCK"; }
                    Text {
                        // Never "locked: true". The two locked states behave
                        // nothing alike and only one of them ends on its own.
                        text: IdentityState.timelock-note;
                        font-size: Typo.body;
                        color: Theme.text-secondary;
                        wrap: word-wrap;
                    }

                    if IdentityState.can-sign: HorizontalLayout {
                        spacing: Sp.s4;
                        blocks := Field {
                            horizontal-stretch: 1;
                            mono: true;
                            placeholder: IdentityState.status == "Locked"
                                ? "extra blocks on top of the delay"
                                : "blocks to wait once unlocking is asked for";
                            text <=> IdentityState.lock-blocks;
                        }
                        if IdentityState.status != "Locked": Btn {
                            text: "Lock";
                            y: (parent.height - self.height) / 2;
                            enabled: !IdentityState.change-busy && blocks.text != "";
                            clicked => {
                                Actions.lock-identity(IdentityState.address, blocks.text.to-float());
                            }
                        }
                        if IdentityState.status == "Locked": Btn {
                            text: "Start unlocking";
                            y: (parent.height - self.height) / 2;
                            enabled: !IdentityState.change-busy;
                            clicked => {
                                Actions.unlock-identity(IdentityState.address, blocks.text.to-float());
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.border-subtle; }

                // Last, and deliberately so: these are the two that end an
                // identity's ordinary life, and they belong below everything
                // somebody might have come here to read.
                if IdentityState.can-sign: VerticalLayout {
                    spacing: Sp.s3;
                    Eyebrow { text: "TAKE IT OUT OF SERVICE"; }
                    HorizontalLayout {
                        spacing: Sp.s4;
                        alignment: start;
                        if IdentityState.status != "Revoked": Btn {
                            text: "Revoke";
                            variant: "destructive";
                            enabled: !IdentityState.change-busy;
                            clicked => { Actions.revoke-identity(IdentityState.address); }
                        }
                        if IdentityState.status == "Revoked": Btn {
                            text: "Recover";
                            variant: "primary";
                            enabled: !IdentityState.change-busy;
                            clicked => { Actions.recover-identity(IdentityState.address); }
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.border-subtle; }

                VerticalLayout {
                    spacing: Sp.s4;
                    Eyebrow { text: "PUBLISHED CONTENT"; }
                    Segmented {
                        width: 320px;
                        options: ["Now", "Over time"];
                        index <=> IdentityState.content-view;
                    }
                    Text {
                        text: IdentityState.content-view == 0
                            ? "What this identity holds right now."
                            : "Every value it has ever published, oldest first — a key written twice appears twice.";
                        font-size: Typo.caption;
                        color: Theme.text-tertiary;
                        wrap: word-wrap;
                    }

                    if IdentityState.content-view == 0 && IdentityState.content.length == 0: Text {
                        text: "Nothing published.";
                        font-size: Typo.caption;
                        color: Theme.text-tertiary;
                    }
                    if IdentityState.content-view == 1 && IdentityState.content-history.length == 0: Text {
                        text: "No history available — this node does not answer for it.";
                        font-size: Typo.caption;
                        color: Theme.text-tertiary;
                        wrap: word-wrap;
                    }

                    if IdentityState.content-view == 0: VerticalLayout {
                        spacing: Sp.s2;
                        for entry in IdentityState.content: ContentRow { entry: entry; }
                    }
                    if IdentityState.content-view == 1: VerticalLayout {
                        spacing: Sp.s2;
                        for entry in IdentityState.content-history: ContentRow { entry: entry; }
                    }
                }

                Rectangle { height: 1px; background: Theme.border-subtle; }

                VerticalLayout {
                    spacing: Sp.s3;
                    Eyebrow { text: "TRY A KEY"; }
                    TryKeyForm {}
                }
            }
        }
    }
}

component TxSheet inherits Rectangle {
    // Dims what is behind without hiding it, so the list is still the context.
    background: Theme.dark ? #0B0C0EC0 : #FBFBFCC0;

    // Swallows clicks so nothing behind the sheet can be pressed through it,
    // and closes on a click outside the card.
    TouchArea {
        clicked => { TxState.txid = ""; }
    }

    Card {
        width: 600px;
        height: min(root.height - Sp.s11 * 2, content.preferred-height);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        // The card itself must not close it.
        TouchArea {}

        Flickable {
            viewport-height: content.preferred-height;

            content := VerticalLayout {
                padding: Sp.s8;
                spacing: Sp.s6;

                HorizontalLayout {
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: Sp.s2;
                        Text {
                            text: TxState.direction == "in" ? "Received"
                                : TxState.direction == "out" ? "Sent"
                                : "Moved between your own addresses";
                            font-size: Typo.title2;
                            font-weight: Typo.w-semibold;
                            color: Theme.text-primary;
                        }
                        Text {
                            text: TxState.when;
                            font-size: Typo.caption;
                            color: Theme.text-tertiary;
                        }
                    }
                    Btn {
                        text: "Close";
                        variant: "ghost";
                        y: 0;
                        clicked => { TxState.txid = ""; }
                    }
                }

                Money {
                    amount: TxState.amount;
                    currency: WalletState.ticker;
                    show-currency: TxState.amount-is-native;
                    size: Typo.title1;
                    mono: false;
                    tone: TxState.direction == "in" ? "positive"
                        : TxState.direction == "out" ? "negative"
                        : "neutral";
                }

                for line in TxState.currency-lines: Text {
                    text: line;
                    font-family: Typo.mono;
                    font-size: Typo.num;
                    color: Theme.text-secondary;
                }

                Rectangle { height: 1px; background: Theme.border-subtle; }

                VerticalLayout {
                    spacing: Sp.s4;

                    HorizontalLayout {
                        Text {
                            text: "Confirmations";
                            font-size: Typo.body;
                            color: Theme.text-secondary;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: TxState.confirmations == "" ? "unconfirmed" : TxState.confirmations;
                            font-family: Typo.mono;
                            font-size: Typo.num;
                            color: TxState.confirmations == "" ? Theme.warning : Theme.text-primary;
                        }
                    }

                    HorizontalLayout {
                        Text {
                            text: "Block";
                            font-size: Typo.body;
                            color: Theme.text-secondary;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: TxState.height == "0" ? "not mined yet" : TxState.height;
                            font-family: Typo.mono;
                            font-size: Typo.num;
                            color: Theme.text-primary;
                        }
                    }

                    HorizontalLayout {
                        Text {
                            text: "Fee";
                            font-size: Typo.body;
                            color: Theme.text-secondary;
                            horizontal-stretch: 1;
                        }
                        Text {
                            // "Not reported" rather than a zero. A fee is
                            // inputs minus outputs, and the input values live
                            // in other transactions — a wallet that printed 0
                            // here would be stating something it does not know.
                            text: TxState.fee == "" ? "not reported by this node" : TxState.fee;
                            font-family: TxState.fee == "" ? "" : Typo.mono;
                            font-size: TxState.fee == "" ? Typo.caption : Typo.num;
                            color: TxState.fee == "" ? Theme.text-tertiary : Theme.text-primary;
                        }
                    }
                }

                VerticalLayout {
                    spacing: Sp.s3;
                    Eyebrow { text: "TRANSACTION ID"; }
                    txid := TextInput {
                        text: TxState.txid;
                        read-only: true;
                        font-family: Typo.mono;
                        font-size: Typo.num-sm;
                        color: Theme.text-primary;
                        wrap: char-wrap;
                    }
                }

                // Its own component, so the field and the button that copies
                // it live in the same scope — an element declared inside an
                // `if` cannot be reached from outside it.
                if TxState.explorer != "": ExplorerLink {}

                HorizontalLayout {
                    spacing: Sp.s4;
                    Btn {
                        text: "Copy id";
                        clicked => {
                            txid.select-all();
                            txid.copy();
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Btn {
                        text: TxState.advanced ? "Hide raw transaction" : "Show raw transaction";
                        variant: "ghost";
                        clicked => { TxState.advanced = !TxState.advanced; }
                    }
                }

                if TxState.advanced: Rectangle {
                    height: 220px;
                    background: Theme.bg-inset;
                    border-radius: R.md;

                    Flickable {
                        viewport-height: raw.preferred-height;
                        raw := Text {
                            text: TxState.raw == "" ? "Waiting for the node…" : TxState.raw;
                            font-family: Typo.mono;
                            font-size: Typo.micro;
                            color: Theme.text-secondary;
                            wrap: word-wrap;
                            x: Sp.s5;
                            width: parent.width - Sp.s5 * 2;
                        }
                    }
                }
            }
        }
    }
}

component ReceiveScreen inherits VerticalLayout {
    spacing: Sp.s7;

    HorizontalLayout {
        alignment: center;
        KeyPicker {}
    }

    HorizontalLayout {
        alignment: center;
        Card {
            width: 420px;

            VerticalLayout {
                padding: Sp.s8;
                spacing: Sp.s6;

                // The QR sits on WHITE even in the dark theme. Inverted codes
                // fail on a fair number of scanners, and this happens to be
                // exactly the Apple Wallet look.
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: WalletState.qr-side + Sp.s6 * 2;
                        height: self.width;
                        background: #FFFFFF;
                        border-radius: R.lg;

                        if WalletState.address != "": Image {
                            source: WalletState.qr;
                            width: WalletState.qr-side;
                            height: WalletState.qr-side;
                            // Rules 4 and 5 from `src/qr.rs`: any residual
                            // scaling is nearest-neighbour, and the image is
                            // never stretched by a layout.
                            image-rendering: pixelated;
                            image-fit: contain;
                        }

                        if WalletState.address == "": Text {
                            text: "No address yet";
                            font-size: Typo.caption;
                            color: #6E747E;
                        }
                    }
                }

                VerticalLayout {
                    spacing: Sp.s3;

                    Eyebrow { text: "YOUR " + WalletState.ticker + " ADDRESS"; }

                    // Selectable, monospace, and wrapping mid-string: an
                    // address is read character by character when it is checked
                    // against something, and a proportional font makes that
                    // needlessly hard.
                    address := TextInput {
                        text: WalletState.address;
                        read-only: true;
                        font-family: Typo.mono;
                        font-size: Typo.num;
                        color: Theme.text-primary;
                        wrap: char-wrap;
                        // Announced in four-character groups, because a screen
                        // reader saying raw base58 at speaking speed produces
                        // something nobody can transcribe or check.
                        accessible-role: AccessibleRole.text;
                        accessible-label: "Receive address";
                        accessible-value: WalletState.address-spoken;
                    }
                }

                HorizontalLayout {
                    spacing: Sp.s4;
                    Btn {
                        text: "Copy address";
                        variant: "primary";
                        horizontal-stretch: 1;
                        clicked => {
                            // The copy happens in Slint, not in Rust: Slint 1.17
                            // exposes no clipboard API to an application, only
                            // to a platform back-end. `TextInput` has one, so
                            // the address goes out through the element that
                            // already holds it.
                            address.select-all();
                            address.copy();
                        }
                    }
                }

                // The single most useful sentence on this screen. Sending
                // mainnet coins to a testnet address loses them, and the two
                // kinds of address look identical.
                Text {
                    text: NetworkState.effective == ""
                        ? "No node has confirmed which chain this is. Check before sharing it."
                        : "Only send " + WalletState.ticker + " on " + NetworkState.effective
                          + " here. Coins from another chain sent to this address are lost.";
                    font-size: Typo.caption;
                    color: NetworkState.effective == "" ? Theme.warning : Theme.text-tertiary;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
            }
        }
    }

    Rectangle { vertical-stretch: 1; }
}

// The stack of things the wallet has said.
//
// Bottom right, over everything including the backup screen — a recovery phrase
// on screen does not make a rejected payment less worth knowing about. Newest
// at the bottom, so the position of what you are reading does not move when
// another arrives.
component ToastHost inherits Rectangle {
    // Wide enough for two lines of detail at this size, narrow enough not to
    // read as a panel taking over the screen.
    property <length> panel-width: 380px;

    // ONE opaque panel, not a stack of floating cards.
    //
    // Separate cards leave gaps, and a gap over a dashboard shows whatever is
    // behind it — an asset amount peeking between two notices reads as a
    // rendering fault rather than as depth. A single surface with hairlines
    // between the entries has the same structure and no holes.
    Rectangle {
        x: parent.width - root.panel-width - Sp.s8;
        y: parent.height - self.height - Sp.s8;
        width: root.panel-width;
        height: stack.preferred-height;

        background: Theme.bg-raised;
        border-radius: R.lg;
        border-width: 1px;
        border-color: Theme.border-strong;
        // In both themes. `Card` shadows only in light, because a card sits IN
        // the page; this floats above it and has to say so on a dark ground
        // too.
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 6px;
        drop-shadow-color: Theme.dark ? #00000066 : #10111426;

        stack := VerticalLayout {
            for entry[i] in ToastState.rows: VerticalLayout {
                if i > 0: Rectangle {
                    height: 1px;
                    background: Theme.border-subtle;
                }

                HorizontalLayout {
                    padding: Sp.card-pad;
                    spacing: Sp.s4;

                    // Colour is never the only signal — the severity is also in
                    // the wording, and the title carries the tone.
                    Rectangle {
                        width: 3px;
                        border-radius: 2px;
                        background: entry.severity == "danger" ? Theme.negative
                            : entry.severity == "warning" ? Theme.warning
                            : Theme.accent;
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: Sp.s2;

                        Text {
                            // The count rather than one card per occurrence: a
                            // refresh failing every fifteen seconds is one
                            // problem, and forty cards is a wallet nobody can
                            // use.
                            text: entry.count > 1
                                ? entry.title + " (" + entry.count + "×)"
                                : entry.title;
                            font-size: Typo.body;
                            font-weight: Typo.w-medium;
                            color: entry.severity == "danger" ? Theme.negative
                                : entry.severity == "warning" ? Theme.warning
                                : Theme.text-primary;
                            wrap: word-wrap;
                        }

                        if entry.detail != "": Text {
                            text: entry.detail;
                            font-size: Typo.caption;
                            color: Theme.text-secondary;
                            wrap: word-wrap;
                        }
                    }

                    Btn {
                        text: "Close";
                        variant: "ghost";
                        y: 0;
                        clicked => { ToastState.dismiss(i); }
                    }
                }
            }

            // Offered only once there is more than one: a wallet that has just
            // failed six times should not need six clicks.
            if ToastState.rows.length > 1: Rectangle {
                height: 1px;
                background: Theme.border-subtle;
            }
            if ToastState.rows.length > 1: HorizontalLayout {
                padding: Sp.s4;
                padding-right: Sp.card-pad;
                alignment: end;
                Btn {
                    text: "Dismiss all";
                    variant: "ghost";
                    clicked => { ToastState.dismiss-all(); }
                }
            }
        }
    }
}

component ComingSoon inherits VerticalLayout {
    in property <string> title;
    in property <string> body;
    alignment: center;
    EmptyState {
        glyph: "◷";
        title: root.title;
        body: root.body;
    }
}


component Onboarding inherits Rectangle {
    // "create" | "unlock"
    in property <string> mode;
    in property <string> wallet-name;
    in property <bool> busy;
    in property <string> problem;

    // Which of the two forms is up. Pure navigation — there is no wallet state
    // that corresponds to "is currently typing a phrase" — but `in-out` rather
    // than private, for the same reason `screen` is: a snapshot has to be able
    // to put the window into this state, and a state no test can reach is a
    // state that quietly rots.
    in-out property <bool> restoring: false;

    background: Theme.bg-base;

    VerticalLayout {
        alignment: center;
        spacing: Sp.s7;
        padding: Sp.s8;

        HorizontalLayout {
            alignment: center;
            Text {
                text: "◆";
                font-size: 34px;
                color: Theme.accent;
            }
        }

        if !root.restoring: PassphraseForm {
            mode: root.mode;
            wallet-name: root.wallet-name;
            busy: root.busy;
            problem: root.problem;
            restore => { root.restoring = true; }
        }

        if root.restoring: RestoreForm {
            busy: root.busy;
            problem: root.problem;
            cancelled => { root.restoring = false; }
        }
    }
}

// The 24 words, laid out in a grid.
//
// Absolute positions computed from the row index rather than a `GridLayout`,
// because the words arrive as a flat model and Slint's grid wants elements
// declared per cell. The arithmetic is the entire trick.
component PhraseGrid inherits Rectangle {
    property <float> columns: 4;
    property <length> cell-height: 36px;

    height: Math.ceil(SeedState.words.length / root.columns) * root.cell-height;

    for word[i] in SeedState.words: Rectangle {
        x: Math.mod(i, root.columns) * (root.width / root.columns);
        y: Math.floor(i / root.columns) * root.cell-height;
        width: root.width / root.columns;
        height: root.cell-height;

        HorizontalLayout {
            padding-left: Sp.s3;
            padding-right: Sp.s3;
            spacing: Sp.s4;

            Text {
                text: word.index;
                font-family: Typo.mono;
                font-size: Typo.num-sm;
                color: Theme.text-tertiary;
                horizontal-alignment: right;
                vertical-alignment: center;
                width: 22px;
                // Not announced. A screen reader reciting a recovery phrase in
                // a shared office is a real failure mode, and the words must be
                // read aloud only when someone asks for it — an opt-in button
                // that is NOT built yet. Until it is, silence is the safe side.
                accessible-role: AccessibleRole.none;
            }

            Text {
                text: word.word;
                font-family: Typo.mono;
                font-size: Typo.num;
                color: Theme.text-primary;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: AccessibleRole.none;
            }
        }
    }
}

// One word of the confirmation step.
component WordCheck inherits VerticalLayout {
    in property <int> position;
    in property <bool> invalid: false;
    in-out property <string> text <=> field.text;
    callback accepted();

    spacing: Sp.s3;

    HorizontalLayout {
        spacing: Sp.s2;
        alignment: start;
        Text {
            text: "Word";
            font-size: Typo.caption;
            color: Theme.text-secondary;
        }
        Text {
            text: root.position;
            font-family: Typo.mono;
            font-size: Typo.caption;
            color: Theme.text-primary;
        }
    }

    field := Field {
        invalid: root.invalid;
        accepted => { root.accepted(); }
    }
}

// ── The three steps of a backup ─────────────────────────────────────────────
//
// Each is its own component because each owns an input, and an input declared
// inside an `if` cannot be reached from outside it. Splitting them is what lets
// every field be read and blanked in the same callback — and it means leaving a
// step destroys its fields rather than leaving them holding what was typed.

// Prove who you are. Only on the way back to a backup that was interrupted:
// a phrase just generated is already in front of the person who generated it.
component BackupPassphrase inherits VerticalLayout {
    callback closed();
    spacing: Sp.s6;

    VerticalLayout {
        spacing: Sp.s3;
        Text {
            text: "Show your recovery phrase";
            font-size: Typo.title1;
            font-weight: Typo.w-semibold;
            color: Theme.text-primary;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center;
            Text {
                width: 460px;
                text: "Enter your passphrase again. ChainVue asks every time these words are shown, rather than once per session.";
                font-size: Typo.body;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }

    HorizontalLayout {
        alignment: center;
        field := Field {
            width: 360px;
            password: true;
            placeholder: "Passphrase";
            invalid: SeedState.problem != "";
            accepted => { root.submit(); }
        }
    }

    if SeedState.problem != "": Text {
        text: SeedState.problem;
        font-size: Typo.caption;
        color: Theme.negative;
        horizontal-alignment: center;
    }

    HorizontalLayout {
        alignment: center;
        spacing: Sp.s4;
        Btn {
            text: "Not now";
            variant: "ghost";
            clicked => { root.closed(); }
        }
        Btn {
            text: "Show phrase";
            variant: "primary";
            enabled: field.text != "" && !SeedState.busy;
            clicked => { root.submit(); }
        }
    }

    function submit() {
        if (field.text == "") { return; }
        Actions.reveal-backup(field.text);
        field.text = "";
    }
}

// Read the words.
component BackupPhrase inherits VerticalLayout {
    callback closed();
    callback written-down();
    spacing: Sp.s6;

    VerticalLayout {
        spacing: Sp.s3;
        Text {
            text: "Write down your recovery phrase";
            font-size: Typo.title1;
            font-weight: Typo.w-semibold;
            color: Theme.text-primary;
            horizontal-alignment: center;
        }
        // Wrapped by an explicit width rather than `max-width`: inside a
        // vertical layout the text is handed the full column and wraps against
        // that, so a max-width alone let this run the width of the window.
        HorizontalLayout {
            alignment: center;
            Text {
                width: 520px;
                text: "These words are the only way to restore this wallet, and anyone who reads them can spend your coins.";
                font-size: Typo.body;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }

    HorizontalLayout {
        alignment: center;
        Card {
            width: 660px;
            VerticalLayout {
                padding: Sp.s5;
                PhraseGrid {}
            }
        }
    }

    HorizontalLayout {
        alignment: center;
        Rectangle {
            height: 36px;
            width: hold-label.preferred-width + Sp.s7 * 2;
            border-radius: R.md;
            border-width: 1px;
            border-color: hold.pressed ? Theme.accent : Theme.border-default;
            background: hold.pressed ? Theme.accent-soft : Theme.bg-surface;
            animate background { duration: Motion.fast; enabled: Motion.enabled; }
            animate border-color { duration: Motion.fast; enabled: Motion.enabled; }

            hold-label := Text {
                text: hold.pressed ? "Release to hide" : "Hold to reveal";
                font-size: Typo.body;
                font-weight: Typo.w-medium;
                color: Theme.text-primary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // Press asks core for the words, release throws them away. This
            // watches `pressed` rather than handling a click because `pressed`
            // also goes false when the pointer is released outside the button
            // or the gesture is cancelled — and every one of those has to
            // conceal the phrase.
            hold := TouchArea {
                mouse-cursor: pointer;
                changed pressed => {
                    if (hold.pressed) {
                        Actions.reveal-phrase();
                    } else {
                        Actions.hide-phrase();
                    }
                }
            }

            accessible-role: AccessibleRole.button;
            accessible-label: "Hold to reveal the recovery phrase";
        }
    }

    HorizontalLayout {
        alignment: center;
        Text {
            width: 560px;
            text: "Write them on paper. There is no Copy button and no Save to file, on purpose — those are the two ways a phrase usually ends up somewhere it can be read by something else.";
            font-size: Typo.caption;
            color: Theme.text-tertiary;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }

    HorizontalLayout {
        alignment: center;
        spacing: Sp.s4;
        Btn {
            text: "Later";
            variant: "ghost";
            clicked => { root.closed(); }
        }
        Btn {
            text: "I've written it down";
            variant: "primary";
            clicked => { root.written-down(); }
        }
    }
}

// Type three of them back.
component BackupVerify inherits VerticalLayout {
    callback back();
    spacing: Sp.s6;

    VerticalLayout {
        spacing: Sp.s3;
        Text {
            text: "Check your copy";
            font-size: Typo.title1;
            font-weight: Typo.w-semibold;
            color: Theme.text-primary;
            horizontal-alignment: center;
        }
        Text {
            text: "Type three of the words back, from what you wrote down.";
            font-size: Typo.body;
            color: Theme.text-secondary;
            horizontal-alignment: center;
        }
    }

    HorizontalLayout {
        alignment: center;
        spacing: Sp.s5;

        first := WordCheck {
            width: 180px;
            position: SeedState.challenge[0];
            invalid: SeedState.problem != "";
            accepted => { root.submit(); }
        }
        second := WordCheck {
            width: 180px;
            position: SeedState.challenge[1];
            invalid: SeedState.problem != "";
            accepted => { root.submit(); }
        }
        third := WordCheck {
            width: 180px;
            position: SeedState.challenge[2];
            invalid: SeedState.problem != "";
            accepted => { root.submit(); }
        }
    }

    if SeedState.problem != "": Text {
        // Which word was wrong is never said. Saying it would turn this screen
        // into a checker that could be fed guesses one position at a time.
        text: SeedState.problem;
        font-size: Typo.caption;
        color: Theme.negative;
        horizontal-alignment: center;
    }

    HorizontalLayout {
        alignment: center;
        spacing: Sp.s4;
        Btn {
            text: "Show the words again";
            variant: "ghost";
            clicked => { root.back(); }
        }
        Btn {
            text: "Confirm";
            variant: "primary";
            enabled: first.text != "" && second.text != "" && third.text != "";
            clicked => { root.submit(); }
        }
    }

    // Hand the words over and blank the fields in the same callback, exactly as
    // the passphrase inputs do.
    function submit() {
        if (first.text == "" || second.text == "" || third.text == "") { return; }
        Actions.confirm-phrase(first.text, second.text, third.text);
        first.text = "";
        second.text = "";
        third.text = "";
    }
}

// Showing a recovery phrase — the highest-consequence screen in the wallet.
component BackupScreen inherits Rectangle {
    background: Theme.bg-base;

    VerticalLayout {
        alignment: center;
        spacing: Sp.s6;
        padding: Sp.s8;
        padding-left: Sp.s11;
        padding-right: Sp.s11;

        if SeedState.step == "passphrase": BackupPassphrase {
            closed => { root.close(); }
        }

        if SeedState.step == "phrase": BackupPhrase {
            closed => { root.close(); }
            written-down => {
                // Conceal before moving on: the next screen has no business
                // having the words sitting behind it.
                Actions.hide-phrase();
                SeedState.problem = "";
                SeedState.step = "verify";
            }
        }

        if SeedState.step == "verify" && SeedState.challenge.length == 3: BackupVerify {
            back => {
                SeedState.problem = "";
                SeedState.step = "phrase";
            }
        }
    }

    // Leaving without finishing. The key keeps its "not backed up" flag, so the
    // offer comes back — this abandons the attempt, it does not decline it
    // permanently.
    function close() {
        SeedState.problem = "";
        SeedState.step = "";
        Actions.cancel-backup();
    }
}

// ── The window ──────────────────────────────────────────────────────────────

export component AppWindow inherits Window {
    title: "ChainVue";
    background: Theme.bg-base;
    // Set once, here, so every element that leaves `font-family` unset gets the
    // bundled face rather than whatever the platform happens to have.
    default-font-family: Typo.ui;
    default-font-size: Typo.body;
    min-width: 880px;
    min-height: 620px;
    preferred-width: 1180px;
    preferred-height: 760px;

    in-out property <string> screen: "dashboard";

    // Whether the nav rail shows labels.
    //
    // Deliberately a STORED property updated by a `changed` handler, not a
    // binding on `root.width`. Binding it would make the rail's width depend on
    // the window width, which the horizontal layout is itself computing — a
    // binding loop that Slint now warns about and that it says "may cause panic
    // at runtime". A wallet must not have one of those. The `changed` callback
    // fires outside layout resolution, so the cycle is broken.
    in-out property <bool> nav-expanded: true;
    changed width => {
        root.nav-expanded = root.width > 1000px;
    }

    // Glyphs are restricted to characters the macOS system font actually
    // carries. `◈` and `◌` rendered as empty boxes and `⚙` came out as a
    // colour emoji — all three only visible in a screenshot, not in the source.
    // A real icon set (Path commands) replaces these later; until then the rule
    // is: nothing here that has ever rendered as a box.
    property <[NavItem]> nav: [
        { id: "dashboard", label: "Dashboard", glyph: "◆", enabled: true, badge: "" },
        { id: "send",      label: "Send",      glyph: "↑", enabled: true, badge: "" },
        { id: "receive",   label: "Receive",   glyph: "↓", enabled: true, badge: "" },
        { id: "activity",  label: "Activity",  glyph: "≡", enabled: true, badge: "" },
        { id: "nodes",     label: "Network",   glyph: "○", enabled: true, badge: "" },
        { id: "identities",label: "Identities",glyph: "◇", enabled: true,  badge: "" },
        { id: "settings",  label: "Settings",  glyph: "⋯", enabled: true, badge: "" },
    ];

    // Before anything else: if there is no wallet, or it is locked, that is the
    // only thing on screen. A dashboard behind a lock screen is a dashboard
    // showing numbers nobody has authenticated for.
    in-out property <bool> restoring: false;

    // Navigating is two statements — what the window shows, and telling the
    // core which screen is open so it can start or stop screen-scoped polling.
    // Both have to happen together, from the rail and from the keyboard alike.
    function go(screen: string) {
        root.screen = screen;
        Actions.navigate(screen);
    }

    // Keyboard shortcuts, and the switch that turns focus rings on.
    //
    // # Why this ENCLOSES the interface rather than sitting beside it
    //
    // Slint delivers a key to the focused element first and offers it to an
    // ANCESTOR only when that element rejects it. A scope declared as a sibling
    // would never see a key at all; one declared as an ancestor sees exactly
    // what nothing else wanted. So a text field keeps every character somebody
    // types, and only the command-modified keys and Escape reach here — a
    // grabbing scope would eat the letter `l` out of a passphrase.
    //
    // Nothing in here can spend or reveal anything. `⌘L` locks, which is the
    // safe direction; there is deliberately no shortcut that unlocks, sends, or
    // shows a recovery phrase.
    // Whether the wallet's own screens are showing, as opposed to the unlock
    // form or the backup screen.
    //
    // Watched rather than merely used, because the swap DESTROYS whatever had
    // focus — the passphrase field, on the way in — and Slint responds to a
    // focused item disappearing by setting focus to nothing at all. From that
    // moment there is no chain for a key to travel up and no shortcut works,
    // which is exactly what unlocking used to do to them.
    property <bool> shell-showing: WalletState.exists && !WalletState.locked
        && SeedState.step == "";
    changed shell-showing => {
        root.focus-shortcuts();
    }

    // Called from Rust after the window is shown — see `main`. There is no way
    // to reach a nested element from outside the component, so the component
    // has to offer one.
    public function focus-shortcuts() {
        shortcuts.focus();
    }

    shortcuts := FocusScope {
        width: 100%;
        height: 100%;

        // Focused at startup so the shortcuts work before anything has been
        // clicked. Focus moves away the moment a field or a button takes it,
        // and the shortcuts keep working because keys bubble back up here.
        //
        // `init` alone is not enough in a real window. It runs when the
        // component is built, and the windowing backend sets up focus when the
        // window is *shown* — which is afterwards, and which leaves nothing
        // focused. With no focus item Slint's delivery loop has no chain to
        // walk, so no scope sees a key at all; Tab still works because the
        // window handles that itself, after the loop. That is exactly the shape
        // of "only Tab does anything".
        init => { shortcuts.focus(); }

        // Any click that lands on nothing else puts keyboard focus back here.
        //
        // Declared FIRST, so it is underneath everything: later siblings get a
        // pointer event before earlier ones, and a click on a button or a field
        // never reaches this. Only a click on bare background does.
        //
        // It exists because focus can end up nowhere — the window can be active
        // with no focus item, and Slint's key delivery starts at the focused
        // item and walks up, so with none there is no chain and no scope hears
        // anything. Rather than reason about every route into that state, any
        // click on the window puts it back.
        TouchArea {
            clicked => {
                InputMode.keyboard = false;
                shortcuts.focus();
            }
        }

        key-pressed(event) => {
            // The first key press is what says a keyboard is in use. From here
            // focus rings render, until a pointer press says otherwise.
            InputMode.keyboard = true;

            // Both, and on macOS that is not belt-and-braces.
            //
            // Slint's winit backend swaps them on Apple platforms — Command
            // arrives as `control` and the physical Control key as `meta`,
            // deliberately, to match Qt. So `control` is the ⌘ case there and
            // the Ctrl case everywhere else, which is exactly the primary
            // modifier on each. Checking only `meta` would have made every
            // shortcut here dead on a Mac.
            if (event.modifiers.control || event.modifiers.meta) {
                if (event.text == "1") { root.go("dashboard"); return EventResult.accept; }
                if (event.text == "2") { root.go("send"); return EventResult.accept; }
                if (event.text == "3") { root.go("receive"); return EventResult.accept; }
                if (event.text == "4") { root.go("activity"); return EventResult.accept; }
                if (event.text == "5") { root.go("nodes"); return EventResult.accept; }
                if (event.text == "6") { root.go("identities"); return EventResult.accept; }
                if (event.text == ",") { root.go("settings"); return EventResult.accept; }
                // Slint reports the character produced, and `⌘L` without shift
                // produces a lower-case `l`.
                if (event.text == "l") { Actions.lock(); return EventResult.accept; }
                if (event.text == "r") { Actions.refresh(); return EventResult.accept; }
            }

            // Escape closes whatever is over the screen, innermost first.
            if (event.text == Key.Escape) {
                if (TxState.txid != "") {
                    TxState.txid = "";
                    return EventResult.accept;
                }
                if (IdentityState.address != "") {
                    Actions.close-identity();
                    return EventResult.accept;
                }
                if (SendState.step != "form") {
                    SendState.step = "form";
                    return EventResult.accept;
                }
            }

            return EventResult.reject;
        }

        if !WalletState.exists || WalletState.locked: Onboarding {
            restoring <=> root.restoring;
            mode: WalletState.exists ? "unlock" : "create";
            wallet-name: WalletState.name;
            busy: WalletState.busy;
            problem: WalletState.problem;
        }

        // And before the shell too: a phrase on screen is the only thing that
        // should be on screen. Nothing behind it is worth the risk of a stray
        // click landing somewhere else while 24 words are visible.
        if WalletState.exists && !WalletState.locked && SeedState.step != "": BackupScreen {}

        if WalletState.exists && !WalletState.locked && SeedState.step == "": HorizontalLayout {
            NavRail {
                items: root.nav;
                active: root.screen;
                // Below ~1000px the rail collapses to glyphs so the content column
                // keeps its shape rather than being squeezed. See `nav-expanded`.
                expanded: root.nav-expanded;
                selected(id) => { root.go(id); }
            }

            VerticalLayout {
                TitleBar {
                    title: root.screen == "dashboard" ? "Dashboard"
                        : root.screen == "nodes" ? "Network"
                        : root.screen == "receive" ? "Receive"
                        : root.screen == "send" ? "Send"
                        : root.screen == "settings" ? "Settings"
                        : root.screen == "activity" ? "Activity"
                        : root.screen == "identities" ? "Identities"
                        : root.screen;
                    network: NetworkState.effective;
                    node-state: NetworkState.node-state;
                    mock-mode: NetworkState.mock-mode;
                    busy: WalletState.busy;
                    can-refresh: true;
                    toggle-theme => { Actions.toggle-theme(); }
                    lock => { Actions.lock(); }
                    refresh => { Actions.refresh(); }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.bg-base;
                    clip: true;

                    // Activity brings its own scroller — see `ActivityScreen`.
                    // Beside the shared one rather than inside it, because two
                    // scrollers stacked over the same area fight over the wheel
                    // and the outer one wins.
                    if root.screen == "activity": ActivityScreen {}

                    if root.screen != "activity": Flickable {
                        viewport-height: content.preferred-height;

                        content := VerticalLayout {
                            padding: Sp.screen-pad;
                            // Caps line length on a wide display. Cards that
                            // stretch to 2000px read as a dashboard, not a product.
                            max-width: Sp.content-max;

                            if root.screen == "dashboard": DashboardScreen {}
                            if root.screen == "send": SendScreen {}
                            if root.screen == "identities": IdentitiesScreen {}
                            if root.screen == "receive": ReceiveScreen {}
                            if root.screen == "settings": SettingsScreen {}
                            if root.screen == "nodes": NodesScreen {}
                            if root.screen != "dashboard" && root.screen != "nodes"
                                && root.screen != "receive" && root.screen != "send"
                                && root.screen != "settings" && root.screen != "activity"
                                && root.screen != "identities": ComingSoon {
                                title: "Not built yet";
                                body: "This part of the wallet is still being written.";
                            }
                        }
                    }
                }

                StatusBar {
                    tip: NetworkState.tip;
                    latency: NetworkState.latency;
                    endpoint: NetworkState.endpoint;
                    sdk-rev: AppInfo.sdk-rev;
                }
            }
        }

        // Over everything, including the nav rail: a detail sheet that left the
        // rail clickable would let someone navigate away from a transaction they
        // are in the middle of reading.
        if WalletState.exists && !WalletState.locked && SeedState.step == ""
            && TxState.txid != "": TxSheet {}

        // Same rule as the transaction sheet: open exactly when the address is
        // non-empty, over everything including the nav rail — navigating away
        // from an identity somebody is reading is not a thing to allow by
        // accident.
        if WalletState.exists && !WalletState.locked && SeedState.step == ""
            && IdentityState.address != "": IdentitySheet {}

        // Above the sheet: the last moment before something irreversible.
        if WalletState.exists && !WalletState.locked && IdentityState.change-ticket != 0:
            IdentityChangeReview {}

        // Above even the phrase screen. A recovery phrase being on screen does
        // not make a rejected payment less worth knowing about, and the toast
        // sits in a corner rather than over the words.
        if ToastState.rows.length > 0: ToastHost {
            width: 100%;
            height: 100%;
        }
    }
}
