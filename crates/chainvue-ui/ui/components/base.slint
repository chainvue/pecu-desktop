import { Theme, Sp, R, Typo, Motion, InputMode } from "../theme/theme.slint";

// A button.
//
// `variant` is a string rather than an enum so that adding one is a one-word
// change here and at the call site, with no generated-type churn.
// "primary" | "secondary" | "ghost" | "destructive"
export component Btn inherits Rectangle {
    in property <string> text;
    in property <string> variant: "secondary";
    in property <bool> enabled: true;
    in property <bool> busy: false;
    callback clicked();

    property <bool> is-primary: root.variant == "primary";
    property <bool> is-ghost: root.variant == "ghost";
    property <bool> is-danger: root.variant == "destructive";

    height: 36px;
    horizontal-stretch: 0;
    min-width: label.preferred-width + Sp.s7 * 2;
    border-radius: R.md;
    border-width: root.is-ghost ? 0px : 1px;

    // A disabled button loses its colour entirely. Keeping the accent border
    // under greyed-out text reads as "this is the button you want" attached to
    // something that does not respond, which is worse than either.
    border-color: !root.enabled ? Theme.border-subtle
        : root.is-primary ? Theme.accent
        : root.is-danger ? Theme.negative
        : Theme.border-default;

    background: !root.enabled ? Theme.bg-inset
        : root.is-primary ? (touch.pressed ? Theme.accent-active : touch.has-hover ? Theme.accent-hover : Theme.accent)
        : root.is-danger ? (touch.has-hover ? Theme.negative-soft : transparent)
        : root.is-ghost ? (touch.has-hover ? Theme.bg-hover : transparent)
        : (touch.pressed ? Theme.bg-active : touch.has-hover ? Theme.bg-hover : Theme.bg-surface);

    // Press feedback is a scale, not a colour jump: it reads as physical.
    // Everything here is gated on Motion.enabled — one line per animation is
    // the entire reduce-motion mechanism.
    animate background { duration: Motion.fast; enabled: Motion.enabled; }
    animate border-color { duration: Motion.fast; enabled: Motion.enabled; }

    label := Text {
        text: root.busy ? "…" : root.text;
        font-size: Typo.body;
        font-weight: Typo.w-medium;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: !root.enabled ? Theme.text-disabled
            : root.is-primary ? Theme.text-on-accent
            : root.is-danger ? Theme.negative
            : Theme.text-primary;
    }

    // Every button is reachable by keyboard. Without this the entire interface
    // could only be operated with a pointer — the single largest accessibility
    // failure a desktop application can have, and one that is invisible to
    // anyone testing it with a mouse.
    //
    // Declared before the touch area so that a pointer press still lands on the
    // touch area: later siblings receive input first.
    focus := FocusScope {
        enabled: root.enabled && !root.busy;
        key-pressed(event) => {
            // Return and space, which is what every platform's button does.
            if (event.text == "\n" || event.text == " ") {
                root.clicked();
                return EventResult.accept;
            }
            return EventResult.reject;
        }
    }

    // The ring, drawn OUTSIDE the button's own border so it never covers the
    // shape it is pointing at. Only while the keyboard is driving — see
    // `InputMode`.
    if focus.has-focus && InputMode.keyboard: Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: R.md + 3px;
        border-width: 2px;
        border-color: Theme.accent-ring;
    }

    touch := TouchArea {
        enabled: root.enabled && !root.busy;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            // The pointer has said where it is, so the ring is noise from here
            // until a key says otherwise.
            InputMode.keyboard = false;
            focus.focus();
            root.clicked();
        }
    }

    accessible-role: AccessibleRole.button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    // What happens when a screen reader activates it.
    //
    // # This was missing everywhere, and it is not a detail
    //
    // Announcing a role and a label tells VoiceOver that a button is there and
    // what it is called. Pressing it is a separate contract — the default
    // action — and nothing in this interface declared one. So every button in
    // this wallet was announced correctly and **did nothing at all** when
    // somebody using a screen reader activated it.
    //
    // `tests/accessibility.rs` did not catch it because it checks that controls
    // have names, which it says plainly. A name on a control that cannot be
    // operated is the more complete version of the failure it was written for.
    //
    // Guarded on `enabled` rather than relying on the caller: an accessibility
    // action does not pass through the touch area, so a disabled button would
    // otherwise be pressable by exactly the route that has no other way in.
    accessible-action-default => {
        if (root.enabled && !root.busy) {
            root.clicked();
        }
    }
}

// A row of mutually exclusive choices.
//
// The thumb animates both `x` and `width`, so it slides *and* resizes between
// options of different lengths rather than jumping. That one detail is most of
// the difference between this and three buttons.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> index: 0;
    callback changed(int);

    height: 34px;
    background: Theme.bg-inset;
    border-radius: R.md;
    border-width: 1px;
    border-color: Theme.border-subtle;
    clip: true;

    // Behind the labels, so the text is never drawn under a moving surface.
    Rectangle {
        x: root.index * (root.width / max(1, root.options.length));
        width: root.width / max(1, root.options.length);
        height: parent.height - 6px;
        y: 3px;
        background: Theme.bg-raised;
        border-radius: R.sm;
        border-width: 1px;
        border-color: Theme.border-default;
        animate x { duration: Motion.base; easing: cubic-bezier(0.2, 0, 0, 1); enabled: Motion.enabled; }
        animate width { duration: Motion.base; easing: cubic-bezier(0.2, 0, 0, 1); enabled: Motion.enabled; }
    }

    HorizontalLayout {
        for option[i] in root.options: Rectangle {
            Text {
                text: option;
                font-size: Typo.caption;
                font-weight: root.index == i ? Typo.w-medium : Typo.w-regular;
                color: root.index == i ? Theme.text-primary : Theme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }

            // A focus ring, because a control that can be reached by keyboard
            // and shows nothing when it is reached cannot be operated by
            // keyboard in practice.
            Rectangle {
                border-radius: R.sm;
                border-width: focus.has-focus ? 2px : 0px;
                border-color: Theme.accent-ring;
            }

            // Keyboard, which this had none of.
            //
            // Every `Btn` in this interface carries a focus scope and answers
            // Return and space. This did not — it was a `TouchArea` and an
            // accessible label, which is enough for a screen reader to announce
            // a control and not enough for anybody to press it. So the restore
            // form's phrase/text/key picker, the content viewer's two views and
            // (once Settings grew tabs) whole sections of the wallet were
            // reachable with a pointer and no other way.
            //
            // The arrow keys move between segments as well, which is what a
            // person expects of a row of tabs and what makes a five-option
            // control bearable without a mouse.
            focus := FocusScope {
                key-pressed(event) => {
                    if (event.text == "\n" || event.text == " ") {
                        root.index = i;
                        root.changed(i);
                        return EventResult.accept;
                    }
                    if (event.text == Key.LeftArrow && root.index > 0) {
                        root.index = root.index - 1;
                        root.changed(root.index);
                        return EventResult.accept;
                    }
                    if (event.text == Key.RightArrow
                        && root.index < root.options.length - 1) {
                        root.index = root.index + 1;
                        root.changed(root.index);
                        return EventResult.accept;
                    }
                    return EventResult.reject;
                }
            }

            // Declared after the focus scope so a pointer press still lands
            // here: later siblings receive input first. Same ordering as `Btn`.
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    focus.focus();
                    root.index = i;
                    root.changed(i);
                }
            }

            accessible-role: AccessibleRole.button;
            accessible-label: option;
            accessible-action-default => {
                root.index = i;
                root.changed(i);
            }
        }
    }
}

// A surface. In dark mode cards are hairline-led; in light mode shadow-led.
// Using both in both themes is what makes a UI look muddy.
export component Card inherits Rectangle {
    in property <bool> interactive: false;
    // A card that floats over the interface rather than sitting in it: the
    // transaction sheet, the identity sheet, the confirmation over that, the
    // notice stack.
    //
    // # Why an overlay breaks the theme's own rule
    //
    // "Dark leans on hairlines, light leans on shadow" is right for a card on a
    // page — a shadow under every card in a dark theme is what makes an
    // interface look muddy. It is wrong for a card on a scrim. A hairline
    // against a dimmed copy of the page underneath is almost no separation at
    // all, so a modal read as part of the thing it was covering.
    //
    // So an overlay climbs the surface ladder instead of relying on its edge —
    // `bg-raised`, a stronger border — and takes a shadow in **both** themes,
    // because this is the one place in the interface where something is
    // genuinely in front of something else.
    in property <bool> elevated: false;
    callback clicked();

    background: root.elevated ? Theme.bg-raised : Theme.bg-surface;
    border-radius: R.lg;
    border-width: 1px;
    border-color: root.elevated ? Theme.border-default
        : root.interactive && touch.has-hover ? Theme.border-default
        : Theme.border-subtle;
    drop-shadow-blur: root.elevated ? 40px : Theme.card-shadow ? 12px : 0px;
    drop-shadow-offset-y: root.elevated ? 10px : Theme.card-shadow ? 2px : 0px;
    drop-shadow-color: root.elevated ? (Theme.dark ? #00000099 : #1011142E)
        : Theme.card-shadow ? #10111412
        : transparent;

    animate border-color { duration: Motion.fast; enabled: Motion.enabled; }

    touch := TouchArea {
        enabled: root.interactive;
        mouse-cursor: root.interactive ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }

    @children
}

// An eyebrow label: 11px, uppercase, tracked out. Used above every figure.
export component Eyebrow inherits Text {
    font-size: Typo.micro;
    font-weight: Typo.w-medium;
    letter-spacing: 0.6px;
    color: Theme.text-tertiary;
}

// The ONLY element allowed to render an amount.
//
// One place owns sign colouring and the monospace family, so a screen cannot
// accidentally render money in a proportional font — where the digits would
// not align in a column and the balance would visibly jitter as it counts up.
export component Money inherits HorizontalLayout {
    in property <string> amount;
    in property <string> currency: "VRSC";
    // Announced as one thing. Two adjacent texts would otherwise be read as
    // two unrelated items, and an amount without its currency is not an
    // amount.
    accessible-role: AccessibleRole.text;
    accessible-label: root.amount + " " + root.currency;
    in property <length> size: Typo.num;
    // "neutral" | "positive" | "negative" | "muted"
    //
    // `muted` is for an amount that is on screen to make the arithmetic add up
    // rather than to be read — transaction change, and nothing else so far. It
    // is deliberately not a colour with meaning: green and red already say
    // which way money moved, and a third meaning would make the palette a
    // language nobody was taught.
    in property <string> tone: "neutral";
    in property <bool> show-currency: true;
    // Monospace keeps a column of amounts aligned and stops the balance
    // jittering as it counts up — but at hero size Menlo's slashed zero reads
    // as a terminal rather than a wallet. So the big number opts out until a
    // proper text face with tabular figures (IBM Plex Mono) is bundled, and
    // every amount in a list keeps it, where alignment matters more than
    // character.
    in property <bool> mono: true;

    // Without this the layout stretches to its parent and the currency drifts
    // to the far edge of the window, disconnected from the number it belongs
    // to. `start` keeps the pair together as one reading unit.
    alignment: start;
    spacing: Sp.s3;

    Text {
        text: root.amount;
        font-family: root.mono ? Typo.mono : "";
        font-size: root.size;
        color: root.tone == "positive" ? Theme.positive
            : root.tone == "negative" ? Theme.negative
            : root.tone == "muted" ? Theme.text-tertiary
            : Theme.text-primary;
        vertical-alignment: center;
    }

    if root.show-currency: Text {
        text: root.currency;
        font-family: root.mono ? Typo.mono : "";
        font-size: root.size * 0.62;
        color: Theme.text-tertiary;
        vertical-alignment: center;
    }
}

// A status dot plus text. Colour is never the only signal — the text is always
// there too, which is what makes this readable without colour vision.
export component StatusPill inherits HorizontalLayout {
    // "online" | "degraded" | "offline" | "pending" | "probing" | "unknown"
    in property <string> state: "unknown";
    in property <string> text;

    // The dot carries no information a screen reader can reach, and the text
    // beside it is often just the chain name. Saying both is what makes the
    // colour redundant rather than load-bearing.
    accessible-role: AccessibleRole.text;
    accessible-label: root.text + ", " + root.state;

    property <brush> tone: root.state == "online" ? Theme.positive
        : root.state == "degraded" || root.state == "pending" || root.state == "probing" ? Theme.warning
        : root.state == "offline" ? Theme.negative
        : Theme.text-tertiary;

    spacing: Sp.s3;

    Rectangle {
        width: 7px;
        height: 7px;
        border-radius: 4px;
        background: root.tone;
        y: (parent.height - self.height) / 2;
        animate background { duration: Motion.base; enabled: Motion.enabled; }
    }

    Text {
        text: root.text;
        font-size: Typo.caption;
        color: Theme.text-secondary;
        vertical-alignment: center;
    }
}

// A loading placeholder at the exact dimensions of the thing it stands in for,
// so nothing shifts when the real content arrives.
export component Skeleton inherits Rectangle {
    in property <length> radius: R.sm;
    // A placeholder has nothing to say. Announcing it would put "group, group,
    // group" between the reader and the content they are waiting for.
    accessible-role: AccessibleRole.none;
    background: Theme.bg-inset;
    border-radius: root.radius;
    opacity: 0.7;
}

// Empty states are built in the same commit as the happy path, not added as
// polish. A wallet showing a blank card while fetching reads as broken.
export component EmptyState inherits VerticalLayout {
    in property <string> glyph: "○";
    in property <string> title;
    in property <string> body;
    in property <string> action-text;
    callback action();

    alignment: center;
    spacing: Sp.s4;

    // Optional. Several of the shapes that would suit an empty state — a wave,
    // an arc, a chart glyph — render as nothing in the fonts this build has,
    // which is worse than no glyph at all because it silently takes the space
    // of one. Where there is no character that both fits and exists, the state
    // goes without.
    if root.glyph != "": Text {
        text: root.glyph;
        font-size: 32px;
        color: Theme.text-tertiary;
        opacity: 0.5;
        horizontal-alignment: center;
    }

    Text {
        text: root.title;
        font-size: Typo.title3;
        font-weight: Typo.w-semibold;
        color: Theme.text-primary;
        horizontal-alignment: center;
    }

    if root.body != "": Text {
        text: root.body;
        font-size: Typo.body;
        color: Theme.text-secondary;
        horizontal-alignment: center;
        wrap: word-wrap;
        max-width: 320px;
    }

    if root.action-text != "": HorizontalLayout {
        alignment: center;
        Btn {
            text: root.action-text;
            variant: "primary";
            clicked => { root.action(); }
        }
    }
}

// One row in a list. Fixed height, because uniform rows are what let Slint's
// ListView virtualize cleanly and keep the scrollbar geometry honest.
export component ListRow inherits Rectangle {
    in property <string> glyph;
    in property <brush> glyph-tone: Theme.text-secondary;
    in property <string> title;
    // Set when the TITLE is an identifier rather than a name — an address on a
    // row nobody has named. Same reasoning as `subtitle-mono`: a base58 string
    // set in a proportional font reads as prose.
    in property <bool> title-mono: false;
    in property <string> subtitle;
    // Every subtitle in this application is either prose or an identifier — a
    // URL, an address, a transaction id — and an identifier set in a
    // proportional font reads as prose. Mono says "this is a thing you compare
    // character by character" before anybody reads a character of it.
    in property <bool> subtitle-mono: false;
    in property <bool> selected: false;
    in property <bool> interactive: true;
    callback clicked();

    height: 64px;
    background: root.selected ? Theme.accent-soft
        : (root.interactive && touch.has-hover) ? Theme.bg-hover
        : transparent;
    border-radius: R.md;

    animate background { duration: Motion.fast; enabled: Motion.enabled; }

    HorizontalLayout {
        padding-left: Sp.s5;
        padding-right: Sp.s5;
        spacing: Sp.s5;

        if root.glyph != "": Rectangle {
            width: 34px;
            height: 34px;
            y: (parent.height - self.height) / 2;
            border-radius: R.full;
            background: Theme.bg-inset;
            Text {
                text: root.glyph;
                font-size: 15px;
                color: root.glyph-tone;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                font-family: root.title-mono ? Typo.mono : "";
                font-size: root.title-mono ? Typo.num : Typo.body;
                font-weight: root.title-mono ? Typo.w-regular : Typo.w-medium;
                color: Theme.text-primary;
                overflow: elide;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                font-family: root.subtitle-mono ? Typo.mono : "";
                font-size: root.subtitle-mono ? Typo.num-sm : Typo.caption;
                color: Theme.text-tertiary;
                overflow: elide;
            }
        }

        @children
    }

    touch := TouchArea {
        enabled: root.interactive;
        clicked => { root.clicked(); }
    }

    // A row that does something is a button, and it is announced by what it
    // says rather than by what it looks like. The subtitle is included because
    // in this application it is always the thing that tells two otherwise
    // identical rows apart — an address, a URL, a transaction id.
    // The role has to be a constant, so a row is always announced as a button
    // and `accessible-enabled` carries whether it can actually be pressed —
    // which is the distinction a reader needs anyway.
    accessible-role: AccessibleRole.button;
    accessible-enabled: root.interactive;
    accessible-label: root.subtitle == "" ? root.title : root.title + ", " + root.subtitle;
    // Opening a row — a transaction, an identity, a node — from a screen
    // reader. Same omission as `Btn`: announced as a button and inert.
    accessible-action-default => {
        if (root.interactive) {
            root.clicked();
        }
    }
}
