// Turning one currency into another.

import { ListView } from "std-widgets.slint";

import { Motion, R, Sp, Theme, Typo } from "../theme/theme.slint";
import { Btn, Card, Eyebrow } from "../components/base.slint";
import { Icon } from "../components/icons.slint";
import { ConvertState, MarketState } from "../vm/state.slint";
import { Field, QuoteLine } from "../components/form.slint";
import { NoteText } from "../components/note.slint";

// The glyph is `⊙`, and it was chosen by looking rather than by taste.
//
// Under the previous pair of fonts `◈` — the obvious currency mark — was absent
// and drew nothing at all, so `⊙` was picked as the nearest thing that existed.
// With Space Grotesk and JetBrains Mono NL the coverage is different: `◈`, `◉`
// and `⊙` are all present in the mono face and **none of them** is in any Space
// Grotesk weight, so the family matters more than the character now. `⬡`, `♦`
// and `⧫` are still in neither.
//
// `⊙` is kept rather than swapped back to `◈`, because `◈` is what the design
// reserves for shielded items and giving it a second meaning here would spend
// it. A glyph is only a glyph if the shipped font has it, and only useful if it
// means one thing.
// One side of a conversion: a labelled box with an amount and a currency.
export component ConvertLeg inherits VerticalLayout {
    in property <string> label;
    in property <string> currency;
    in property <string> under;
    // Which leg this is, for the picker to write back to.
    in property <string> side;
    // Editable on the paying side, a computed estimate on the receiving one.
    in property <bool> editable: false;
    in property <string> estimate;
    in-out property <string> draft;
    callback edited();

    spacing: Sp.s3;

    Eyebrow { text: root.label; }

    Card {
        VerticalLayout {
            padding: Sp.s5;
            spacing: Sp.s3;

            HorizontalLayout {
                spacing: Sp.s4;

                if root.editable: amount := Field {
                    mono: true;
                    placeholder: "0.0000";
                    text <=> root.draft;
                    horizontal-stretch: 1;
                    edited => { root.edited(); }
                }

                // Not a field: nothing types here. An estimate that looked
                // editable would invite somebody to set the number they want
                // and expect the chain to honour it.
                if !root.editable: Text {
                    text: root.estimate == "" ? "—" : root.estimate;
                    font-family: Typo.mono;
                    font-size: Typo.num-lg;
                    font-weight: Typo.w-bold;
                    color: root.estimate == "" ? Theme.text-tertiary : Theme.text-primary;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Btn {
                    text: root.currency == "" ? @tr("Choose") : root.currency;
                    variant: "ghost";
                    clicked => { ConvertState.picking = root.side; }
                }
            }

            if root.under != "": Text {
                text: root.under;
                font-size: Typo.micro;
                color: Theme.text-tertiary;
            }
        }
    }
}

// Convert. A form, then a review — see `ConvertState` for why.
export component ConvertScreen inherits HorizontalLayout {
    spacing: Sp.s8;

    VerticalLayout {
        spacing: Sp.s5;
        width: 52%;

        ConvertLeg {
            label: @tr("YOU PAY");
            side: "pay";
            currency: ConvertState.from-name;
            editable: true;
            draft <=> ConvertState.pay-draft;
            under: ConvertState.from-balance == "" ? ""
                : @tr("Available: ") + ConvertState.from-balance;
            edited => { ConvertState.edited(); }
        }

        // The swap, between the two boxes because that is what it acts on.
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: R.md;
                background: swaptouch.has-hover ? Theme.bg-hover : Theme.bg-inset;
                border-width: 1px;
                border-color: Theme.border-default;
                animate background { duration: Motion.fast; enabled: Motion.enabled; }

                Icon {
                    name: "convert";
                    size: 18px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    tone: Theme.text-secondary;
                }

                swaptouch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { ConvertState.swap(); }
                }

                accessible-role: button;
                accessible-label: @tr("Swap the two currencies");
                accessible-action-default => { ConvertState.swap(); }
            }
        }

        ConvertLeg {
            label: @tr("YOU GET");
            side: "get";
            currency: ConvertState.to-name;
            estimate: ConvertState.get-estimate;
            under: @tr("Estimated. The chain does not guarantee it.");
        }

        // Where the Review button goes, once there is something behind it.
        //
        // It was here, primary and enabled, wired to a callback nothing
        // listened to — so the one action on this screen did nothing at all.
        // Everything above is real: the route, the estimate and the fees come
        // from the node. Signing does not exist yet, and a button that looks
        // like it will send money is the worst possible place to be optimistic.
        if ConvertState.ready: Card {
            VerticalLayout {
                padding: Sp.s5;
                spacing: Sp.s2;
                Text {
                    text: @tr("Priced, not signed");
                    font-size: Typo.body;
                    font-weight: Typo.w-bold;
                    color: Theme.text-secondary;
                }
                Text {
                    text: @tr("This wallet can price a conversion and cannot yet make one. Nothing on this screen sends anything.");
                    font-size: Typo.caption;
                    color: Theme.text-tertiary;
                    wrap: word-wrap;
                }
            }
        }

        Rectangle { vertical-stretch: 1; }
    }

    // ── The quote ───────────────────────────────────────────────────────
    VerticalLayout {
        spacing: Sp.s4;
        horizontal-stretch: 1;

        Eyebrow { text: @tr("QUOTE"); }

        Card {
            VerticalLayout {
                padding: Sp.s5;
                spacing: Sp.s4;

                QuoteLine {
                    label: @tr("Route");
                    value: ConvertState.via == "" ? "" : @tr("via ") + ConvertState.via;
                }
                QuoteLine { label: @tr("Rate"); value: ConvertState.rate; }
                QuoteLine {
                    label: @tr("Conversion fee");
                    value: ConvertState.conversion-fee;
                }
                QuoteLine {
                    label: @tr("Network fee");
                    value: ConvertState.network-fee;
                }
                QuoteLine {
                    label: @tr("Slippage");
                    value: ConvertState.slippage;
                    tone: ConvertState.slippage-tone == "negative" ? Theme.negative
                        : ConvertState.slippage-tone == "warning" ? Theme.warning
                        : Theme.text-primary;
                }

                Rectangle {
                    height: 1px;
                    background: Theme.border-subtle;
                }

                // The one figure that is a commitment rather than a guess, so
                // it is the one set in bold.
                QuoteLine {
                    label: @tr("You receive at least");
                    value: ConvertState.minimum;
                    strong: true;
                }
            }
        }

        if ConvertState.note.code != "": Card {
            VerticalLayout {
                padding: Sp.s5;
                spacing: Sp.s3;
                HorizontalLayout {
                    spacing: Sp.s3;
                    alignment: start;
                    Icon {
                        name: "warning";
                        size: 16px;
                        tone: Theme.warning;
                    }
                    NoteText {
                        note: ConvertState.note;
                        horizontal-stretch: 1;
                    }
                }
            }
        }

        Rectangle { vertical-stretch: 1; }
    }
}

// Choosing a currency for one leg.
//
// The list is `MarketState.rows` — the same rows the markets screen shows, with
// the same prices, because there is no second source for them to disagree with.
// It is also the exact set of currencies that can be converted at all: a row is
// there because some pool prices it, and a pool that prices it is a pool that
// can route it.
export component ConvertPicker inherits Rectangle {
    background: Theme.dark ? #0B0C0EE0 : #FBFBFCE0;

    // Swallows clicks aimed at the form behind, and closes on one that lands on
    // nothing — the same behaviour every other overlay in this build has.
    TouchArea {
        clicked => { ConvertState.picking = ""; }
    }

    Card {
        elevated: true;
        width: 460px;
        height: 520px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        // Over the dismissing area below it, so a click inside does not close.
        TouchArea {}

        VerticalLayout {
            padding: Sp.s7;
            spacing: Sp.s5;

            VerticalLayout {
                spacing: Sp.s2;
                Text {
                    text: ConvertState.picking == "pay"
                        ? @tr("Choose what to pay with")
                        : @tr("Choose what to receive");
                    font-size: Typo.title2;
                    font-weight: Typo.w-bold;
                    color: Theme.text-primary;
                }
                Text {
                    text: @tr("Every currency a started basket can price. One that is not here cannot be converted in a single transaction.");
                    font-size: Typo.caption;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
            }

            ListView {
                for row in MarketState.rows: Rectangle {
                    height: 52px;
                    border-radius: R.md;
                    background: pick.has-hover ? Theme.bg-hover : transparent;
                    animate background { duration: Motion.fast; enabled: Motion.enabled; }

                    HorizontalLayout {
                        padding-left: Sp.s4;
                        padding-right: Sp.s4;
                        spacing: Sp.s4;

                        Text {
                            text: row.name;
                            font-family: Typo.mono;
                            font-size: Typo.body;
                            font-weight: Typo.w-bold;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Text {
                            text: row.price;
                            font-family: Typo.mono;
                            font-size: Typo.num-sm;
                            color: Theme.text-tertiary;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                        }
                    }

                    pick := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if (ConvertState.picking == "pay") {
                                ConvertState.from-address = row.address;
                            } else {
                                ConvertState.to-address = row.address;
                            }
                            ConvertState.picking = "";
                            ConvertState.edited();
                        }
                    }

                    accessible-role: button;
                    accessible-label: @tr("{}, {}", row.name, row.price);
                    accessible-action-default => {
                        if (ConvertState.picking == "pay") {
                            ConvertState.from-address = row.address;
                        } else {
                            ConvertState.to-address = row.address;
                        }
                        ConvertState.picking = "";
                        ConvertState.edited();
                    }
                }
            }
        }
    }
}
