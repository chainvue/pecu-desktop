// Turning one currency into another.

import { ListView } from "std-widgets.slint";

import { Motion, R, Sp, Theme, Typo } from "../theme/theme.slint";
import { Btn, Card, Eyebrow, Money, TxId } from "../components/base.slint";
import { Icon } from "../components/icons.slint";
import { Actions, ConvertState, HaltState, MarketState } from "../vm/state.slint";
import { Field, QuoteLine } from "../components/form.slint";
import { Notice, NoteText, NoticeTitle } from "../components/note.slint";

// The glyph is `⊙`, and it was chosen by looking rather than by taste.
//
// Under the previous pair of fonts `◈` — the obvious currency mark — was absent
// and drew nothing at all, so `⊙` was picked as the nearest thing that existed.
// With Space Grotesk and JetBrains Mono NL the coverage is different: `◈`, `◉`
// and `⊙` are all present in the mono face and **none of them** is in any Space
// Grotesk weight, so the family matters more than the character now. `⬡`, `♦`
// and `⧫` are still in neither.
//
// `⊙` is kept rather than swapped back to `◈`, because `◈` is what the design
// reserves for shielded items and giving it a second meaning here would spend
// it. A glyph is only a glyph if the shipped font has it, and only useful if it
// means one thing.
// One side of a conversion: a labelled box with an amount and a currency.
export component ConvertLeg inherits VerticalLayout {
    in property <string> label;
    in property <string> currency;
    in property <string> under;
    // Which leg this is, for the picker to write back to.
    in property <string> side;
    // Editable on the paying side, a computed estimate on the receiving one.
    in property <bool> editable: false;
    in property <string> estimate;
    in-out property <string> draft;
    callback edited();

    spacing: Sp.s3;

    Eyebrow { text: root.label; }

    Card {
        VerticalLayout {
            padding: Sp.s5;
            spacing: Sp.s3;

            HorizontalLayout {
                spacing: Sp.s4;

                if root.editable: amount := Field {
                    mono: true;
                    placeholder: "0.0000";
                    text <=> root.draft;
                    horizontal-stretch: 1;
                    edited => { root.edited(); }
                }

                // Not a field: nothing types here. An estimate that looked
                // editable would invite somebody to set the number they want
                // and expect the chain to honour it.
                if !root.editable: Text {
                    text: root.estimate == "" ? "—" : root.estimate;
                    font-family: Typo.mono;
                    font-size: Typo.num-lg;
                    font-weight: Typo.w-bold;
                    color: root.estimate == "" ? Theme.text-tertiary : Theme.text-primary;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Btn {
                    text: root.currency == "" ? @tr("Choose") : root.currency;
                    variant: "ghost";
                    clicked => { ConvertState.picking = root.side; }
                }
            }

            if root.under != "": Text {
                text: root.under;
                font-size: Typo.micro;
                color: Theme.text-tertiary;
            }
        }
    }
}

// Step one: what to convert, and what it is expected to yield.
component ConvertForm inherits HorizontalLayout {
    spacing: Sp.s8;

    VerticalLayout {
        spacing: Sp.s5;
        width: 52%;

        ConvertLeg {
            label: @tr("YOU PAY");
            side: "pay";
            currency: ConvertState.from-name;
            editable: true;
            draft <=> ConvertState.pay-draft;
            under: ConvertState.from-balance == "" ? ""
                : @tr("Available: ") + ConvertState.from-balance;
            edited => { ConvertState.edited(); }
        }

        // The swap, between the two boxes because that is what it acts on.
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: R.md;
                background: swaptouch.has-hover ? Theme.bg-hover : Theme.bg-inset;
                border-width: 1px;
                border-color: Theme.border-default;
                animate background { duration: Motion.fast; enabled: Motion.enabled; }

                Icon {
                    name: "convert";
                    size: 18px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    tone: Theme.text-secondary;
                }

                swaptouch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { ConvertState.swap(); }
                }

                accessible-role: button;
                accessible-label: @tr("Swap the two currencies");
                accessible-action-default => { ConvertState.swap(); }
            }
        }

        ConvertLeg {
            label: @tr("YOU GET");
            side: "get";
            currency: ConvertState.to-name;
            estimate: ConvertState.get-estimate;
            under: @tr("Estimated. The chain does not guarantee it.");
        }

        // What the protocol has switched off, when it has switched anything off.
        //
        // Above the button rather than beside it: this is the reason the button
        // is dead, and a disabled control with its explanation somewhere else
        // is a control people press twice and then give up on.
        //
        // Shown for a warning too — a bridge halt does not stop a conversion,
        // and saying so beats leaving somebody to wonder.
        if HaltState.severity == "critical" || HaltState.severity == "warning"
            || HaltState.severity == "unknown": Notice {
            headline: HaltState.in-blocks > 0
                ? @tr("In {} blocks", HaltState.in-blocks)
                : @tr("From the network");
            body: haltwords.text;
            tone: HaltState.severity == "critical" ? "negative" : "warning";
        }

        // The sentence itself, resolved once. `Notice` takes strings, and this
        // is the one place a `Note` has to become one.
        haltwords := NoteText {
            note: HaltState.note;
            visible: false;
            height: 0px;
        }

        // There was a card here saying the wallet could price a conversion and
        // could not make one. It can now, so the button is back — and it is
        // back the way the send form's is: it builds and signs, and it does not
        // send. The step that sends is the review, and it is a separate press
        // on a screen that shows what was actually signed.
        //
        // `enabled` on the core's verdict, not on a length check here: "ready"
        // means a route exists, the amount parses and the wallet holds it, and
        // none of those is a property of the text in a field.
        // Dead while the protocol is not taking conversions.
        //
        // The quote above it is still real — the pools have reserves and the
        // node will price them all day — and it describes a market nobody can
        // trade in. Letting somebody sign that costs a key, a round trip and
        // their confidence, and the transaction is rejected in validation
        // before it reaches a block. The core refuses it too; this is so
        // nobody gets that far.
        Btn {
            text: HaltState.conversions-halted ? @tr("Conversions are switched off")
                : ConvertState.busy ? @tr("Preparing…")
                : @tr("Review conversion");
            variant: "primary";
            enabled: ConvertState.ready && !ConvertState.busy
                && !HaltState.conversions-halted;
            clicked => { ConvertState.review(); }
        }

        // Why a build failed, when it failed before there was a review to put
        // it on. The refusal a paused network produces lands here.
        if ConvertState.problem.code != "": NoticeTitle {
            note: ConvertState.problem;
            font-size: Typo.caption;
            color: Theme.negative;
            wrap: word-wrap;
        }

        Rectangle { vertical-stretch: 1; }
    }

    // ── The quote ───────────────────────────────────────────────────────
    VerticalLayout {
        spacing: Sp.s4;
        horizontal-stretch: 1;

        Eyebrow { text: @tr("QUOTE"); }

        Card {
            VerticalLayout {
                padding: Sp.s5;
                spacing: Sp.s4;

                QuoteLine {
                    label: @tr("Route");
                    value: ConvertState.via == "" ? "" : @tr("via ") + ConvertState.via;
                }
                QuoteLine { label: @tr("Rate"); value: ConvertState.rate; }
                QuoteLine {
                    label: @tr("Conversion fee");
                    value: ConvertState.conversion-fee;
                }
                QuoteLine {
                    label: @tr("Network fee");
                    value: ConvertState.network-fee;
                }
                QuoteLine {
                    label: @tr("Slippage");
                    value: ConvertState.slippage;
                    tone: ConvertState.slippage-tone == "negative" ? Theme.negative
                        : ConvertState.slippage-tone == "warning" ? Theme.warning
                        : Theme.text-primary;
                }

                Rectangle {
                    height: 1px;
                    background: Theme.border-subtle;
                }

                // The one figure that is a commitment rather than a guess, so
                // it is the one set in bold.
                QuoteLine {
                    label: @tr("You receive at least");
                    value: ConvertState.minimum;
                    strong: true;
                }
            }
        }

        if ConvertState.note.code != "": Card {
            VerticalLayout {
                padding: Sp.s5;
                spacing: Sp.s3;
                HorizontalLayout {
                    spacing: Sp.s3;
                    alignment: start;
                    Icon {
                        name: "warning";
                        size: 16px;
                        tone: Theme.warning;
                    }
                    NoteText {
                        note: ConvertState.note;
                        horizontal-stretch: 1;
                    }
                }
            }
        }

        Rectangle { vertical-stretch: 1; }
    }
}

// Convert: a form, then a review, then what happened.
//
// The same three steps the send screen has, and for the same reason — the
// review is not a confirmation dialog, it is the decoded transaction. On this
// screen that matters more rather than less: a conversion's whole meaning is
// inside a CryptoCondition payload, so which currency, how much, which basket
// it routes through and where the result lands are invisible to anyone reading
// the raw transaction, and the only place they become readable is here.
export component ConvertScreen inherits VerticalLayout {
    spacing: Sp.s7;

    // The node understood this conversion and said no.
    //
    // Named for the one code rather than for "there is a problem", and that is
    // deliberate. Most of the dozen `convert-*` notes are refusals to *build*
    // something — a bad recipient, a currency this wallet cannot identify, a
    // price that moved below the floor — and they are reported before anything
    // is signed, from a screen where offering the conversion again is the
    // correct thing to do. This one is the network having rejected bytes that
    // were already signed. Whether the others may go on re-offering the quote
    // they were priced from is issue #19's wider question and is not answered
    // here.
    property <bool> refused-by-node: ConvertState.problem.code == "convert-refused-by-node";

    if ConvertState.step == "form": ConvertForm {}

    // ── Step 2: what was actually signed ────────────────────────────────
    //
    // Two columns, and not for looks. In one column this card is taller than
    // an 800px window: the buttons — including the one that spends — sat below
    // the fold with nothing on screen to say they were there. A review whose
    // action you have to go looking for is a review people learn to skip.
    //
    // The split follows the content. Left is the transaction: what it converts,
    // whose coins, where the result goes, and every output. Right is what it
    // costs and what it is expected to be worth, under the one paragraph that
    // says none of those figures is a promise.
    if ConvertState.step == "review": HorizontalLayout {
        alignment: center;
        Card {
            width: 900px;
            VerticalLayout {
                padding: Sp.s7;
                spacing: Sp.s5;

                VerticalLayout {
                    spacing: Sp.s2;
                    Text {
                        text: @tr("Check this conversion");
                        font-size: Typo.title2;
                        font-weight: Typo.w-bold;
                        color: Theme.text-primary;
                    }
                    Text {
                        text: @tr("Read back from the transaction that was signed — not from what you typed.");
                        font-size: Typo.caption;
                        color: Theme.text-tertiary;
                        wrap: word-wrap;
                    }
                }

                HorizontalLayout {
                    spacing: Sp.s7;

                    // ── What the transaction does ───────────────────────
                    VerticalLayout {
                        spacing: Sp.s5;
                        horizontal-stretch: 1;

                        VerticalLayout {
                            spacing: Sp.s2;
                            Eyebrow { text: @tr("CONVERTING"); }
                            Text {
                                text: ConvertState.review-via == ""
                                    ? @tr("{} → {}", ConvertState.review-from, ConvertState.review-to)
                                    : @tr("{} → {} via {}", ConvertState.review-from,
                                          ConvertState.review-to, ConvertState.review-via);
                                font-family: Typo.mono;
                                font-size: Typo.num;
                                color: Theme.text-primary;
                                wrap: word-wrap;
                            }
                        }

                        // One under the other, not side by side. Two columns
                        // put a 34-character address in 230 points, which wraps
                        // it — and a wrapped address is one nobody can compare
                        // against the one on their screen or their paper. The
                        // left column has the height to spare; this is what it
                        // is for.
                        //
                        // The delivery address is decoded from the payload, not
                        // taken from the form. It is worth showing even though
                        // this wallet always converts to itself: the builder
                        // writes it as a bare key hash, so an identity address
                        // there would pay the R-form of the same bytes, which
                        // nobody holds a key for.
                        if ConvertState.review-from-address != "": VerticalLayout {
                            spacing: Sp.s2;
                            Eyebrow { text: @tr("PAID FROM"); }
                            Text {
                                text: ConvertState.review-from-address;
                                font-family: Typo.mono;
                                font-size: Typo.num-sm;
                                color: Theme.text-secondary;
                                wrap: char-wrap;
                            }
                        }

                        if ConvertState.review-recipient != "": VerticalLayout {
                            spacing: Sp.s2;
                            Eyebrow { text: @tr("DELIVERED TO"); }
                            Text {
                                text: ConvertState.review-recipient;
                                font-family: Typo.mono;
                                font-size: Typo.num-sm;
                                color: Theme.text-secondary;
                                wrap: char-wrap;
                            }
                        }

                        VerticalLayout {
                            spacing: Sp.s2;
                            Eyebrow { text: @tr("OUTPUTS"); }

                            // Every output, change included, on the same rule
                            // the send review follows: change is drawn quieter
                            // because only one row is the question being asked,
                            // and it is still shown in full because a review
                            // whose figures do not add up is one people stop
                            // reading.
                            for output in ConvertState.outputs: HorizontalLayout {
                                spacing: Sp.s5;
                                padding-top: Sp.s2;
                                padding-bottom: Sp.s2;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    Text {
                                        text: output.address == "" ? @tr("Unknown destination") : output.address;
                                        font-family: Typo.mono;
                                        font-size: Typo.num-sm;
                                        color: output.address == "" ? Theme.negative
                                            : output.is-change ? Theme.text-tertiary
                                            : Theme.text-primary;
                                        wrap: char-wrap;
                                    }
                                    if output.is-change: Text {
                                        text: @tr("Change · back to your wallet");
                                        font-size: Typo.caption;
                                        color: Theme.text-disabled;
                                    }
                                    if !output.is-change: NoteText {
                                        note: output.kind;
                                        font-size: Typo.caption;
                                        color: Theme.text-tertiary;
                                    }
                                }

                                Money {
                                    amount: output.amount;
                                    show-currency: false;
                                    size: output.is-change ? Typo.num-sm : Typo.num-sm;
                                    tone: output.is-change ? "muted" : "neutral";
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }

                        Rectangle { vertical-stretch: 1; }
                    }

                    // ── What it costs, and what it is worth ─────────────
                    VerticalLayout {
                        spacing: Sp.s5;
                        width: 360px;

                        // The paragraph this screen exists to make unmissable.
                        // Everything else here is exact — these are the bytes —
                        // and this one figure is not, and the difference is not
                        // something a person can be expected to infer from a
                        // layout.
                        Notice {
                            headline: @tr("The price is not fixed here");
                            body: @tr("The chain converts on import, at least a block from now, at the reserves as they are then. The protocol has no slippage bound: the floor below was checked once, just now, and nothing enforces it.");
                        }

                        VerticalLayout {
                            spacing: Sp.s3;
                            QuoteLine { label: @tr("Converting"); value: ConvertState.review-pay; }
                            QuoteLine { label: @tr("The node expects"); value: ConvertState.review-estimate; }
                            // Bold, and the wording is deliberate: "worth doing
                            // at", not "you will receive at least". Nothing
                            // enforces it.
                            QuoteLine {
                                label: @tr("Only worth doing above");
                                value: ConvertState.review-minimum;
                                strong: true;
                            }

                            Rectangle {
                                height: 1px;
                                background: Theme.border-subtle;
                            }

                            QuoteLine {
                                label: @tr("Conversion fee");
                                value: ConvertState.review-conversion-fee;
                            }
                            QuoteLine {
                                label: @tr("Network fee");
                                value: ConvertState.review-network-fee;
                            }
                            QuoteLine {
                                label: @tr("Leaving your wallet");
                                value: ConvertState.review-total;
                                strong: true;
                            }
                            if ConvertState.review-balance-after != "": QuoteLine {
                                label: @tr("Left afterwards");
                                value: ConvertState.review-balance-after;
                            }
                        }

                        Rectangle { vertical-stretch: 1; }
                    }
                }

                if ConvertState.problem.code != "": NoticeTitle {
                    note: ConvertState.problem;
                    font-size: Typo.caption;
                    color: Theme.negative;
                    wrap: word-wrap;
                }

                // The ordinary review: leave it, or send it.
                if !root.refused-by-node: HorizontalLayout {
                    spacing: Sp.s4;
                    Btn {
                        text: @tr("Back");
                        variant: "ghost";
                        clicked => { ConvertState.cancel(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Btn {
                        text: ConvertState.busy ? @tr("Converting…") : @tr("Convert now");
                        variant: "primary";
                        enabled: !ConvertState.busy;
                        clicked => { ConvertState.confirm(); }
                    }
                }

                // After the node has refused it, the same row would put the
                // refused broadcast back under the cursor as the brightest
                // thing on the card. The figures above it were priced before
                // the refusal, and a refusal usually means the reserves moved
                // — so pressing it again is either a wasted round trip or a
                // conversion at a price nobody on this screen has read.
                //
                // Back is the way to a fresh quote: it returns to the form
                // with both currencies still in it, and the next quote is
                // priced against the reserves as they are then.
                if root.refused-by-node: HorizontalLayout {
                    alignment: end;
                    Btn {
                        text: @tr("Back");
                        variant: "primary";
                        clicked => { ConvertState.cancel(); }
                    }
                }
            }
        }
    }

    // ── Step 3: what happened ───────────────────────────────────────────
    if ConvertState.step == "sent" || ConvertState.step == "uncertain": HorizontalLayout {
        alignment: center;
        Card {
            // One line for the transaction id — see the send screen's twin.
            width: 640px;
            VerticalLayout {
                padding: Sp.s8;
                spacing: Sp.s6;

                Text {
                    text: ConvertState.step == "sent"
                        ? @tr("Conversion sent")
                        : @tr("We could not confirm your conversion was sent");
                    font-size: Typo.title2;
                    font-weight: Typo.w-bold;
                    color: ConvertState.step == "sent" ? Theme.positive : Theme.warning;
                    wrap: word-wrap;
                }

                // Sent, not done. The chain has accepted the request; the
                // conversion itself happens on import, and what comes out is
                // decided then.
                if ConvertState.step == "sent": Text {
                    text: @tr("The network has the request. What you receive is decided when it is imported, a block or more from now, at the reserves as they are then.");
                    font-size: Typo.body;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }

                if ConvertState.step == "uncertain": Text {
                    text: @tr("It may already be on its way. Pecu has saved the exact transaction and can check on it. Do not send it again — that could convert twice.");
                    font-size: Typo.body;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }

                TxId {
                    txid: ConvertState.txid;
                    explorer: ConvertState.explorer;
                    open-link(url) => { Actions.open-link(url); }
                }

                HorizontalLayout {
                    Rectangle { horizontal-stretch: 1; }
                    Btn {
                        text: @tr("Done");
                        variant: "primary";
                        clicked => { ConvertState.done(); }
                    }
                }
            }
        }
    }

    Rectangle { vertical-stretch: 1; }
}

// Choosing a currency for one leg.
//
// The list is `MarketState.rows` — the same rows the markets screen shows, with
// the same prices, because there is no second source for them to disagree with.
// It is also the exact set of currencies that can be converted at all: a row is
// there because some pool prices it, and a pool that prices it is a pool that
// can route it.
export component ConvertPicker inherits Rectangle {
    background: Theme.dark ? #0B0C0EE0 : #FBFBFCE0;

    // Swallows clicks aimed at the form behind, and closes on one that lands on
    // nothing — the same behaviour every other overlay in this build has.
    TouchArea {
        clicked => { ConvertState.picking = ""; }
    }

    Card {
        elevated: true;
        width: 460px;
        height: 520px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        // Over the dismissing area below it, so a click inside does not close.
        TouchArea {}

        VerticalLayout {
            padding: Sp.s7;
            spacing: Sp.s5;

            VerticalLayout {
                spacing: Sp.s2;
                Text {
                    text: ConvertState.picking == "pay"
                        ? @tr("Choose what to pay with")
                        : @tr("Choose what to receive");
                    font-size: Typo.title2;
                    font-weight: Typo.w-bold;
                    color: Theme.text-primary;
                }
                Text {
                    text: @tr("Every currency a started basket can price. One that is not here cannot be converted in a single transaction.");
                    font-size: Typo.caption;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
            }

            ListView {
                for row in MarketState.rows: Rectangle {
                    height: 52px;
                    border-radius: R.md;
                    background: pick.has-hover ? Theme.bg-hover : transparent;
                    animate background { duration: Motion.fast; enabled: Motion.enabled; }

                    HorizontalLayout {
                        padding-left: Sp.s4;
                        padding-right: Sp.s4;
                        spacing: Sp.s4;

                        Text {
                            text: row.name;
                            font-family: Typo.mono;
                            font-size: Typo.body;
                            font-weight: Typo.w-bold;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Text {
                            text: row.price;
                            font-family: Typo.mono;
                            font-size: Typo.num-sm;
                            color: Theme.text-tertiary;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                        }
                    }

                    pick := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if (ConvertState.picking == "pay") {
                                ConvertState.from-address = row.address;
                            } else {
                                ConvertState.to-address = row.address;
                            }
                            ConvertState.picking = "";
                            ConvertState.edited();
                        }
                    }

                    accessible-role: button;
                    accessible-label: @tr("{}, {}", row.name, row.price);
                    accessible-action-default => {
                        if (ConvertState.picking == "pay") {
                            ConvertState.from-address = row.address;
                        } else {
                            ConvertState.to-address = row.address;
                        }
                        ConvertState.picking = "";
                        ConvertState.edited();
                    }
                }
            }
        }
    }
}
