// Defining and launching a currency.

import { InputMode, Motion, R, Sp, Theme, Typo } from "../theme/theme.slint";
import { Btn, Card, EmptyState, Eyebrow, ListRow, Money, StatusPill } from "../components/base.slint";
import { CurrencyField, CurrencySlice } from "../vm/structs.slint";
import { Actions, CurrencyState, WalletState } from "../vm/state.slint";
import { Field, FlowStepper } from "../components/form.slint";

// What this wallet's identities define, and what they could still define.
//
// # Why the second list is on the same screen
//
// A currency cannot exist without an identity of the same name, and an identity
// may define exactly one, once. So "which of my names are still free for this"
// is not a separate question somebody goes looking for — it is the other half
// of the list they are already reading, and the place a launch starts from.
// A proportional bar: slices side by side, each as wide as its share.
//
// # Why a bar and not a pie
//
// The arithmetic is the same; the reading is not. A pie needs path arcs — new
// geometry code in a crate that plots time series — and at this size it makes
// two similar shares indistinguishable. A bar is rectangles with proportional
// widths, which Slint lays out for free, and it can draw **short**: a basket
// whose weights do not add to one whole leaves a visible gap, which is the one
// mistake on this screen that cannot be fixed after the launch.
//
// A pie normalised to its own total is always full, and would have hidden it.
// One answer, with its consequence written inside the thing you press.
//
// # Why a row rather than a segmented control
//
// Every either/or in the currency form is difficult for the same reason: the
// labels are short and what they commit to is not. A segmented control can hold
// "Token · Basket · NFT" and nothing else, so the explanation ends up in a
// paragraph underneath that changes as the selection moves — which is a caption
// about a control rather than a description of a choice, and it is read last if
// it is read at all.
//
// A row carries the sentence. That is also what a screen reader announces,
// because the label is built from both halves.
export component ChoiceRow inherits Rectangle {
    in property <string> title;
    in property <string> body;
    // A value belonging to the answer rather than a sentence about it — an
    // i-address, so far. Monospaced and last, because it is what somebody checks
    // rather than what they read.
    in property <string> note;
    in property <bool> selected: false;
    // An answer that is on screen to be read rather than pressed, with `body`
    // carrying the reason. Refused options stay visible: a wallet whose
    // unusable identities had silently vanished would look identical to one
    // with no identities at all.
    in property <bool> enabled: true;
    // "accent" for an ordinary answer, "warning" for one with no way back.
    in property <string> tone: "accent";
    callback chosen();

    border-radius: R.md;
    // A refused answer loses its outline as well as its colour. With one, it
    // reads as a control that happens to be off; without one, it reads as a note
    // — which is what it is, and the difference has to survive a dark palette
    // where a disabled fill and a live one are four per cent apart.
    border-width: root.enabled || root.selected ? 1px : 0px;
    border-color: root.selected
        ? (root.tone == "warning" ? Theme.warning : Theme.accent)
        : Theme.border-subtle;
    background: root.selected
        ? (root.tone == "warning" ? Theme.warning-soft : Theme.accent-soft)
        : root.enabled ? Theme.bg-surface : Theme.bg-inset;
    animate border-color, background { duration: Motion.fast; enabled: Motion.enabled; }

    VerticalLayout {
        padding: Sp.s4;
        spacing: 2px;
        Text {
            text: root.title;
            font-size: Typo.body;
            font-weight: root.selected ? Typo.w-medium : Typo.w-regular;
            color: root.enabled ? Theme.text-primary : Theme.text-tertiary;
            wrap: word-wrap;
        }
        if root.body != "": Text {
            text: root.body;
            font-size: Typo.caption;
            color: root.enabled ? Theme.text-secondary : Theme.text-tertiary;
            wrap: word-wrap;
        }
        if root.note != "": Text {
            text: root.note;
            font-family: Typo.mono;
            font-size: Typo.num-sm;
            color: Theme.text-tertiary;
            wrap: char-wrap;
        }
    }

    if root.enabled: TouchArea {
        mouse-cursor: pointer;
        clicked => { root.chosen(); }
    }

    // The role has to be a constant — the same rule `ListRow` records — so a
    // refused answer is announced as a button that cannot be pressed, with the
    // reason in its label, rather than being silently inert.
    accessible-role: AccessibleRole.button;
    accessible-enabled: root.enabled;
    accessible-label: root.body == "" ? root.title : @tr("{}. {}", root.title, root.body);
    accessible-action-default => {
        if (root.enabled) {
            root.chosen();
        }
    }
}

// The question a step is asking, and one line on why it matters.
//
// Every step starts with one of these, so a person who has just pressed Next
// lands on a sentence rather than on a field.
export component StepHead inherits VerticalLayout {
    in property <string> title;
    in property <string> body;
    spacing: Sp.s2;

    Text {
        text: root.title;
        font-size: Typo.title3;
        font-weight: Typo.w-bold;
        color: Theme.text-primary;
        wrap: word-wrap;
    }
    if root.body != "": Text {
        text: root.body;
        font-size: Typo.caption;
        color: Theme.text-secondary;
        wrap: word-wrap;
    }
}

export component ProportionBar inherits VerticalLayout {
    in property <[CurrencySlice]> slices;
    // What an empty bar should say. An empty bar is not a neutral state here —
    // for a token it means a currency that can never hold anything.
    in property <string> empty-note;
    spacing: Sp.s3;

    // The slices are placed by hand rather than by a horizontal layout, and the
    // reason is a compile error rather than a preference.
    //
    // A slice's width is a share of the track — `track.width * percent / 100`.
    // Inside a layout, that width feeds the layout's minimum width, which feeds
    // its parent's, and once this bar sits in a column whose own width is being
    // negotiated the chain closes: the enclosing `Flickable` derives its
    // viewport width from the content's minimum width, which now depends on the
    // track's width, which depends on the viewport. Slint refuses to compile a
    // binding loop, and it is right to — the layout would have no fixed point.
    //
    // Placed absolutely, a slice reports no minimum of its own and the loop is
    // gone. The cost is that the running offset has to be carried, which is what
    // `offset-percent` is for; the core computes it beside the share, from the
    // same arithmetic, so the two cannot disagree about where a slice starts.
    track := Rectangle {
        height: 14px;
        border-radius: R.sm;
        background: Theme.bg-inset;
        clip: true;

        for slice in root.slices: Rectangle {
            // The one place numbers cross this boundary unformatted, and they
            // are proportions rather than amounts — see `CurrencySlice`.
            x: track.width * slice.offset-percent / 100;
            // Two pixels of daylight between neighbours, taken off the right so
            // the first slice still starts at the left edge.
            width: max(0px, track.width * slice.percent / 100 - 2px);
            height: parent.height;
            border-radius: R.sm;
            background: slice.tone == "accent" ? Theme.accent
                : slice.tone == "positive" ? Theme.positive
                : slice.tone == "warning" ? Theme.warning
                : Theme.text-tertiary;
        }
    }

    if root.slices.length == 0 && root.empty-note != "": Text {
        text: root.empty-note;
        font-size: Typo.caption;
        color: Theme.text-tertiary;
        wrap: word-wrap;
    }

    // The legend. Colour is never the only signal — every slice is named and
    // its share written out, which is also what a screen reader gets.
    if root.slices.length > 0: VerticalLayout {
        spacing: Sp.s2;
        for slice in root.slices: HorizontalLayout {
            spacing: Sp.s3;
            Rectangle {
                width: 8px;
                height: 8px;
                y: 4px;
                border-radius: 2px;
                background: slice.tone == "accent" ? Theme.accent
                    : slice.tone == "positive" ? Theme.positive
                    : slice.tone == "warning" ? Theme.warning
                    : Theme.text-tertiary;
            }
            Text {
                text: slice.label == "" ? "—" : slice.label;
                font-size: Typo.caption;
                color: Theme.text-secondary;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Text {
                text: slice.percent-display;
                font-family: Typo.mono;
                font-size: Typo.num-sm;
                color: Theme.text-primary;
            }
        }
    }
}


// What would go on the chain, updating as the form is edited.
//
// The permanent fields are marked, and that marking is the reason the panel is
// here: everything else it shows is also in the form above it.
export component DefinitionPreview inherits VerticalLayout {
    in property <[CurrencyField]> fields;
    spacing: Sp.s3;

    // Label beside value, in two columns.
    //
    // It was stacked for a while, and the reason was real: this panel lived in a
    // 360px column, where the value got whatever the label left of it and an
    // i-address does not fit in that — so the preview clipped, and a preview
    // showing a different definition from the one being made is worse than no
    // preview.
    //
    // The panel is on a full-width review now. Seven label/value pairs stacked
    // is fourteen lines of alternating type sizes that has to be read in order
    // to be read at all; in two columns it is a table, which is what somebody
    // checking a definition against what they meant actually wants. The label
    // column is fixed so the values line up down the page.
    for field in root.fields: HorizontalLayout {
        spacing: Sp.s5;
        Text {
            text: field.label;
            width: 180px;
            font-size: Typo.caption;
            color: Theme.text-tertiary;
            wrap: word-wrap;
        }
        Text {
            text: field.value;
            horizontal-stretch: 1;
            font-family: Typo.mono;
            font-size: Typo.num-sm;
            color: Theme.text-primary;
            // `char-wrap`, not `word-wrap`. Half of these are single unbroken
            // tokens — an i-address has no spaces to break at — and
            // word-wrapping one just clips it.
            wrap: char-wrap;
        }
    }
}

// Configuring a currency: one question at a time.
//
// # Why this is stepped now, when it deliberately was not before
//
// It used to be one page — the kind, the identity, the reserves, the supply,
// two permanent switches and a start height down the left, with a live picture
// of the definition on the right. The argument for that shape was written into
// this file: every field here is permanent, and a stepped flow hides the
// consequence of step two while somebody is on step one.
//
// That was the wrong conclusion from a true premise. Nothing was hidden and
// nothing was legible either: two of the six sections did not apply to the kind
// that was selected, the right-hand panel restated six values that were already
// on the left, and the whole form was three windows tall in a column 420px
// wide. "Everything visible at once" had become "none of it readable".
//
// So the premise is answered where it belongs instead. Each step asks one
// thing, and the **last step is the whole definition at full width** — every
// value, both bars, the fee, and every warning — which is the screen the old
// side panel was trying to be. Nothing is signed before it has been seen, and
// the review after it still reads its figures off the transaction rather than
// off this form.
export component CurrencyForm inherits VerticalLayout {
    spacing: Sp.s6;

    // Where the form is, as a number, so the breadcrumb is written once rather
    // than five times. The claiming path has one more question in the middle —
    // see `plan()` in the core for why that path is a different journey rather
    // than this one with a step inserted.
    property <int> at: CurrencyState.form-step == "kind" ? 0
        : CurrencyState.form-step == "under" ? 1
        : CurrencyState.form-step == "authority" ? 2
        : CurrencyState.form-step == "setup" ? (CurrencyState.claiming ? 3 : 2)
        : (CurrencyState.claiming ? 4 : 3);

    // Re-checking the draft is cheap in the core — arithmetic over what was
    // typed, no node asked — but the answer rebuilds five models: the problems,
    // both bars' slices, the preview and the step list. Done on every keystroke
    // that is five model swaps and a repaint per character, which is what typing
    // into a weight or an amount felt like.
    //
    // A tenth of a second collapses a burst into one check and is under the
    // threshold where a preview reads as lagging behind the field.
    //
    // Only the typed fields go through here. Choosing a kind, picking an
    // identity or adding a row are single acts with nothing to collapse, and
    // they still check immediately.
    draftcheck := Timer {
        interval: 120ms;
        running: false;
        triggered => {
            self.running = false;
            Actions.check-currency();
        }
    }

    function recheck() {
        draftcheck.running = false;
        draftcheck.running = true;
    }

    // The breadcrumb, built here rather than in the core.
    //
    // The difference from `CurrencyState.steps` is what each one is about. That
    // one draws **transactions** — how many there are and which cost money are
    // facts about the chain, and an interface deciding them for itself would be
    // a second opinion about what is being spent. This draws where somebody is
    // in a form, which is this file's own business. The same split the identity
    // claim form records.
    //
    // Two of them rather than one with a conditional entry, because the two
    // paths have a different number of questions and a step that appears and
    // disappears under the current position is worse than two honest pictures.
    if !CurrencyState.claiming: FlowStepper {
        steps: [
            {
                label: @tr("Kind"),
                state: root.at == 0 ? "now" : "done",
                costs: false,
            },
            {
                label: @tr("Identity"),
                state: root.at < 1 ? "later" : root.at == 1 ? "now" : "done",
                costs: false,
            },
            {
                label: @tr("Set it up"),
                state: root.at < 2 ? "later" : root.at == 2 ? "now" : "done",
                costs: false,
            },
            {
                label: @tr("Check and launch"),
                state: root.at < 3 ? "later" : "now",
                costs: false,
            },
        ];
    }
    if CurrencyState.claiming: FlowStepper {
        steps: [
            {
                label: @tr("Kind"),
                state: root.at == 0 ? "now" : "done",
                costs: false,
            },
            {
                label: @tr("Name"),
                state: root.at < 1 ? "later" : root.at == 1 ? "now" : "done",
                costs: false,
            },
            {
                label: @tr("Who can take it back"),
                state: root.at < 2 ? "later" : root.at == 2 ? "now" : "done",
                costs: false,
            },
            {
                label: @tr("Set it up"),
                state: root.at < 3 ? "later" : root.at == 3 ? "now" : "done",
                costs: false,
            },
            {
                label: @tr("Check and launch"),
                state: root.at < 4 ? "later" : "now",
                costs: false,
            },
        ];
    }

    // ── 1 · What kind ───────────────────────────────────────────────────
    //
    // First, because it decides which questions come after it.
    if CurrencyState.form-step == "kind": VerticalLayout {
        spacing: Sp.s4;

        StepHead {
            title: @tr("What kind of currency?");
            body: @tr("This decides what the rest of the form asks for, and it is fixed at launch.");
        }

        ChoiceRow {
            title: @tr("Token");
            body: @tr("A plain token. It exists in whatever quantity you allocate at launch, or that you mint later.");
            selected: CurrencyState.kind == "token";
            chosen => {
                CurrencyState.kind = "token";
                Actions.check-currency();
            }
        }
        ChoiceRow {
            title: @tr("Basket");
            body: @tr("Holds reserves of other currencies and converts between them. You set each reserve's share of the whole, and consensus reads those shares exactly.");
            selected: CurrencyState.kind == "basket";
            chosen => {
                CurrencyState.kind = "basket";
                Actions.check-currency();
            }
        }
        ChoiceRow {
            title: @tr("NFT");
            body: @tr("A single indivisible unit. No supply to set and no reserves to hold.");
            selected: CurrencyState.kind == "nft";
            chosen => {
                CurrencyState.kind = "nft";
                Actions.check-currency();
            }
        }
    }

    // ── 2 · Which identity ──────────────────────────────────────────────
    //
    // One list, not a chooser above a list.
    //
    // This step used to ask twice: a pair of rows for *where the identity comes
    // from*, and then, underneath, the identities themselves in rows that looked
    // exactly the same. Two levels of the same control, and the reader had to
    // work out which pair was the question.
    //
    // There is only one question — which name does this currency take — and a
    // name that does not exist yet is one of its answers. So it is one list with
    // exactly one selection, and the last entry is the one that has to be
    // claimed first.
    if CurrencyState.form-step == "under": VerticalLayout {
        spacing: Sp.s4;

        StepHead {
            title: @tr("Which name will it use?");
            body: @tr("The currency takes that identity's address and its name, and that identity can never define another one.");
        }

        // Collapsed the moment it is answered.
        //
        // Every identity in the wallet, listed in full, is as tall as the wallet
        // is old — and the field that appears when a new name is chosen sat
        // below all of them, off the bottom of the window. Choosing is a step,
        // and a finished step should take one row.
        if CurrencyState.claiming || CurrencyState.identity != "": HorizontalLayout {
            spacing: Sp.s4;
            Rectangle {
                horizontal-stretch: 1;
                border-radius: R.md;
                border-width: 1px;
                border-color: Theme.accent;
                background: Theme.accent-soft;
                VerticalLayout {
                    padding: Sp.s4;
                    spacing: 2px;
                    Text {
                        text: CurrencyState.claiming
                            ? @tr("A new name, claimed as part of this launch")
                            : CurrencyState.identity-name == ""
                                ? CurrencyState.identity
                                : CurrencyState.identity-name;
                        font-size: Typo.body;
                        color: Theme.text-primary;
                        wrap: word-wrap;
                    }
                    if !CurrencyState.claiming: Text {
                        text: CurrencyState.identity;
                        font-family: Typo.mono;
                        font-size: Typo.num-sm;
                        color: Theme.text-tertiary;
                        wrap: char-wrap;
                    }
                }
            }
            Btn {
                text: @tr("Change");
                variant: "ghost";
                y: (parent.height - self.height) / 2;
                clicked => {
                    CurrencyState.claiming = false;
                    CurrencyState.identity = "";
                    CurrencyState.identity-name = "";
                    CurrencyState.new-name = "";
                    Actions.check-currency();
                }
            }
        }

        // Wrapped in a layout because Slint cannot put a `for` directly after
        // an `if` — the condition takes one element, and a repeater is not one.
        if !CurrencyState.claiming && CurrencyState.identity == "": VerticalLayout {
            spacing: Sp.s3;

            for entry in CurrencyState.eligible: ChoiceRow {
                title: entry.name;
                // The refusal when there is one, and the address when there is
                // not. Never both: a row that can be pressed does not need to
                // explain itself, and one that cannot has nothing else to say.
                body: entry.refusal;
                note: entry.refusal == "" ? entry.address : "";
                enabled: entry.refusal == "";
                selected: !CurrencyState.claiming && CurrencyState.identity == entry.address;
                chosen => {
                    CurrencyState.claiming = false;
                    CurrencyState.new-name = "";
                    CurrencyState.identity = entry.address;
                    CurrencyState.identity-name = entry.name;
                    Actions.check-currency();
                }
            }

            // The answer that makes this screen usable on a wallet with no spare
            // identity — which is every wallet, the first time. An entry in the
            // same list rather than a link somewhere below, because it answers
            // the same question the rows above it do.
            ChoiceRow {
                title: @tr("A new name");
                body: @tr("Claim one as part of this launch. The identity and the currency share the name and the address, and the wallet does the two in order.");
                selected: CurrencyState.claiming;
                chosen => {
                    CurrencyState.claiming = true;
                    // Clearing the other answer, because core refuses a draft
                    // that carries both — and it is right to: guessing which was
                    // meant would define a currency under an identity nobody
                    // chose.
                    CurrencyState.identity = "";
                    CurrencyState.identity-name = "";
                    Actions.check-currency();
                }
            }
        }

        // Directly under the row it belongs to, so the field and the answer that
        // asked for it read as one thing.
        if CurrencyState.claiming: VerticalLayout {
            spacing: Sp.s3;

            // Asking the chain about a name costs two requests — is it taken,
            // and what does it cost — and firing them on every keystroke sent
            // sixteen of them for the word "livecoin", each one landing out of
            // order and rewriting the field's answer as it went. That is what
            // the screen feeling slow actually was.
            //
            // The local rule still runs on every keystroke: it is arithmetic
            // over a string and it is what refuses a capital letter instantly.
            // Only the chain waits for a pause.
            namecheck := Timer {
                interval: 350ms;
                running: false;
                triggered => {
                    self.running = false;
                    Actions.check-currency-name(CurrencyState.new-name);
                }
            }
            Text {
                text: @tr("The name to claim");
                font-size: Typo.caption;
                color: Theme.text-secondary;
            }
            newname := Field {
                mono: true;
                placeholder: @tr("lowercase, digits, _ and -");
                text <=> CurrencyState.new-name;
                invalid: newname.text != "" && CurrencyState.new-name-problem != "";
                edited => {
                    // Restarted, not merely started: each keystroke pushes the
                    // question back, so it is asked once about the name
                    // somebody stopped typing.
                    namecheck.running = false;
                    namecheck.running = true;
                    root.recheck();
                }
            }
            if CurrencyState.new-name-problem != "": Text {
                text: CurrencyState.new-name-problem;
                font-size: Typo.caption;
                color: Theme.negative;
                wrap: word-wrap;
            }
            // Both fees, together. They are charged by two different
            // transactions and a screen that showed one of them would understate
            // what this commits to by the larger half.
            if CurrencyState.new-name-problem == "" && CurrencyState.new-name-fee != "": Text {
                text: @tr("Free to claim · the name costs {0} {1}, and the launch costs {2} {1} on top.",
                          CurrencyState.new-name-fee, WalletState.ticker, CurrencyState.fee);
                font-size: Typo.caption;
                color: Theme.text-tertiary;
                wrap: word-wrap;
            }
        }
    }
    // ── 3 · Who can take the name back ──────────────────────────────────
    //
    // Only on the path that claims one, and the same question the identity
    // screen asks in the same words — because it is the same decision with the
    // same permanent consequence, and two wordings for it would be two answers.
    //
    // Neither answer is preselected. The whole reason this is a step is that the
    // dangerous one used to be what happened when nobody chose.
    if CurrencyState.form-step == "authority": VerticalLayout {
        spacing: Sp.s4;

        StepHead {
            title: @tr("Who can take this name back?");
            body: @tr("If it is ever stolen — a key copied, a machine lost — revoking it is what stops the thief using it. Revoking needs a recovery authority that is not the identity itself, and that is free to set only now.");
        }

        ChoiceRow {
            title: @tr("Another identity can recover it");
            body: @tr("The one to choose if this name matters. Name an identity you also control, or one you trust.");
            selected: CurrencyState.new-authority == "other";
            chosen => { CurrencyState.new-authority = "other"; }
        }
        ChoiceRow {
            title: @tr("Nobody — it can never be revoked");
            tone: "warning";
            body: @tr("The identity becomes its own authority, and the chain refuses a revocation whose subject is its own recovery authority. Changing this later costs another transaction.");
            selected: CurrencyState.new-authority == "none";
            chosen => {
                CurrencyState.new-authority = "none";
                // Cleared, so what the review shows and what the command carries
                // cannot disagree with the answer given here.
                CurrencyState.new-revocation = "";
                CurrencyState.new-recovery = "";
            }
        }

        if CurrencyState.new-authority == "other": VerticalLayout {
            spacing: Sp.s3;
            HorizontalLayout {
                spacing: Sp.s4;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: Sp.s2;
                    Text {
                        text: @tr("Recovery — required");
                        font-size: Typo.caption;
                        color: Theme.text-secondary;
                    }
                    Field {
                        mono: true;
                        placeholder: @tr("name@ or i-address");
                        text <=> CurrencyState.new-recovery;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: Sp.s2;
                    Text {
                        text: @tr("Revocation — optional");
                        font-size: Typo.caption;
                        color: Theme.text-secondary;
                    }
                    Field {
                        mono: true;
                        placeholder: @tr("name@ or i-address");
                        text <=> CurrencyState.new-revocation;
                    }
                }
            }
            // Which of the two actually decides this, said plainly. It is not
            // obvious and it is the reason one field is required and the other
            // is not.
            Text {
                text: @tr("Recovery is the one that matters: leave it blank and the identity is its own recovery authority again, whatever revocation says. Left blank, revocation becomes the identity itself, which can revoke itself — that is fine.");
                font-size: Typo.caption;
                color: Theme.text-tertiary;
                wrap: word-wrap;
            }
        }
    }

    // ── 4 · Set it up ───────────────────────────────────────────────────
    //
    // The kind-specific questions, and the two permanent switches that are not
    // amounts. Each table has its bar directly underneath rather than in a
    // column beside the form: the bar is feedback on the rows above it, and at
    // full width its legend stops reflowing every time a row is added.
    if CurrencyState.form-step == "setup": VerticalLayout {
        spacing: Sp.s6;

        StepHead {
            title: CurrencyState.kind == "basket" ? @tr("Set up the basket")
                : CurrencyState.kind == "nft" ? @tr("Set up the NFT")
                : @tr("Set up the token");
            body: CurrencyState.kind == "nft"
                ? @tr("An NFT is one indivisible unit, so there is no supply to allocate and no reserve to hold.")
                : @tr("Everything here is fixed at launch.");
        }

        // Reserves — a basket only.
        if CurrencyState.kind == "basket": VerticalLayout {
            spacing: Sp.s3;
            HorizontalLayout {
                Text {
                    text: @tr("Reserves");
                    font-size: Typo.body;
                    font-weight: Typo.w-medium;
                    color: Theme.text-primary;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                Btn {
                    text: @tr("Add a reserve");
                    clicked => { Actions.add-reserve(); }
                }
            }
            Text {
                text: @tr("The weights are shares of one whole and must add to 100%. Consensus reads them exactly, and a basket launched with the wrong ones has the wrong prices in it forever.");
                font-size: Typo.caption;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }
            // Column names, because a placeholder disappears the moment somebody
            // types into the field it was describing — which is when a bare `50`
            // in a narrow column stops saying what it is a share of.
            if CurrencyState.reserve-rows.length > 0: HorizontalLayout {
                spacing: Sp.s4;
                Text {
                    text: @tr("CURRENCY");
                    font-size: Typo.micro;
                    color: Theme.text-tertiary;
                    horizontal-stretch: 1;
                }
                Text {
                    text: @tr("SHARE %");
                    font-size: Typo.micro;
                    color: Theme.text-tertiary;
                    width: 120px;
                }
                Rectangle { width: 108px; }
            }
            for entry[i] in CurrencyState.reserve-rows: HorizontalLayout {
                spacing: Sp.s4;
                // Chosen, not typed.
                //
                // The definition carries a currency's **i-address**, and this
                // field used to take a name — so a basket with `VRSCTEST` as a
                // reserve was accepted by every check on this screen and then
                // refused by the builder, after the launch had been agreed to,
                // with a message about i-addresses that nothing had mentioned.
                // A list of what the chain actually has cannot be typed wrong.
                Rectangle {
                    horizontal-stretch: 1;
                    height: 42px;
                    border-radius: R.md;
                    border-width: 1px;
                    border-color: pick.has-focus && InputMode.keyboard
                        ? Theme.accent
                        : Theme.border-default;
                    background: touch.has-hover ? Theme.bg-hover : Theme.bg-inset;
                    animate background, border-color { duration: Motion.fast; enabled: Motion.enabled; }

                    HorizontalLayout {
                        padding-left: Sp.s5;
                        padding-right: Sp.s5;
                        spacing: Sp.s3;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 0px;
                            Text {
                                text: entry.name == ""
                                    ? (entry.currency == "" ? @tr("Choose a currency") : entry.currency)
                                    : entry.name;
                                font-size: Typo.body;
                                color: entry.currency == "" ? Theme.text-disabled : Theme.text-primary;
                                overflow: elide;
                            }
                            if entry.name != "": Text {
                                text: entry.currency;
                                font-family: Typo.mono;
                                font-size: Typo.micro;
                                color: Theme.text-tertiary;
                                overflow: elide;
                            }
                        }
                        Text {
                            text: "▾";
                            font-family: Typo.mono;
                            font-size: Typo.caption;
                            color: Theme.text-tertiary;
                            vertical-alignment: center;
                        }
                    }

                    pick := FocusScope {
                        key-pressed(event) => {
                            if (event.text == "\n" || event.text == " ") {
                                CurrencyState.picking-reserve = i;
                                Actions.search-currencies("");
                                return EventResult.accept;
                            }
                            return EventResult.reject;
                        }
                    }
                    // Outside the shape, and only while the keyboard is
                    // driving — the rule `Btn` documents.
                    if pick.has-focus && InputMode.keyboard: Rectangle {
                        x: -3px;
                        y: -3px;
                        width: parent.width + 6px;
                        height: parent.height + 6px;
                        border-radius: R.md + 3px;
                        border-width: 2px;
                        border-color: Theme.accent-ring;
                    }

                    touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            InputMode.keyboard = false;
                            pick.focus();
                            CurrencyState.picking-reserve = i;
                            // Opened on an empty query, which is the start of
                            // the whole list rather than nothing at all.
                            Actions.search-currencies("");
                        }
                    }

                    accessible-role: AccessibleRole.button;
                    accessible-label: entry.name == ""
                        ? @tr("Choose a currency for this reserve")
                        : @tr("Reserve currency, {}. Choose a different one.", entry.name);
                    accessible-action-default => {
                        CurrencyState.picking-reserve = i;
                        Actions.search-currencies("");
                    }
                }
                // Seeded on `init`, not bound.
                //
                // `Field.text` is an alias for its inner input's text. A one-way
                // binding on it — `text: entry.weight` — fights the typing: the
                // binding re-evaluates and puts the old value back, so the field
                // silently refuses everything typed into it. And `<=>` cannot
                // point at a model element; Slint requires a property reference.
                //
                // So the row seeds itself once when it is built and writes back
                // on every edit. The model stays the source of truth for Rust,
                // and the field owns what is in it while somebody is typing.
                Field {
                    width: 120px;
                    mono: true;
                    placeholder: "%";
                    init => { self.text = entry.weight; }
                    edited => {
                        CurrencyState.reserve-rows[i].weight = self.text;
                        root.recheck();
                    }
                }
                Btn {
                    text: @tr("Remove");
                    variant: "ghost";
                    width: 108px;
                    clicked => { Actions.remove-reserve(i); }
                }
            }
            // The total beside the bar, in the tone the bar is drawn in, so the
            // picture and the number say the same thing.
            HorizontalLayout {
                height: 16px;
                Eyebrow {
                    text: @tr("SHARES OF THE WHOLE");
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                Text {
                    text: CurrencyState.weights-total;
                    font-family: Typo.mono;
                    font-size: Typo.num-sm;
                    color: CurrencyState.weights-total == "100%"
                        ? Theme.positive
                        : Theme.warning;
                    vertical-alignment: center;
                }
            }
            ProportionBar {
                slices: CurrencyState.slices;
                empty-note: @tr("No reserves yet. A basket without them holds nothing.");
            }
        }

        // Starting supply — everything except an NFT, which is always exactly
        // one unit.
        if CurrencyState.kind != "nft": VerticalLayout {
            spacing: Sp.s3;
            HorizontalLayout {
                Text {
                    text: @tr("Starting supply");
                    font-size: Typo.body;
                    font-weight: Typo.w-medium;
                    color: Theme.text-primary;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                Btn {
                    text: @tr("Allocate to an identity");
                    clicked => { Actions.add-preallocation(); }
                }
            }
            Text {
                text: @tr("Allocations go to identities, not to addresses. Nothing here means the currency starts empty — which is only useful if it can be minted.");
                font-size: Typo.caption;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }
            if CurrencyState.supply-rows.length > 0: HorizontalLayout {
                spacing: Sp.s4;
                Text {
                    text: @tr("IDENTITY");
                    font-size: Typo.micro;
                    color: Theme.text-tertiary;
                    horizontal-stretch: 1;
                }
                Text {
                    text: @tr("AMOUNT");
                    font-size: Typo.micro;
                    color: Theme.text-tertiary;
                    width: 160px;
                }
                Rectangle { width: 108px; }
            }
            for entry[i] in CurrencyState.supply-rows: HorizontalLayout {
                spacing: Sp.s4;
                Field {
                    horizontal-stretch: 1;
                    mono: true;
                    placeholder: @tr("name@ or i-address");
                    init => { self.text = entry.recipient; }
                    edited => {
                        CurrencyState.supply-rows[i].recipient = self.text;
                        root.recheck();
                    }
                }
                Field {
                    width: 160px;
                    mono: true;
                    placeholder: "0.0000 0000";
                    init => { self.text = entry.amount; }
                    edited => {
                        CurrencyState.supply-rows[i].amount = self.text;
                        root.recheck();
                    }
                }
                Btn {
                    text: @tr("Remove");
                    variant: "ghost";
                    width: 108px;
                    clicked => { Actions.remove-preallocation(i); }
                }
            }
            HorizontalLayout {
                height: 16px;
                Eyebrow {
                    text: @tr("ALLOCATED AT LAUNCH");
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                Text {
                    text: CurrencyState.supply-total;
                    font-family: Typo.mono;
                    font-size: Typo.num-sm;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                }
            }
            ProportionBar {
                slices: CurrencyState.supply-slices;
                empty-note: @tr("Nothing allocated. The currency starts empty.");
            }
        }

        // Can the supply grow. Two rows rather than a segmented control,
        // because the two answers are a sentence apart and one of them cannot be
        // undone.
        VerticalLayout {
            spacing: Sp.s3;
            Text {
                text: @tr("Can more be minted later?");
                font-size: Typo.body;
                font-weight: Typo.w-medium;
                color: Theme.text-primary;
            }
            ChoiceRow {
                title: @tr("No — fixed at launch");
                body: @tr("The supply is what it is, and nothing can add to it, ever.");
                selected: !CurrencyState.mintable;
                chosen => {
                    CurrencyState.mintable = false;
                    Actions.check-currency();
                }
            }
            ChoiceRow {
                title: @tr("Yes — this identity can mint more");
                body: @tr("Whoever controls the identity can create more at any time. Whoever holds the currency is trusting that.");
                selected: CurrencyState.mintable;
                chosen => {
                    CurrencyState.mintable = true;
                    Actions.check-currency();
                }
            }
        }

        // When it begins. A launch is not instant, and consensus refuses a
        // currency that starts at or before the block it was mined in.
        VerticalLayout {
            spacing: Sp.s3;
            Text {
                text: @tr("When does it start?");
                font-size: Typo.body;
                font-weight: Typo.w-medium;
                color: Theme.text-primary;
            }
            HorizontalLayout {
                spacing: Sp.s5;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: @tr("Blocks from now");
                        font-size: Typo.caption;
                        color: Theme.text-secondary;
                    }
                    Text {
                        text: CurrencyState.start-block == ""
                            ? @tr("Consensus refuses a currency that begins at or before the current block.")
                            : @tr("Block {}, roughly {} minutes away.",
                                  CurrencyState.start-block, CurrencyState.start-delay);
                        font-size: Typo.caption;
                        color: Theme.text-tertiary;
                        wrap: word-wrap;
                    }
                }
                delay := Field {
                    width: 160px;
                    mono: true;
                    placeholder: "20";
                    y: (parent.height - self.height) / 2;
                    init => { self.text = CurrencyState.start-delay; }
                    edited => {
                        CurrencyState.start-delay = delay.text;
                        root.recheck();
                    }
                }
            }
        }

        // Why the button is off, or what the chain will say yes to anyway.
        // Blocking first — one of them is the reason Next does not move.
        if CurrencyState.problems.length > 0: VerticalLayout {
            spacing: Sp.s3;
            for problem in CurrencyState.problems: Rectangle {
                background: problem.blocking ? Theme.negative-soft : Theme.warning-soft;
                border-radius: R.md;
                VerticalLayout {
                    padding: Sp.s5;
                    Text {
                        text: problem.text;
                        font-size: Typo.caption;
                        color: problem.blocking ? Theme.negative : Theme.warning;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }

    // ── 5 · Check and launch ────────────────────────────────────────────
    //
    // The whole definition at full width, which is what the old side panel was
    // trying to be in 360px beside a form that already said most of it.
    if CurrencyState.form-step == "review": VerticalLayout {
        spacing: Sp.s5;

        StepHead {
            title: @tr("Check it, then launch");
            body: @tr("Every value here is fixed when the definition is mined. An identity defines one currency, once.");
        }

        Rectangle {
            background: Theme.bg-inset;
            border-radius: R.md;
            VerticalLayout {
                padding: Sp.s5;
                spacing: Sp.s4;
                // Said once, here, rather than tagged on every row. Every field
                // of a currency definition is permanent, and a "permanent" mark
                // beside all six of them is six copies of one sentence.
                Eyebrow { text: @tr("WHAT GOES ON THE CHAIN · ALL OF IT PERMANENT"); }
                DefinitionPreview { fields: CurrencyState.preview; }
            }
        }

        if CurrencyState.kind == "basket": VerticalLayout {
            spacing: Sp.s3;
            HorizontalLayout {
                height: 16px;
                Eyebrow {
                    text: @tr("RESERVES");
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                Text {
                    text: CurrencyState.weights-total;
                    font-family: Typo.mono;
                    font-size: Typo.num-sm;
                    color: CurrencyState.weights-total == "100%"
                        ? Theme.positive
                        : Theme.warning;
                    vertical-alignment: center;
                }
            }
            ProportionBar {
                slices: CurrencyState.slices;
                empty-note: @tr("No reserves. A basket without them holds nothing.");
            }
        }

        if CurrencyState.kind != "nft": VerticalLayout {
            spacing: Sp.s3;
            HorizontalLayout {
                height: 16px;
                Eyebrow {
                    text: @tr("STARTING SUPPLY");
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                Text {
                    text: CurrencyState.supply-total;
                    font-family: Typo.mono;
                    font-size: Typo.num-sm;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                }
            }
            ProportionBar {
                slices: CurrencyState.supply-slices;
                empty-note: @tr("Nothing allocated. The currency starts empty.");
            }
        }

        if CurrencyState.fee != "": VerticalLayout {
            spacing: Sp.s2;
            HorizontalLayout {
                Text {
                    text: @tr("Launch fee");
                    font-size: Typo.body;
                    font-weight: Typo.w-medium;
                    color: Theme.text-primary;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                Money {
                    amount: CurrencyState.fee;
                    currency: WalletState.ticker;
                    size: Typo.num;
                }
            }
            // The half that is burned is not a detail. The SDK's own capture
            // shows 205 in, 105 out and 100 unaccounted for, and the miner fee
            // is on top of all of it.
            Text {
                text: @tr("Half of this becomes the new currency's reserve deposit and half is burned. The miner fee is on top and is not included here.");
                font-size: Typo.caption;
                color: Theme.text-tertiary;
                wrap: word-wrap;
            }
        }

        // What the chain is about to be asked to do, from the core — how many
        // transactions there are and which cost money are its facts, not this
        // file's. Written as a list rather than drawn with `FlowStepper`,
        // because the breadcrumb at the top of this form is already a stepper
        // and two of those on one screen is a puzzle.
        if CurrencyState.steps.length > 0: Rectangle {
            background: Theme.bg-inset;
            border-radius: R.md;
            VerticalLayout {
                padding: Sp.s5;
                spacing: Sp.s3;
                Eyebrow {
                    // The one-step case reads "ONE TRANSACTION" rather than
                    // "1 STEPS", and `@tr`'s plural form is what lets a
                    // language with three of them say so too.
                    text: CurrencyState.steps.length == 1
                        ? @tr("WHAT HAPPENS NEXT · ONE TRANSACTION")
                        : @tr("WHAT HAPPENS NEXT · {n} STEP" | "WHAT HAPPENS NEXT · {n} STEPS"
                              % CurrencyState.steps.length);
                }
                for step[i] in CurrencyState.steps: HorizontalLayout {
                    spacing: Sp.s3;
                    Text {
                        text: i + 1;
                        font-family: Typo.mono;
                        font-size: Typo.num-sm;
                        color: Theme.text-tertiary;
                    }
                    Text {
                        text: step.label;
                        font-size: Typo.caption;
                        color: Theme.text-secondary;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }
                    if step.costs: Text {
                        text: @tr("costs a fee");
                        font-size: Typo.micro;
                        color: Theme.warning;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Rectangle {
            background: Theme.warning-soft;
            border-radius: R.md;
            VerticalLayout {
                padding: Sp.s5;
                spacing: Sp.s2;
                Text {
                    text: @tr("This cannot be undone or repeated");
                    font-size: Typo.body;
                    font-weight: Typo.w-medium;
                    color: Theme.warning;
                    wrap: word-wrap;
                }
                Text {
                    text: CurrencyState.claiming
                        ? @tr("The next press claims the name and pays for it. The launch itself is reviewed afterwards, once the name is on the chain.")
                        : @tr("The next press builds and signs the definition and shows the exact fee. Nothing is sent until that review is agreed to.");
                    font-size: Typo.caption;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
            }
        }

        if CurrencyState.problems.length > 0: VerticalLayout {
            spacing: Sp.s3;
            for problem in CurrencyState.problems: Rectangle {
                background: problem.blocking ? Theme.negative-soft : Theme.warning-soft;
                border-radius: R.md;
                VerticalLayout {
                    padding: Sp.s5;
                    Text {
                        text: problem.text;
                        font-size: Typo.caption;
                        color: problem.blocking ? Theme.negative : Theme.warning;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}

// The last moment before something irreversible.
//
// Its own layer over the screen rather than a section inside it, for the reason
// the send review and the identity change review are: this is not one heading
// among eight. Everything on it was read back off the transaction that was
// actually built and signed — the fee especially, which comes from chain policy
// and not from anything typed into the form.
export component LaunchReview inherits Rectangle {
    background: Theme.dark ? #0B0C0EE0 : #FBFBFCE0;
    TouchArea {}

    Card {
        elevated: true;
        width: 520px;
        height: content.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        content := VerticalLayout {
            padding: Sp.s8;
            spacing: Sp.s5;

            VerticalLayout {
                spacing: Sp.s2;
                Text {
                    text: @tr("Launch this currency");
                    font-size: Typo.title2;
                    font-weight: Typo.w-bold;
                    color: Theme.text-primary;
                }
                Text {
                    text: CurrencyState.launch-name;
                    font-family: Typo.mono;
                    font-size: Typo.num-sm;
                    color: Theme.text-secondary;
                }
            }

            Text {
                text: CurrencyState.launch-description;
                font-size: Typo.body;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }

            // Three figures, because one would understate it. The fee splits in
            // half and both halves are funded — only one comes back as an
            // output — and the miner fee is on top of both.
            VerticalLayout {
                spacing: Sp.s3;
                HorizontalLayout {
                    Text {
                        text: @tr("Launch fee");
                        font-size: Typo.body;
                        font-weight: Typo.w-medium;
                        color: Theme.text-primary;
                        horizontal-stretch: 1;
                    }
                    Money {
                        amount: CurrencyState.launch-fee;
                        currency: WalletState.ticker;
                        size: Typo.num;
                    }
                }
                HorizontalLayout {
                    Text {
                        text: @tr("of which, the currency's reserve deposit");
                        font-size: Typo.caption;
                        color: Theme.text-tertiary;
                        horizontal-stretch: 1;
                    }
                    Money {
                        amount: CurrencyState.launch-deposit;
                        currency: WalletState.ticker;
                        size: Typo.num-sm;
                        tone: "muted";
                        show-currency: false;
                    }
                }
                HorizontalLayout {
                    Text {
                        text: @tr("of which, burned");
                        font-size: Typo.caption;
                        color: Theme.text-tertiary;
                        horizontal-stretch: 1;
                    }
                    Money {
                        amount: CurrencyState.launch-burned;
                        currency: WalletState.ticker;
                        size: Typo.num-sm;
                        tone: "muted";
                        show-currency: false;
                    }
                }
                Text {
                    text: @tr("The miner fee is on top of this and is not included.");
                    font-size: Typo.caption;
                    color: Theme.text-tertiary;
                    wrap: word-wrap;
                }
            }

            // When it begins, which is not now. A currency exists from the
            // moment this transaction is mined and does nothing until its start
            // block — and somebody who is not told that reads the first quiet
            // hour as a failed launch.
            HorizontalLayout {
                Text {
                    text: @tr("Begins at block");
                    font-size: Typo.body;
                    font-weight: Typo.w-medium;
                    color: Theme.text-primary;
                    horizontal-stretch: 1;
                }
                Text {
                    text: CurrencyState.launch-start-block;
                    font-family: Typo.mono;
                    font-size: Typo.num;
                    color: Theme.text-primary;
                }
            }

            Rectangle {
                background: Theme.warning-soft;
                border-radius: R.md;
                VerticalLayout {
                    padding: Sp.s5;
                    spacing: Sp.s2;
                    Text {
                        text: @tr("This cannot be undone or repeated");
                        font-size: Typo.body;
                        font-weight: Typo.w-medium;
                        color: Theme.warning;
                        wrap: word-wrap;
                    }
                    Text {
                        text: @tr("An identity defines one currency, once. Every value in this definition is fixed at launch.");
                        font-size: Typo.caption;
                        color: Theme.text-secondary;
                        wrap: word-wrap;
                    }
                }
            }

            HorizontalLayout {
                spacing: Sp.s4;
                alignment: end;
                Btn {
                    text: @tr("Back");
                    variant: "ghost";
                    enabled: !CurrencyState.launch-busy;
                    clicked => { Actions.cancel-launch(CurrencyState.launch-ticket); }
                }
                Btn {
                    text: CurrencyState.launch-busy ? @tr("Sending…") : @tr("Launch it");
                    variant: "primary";
                    enabled: !CurrencyState.launch-busy;
                    clicked => { Actions.confirm-launch(CurrencyState.launch-ticket); }
                }
            }
        }
    }
}

// What the form costs and what it is waiting for, pinned below the scroller.
//
// # Why this is not inside the form
//
// Because the form is taller than the window and gets taller with every reserve
// somebody adds. Everything that decides whether to go ahead — the fee, what is
// still blocking, and the button itself — sat under the fold, while the thing
// that caused the blockage sat at the top. A basket with weights that do not add
// up showed an amber `70%` beside the bar and nothing else: the sentence
// explaining it, and the disabled button it explains, were both off screen.
//
// So it lives between the scrolling area and the status bar, as a real layout
// row rather than an overlay. That means no coordinate arithmetic against the
// nav rail's width, and nothing to keep in step when the window resizes.
// Choosing a reserve out of what the chain actually has.
//
// # Why an overlay rather than a dropdown under the row
//
// Because the list is long — 290 currencies on VRSCTEST — and it has to be
// searched. A menu that opens inside a scrolling form either clips at the card's
// edge or has to be positioned against coordinates the layout owns, and it has
// nowhere to put a search field. This is the shape the wallet already uses for
// "one decision, on top of everything": the transaction sheet, the identity
// sheet, both reviews.
//
// # Why the search runs in the core
//
// Slint cannot filter a model in a binding, so it could not be done here even if
// it should be. It should not: what counts as a match, and what ranks above
// what, is a rule — and `currency::choices` is where it is written down with a
// test against it.
export component ReservePicker inherits Rectangle {
    background: Theme.dark ? #0B0C0EE0 : #FBFBFCE0;

    // Swallows clicks aimed at the form behind, and closes on one that lands on
    // nothing — the same behaviour every other overlay in this file has.
    TouchArea {
        clicked => { root.dismiss(); }
    }

    function dismiss() {
        CurrencyState.picking-reserve = -1;
        CurrencyState.choices-query = "";
    }

    Card {
        elevated: true;
        width: 560px;
        height: 560px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        // Over the dismissing area below it, so a click inside the card does
        // not close it.
        TouchArea {}

        VerticalLayout {
            padding: Sp.s7;
            spacing: Sp.s5;

            VerticalLayout {
                spacing: Sp.s2;
                Text {
                    text: @tr("Choose a reserve");
                    font-size: Typo.title2;
                    font-weight: Typo.w-bold;
                    color: Theme.text-primary;
                }
                Text {
                    text: @tr("Every currency this chain knows about. What goes into the definition is the address, not the name — which is why this is a list rather than a field.");
                    font-size: Typo.caption;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
            }

            // The same reason the name fields debounce: a keystroke here is a
            // message to the core and a rebuild of the list model. Local work
            // rather than a request, so a shorter wait than the 350ms the chain
            // lookups use.
            narrowing := Timer {
                interval: 120ms;
                running: false;
                triggered => {
                    self.running = false;
                    Actions.search-currencies(CurrencyState.choices-query);
                }
            }

            query := Field {
                placeholder: @tr("Search by name or address");
                text <=> CurrencyState.choices-query;
                // Focused on open, so the list can be narrowed by typing
                // without reaching for the pointer first.
                init => { query.focus(); }
                edited => {
                    narrowing.running = false;
                    narrowing.running = true;
                }
            }

            if CurrencyState.choices-busy: Text {
                text: @tr("Asking the node for the chain's currency list. This is one large reply and it is only fetched once.");
                font-size: Typo.caption;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }

            if CurrencyState.choices-problem != "": Rectangle {
                background: Theme.negative-soft;
                border-radius: R.md;
                VerticalLayout {
                    padding: Sp.s5;
                    spacing: Sp.s3;
                    Text {
                        text: CurrencyState.choices-problem;
                        font-size: Typo.caption;
                        color: Theme.negative;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: start;
                        Btn {
                            text: @tr("Try again");
                            clicked => { Actions.search-currencies(CurrencyState.choices-query); }
                        }
                    }
                }
            }

            if !CurrencyState.choices-busy && CurrencyState.choices-problem == ""
                && CurrencyState.choices.length == 0: Text {
                text: CurrencyState.choices-query == ""
                    ? @tr("This chain lists no currencies that are not already reserves of this basket.")
                    : @tr("Nothing on this chain matches that.");
                font-size: Typo.caption;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }

            Flickable {
                vertical-stretch: 1;
                viewport-height: list.preferred-height;

                list := VerticalLayout {
                    spacing: Sp.s2;
                    alignment: start;

                    for row in CurrencyState.choices: Rectangle {
                        height: line.preferred-height;
                        border-radius: R.md;
                        background: hover.has-hover ? Theme.bg-hover : transparent;

                        line := HorizontalLayout {
                            padding: Sp.s4;
                            spacing: Sp.s4;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text {
                                    text: row.name;
                                    font-size: Typo.body;
                                    color: Theme.text-primary;
                                    overflow: elide;
                                }
                                Text {
                                    text: row.address;
                                    font-family: Typo.mono;
                                    font-size: Typo.micro;
                                    color: Theme.text-tertiary;
                                    overflow: elide;
                                }
                                // Only when there is something to say. A
                                // reserve that has not started yet is a reserve
                                // holding something that does not exist.
                                if row.note != "": Text {
                                    text: row.note;
                                    font-size: Typo.micro;
                                    color: Theme.warning;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                StatusPill {
                                    state: "online";
                                    text: row.kind;
                                }
                            }
                        }

                        hover := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                Actions.choose-reserve(
                                    CurrencyState.picking-reserve, row.name, row.address);
                                root.dismiss();
                            }
                        }

                        accessible-role: AccessibleRole.button;
                        accessible-label: @tr("{}, {}", row.name, row.kind)
                            + (row.note == "" ? "" : ", " + row.note);
                        accessible-action-default => {
                            Actions.choose-reserve(
                                CurrencyState.picking-reserve, row.name, row.address);
                            root.dismiss();
                        }
                    }
                }
            }

            // Said rather than hidden. A list that stopped at forty without
            // saying so reads as "that is all there is" while holding back the
            // currency somebody came here for.
            if CurrencyState.choices-more > 0: Text {
                text: @tr("{n} more match. Narrow the search to see them." | "{n} more match. Narrow the search to see them." % CurrencyState.choices-more);
                font-size: Typo.caption;
                color: Theme.text-tertiary;
                wrap: word-wrap;
            }

            HorizontalLayout {
                alignment: end;
                Btn {
                    text: @tr("Cancel");
                    variant: "ghost";
                    clicked => { root.dismiss(); }
                }
            }
        }
    }
}

// What a form costs and what it is waiting for, pinned below the scroller.
//
// # Why this is not inside the form
//
// Because both forms that use it are taller than the window and get taller as
// they are filled in. Everything that decides whether to go ahead — the fee,
// what is still blocking, and the button itself — sat under the fold, while the
// thing that caused the blockage sat at the top. A basket with weights that do
// not add up showed an amber `70%` beside the bar and nothing else: the
// sentence explaining it, and the disabled button it explains, were both off
// screen.
//
// So it lives between the scrolling area and the status bar, as a real layout
// row rather than an overlay. That means no coordinate arithmetic against the
// nav rail's width, and nothing to keep in step when the window resizes.
//
// It knows nothing about either screen. Both pass their own words in, which is
// what stopped the second one being a copy of the first.
export component ActionBar inherits Rectangle {
    // What the press will cost, in one line. Never empty: a bar that shows
    // buttons and no figure invites the press it exists to qualify.
    in property <string> cost;
    // Why the button is off, or what it will do when it is on.
    in property <string> note;
    // Whether that note is a refusal. Decides its colour, so a screen cannot
    // say "1 thing to fix" in the tone of an aside.
    in property <bool> note-bad: false;
    in property <string> back-text: @tr("Cancel");
    in property <string> primary-text;
    in property <bool> primary-enabled: true;
    callback back();
    callback primary();

    background: Theme.bg-surface;
    height: 68px;

    // A hairline, so the bar reads as pinned rather than as the last card
    // having drifted to the bottom of the page.
    Rectangle {
        height: 1px;
        y: 0;
        background: Theme.border-subtle;
    }

    HorizontalLayout {
        padding-left: Sp.screen-pad;
        padding-right: Sp.screen-pad;
        spacing: Sp.s5;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.cost;
                font-size: Typo.body;
                font-weight: Typo.w-medium;
                color: Theme.text-primary;
                overflow: elide;
            }
            Text {
                text: root.note;
                font-size: Typo.caption;
                color: root.note-bad ? Theme.negative : Theme.text-tertiary;
                overflow: elide;
            }
        }

        HorizontalLayout {
            alignment: end;
            spacing: Sp.s3;
            Btn {
                text: root.back-text;
                variant: "ghost";
                y: (parent.height - self.height) / 2;
                clicked => { root.back(); }
            }
            Btn {
                text: root.primary-text;
                variant: "primary";
                y: (parent.height - self.height) / 2;
                enabled: root.primary-enabled;
                clicked => { root.primary(); }
            }
        }
    }
}

export component CurrenciesScreen inherits VerticalLayout {
    spacing: Sp.s7;

    // Opening the form is three statements, and all three have to happen from
    // both places that offer it — the button in the corner and the one in the
    // middle of the empty state. A form reopened later must not resume halfway
    // through somebody else's answers, and least of all on a review.
    function open-form() {
        CurrencyState.form-step = "kind";
        CurrencyState.new-authority = "";
        CurrencyState.defining = true;
        Actions.check-currency();
    }

    // The list and everything about it steps aside while the form is open.
    //
    // It used to stay: the currencies, the heading, the count and the identity
    // list all sat above and below a form that was itself taller than the
    // window. Configuring one currency and reading about the others are not the
    // same task, and putting both on screen made the one being done the harder
    // of the two to find.
    if !CurrencyState.defining: HorizontalLayout {
        spacing: Sp.s5;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Sp.s2;
            Text {
                text: CurrencyState.rows.length == 0
                    ? @tr("No currencies yet")
                    : @tr("{n} currency your identities define"
                          | "{n} currencies your identities define" % CurrencyState.rows.length);
                font-size: Typo.caption;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }
        }
        Btn {
            text: CurrencyState.busy ? @tr("Reading…") : @tr("Refresh");
            enabled: !CurrencyState.busy;
            y: (parent.height - self.height) / 2;
            clicked => { Actions.refresh-currencies(); }
        }
        // Hidden when the list is empty, because the empty state carries the
        // same action in the middle of the card, where somebody reading the
        // explanation actually is. Two identical primary buttons on one screen
        // make a reader stop and work out which is which, and the answer is
        // that there is no difference.
        if !(CurrencyState.rows.length == 0 && !CurrencyState.busy): Btn {
            text: @tr("Define a currency");
            variant: "primary";
            y: (parent.height - self.height) / 2;
            clicked => { root.open-form(); }
        }
    }

    if !CurrencyState.defining: Card {
        VerticalLayout {
            padding: Sp.s3;

            // The action belongs in the empty state, not only in the corner.
            //
            // This is the one screen state whose entire content is "there is
            // nothing here" — and the thing to do about it was a button at the
            // far top right, past the heading, in the place the eye goes last.
            // An empty state that explains a feature and does not offer it is a
            // leaflet.
            if CurrencyState.rows.length == 0 && !CurrencyState.busy: Rectangle {
                height: 200px;
                EmptyState {
                    glyph: "⊙";
                    title: @tr("None of your identities defines a currency");
                    body: @tr("A currency in Verus is a name you already own, wearing a second hat — its address is the identity's. Defining one is permanent, and an identity can do it once.");
                    action-text: @tr("Define a currency");
                    action => { root.open-form(); }
                }
            }

            for row in CurrencyState.rows: ListRow {
                glyph: "⊙";
                glyph-tone: Theme.accent;
                title: row.name;
                subtitle: row.address;
                subtitle-mono: true;
                interactive: true;
                clicked => { Actions.open-currency(row.address); }

                HorizontalLayout {
                    spacing: Sp.s5;
                    alignment: end;

                    // Fixed, so the pills line up down the column rather than
                    // following the note beside them — the same reason the
                    // identity list fixes this width.
                    VerticalLayout {
                        width: 300px;
                        alignment: center;
                        spacing: 2px;
                        HorizontalLayout {
                            alignment: end;
                            spacing: Sp.s3;
                            // Said in words, not by the pill's colour alone.
                            // Whether the supply can still grow is a different
                            // promise to whoever holds it, and it is permanent.
                            if row.mintable: Text {
                                text: @tr("mintable");
                                font-size: Typo.micro;
                                color: Theme.warning;
                                vertical-alignment: center;
                            }
                            StatusPill {
                                state: row.tone;
                                text: row.kind;
                            }
                        }
                        // A launch is not instant. Between the definition being
                        // mined and the start block the currency exists and
                        // does nothing — and a row that omitted this showed it
                        // exactly as it shows one that has been running for a
                        // month. Said only while it is true.
                        if !row.started: Text {
                            text: @tr("Starts at block {}", row.start-block);
                            font-size: Typo.caption;
                            color: Theme.warning;
                            horizontal-alignment: right;
                        }
                        if row.note != "": Text {
                            text: row.note;
                            font-size: Typo.caption;
                            color: Theme.text-tertiary;
                            horizontal-alignment: right;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }

    // An unfinished currency, said before anything else on this screen.
    //
    // It has already cost something — a name claim, or an identity that is
    // registered and paid for — and the second of those can never be spent on a
    // different currency. That is not a thing to leave a person to discover.
    if CurrencyState.pending-identity != "" && !CurrencyState.defining: VerticalLayout {
        spacing: Sp.s4;
        Eyebrow { text: @tr("UNFINISHED"); }
        Card {
            VerticalLayout {
                padding: Sp.card-pad;
                spacing: Sp.s4;
                Text {
                    text: CurrencyState.pending-identity;
                    font-family: Typo.mono;
                    font-size: Typo.title3;
                    color: Theme.text-primary;
                }
                Text {
                    text: CurrencyState.pending-note;
                    font-size: Typo.body;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                // The same diagram the form drew as a plan, now saying which of
                // those steps have actually happened — and which of the ones
                // that have were paid for.
                FlowStepper { steps: CurrencyState.pending-steps; }
                HorizontalLayout {
                    spacing: Sp.s3;
                    alignment: end;
                    Btn {
                        text: @tr("Abandon");
                        variant: "ghost";
                        clicked => { Actions.abandon-launch(); }
                    }
                    if CurrencyState.pending-can-continue: Btn {
                        text: @tr("Define the currency");
                        variant: "primary";
                        clicked => { Actions.resume-launch(); }
                    }
                }
            }
        }
    }

    // Configuring one. The form is the screen while it is open.
    if CurrencyState.defining: VerticalLayout {
        spacing: Sp.s4;
        Eyebrow { text: @tr("DEFINE A CURRENCY"); }
        // Capped, not stretched. A question at a time does not need a second
        // column beside it, and a line of body text running the full width of a
        // 1400px window is a line nobody finishes.
        //
        // A fixed width rather than a maximum: `max-width` here is negotiated
        // against the shared `Flickable`'s viewport, and the viewport's width is
        // derived from this content's minimum — a loop Slint refuses to compile.
        // A constant depends on nothing, so there is no loop to close, and 780px
        // is inside the 880px minimum window this wallet declares.
        HorizontalLayout {
            Card {
                width: 780px;
                VerticalLayout {
                    padding: Sp.card-pad;
                    spacing: Sp.s6;

                    CurrencyForm {}

                    // The buttons are NOT here. They live in the pinned
                    // `ActionBar`, outside the scroller — see that component.
                    // What stays is the padding it would otherwise sit on top of.
                    Rectangle { height: Sp.s8; }
                }
            }
            // Takes the rest, so the card stays at the left edge rather than
            // being centred by a layout that has one child.
            Rectangle { horizontal-stretch: 1; }
        }
    }

    // The other half. Every identity, with whether it may still be used —
    // including the ones that may not, and why.
    if CurrencyState.eligible.length > 0 && !CurrencyState.defining: VerticalLayout {
        spacing: Sp.s4;
        Eyebrow { text: @tr("YOUR IDENTITIES"); }
        Card {
            VerticalLayout {
                padding: Sp.s3;
                for entry in CurrencyState.eligible: ListRow {
                    glyph: "◇";
                    glyph-tone: entry.refusal == "" ? Theme.positive : Theme.text-tertiary;
                    title: entry.name;
                    subtitle: entry.address;
                    subtitle-mono: true;
                    interactive: false;

                    HorizontalLayout {
                        spacing: Sp.s5;
                        alignment: end;
                        VerticalLayout {
                            width: 420px;
                            alignment: center;
                            Text {
                                text: entry.refusal == ""
                                    ? @tr("Free to define a currency")
                                    : entry.refusal;
                                font-size: Typo.caption;
                                color: entry.refusal == ""
                                    ? Theme.text-secondary
                                    : Theme.text-tertiary;
                                horizontal-alignment: right;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }

    Rectangle { vertical-stretch: 1; }
}
