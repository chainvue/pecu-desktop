// The dashboard, and the panels it is made of.

import { Motion, R, Sp, Theme, Typo } from "../theme/theme.slint";
import { Btn, Card, EmptyState, Eyebrow, ListRow, Money, Skeleton, StatusPill } from "../components/base.slint";
import { NoteText } from "../components/note.slint";
import { Actions, ChartState, ConvertState, HaltState, MarketState, SeedState, SendState, WalletState } from "../vm/state.slint";

// The screen shown whenever there is no unlocked wallet.
// A payment we could not confirm reached the network.
//
// Given the top of the dashboard because it is the one thing in this wallet
// that is genuinely unresolved, and because the wrong move — sending again —
// is the tempting one.
export component PendingPayments inherits VerticalLayout {
    spacing: Sp.s4;
    Eyebrow { text: @tr("UNCONFIRMED"); }

    Card {
        VerticalLayout {
            padding: Sp.card-pad;
            spacing: Sp.s5;

            for row in SendState.pending-rows: VerticalLayout {
                // Whether "Stop tracking" has been pressed once.
                //
                // Two presses, because abandoning is not merely forgetting. The
                // stored bytes go with the record, and those bytes are the only
                // safe way to finish this payment — resending them cannot pay
                // twice, and rebuilding is forbidden precisely because it can.
                // So this discards the one recovery there is, from a ghost
                // button, in one click, with nothing asked.
                //
                // A second press rather than a dialog: the weight is real but
                // it is not a revocation, and a modal over the dashboard for
                // every abandoned record would be its own problem.
                property <bool> confirming: false;

                spacing: Sp.s4;

                HorizontalLayout {
                    spacing: Sp.s5;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text {
                            text: row.state == "absent"
                                ? @tr("This payment has not appeared on the network")
                                : @tr("We could not confirm this payment was sent");
                            font-size: Typo.body;
                            font-weight: Typo.w-medium;
                            color: Theme.warning;
                            wrap: word-wrap;
                        }
                        Text {
                            text: row.state == "absent"
                                ? @tr("Asked {} times and the node has never seen it. Sending the same transaction again is safe — it is the same bytes, so it cannot pay twice.", row.checks)
                                : @tr("It may already be on its way. Do not send it again yet — that could send the money twice. Pecu is checking.");
                            font-size: Typo.caption;
                            color: Theme.text-secondary;
                            wrap: word-wrap;
                        }
                    }
                    Money {
                        amount: row.amount;
                        currency: WalletState.ticker;
                        y: (parent.height - self.height) / 2;
                    }
                }

                Text {
                    text: row.txid;
                    font-family: Typo.mono;
                    font-size: Typo.num-sm;
                    color: Theme.text-tertiary;
                    wrap: char-wrap;
                }

                HorizontalLayout {
                    spacing: Sp.s4;
                    Btn {
                        text: @tr("Check now");
                        clicked => { Actions.resolve-pending(row.id, "check"); }
                    }
                    // Only once the node has been asked repeatedly and never
                    // seen it. Offering this earlier would be offering the one
                    // action that can pay twice.
                    if row.state == "absent": Btn {
                        text: @tr("Send the same transaction again");
                        variant: "primary";
                        clicked => { Actions.resolve-pending(row.id, "resend"); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if !confirming: Btn {
                        text: @tr("Stop tracking");
                        variant: "ghost";
                        clicked => { confirming = true; }
                    }
                    if confirming: Btn {
                        text: @tr("Keep it");
                        variant: "ghost";
                        clicked => { confirming = false; }
                    }
                    if confirming: Btn {
                        text: @tr("Discard the record");
                        variant: "destructive";
                        clicked => {
                            confirming = false;
                            Actions.resolve-pending(row.id, "abandon");
                        }
                    }
                }

                if confirming: Text {
                    text: @tr("Pecu will stop asking about this payment and will drop the signed transaction it kept. If it never reached the network, there is then no way to send it that is guaranteed not to pay twice.");
                    font-size: Typo.caption;
                    color: Theme.warning;
                    wrap: word-wrap;
                }
            }
        }
    }
}

// The plotted area: two paths, a wipe, and a crosshair.
//
// Its own component because the draw-in needs a clip rectangle wrapping a
// holder pinned at full size, and because the touch area has to be able to
// address the paths — neither survives being written inline.
export component ChartPlot inherits Rectangle {
    // Slint has no stroke-dasharray and no path-length animation, so the
    // draw-in is a **clip wipe**: an outer rectangle whose width animates from
    // nothing to full, containing a holder that is always the full size. The
    // paths never move; what moves is how much of them is visible. Zero
    // per-frame path work, and it works identically for the gradient.
    in-out property <float> progress: 0;

    // Runs once when the data arrives. Reversing it on every re-plot would
    // mean the chart redrew itself every fifteen seconds when the tip poll
    // finds a new block, which is a wallet fidgeting at you.
    states [
        drawn when ChartState.has-data: {
            progress: 1;
            in {
                animate progress {
                    duration: Motion.draw;
                    easing: cubic-bezier(0.22, 1, 0.36, 1);
                    enabled: Motion.enabled;
                }
            }
        }
    ]

    // The fill first, so the stroke is never drawn under it.
    Rectangle {
        width: parent.width * root.progress;
        clip: true;

        Rectangle {
            width: root.width;
            height: root.height;

            Path {
                commands: ChartState.area-at(root.width, root.height);
                // Faded to nothing at the baseline. The stroke has to stay
                // readable against the fill directly beneath it, so the fill
                // never gets close to the stroke's own weight.
                // Faded to nothing well before the baseline. A fill still
                // visible at the bottom reads as a filled shape rather than as
                // depth under a line, and it competes with the stroke it is
                // supposed to sit beneath.
                //
                // The top stop is chosen to look right **without** the fade as
                // well: the software renderer — which is what draws the
                // reference images, and what would draw the wallet on a machine
                // with no working GPU path — fills a `Path` with the first stop
                // and ignores the rest. A gradient whose top end is too strong
                // to stand on its own would then look correct in review and
                // wrong on somebody's laptop.
                fill: @linear-gradient(180deg,
                    Theme.chart-line.with-alpha(0.16) 0%,
                    Theme.chart-line.with-alpha(0.05) 60%,
                    Theme.chart-line.with-alpha(0.0) 100%);
            }

            Path {
                commands: ChartState.line-at(root.width, root.height);
                stroke: Theme.chart-line;
                stroke-width: 2px;
            }
        }
    }

    // Where the line ends — which is now. The one point on the chart that is
    // still moving, and the anchor the wipe appears to be drawn by.
    if ChartState.hover < 0: Rectangle {
        x: ChartState.end-x-at(root.width, root.height) - 4px;
        y: ChartState.end-y-at(root.width, root.height) - 4px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: Theme.chart-line;
        opacity: root.progress;
    }

    // The crosshair. Only while a pointer is actually over the chart.
    if ChartState.hover >= 0: Rectangle {
        x: ChartState.hover-x;
        width: 1px;
        y: 0;
        height: root.height;
        background: Theme.chart-grid.with-alpha(0.14);
    }

    if ChartState.hover >= 0: Rectangle {
        x: ChartState.hover-x - 5px;
        y: ChartState.hover-y - 5px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: Theme.chart-line;
        border-width: 2px;
        border-color: Theme.bg-surface;
        // Gliding between samples rather than teleporting is most of the
        // difference between this and a chart library.
        animate x { duration: 90ms; easing: ease-out; enabled: Motion.enabled; }
        animate y { duration: 90ms; easing: ease-out; enabled: Motion.enabled; }
    }

    touch := TouchArea {
        // `mouse-x` updates on hover; `moved()` only fires while pressed, so
        // this is a binding rather than a callback.
        changed mouse-x => {
            if (touch.has-hover) { ChartState.hovered(touch.mouse-x); }
        }
        changed has-hover => {
            if (!touch.has-hover) { ChartState.left(); }
        }
    }
}

// The balance over time, with its range control and its own empty state.
export component BalanceChart inherits VerticalLayout {
    // Settable, because the same chart is asked for at two sizes: it is the
    // subject of its own card on a screen dedicated to it, and a sparkline
    // under the balance on the dashboard. 200px of chart above three columns
    // pushed all three below the fold.
    in property <length> plot-height: 200px;

    spacing: Sp.s4;

    Rectangle {
        height: root.plot-height;

        ChartPlot {
            width: parent.width;
            height: parent.height;
        }
    }

    if ChartState.has-data: HorizontalLayout {
        spacing: Sp.s5;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            // While hovering, the header reads the value AT THE CURSOR. The
            // change figure keeps describing the window, which is what makes
            // the two useful together.
            Text {
                text: ChartState.hover >= 0
                    ? @tr("{} {}", ChartState.hover-amount, ChartState.ticker)
                    : ChartState.change;
                font-family: Typo.mono;
                font-size: Typo.num-sm;
                color: ChartState.hover >= 0 ? Theme.text-primary
                    : ChartState.change-tone == "positive" ? Theme.positive
                    : ChartState.change-tone == "negative" ? Theme.negative
                    : Theme.text-secondary;
            }
            Text {
                text: ChartState.hover >= 0 ? ChartState.hover-when : ChartState.caption;
                font-size: Typo.caption;
                color: Theme.text-tertiary;
                overflow: elide;
            }
        }

        // What period this is a picture of. The chart has no gridlines and no
        // tick labels, so this is the only thing that says so — a question the
        // range buttons used to answer by implication, and which nothing
        // answered once they were gone.
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: ChartState.span-from == "" ? "" : @tr("{} → now", ChartState.span-from);
                font-size: Typo.caption;
                color: Theme.text-tertiary;
                horizontal-alignment: right;
            }
            // And what the plot's floor and ceiling are worth — the other axis,
            // which had no label at all.
            if ChartState.span-range != "": Text {
                text: ChartState.span-range;
                font-family: Typo.mono;
                font-size: Typo.micro;
                color: Theme.text-disabled;
                horizontal-alignment: right;
            }
        }
    }
}

// What this wallet holds.
export component AssetsPanel inherits Card {
    // Which currency to convert, by i-address. Asked of the screen, because
    // going to Convert belongs to the window and this panel knows only that a
    // row was pressed and which currency it was about.
    callback convert(string);

    VerticalLayout {
        padding: Sp.s3;

        if WalletState.assets.length == 0 && !WalletState.loading: Rectangle {
            height: 108px;
            EmptyState {
                glyph: "◇";
                title: @tr("No assets yet");
                body: @tr("Receive to get started.");
            }
        }

        if WalletState.loading: Rectangle {
            height: 64px;
            HorizontalLayout {
                padding: Sp.s5;
                spacing: Sp.s5;
                Skeleton { width: 34px; height: 34px; radius: R.full; }
                VerticalLayout {
                    alignment: center;
                    spacing: Sp.s2;
                    Skeleton { width: 120px; height: 13px; }
                    Skeleton { width: 72px; height: 11px; }
                }
            }
        }

        for asset in WalletState.assets: ListRow {
            glyph: asset.native ? "◆" : "◇";
            glyph-tone: asset.native ? Theme.accent : Theme.text-secondary;
            title: asset.name;
            // A token row puts its i-address here, because that is the part of
            // it that cannot lie. The chain's own row has no such need — a
            // chain does not want its id printed under its own name — and so
            // that line sat empty on the one row whose figure is a total.
            //
            // # Why the row says what it counts
            //
            // This figure and the headline at the top of the same screen are
            // no longer the same number: the headline is spendable and
            // maturing, and this is those plus the shielded pool. Two totals
            // on one screen that differ, with nothing saying why, is a worse
            // bug than the omission that produced them — so the row states its
            // own composition, the way the headline's columns each state
            // theirs.
            //
            // Two wordings rather than a caption plus a footnote, because
            // whether the pool is in there is a fact about *this* figure. An
            // account nobody has scanned is not a zero, so the row does not
            // add one and does not claim to have: `counts-shielded` is set
            // from the same value the amount was built from, one line apart in
            // `Reading::portfolio`, and the two cannot disagree.
            //
            // A formula rather than a sentence, and deliberately. This column
            // is the narrowest of the three and shares a row with a monospace
            // amount; "spendable, maturing and your shielded balance" wraps or
            // elides, and an elided caption about what a number contains is
            // worse than none. The words are the ones the headline's own
            // columns already use.
            subtitle: asset.native
                ? (asset.counts-shielded
                    ? @tr("spendable + maturing + shielded")
                    : @tr("spendable + maturing"))
                : asset.secondary;
            // A token row is the way to Convert; the chain's own row is not.
            // Converting coin is something Convert will happily do, but the
            // native row is here to say what is held, and a wallet whose every
            // balance is also a button has stopped distinguishing the two.
            interactive: !asset.native;
            // Overriding the inherited name rather than accepting it: "{title},
            // {subtitle}" says everything except the one thing a screen reader
            // needs, which is what pressing does. The i-address stays in it.
            // Thirty-four characters is punishing to hear, and it is the only
            // part of a token row that cannot lie — dropping it would announce
            // two holdings whose names collide as the same button, which is the
            // substitution the sighted row refuses to make.
            accessible-label: asset.native
                ? asset.name
                : @tr("Convert {}, {}", asset.name, asset.secondary);
            clicked => { root.convert(asset.currency-id); }

            // # Why there is no convert mark on this row
            //
            // There was one, in a gutter reserved on every row so the amounts
            // would still line up. It was re-recorded and looked at, and the
            // gutter cost 27px of a column that has none to spare: this card
            // is one of three sharing the window by what each would prefer, so
            // it widened Assets, elided `iBoaN7sw…stcfgGMh` on the row the
            // mark sat on — the part of a token row that cannot lie — and
            // pushed `Bridge.vETH` in Markets down to `Bridge.v…`. A 15px
            // arrow bought with two truncated identifiers is a bad trade.
            //
            // What says the row is pressable is the sentence under the list,
            // which is words rather than a glyph and costs nothing. Every one
            // of its three wordings names Convert, including the one for a
            // chain that is refusing conversions: a caption that fell silent
            // about where the row goes would leave a pressable row with
            // nothing at all marking it, in exactly the state somebody is most
            // likely to go looking.

            // Right-aligned, so a column of amounts lines up on the decimal
            // point rather than floating in the middle of the row. With the
            // monospace family that is what makes two balances comparable.
            //
            // # Two lines rather than two columns
            //
            // The value goes under the amount, not beside it. Beside it was
            // tried and is not affordable: this card is the narrowest of the
            // three, a second figure on the row costs more than the 27px
            // convert gutter that was removed for eliding `iBoaN7sw…stcfgGMh`,
            // and the i-address is the part of a token row that cannot lie.
            // Stacked, the pair is as wide as the wider of the two — which is
            // the amount, every time, because it carries eight decimal places
            // and the value carries two.
            //
            // It costs no height either. `ListRow` is 64px whatever is in it,
            // and the left column already runs to two lines, so the second
            // figure lands beside the caption that explains the first.
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                HorizontalLayout {
                    alignment: end;
                    Money {
                        amount: asset.amount;
                        show-currency: false;
                        size: Typo.num;
                    }
                }
                // What it is worth. Through `Money` rather than a bare `Text`,
                // for the accessible label: the figure is drawn without its
                // unit, which works on screen because the column heading names
                // it once, and does not work at all read aloud — "six thousand
                // seven hundred and five" is not an answer to "what is this
                // worth" without a currency after it.
                //
                // `muted` is the tone for a figure that is on screen to be
                // *compared* rather than acted on, which is what this is: it is
                // derived from reserve state, rounded to something a narrow
                // column can hold, and nothing sends it.
                HorizontalLayout {
                    alignment: end;
                    Money {
                        amount: asset.value;
                        currency: MarketState.quote;
                        show-currency: false;
                        size: Typo.num-sm;
                        tone: "muted";
                    }
                }
            }
        }

        // What the row is a shortcut to, and why it is the only route.
        //
        // Under the rows rather than on one of them: it is true of every token
        // in the list, and repeated per row it would be three copies of one
        // sentence. Silent on a wallet holding only coin, where it would be a
        // warning about money nobody has.
        //
        // # Why this is a `Rectangle` with its height written out
        //
        // A wrapping `Text` is measured twice and the two answers disagree.
        // Slint asks a layout cell how tall it wants to be **before** any
        // width has been solved, and the width it measures against is the
        // cell's *preferred* width; then it draws the text at the width the
        // solved layout actually handed over. Both earlier shapes got caught
        // by that from opposite sides. In a `HorizontalLayout` the sentence
        // was measured unwrapped, asked for one line's height, and the picture
        // came back with everything after the first line cut off below the
        // card. In a `VerticalLayout` with `preferred-width: 0px` — which the
        // caption needs, or its unwrapped width decides how wide this column
        // is and Markets loses a third of itself — it was measured against
        // nought and asked for the height of a sentence wrapped one word per
        // line: 105px of empty card under two drawn lines, and the ASSETS card
        // stopped hugging its rows.
        //
        // A `Rectangle` is not a layout, so it contributes exactly the height
        // written here and nothing about the sentence is inferred. The width
        // is read off the cell the card handed over rather than asked for,
        // which is the direction that cannot feed back into the column split,
        // and the `Text` inside — sized by its own content rather than by a
        // cell — wraps to that width and is the height it actually drew. Same
        // move as the `Rectangle { height: 108px }` empty state above.
        //
        // The inset is not decoration either: the rows carry the list's own
        // padding rather than the card's, so without it the sentence starts to
        // the left of every name it is about.
        if WalletState.holds-tokens: Rectangle {
            height: caption.height + Sp.s3 * 2;

            caption := Text {
                x: Sp.s5;
                y: Sp.s3;
                width: parent.width - Sp.s5 * 2;

                // Three wordings, because there are three states and only one
                // of them is "conversions work". `HaltState.conversions-halted`
                // alone does not separate them: `upgrade::Status::unknown` sets
                // it false because the field has to be something, and the note
                // on it says never to collapse that into clear.
                text: HaltState.conversions-halted
                    // Present tense, no date. `disabledefi` has stood on this
                    // chain since block 1 187 000 and on mainnet since July, so
                    // "until they are back" would be a promise nobody made.
                    ? @tr("Only {} can be sent, and this chain has conversions switched off — so a token cannot be moved at all. Its row opens Convert, which says the same thing.", WalletState.ticker)
                    // Nothing read yet, or the read failed. The dashboard is
                    // the first screen after unlock and the portfolio can
                    // arrive before the halt does, so this is a state a wallet
                    // passes through rather than an exotic one — and on this
                    // chain the instruction it would otherwise print is false.
                    : HaltState.severity == "" || HaltState.severity == "unknown"
                    ? @tr("Only {} can be sent. A token leaves this wallet only by conversion, and this wallet does not know whether this chain is taking them. Its row opens Convert, which will say.", WalletState.ticker)
                    // "Leaves this wallet only by conversion" rather than "open
                    // its row to convert it": a row is given to every non-zero
                    // token holding, while a conversion needs a started pool
                    // trading both legs, so a currency that is nobody's reserve
                    // has a row and no route. The row still goes to Convert,
                    // which is the screen that answers that per pair.
                    : @tr("Only {} can be sent. A token leaves this wallet only by conversion — its row opens Convert, which says whether this one has a route.", WalletState.ticker);
                font-size: Typo.micro;
                color: Theme.text-tertiary;
                wrap: word-wrap;
            }
        }

        // …and what the list's silence means when there is no token in it.
        //
        // Two wallets reach this card with the same rows: one holding only the
        // chain's own coin, and one whose read could not reach an address and
        // therefore counted no tokens anywhere. The first is complete and needs
        // no sentence — a wallet holding coin is not missing anything, and
        // "you hold no tokens" under a list that shows none is the card reading
        // itself out. The second is an absence of a list rather than a list of
        // nothing, and it said so nowhere: `tokens-unknown` was computed in the
        // core, crossed nothing, and reached no screen.
        //
        // So the sentence appears in exactly one of the two, and the silence in
        // the other now means something because its opposite speaks.
        //
        // # Why it is not drawn over a list that does have tokens
        //
        // The same failure can leave some rows standing — a second address
        // answered — and those rows are true. What is missing there is unknown
        // in the same way, and the caption above it already occupies this slot
        // with a different subject; two stacked captions under three rows is a
        // paragraph. The figures at the top of the screen carry NOT UP TO DATE
        // from the same read, which is the part that is about them.
        //
        // `Rectangle` with its height written out, and the inset, for the
        // reasons argued at length above the caption it sits under.
        if !WalletState.holds-tokens && WalletState.tokens-unknown: Rectangle {
            height: uncounted.height + Sp.s3 * 2;

            // Through the note table rather than as a literal here, unlike its
            // neighbour. That caption picks between three wordings on interface
            // state and interpolates the ticker, so it belongs to the screen;
            // this is one fixed sentence for one state the core named, which is
            // what that file holds. Nothing else renders this code, so the
            // note is built here — `app.slint` does the same for the sentences
            // under the action bar.
            uncounted := NoteText {
                x: Sp.s5;
                y: Sp.s3;
                width: parent.width - Sp.s5 * 2;

                note: { code: "assets-tokens-unknown" };
                // Matching the caption beside it rather than `NoteText`'s own
                // default: this is the same kind of line in the same column,
                // and a second size would read as a second kind of remark.
                font-size: Typo.micro;
                color: Theme.text-tertiary;
            }
        }
    }
}

// What things are worth. The same rows the markets screen shows, which is why
// there is no second source for them to disagree with.
export component MarketsPanel inherits Card {
    VerticalLayout {
        padding: Sp.s3;

        if MarketState.rows.length == 0: Rectangle {
            height: 108px;
            EmptyState {
                glyph: "⊙";
                title: @tr("No prices yet");
                body: @tr("Prices appear once a converter has been read.");
            }
        }

        // Four, not all of them. VRSCTEST prices around fifty currencies and a
        // dashboard column is not a table — the rows arrive priced-first, so
        // this is the part of the list that says something.
        //
        // Four rather than six because this column sits beside two others and
        // has no scroll of its own: six ran the card off the bottom of the
        // window at the size every reference image is taken at.
        //
        // No glyph. Every row would carry the same one, which is decoration
        // rather than information — and it is 46px of a column narrow enough
        // that it was truncating the names instead.
        //
        // The wrapper is not decoration. Slint's `for` body must be an element,
        // so `for … : if …` does not parse; a layout that holds the row or
        // holds nothing is how a repeater gets a conditional, and an empty one
        // contributes no height as long as it is told not to stretch.
        for row[index] in MarketState.rows: VerticalLayout {
            vertical-stretch: 0;

            if index < 4: ListRow {
                title: row.name;
                subtitle: row.price;
                interactive: false;

                HorizontalLayout {
                    alignment: end;
                    Text {
                        text: row.change;
                        font-family: Typo.mono;
                        font-size: Typo.num-sm;
                        // Carried, not read off the sign — `—` has none.
                        color: row.tone == "positive" ? Theme.positive
                            : row.tone == "negative" ? Theme.negative
                            : Theme.text-tertiary;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// What has happened.
export component ActivityPanel inherits Card {
    VerticalLayout {
        padding: Sp.s3;

        if WalletState.activity.length == 0 && !WalletState.loading: Rectangle {
            height: 108px;
            EmptyState {
                glyph: "○";
                title: @tr("No transactions yet");
                body: @tr("Activity appears here once this wallet has been paid.");
            }
        }

        for tx in WalletState.activity: ListRow {
            glyph: tx.direction == "in" ? "↓" : tx.direction == "out" ? "↑" : "↔";
            glyph-tone: tx.direction == "in" ? Theme.positive
                : tx.direction == "out" ? Theme.negative
                : Theme.text-secondary;
            title: tx.direction == "in" ? @tr("Received")
                : tx.direction == "out" ? @tr("Sent")
                : @tr("Moved");
            subtitle-note: tx.when;
            interactive: true;

            HorizontalLayout {
                spacing: Sp.s4;
                alignment: end;

                // The pill goes BEFORE the amount, so a pending row does not
                // push its figure out of the column every other row lines up
                // in. Alignment is what makes a list of amounts readable; the
                // pill can move.
                if tx.pending: StatusPill {
                    state: "pending";
                    text: @tr("Pending");
                    y: (parent.height - self.height) / 2;
                }

                Money {
                    amount: tx.amount;
                    show-currency: false;
                    size: Typo.num-sm;
                    tone: tx.direction == "in" ? "positive"
                        : tx.direction == "out" ? "negative"
                        : "neutral";
                    y: (parent.height - self.height) / 2;
                }
            }
        }
    }
}

export component DashboardScreen inherits VerticalLayout {
    // Asked of the window, because `go` belongs to the window: this screen
    // knows it wants Send, not how the shell gets there.
    callback navigate(string);

    spacing: Sp.section-gap;

    if SendState.pending-rows.length > 0: PendingPayments {}

    // A wallet whose phrase has never been written down is one disk failure
    // from being gone. That is worth the top of the screen, and worth staying
    // there — it disappears when the backup is confirmed, not when dismissed.
    if WalletState.backup-key != "": Card {
        VerticalLayout {
            padding: Sp.card-pad;

            HorizontalLayout {
                spacing: Sp.s5;

                Rectangle {
                    width: 34px;
                    height: 34px;
                    y: (parent.height - self.height) / 2;
                    border-radius: R.full;
                    background: Theme.warning-soft;
                    Text {
                        // A warning glyph, not a word.
                        text: "!";
                        font-size: 15px;
                        font-weight: Typo.w-bold;
                        color: Theme.warning;
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: @tr("Your recovery phrase is not written down");
                        font-size: Typo.body;
                        font-weight: Typo.w-medium;
                        color: Theme.text-primary;
                    }
                    Text {
                        text: @tr("Without it, nothing can restore this wallet — not us, not anyone.");
                        font-size: Typo.caption;
                        color: Theme.text-secondary;
                    }
                }

                Btn {
                    text: @tr("Back up now");
                    variant: "primary";
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        SeedState.problem = { code: "", args: [] };
                        // The key the wallet is nagging about. The screen is
                        // told which one; the banner is the one place where the
                        // wallet, not the person, picks it.
                        SeedState.label = WalletState.backup-key;
                        SeedState.re-reading = false;
                        SeedState.step = "passphrase";
                    }
                }
            }
        }
    }

    // The hero.
    //
    // Total first, because that is the number people quote — with the breakdown
    // directly beneath it, because a Verus balance is genuinely several numbers
    // and a wallet that shows one cannot explain "you have 500 but can spend
    // 20". The design has no equivalent of that row and it is kept anyway: it
    // is the difference between a figure and a spendable figure.
    //
    // The three actions sit in the card rather than under it, which is the
    // design's arrangement and the one that stops them competing with the
    // section headings below.
    Card {
        VerticalLayout {
            padding: Sp.card-pad;
            spacing: Sp.s5;

            HorizontalLayout {
                spacing: Sp.s7;

                VerticalLayout {
                    spacing: Sp.s4;
                    horizontal-stretch: 1;

                    HorizontalLayout {
                        spacing: Sp.s4;
                        alignment: start;
                        Eyebrow { text: @tr("TOTAL BALANCE"); }
                        // "These numbers were true, just not now" — a different
                        // statement from "loading", and the one worth making
                        // when a read fails against figures already on screen.
                        if WalletState.stale: Eyebrow {
                            text: @tr("· NOT UP TO DATE");
                            color: Theme.warning;
                        }
                    }

                    if WalletState.loading: Skeleton {
                        width: 320px;
                        height: 48px;
                    }

                    if !WalletState.loading: Money {
                        amount: WalletState.total;
                        currency: WalletState.ticker;
                        size: Typo.hero;
                        mono: false;
                    }

                    // The parts of the total, as separate figures rather than
                    // one sentence.
                    //
                    // This was a single dot-separated run at caption size:
                    // three long monospace numbers, three meanings, one line.
                    // Nobody parses that — and the one that decides whether a
                    // payment can be made at all, spendable, was the least
                    // prominent number on a screen headed by a total that
                    // includes money nobody can spend.
                    // The shielded pool, on its own row.
                    //
                    // It was inside the breakdown below, and that was wrong
                    // twice. The breakdown appears only when something is
                    // maturing or in flight — so a private balance vanished
                    // because none of the *public* coins were immature, which
                    // is not a relationship. And it is not a part of the total
                    // above the way spendable and maturing are: it is a second
                    // pool, the same coin with different visibility.
                    //
                    // Shown only when there is something in it. `shielded-any`
                    // rather than a string test, because a zero here would be
                    // the wallet stating that none of your coins are private,
                    // in the weight of a fact — and that is not what having
                    // nothing shielded means.
                    // A scan under way, before there is anything to report.
                    //
                    // Its own line rather than a spinner beside the balance: at
                    // this point there is no balance, and the honest thing to
                    // show is what the wallet is doing about that.
                    if WalletState.shielded-scanning && !WalletState.shielded-any: Text {
                        text: @tr("Looking for shielded funds… {}%", WalletState.shielded-scan-percent);
                        font-size: Typo.caption;
                        color: Theme.accent;
                    }

                    if !WalletState.loading && WalletState.shielded-any: HorizontalLayout {
                        spacing: Sp.s9;
                        alignment: start;

                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: WalletState.shielded-balance;
                                font-family: Typo.mono;
                                font-size: Typo.num;
                                color: Theme.accent;
                            }
                            Text {
                                // The second-pool argument at the top of this
                                // row, said on screen instead of only in the
                                // source. Safe in every state the caption can
                                // reach, because the row is gated on
                                // `shielded-any` — it never renders beside a
                                // pool nobody has scanned, nor beside one
                                // scanned and found empty.
                                text: @tr("shielded · not counted above");
                                font-size: Typo.micro;
                                color: Theme.text-tertiary;
                            }
                        }
                    }

                    if !WalletState.loading && WalletState.has-breakdown: HorizontalLayout {
                        spacing: Sp.s9;
                        alignment: start;

                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: WalletState.spendable;
                                font-family: Typo.mono;
                                font-size: Typo.num;
                                color: Theme.text-primary;
                            }
                            Text {
                                text: @tr("spendable");
                                font-size: Typo.micro;
                                color: Theme.text-tertiary;
                            }
                        }

                        if WalletState.immature != "": VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: WalletState.immature;
                                font-family: Typo.mono;
                                font-size: Typo.num;
                                color: Theme.warning;
                            }
                            Text {
                                // The wait belongs with the figure it
                                // qualifies, not in a parenthesis inside a
                                // longer sentence.
                                text: WalletState.matures-in == ""
                                    ? @tr("maturing")
                                    : @tr("maturing · {}", WalletState.matures-in);
                                font-size: Typo.micro;
                                color: Theme.text-tertiary;
                            }
                        }

                        if WalletState.incoming != "": VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: WalletState.incoming;
                                font-family: Typo.mono;
                                font-size: Typo.num;
                                color: Theme.positive;
                            }
                            Text {
                                // Not the shielded sentence, and deliberately
                                // not. This is the same pool one confirmation
                                // away: it joins the total the moment it is
                                // mined, where shielded value never does.
                                // Repeating "not counted above" here would
                                // flatten the difference between money that is
                                // coming and money that is elsewhere.
                                text: @tr("arriving · not counted yet");
                                font-size: Typo.micro;
                                color: Theme.text-tertiary;
                            }
                        }

                        // Money that has left and not settled.
                        if WalletState.pending != "": VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: WalletState.pending;
                                font-family: Typo.mono;
                                font-size: Typo.num;
                                color: Theme.text-secondary;
                            }
                            Text {
                                // The opposite sentence to the shielded one,
                                // and it has to be. These coins are confirmed
                                // and an unconfirmed transaction already spends
                                // them, so `Funding` puts them in neither of the
                                // lists the total is built from: a reader who
                                // subtracts them a second time arrives at a
                                // number the wallet never claimed. "not counted
                                // above" would be false here in the same breath
                                // it is true two columns to the left.
                                text: @tr("leaving · already deducted");
                                font-size: Typo.micro;
                                color: Theme.text-tertiary;
                            }
                        }
                    }
                }

                // The three things a person came here to do.
                VerticalLayout {
                    alignment: start;
                    HorizontalLayout {
                        spacing: Sp.s3;
                        alignment: end;
                        Btn {
                            text: @tr("Send");
                            variant: "primary";
                            clicked => { root.navigate("send"); }
                        }
                        Btn {
                            text: @tr("Receive");
                            variant: "secondary";
                            clicked => { root.navigate("receive"); }
                        }
                        Btn {
                            text: @tr("Convert");
                            variant: "ghost";
                            clicked => { root.navigate("convert"); }
                        }
                    }
                }
            }

            // The balance over time, inside the card with the figure it is a
            // chart of, so the two read as one statement.
            //
            // Absent entirely until there is something to draw. A wallet with
            // no transactions would otherwise stack three empty states — no
            // chart, no assets, no transactions — which says one thing three
            // times and makes a new wallet look broken.
            if ChartState.has-data: BalanceChart { plot-height: 132px; }
        }
    }

    // A wallet with nothing in it says so once.
    //
    // The three columns below each carry their own empty state, and on a fresh
    // wallet all three fire at the same moment — "no assets", "no prices", "no
    // transactions" — which is one fact stated three times and reads as
    // breakage rather than as newness. The chart is already absent for exactly
    // this reason; the comment on it warned about stacking empty states and
    // then a third column was added anyway.
    property <bool> nothing-yet: !WalletState.loading
        && WalletState.assets.length == 0
        && WalletState.activity.length == 0
        && MarketState.rows.length == 0;

    if root.nothing-yet: Card {
        VerticalLayout {
            padding: Sp.s10;
            EmptyState {
                glyph: "◇";
                title: @tr("Nothing here yet");
                body: @tr("Receive to this wallet, and the balance, its history and what things are worth all appear here.");
                action-text: @tr("Show my address");
                action => { root.navigate("receive"); }
            }
        }
    }

    // Three columns, which is what the design does with the space and what
    // stops each list running the width of a 1240px window.
    if !root.nothing-yet: HorizontalLayout {
        spacing: Sp.s5;

        // `alignment: start` on each, and it is load-bearing: without it the
        // layout hands the spare height to the gap between the heading and the
        // card, so three columns holding different amounts began at three
        // different heights and the shortest one sat at the bottom of the
        // screen.
        VerticalLayout {
            spacing: Sp.s4;
            alignment: start;
            horizontal-stretch: 1;
            // The unit for the second figure on every row, named once here.
            //
            // Once rather than per row, for the width argued at the row itself;
            // and here rather than inside the card because this is the same
            // sentence the markets screen's own heading makes — "ALL CURRENCIES
            // · PRICED IN DAI.vETH" — about the same book. Silent until there is
            // a book: before the first markets read every value is `—`, and a
            // heading promising a currency nothing is priced in would be the
            // card announcing a column it is not drawing.
            Eyebrow {
                text: MarketState.quote == ""
                    ? @tr("ASSETS")
                    : @tr("ASSETS · WORTH IN {}", MarketState.quote);
            }
            AssetsPanel {
                // The Convert screen's own picker writes these two properties
                // and then fires `edited()`; arriving from here does the same
                // thing, so there is one path into a priced form rather than
                // two that can drift apart.
                convert(currency) => {
                    // Convert draws the form only at `step == "form"`, and
                    // nothing resets the step on navigation — so somebody who
                    // read "Conversion sent" and pressed Dashboard in the rail
                    // instead of Done would press this row and land back on
                    // that receipt, with the currency swapped underneath it
                    // and a fresh quote already sent. Land on a form.
                    //
                    // Through the screen's own two exits rather than by
                    // writing `step` here: a review that is merely walked away
                    // from leaves the core holding signed bytes against a
                    // ticket number nobody can reach again, which is the whole
                    // reason `cancel()` sends `CancelConversion`. The price of
                    // going through them is that a signed conversion is
                    // discarded by pressing a row, and that is the right way
                    // round — the alternative is money already signed for
                    // sitting in memory behind a screen that has moved on.
                    if (ConvertState.step == "review") {
                        ConvertState.cancel();
                    } else if (ConvertState.step != "form") {
                        ConvertState.done();
                    }
                    // A refusal from earlier in the session is not about the
                    // currency this row just picked, and it is drawn under the
                    // button on the form this row promises. `cancel()` and
                    // `done()` clear it; arriving at a form that was already a
                    // form has to clear it here.
                    ConvertState.problem = { code: "", args: [] };
                    ConvertState.from-address = currency;
                    // An amount typed against another currency is not this
                    // one's amount. Carrying it over would put a figure in the
                    // pay field that means something else.
                    ConvertState.pay-draft = "";
                    // Never a form that converts something into itself.
                    if (ConvertState.to-address == currency) {
                        ConvertState.to-address = "";
                    }
                    ConvertState.edited();
                    root.navigate("convert");
                }
            }
        }

        VerticalLayout {
            spacing: Sp.s4;
            alignment: start;
            horizontal-stretch: 1;
            // The heading, and on the end of it the one column head this panel
            // needs.
            //
            // # Why the percentages are labelled at all
            //
            // The markets screen heads the same column `30d`, and the comment
            // there says why that is load-bearing: the series is sampled once a
            // day, so the same figures under a `24h` head would look precise
            // and not be. This panel showed them from the same
            // `Book::change_over_window` with the label dropped — leaving a
            // bare percentage, which is read as a day's move, that being what a
            // bare percentage means on every other market screen anybody has
            // seen.
            //
            // # Why it is up here and not over the rows
            //
            // Because a heading row inside the card costs 24px, and this card
            // has none: four rows was already chosen as the most that fit above
            // the footer at the size every reference image is taken at, and a
            // head over them pushed the fourth off the bottom of the window.
            // Out here it costs nothing — the eyebrow line is drawn either way
            // — and it is where the markets screen puts its own column heads,
            // outside the card, for its own reason.
            //
            // Only the change column is headed. The other figure on the row is
            // the price, which needs no window and whose unit is named to the
            // left of this, and a `Name` head over the first column would be
            // one word explaining a list of currency names.
            HorizontalLayout {
                spacing: Sp.s4;
                // Over the figures rather than over the card's edge: the rows
                // carry the list's own padding inside the card's, and this line
                // sits outside both.
                padding-right: Sp.s3 + Sp.s5;
                Eyebrow {
                    text: MarketState.quote == ""
                        ? @tr("MARKETS")
                        : @tr("MARKETS · {}", MarketState.quote);
                    horizontal-stretch: 1;
                }
                // Gone with the rows it heads, rather than standing over an
                // empty card: the panel's own empty state says what is going
                // on, and a column head is not part of that sentence.
                if MarketState.rows.length > 0: Text {
                    text: @tr("30d");
                    font-size: Typo.micro;
                    color: Theme.text-tertiary;
                    horizontal-alignment: right;
                }
            }
            MarketsPanel {}
        }

        VerticalLayout {
            spacing: Sp.s4;
            alignment: start;
            horizontal-stretch: 1;
            Eyebrow { text: @tr("RECENT ACTIVITY"); }
            ActivityPanel {}
        }
    }

    Rectangle { vertical-stretch: 1; }
}
