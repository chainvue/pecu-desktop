// What has happened, and one transaction in detail.

import { ListView } from "std-widgets.slint";
import { R, Sp, Theme, Typo } from "../theme/theme.slint";
import { Btn, Card, EmptyState, ListRow, Money, Segmented, TxId } from "../components/base.slint";
import { ActivityRow } from "../vm/structs.slint";
import { Actions, ActivityState, TxState, WalletState } from "../vm/state.slint";
import { NoteText } from "../components/note.slint";

// One transaction, in the list.
export component ActivityRowItem inherits VerticalLayout {
    in property <ActivityRow> entry;
    // Mined, and therefore in a block with a time and a depth.
    // Whether this happened on the chain at all.
    //
    // A **login did not**. It is a signature over a challenge; it never reaches
    // a block. So it is neither confirmed nor unconfirmed, and the row says
    // neither — the first attempt at this made it "unconfirmed" in warning
    // colour, which is a worse falsehood than the "101 confirmations" it was
    // fixing. Conversions and identity actions are real transactions and keep
    // their count.
    property <bool> on-chain: root.entry.kind != "login";
    // Mined, and therefore in a block with a time and a depth.
    property <bool> settled: root.on-chain && !root.entry.pending && root.entry.height > 0;
    // Depth, guarded and capped.
    //
    // Guarded because a tip that is briefly behind a block — during a reorg, or
    // between a new block arriving and the next poll — would otherwise print a
    // negative count. Capped because past a thousand the exact number carries
    // no information anybody uses: what matters is 1 (it is in a block) and
    // 100 (a coinbase has matured), and "1 187 402 confirmations" is a figure
    // that only makes the useful ones harder to read.
    property <int> depth: max(0, WalletState.tip-height - root.entry.height + 1);
    spacing: Sp.s2;

    // The day heading, above the first row of that day. Its own layout so the
    // breathing room above it is padding rather than a Text property that
    // silently does nothing.
    if root.entry.group.code != "": VerticalLayout {
        padding-top: Sp.s5;
        padding-left: Sp.s5;
        padding-bottom: Sp.s2;
        NoteText {
            note: root.entry.group;
            font-size: Typo.micro;
            font-weight: Typo.w-medium;
            letter-spacing: 0.6px;
            color: Theme.text-tertiary;
        }
    }

    ListRow {
        // The kind chooses the mark, and the direction only decides which way
        // a payment points. A login and an identity action move nothing, so
        // reading their mark off the direction would draw them all identically.
        glyph: root.entry.kind == "login" ? "✓"
            : root.entry.kind == "identity" ? "◇"
            : root.entry.kind == "convert" ? "↔"
            : root.entry.direction == "in" ? "↓"
            : root.entry.direction == "out" ? "↑"
            : "↔";
        glyph-tone: root.entry.kind == "login" ? Theme.accent
            : root.entry.kind == "identity" ? Theme.warning
            : root.entry.kind == "convert" ? Theme.text-secondary
            : root.entry.direction == "in" ? Theme.positive
            : root.entry.direction == "out" ? Theme.negative
            : Theme.text-secondary;
        title: root.entry.kind == "login" ? @tr("Signed in")
            : root.entry.kind == "identity" ? @tr("Identity updated")
            : root.entry.kind == "convert" ? @tr("Converted")
            : root.entry.direction == "in" ? @tr("Received")
            : root.entry.direction == "out" ? @tr("Sent")
            : @tr("Moved");
        // When, not which transaction.
        //
        // This line used to carry the abbreviated txid, and it made every row
        // in the list look like every other: sixty-four hex characters elided
        // to eight are not something a person tells apart, so a screen of them
        // reads as one repeated row. The time differs between rows, which is
        // the whole job of a subtitle in a list somebody scans.
        //
        // The id is not lost — it is in the sheet a click away, in full and
        // beside an explorer link, which is where somebody who wants a
        // transaction id is actually going.
        //
        // The chain has nothing better to offer here. The history comes from
        // address deltas, and a delta names no counterparty: putting "to
        // robert@" on this line would cost a `getrawtransaction` per row.
        // What this was, when there is something to say — otherwise when it
        // happened. Never both: two facts in a subtitle is a subtitle nobody
        // reads either half of.
        // What this was, when there is something to say — otherwise when it
        // happened. One is a string the core fills in and the other a named
        // reason, which is why they arrive on two properties.
        subtitle: root.entry.note;
        subtitle-note: root.entry.note == "" && root.settled
            ? root.entry.when
            : { code: "" };
        interactive: true;
        clicked => { Actions.open-tx(root.entry.txid); }

        HorizontalLayout {
            spacing: Sp.s5;
            alignment: end;

            VerticalLayout {
                alignment: center;
                spacing: 2px;

                if root.settled: Text {
                    // Derived, never stored: `tip - height + 1`. A new block
                    // changes one number and every row here follows.
                    // `@tr`'s plural form rather than a hand-rolled
                    // `== 1` branch: English has two cases and Polish has
                    // three, and which ones exist is a property of the
                    // language rather than of this line.
                    text: WalletState.tip-height == 0 ? ""
                        : root.depth > 999 ? @tr("999+ confirmations")
                        : @tr("{n} confirmation" | "{n} confirmations" % root.depth);
                    font-size: Typo.micro;
                    color: Theme.text-disabled;
                    horizontal-alignment: right;
                }
                if root.on-chain && !root.settled: Text {
                    text: @tr("unconfirmed");
                    font-size: Typo.caption;
                    color: Theme.warning;
                    horizontal-alignment: right;
                }
            }

            Money {
                amount: root.entry.amount;
                show-currency: false;
                tone: root.entry.direction == "in" ? "positive"
                    : root.entry.direction == "out" ? "negative"
                    : "neutral";
                y: (parent.height - self.height) / 2;
            }
        }
    }
}

export component ActivityScreen inherits VerticalLayout {
    padding: Sp.screen-pad;
    // Both were the shared page layout's job until this screen left it.
    max-width: Sp.content-max;
    spacing: Sp.s5;

    // Which money the bare numbers on this screen are in, said once.
    //
    // # Once, and not on the rows
    //
    // Every native amount below is in the same currency, so a ticker per row
    // would be one word repeated down a column somebody is scanning for the
    // numbers. That is why the rows ask `Money` for `show-currency: false`,
    // and this line exists so that decision stops meaning the screen never
    // names the currency at all.
    //
    // # Here rather than on the day heading
    //
    // The heading repeats. Three of them in the reference set, and one per day
    // in a history with any length to it — "once per screen" and "on the day
    // heading" are the same sentence only for a list with one day in it. The
    // heading is also a `Note` the core words and sends, so putting a ticker
    // in it would be a change to another crate for a screen's question.
    //
    // Above the summary strip rather than inside it, because the strip is
    // conditioned on `ActivityState.stats` and nothing but the fixtures ever
    // fills it — there is no `set_stats` in `bridge.rs`. A ticker inside that
    // `if` would be drawn in every reference image and in no running wallet,
    // which is precisely the build the issue is about. Above it is also the
    // truthful position rather than merely the reachable one: `Sent · 30d` and
    // `Received · 30d` are bare figures in this same currency, so the sentence
    // stands over everything it is about instead of over the list alone.
    //
    // # Why the guard is the ticker itself and not `loading`
    //
    // `WalletState.ticker` is empty until a node names the chain. The other
    // prose that interpolates it is gated behind a sibling property that
    // arrives in the same call, and reaching for `!WalletState.loading` here
    // would look like the same move and not be one: `bridge::apply_wallet`
    // also clears `loading`, on unlock, before any portfolio exists. There is
    // a window in which the wallet is loaded and the chain is still unnamed,
    // and in it this line would read "Amounts are in ." Gated on the value, an
    // unnamed chain gets no line rather than a sentence with a hole in it.
    if WalletState.ticker != "": Text {
        text: @tr("Amounts are in {} unless the row names another currency.", WalletState.ticker);
        font-size: Typo.caption;
        color: Theme.text-tertiary;
    }

    // The summary, above the filters, because it describes the whole list
    // rather than the slice being looked at.
    if ActivityState.stats.length > 0: HorizontalLayout {
        spacing: Sp.s4;
        for stat in ActivityState.stats: Card {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: Sp.s4;
                spacing: Sp.s1;
                NoteText {
                    note: stat.label;
                    font-size: Typo.micro;
                    color: Theme.text-tertiary;
                }
                Text {
                    text: stat.value;
                    font-family: Typo.mono;
                    font-size: Typo.num;
                    font-weight: Typo.w-bold;
                    color: Theme.text-primary;
                }
            }
        }
    }

    // The filters. Present for kinds this wallet cannot produce yet, and that
    // is deliberate rather than sloppy: the rail makes the same promise about
    // screens that are coming, and a filter list that grew as features landed
    // would move under somebody's hand every release.
    HorizontalLayout {
        alignment: start;
        Segmented {
            // Wide enough for its five labels. Left to hug its contents the
            // control squeezed them into an unreadable run.
            width: 420px;
            options: [@tr("All"), @tr("Payments"), @tr("Converts"), @tr("Logins"), @tr("Identity")];
            index: ActivityState.filter == "payment" ? 1
                : ActivityState.filter == "convert" ? 2
                : ActivityState.filter == "login" ? 3
                : ActivityState.filter == "identity" ? 4
                : 0;
            changed(i) => {
                ActivityState.filter = i == 1 ? "payment"
                    : i == 2 ? "convert"
                    : i == 3 ? "login"
                    : i == 4 ? "identity"
                    : "all";
                ActivityState.filter-changed(ActivityState.filter);
            }
        }
    }

    if WalletState.history.length == 0 && !WalletState.loading: Card {
        VerticalLayout {
            padding: Sp.s11;
            EmptyState {
                glyph: "○";
                title: @tr("No transactions yet");
                body: @tr("Everything this wallet has ever sent or received appears here.");
            }
        }
    }

    if WalletState.history.length > 0: Card {
        // Takes whatever the footer leaves, so a long history fills the window
        // and "Load older" stays reachable rather than being pushed off the end
        // of a list that grows every time it is pressed.
        // And fills it, rather than hugging its contents.
        //
        // A `ListView` cannot size to what is in it: knowing the content height
        // means laying the content out, and not laying out what nobody can see
        // is the entire point. Binding the card to `viewport-height` compiles to
        // a binding loop, which is the compiler saying the same thing.
        //
        // So the list occupies the pane the way a list does everywhere else —
        // rows at the top, the rest empty on a short history. The footer below
        // it is better off for it: "Load older" now sits at a fixed place
        // instead of after a list that grows every time it is pressed.
        vertical-stretch: 1;
        VerticalLayout {
            padding: Sp.s3;
            // Every transaction, newest first, and only the visible ones built.
            // The day headings ride along inside the row that starts a day —
            // computed in core, which can see the row before this one — so this
            // stays one flat model rather than a tree the list cannot page.
            list := ListView {
                // One element per row, unconditionally.
                //
                // The filter was here first — `visible` plus a zeroed height —
                // and it did not work: a `ListView` positions its items from
                // their preferred height, so a conditional one made every row
                // draw on top of the last. The list arrives filtered from the
                // core now. See `Command::SetHistoryFilter`.
                for item in WalletState.history: ActivityRowItem {
                    entry: item;
                }
            }
        }
    }

    // Offered until the scan has actually reached the start of the chain.
    // History is fetched in windows of blocks, so an empty stretch is not the
    // end of the list — and a wallet that stopped at the first quiet week would
    // simply be hiding transactions.
    if WalletState.history.length > 0 && !WalletState.history-complete: HorizontalLayout {
        alignment: center;
        Btn {
            text: WalletState.loading-history ? @tr("Reading…") : @tr("Load older transactions");
            enabled: !WalletState.loading-history;
            clicked => { Actions.load-older(); }
        }
    }

    if WalletState.history.length > 0 && WalletState.history-complete: Text {
        text: @tr("That is everything on the chain for this wallet.");
        font-size: Typo.caption;
        color: Theme.text-tertiary;
        horizontal-alignment: center;
    }

    // No trailing spacer here, unlike the other screens. The list above is what
    // takes the leftover height — a spacer competing for it would split the
    // difference and leave the list half a window tall with empty space beneath.
    if WalletState.history.length == 0: Rectangle { vertical-stretch: 1; }
}

export component TxSheet inherits Rectangle {
    // Dims what is behind without hiding it, so the list is still the context.
    background: Theme.dark ? #0B0C0EC0 : #FBFBFCC0;

    // Swallows clicks so nothing behind the sheet can be pressed through it,
    // and closes on a click outside the card.
    TouchArea {
        clicked => { TxState.txid = ""; }
    }

    Card {
        elevated: true;
        width: 600px;
        height: min(root.height - Sp.s11 * 2, content.preferred-height);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        // The card itself must not close it.
        TouchArea {}

        Flickable {
            viewport-height: content.preferred-height;

            content := VerticalLayout {
                padding: Sp.s8;
                spacing: Sp.s6;

                HorizontalLayout {
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: Sp.s2;
                        Text {
                            text: TxState.direction == "in" ? @tr("Received")
                                : TxState.direction == "out" ? @tr("Sent")
                                : @tr("Moved between your own addresses");
                            font-size: Typo.title2;
                            font-weight: Typo.w-bold;
                            color: Theme.text-primary;
                        }
                        NoteText {
                            note: TxState.when;
                            font-size: Typo.caption;
                            color: Theme.text-tertiary;
                        }
                    }
                    Btn {
                        text: @tr("Close");
                        variant: "ghost";
                        y: 0;
                        clicked => { TxState.txid = ""; }
                    }
                }

                Money {
                    amount: TxState.amount;
                    currency: WalletState.ticker;
                    show-currency: TxState.amount-is-native;
                    size: Typo.title1;
                    mono: false;
                    tone: TxState.direction == "in" ? "positive"
                        : TxState.direction == "out" ? "negative"
                        : "neutral";
                }

                for line in TxState.currency-lines: Text {
                    text: line;
                    font-family: Typo.mono;
                    font-size: Typo.num;
                    color: Theme.text-secondary;
                }

                Rectangle { height: 1px; background: Theme.border-subtle; }

                VerticalLayout {
                    spacing: Sp.s4;

                    HorizontalLayout {
                        Text {
                            text: @tr("Confirmations");
                            font-size: Typo.body;
                            color: Theme.text-secondary;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: TxState.confirmations == "" ? @tr("unconfirmed") : TxState.confirmations;
                            font-family: Typo.mono;
                            font-size: Typo.num;
                            color: TxState.confirmations == "" ? Theme.warning : Theme.text-primary;
                        }
                    }

                    HorizontalLayout {
                        Text {
                            text: @tr("Block");
                            font-size: Typo.body;
                            color: Theme.text-secondary;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: TxState.height == "0" ? @tr("not mined yet") : TxState.height;
                            font-family: Typo.mono;
                            font-size: Typo.num;
                            color: Theme.text-primary;
                        }
                    }

                    HorizontalLayout {
                        Text {
                            text: @tr("Fee");
                            font-size: Typo.body;
                            color: Theme.text-secondary;
                            horizontal-stretch: 1;
                        }
                        Text {
                            // "Not reported" rather than a zero. A fee is
                            // inputs minus outputs, and the input values live
                            // in other transactions — a wallet that printed 0
                            // here would be stating something it does not know.
                            text: TxState.fee == "" ? @tr("not reported by this node") : TxState.fee;
                            font-family: TxState.fee == "" ? "" : Typo.mono;
                            font-size: TxState.fee == "" ? Typo.caption : Typo.num;
                            color: TxState.fee == "" ? Theme.text-tertiary : Theme.text-primary;
                        }
                    }
                }

                // The same component the send and convert screens end with,
                // rather than a third arrangement of the same two facts.
                //
                // This sheet used to hold its own copy of both — an id with a
                // `Copy id` button, and a link it would copy and would not
                // open, under a comment arguing that opening a browser is one
                // process spawn away from running something else. Issue #18 is
                // that the two screens disagreed; the answer is one component
                // offering both actions, not one of the two conventions
                // winning.
                //
                // The security concern that comment recorded was not dropped.
                // Opening goes through `Actions.open-link`, which is
                // `pecu-app`'s `open_in_browser`, which refuses anything
                // `is_openable` does not recognise — `https://` and an
                // unreserved URL alphabet, so no `file://`, no `javascript:`,
                // and no `cmd` metacharacter for the one platform that parses
                // the argument. Extending opening to this screen makes that
                // check more load-bearing rather than less, which is why it is
                // named here as well as at its definition.
                TxId {
                    txid: TxState.txid;
                    explorer: TxState.explorer;
                    open-link(url) => { Actions.open-link(url); }
                }

                HorizontalLayout {
                    alignment: start;
                    Btn {
                        text: TxState.advanced ? @tr("Hide raw transaction") : @tr("Show raw transaction");
                        variant: "ghost";
                        clicked => { TxState.advanced = !TxState.advanced; }
                    }
                }

                if TxState.advanced: Rectangle {
                    height: 220px;
                    background: Theme.bg-inset;
                    border-radius: R.md;

                    Flickable {
                        viewport-height: raw.preferred-height;
                        raw := Text {
                            text: TxState.raw == "" ? @tr("Waiting for the node…") : TxState.raw;
                            font-family: Typo.mono;
                            font-size: Typo.micro;
                            color: Theme.text-secondary;
                            wrap: word-wrap;
                            x: Sp.s5;
                            width: parent.width - Sp.s5 * 2;
                        }
                    }
                }
            }
        }
    }
}
