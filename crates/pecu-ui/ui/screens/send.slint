// Paying somebody: the form, and the review that is read back from a signed
// transaction rather than from what was typed.

import { R, Sp, Theme, Typo } from "../theme/theme.slint";
import { Btn, Card, EmptyState, Eyebrow, ListRow, Money, TxId } from "../components/base.slint";
import { Actions, HaltState, SendState, WalletState } from "../vm/state.slint";
import { Field, KeyPicker, QuoteLine } from "../components/form.slint";
import { Notice, NoteText, NoticeTitle } from "../components/note.slint";

export component SendForm inherits HorizontalLayout {
    spacing: Sp.s7;

    // ── Who this wallet has paid ────────────────────────────────────────
    //
    // The design calls this Contacts. It is not an address book somebody
    // fills in — it is who this wallet has actually paid, which the core
    // records once a node has accepted a payment. That makes it the one check
    // a checksum cannot do: a mistyped address that happens to be valid looks
    // exactly like a correct one, and "you have paid this before" is the only
    // thing the wallet can say about it.
    VerticalLayout {
        spacing: Sp.s4;
        width: 27%;

        Eyebrow { text: @tr("PAID BEFORE"); }

        Card {
            VerticalLayout {
                padding: Sp.s3;

                if SendState.known.length == 0: Rectangle {
                    height: 108px;
                    EmptyState {
                        glyph: "○";
                        title: @tr("Nobody yet");
                        body: @tr("Addresses appear here once a payment to them has been accepted.");
                    }
                }

                for row in SendState.known: ListRow {
                    // The chain's name first, then what the owner called it,
                    // then the address — most recognisable to least. A payment
                    // to a VerusID records the i-address it resolved to, so
                    // without the name this list is a column of `i4YzoP8Z…`.
                    //
                    // Clicking still fills the **address**, not the name: it is
                    // the identifier that cannot be re-pointed between the click
                    // and the signature, and the review shows both.
                    title: row.name != "" ? row.name
                        : row.label != "" ? row.label
                        : row.address;
                    title-mono: row.label == "";
                    subtitle: row.summary;
                    interactive: true;
                    clicked => {
                        SendState.to-draft = row.address;
                        root.check();
                    }
                }
            }
        }

        Rectangle { vertical-stretch: 1; }
    }

    Card {
        horizontal-stretch: 1;
        VerticalLayout {
            padding: Sp.s8;
            spacing: Sp.s6;

            // Which key is paying. Named on the form rather than only in the
            // review, because "where is this coming from" is a question about
            // the payment somebody is composing, not about the one they are
            // being asked to confirm.
            VerticalLayout {
                spacing: Sp.s3;
                HorizontalLayout {
                    Text {
                        text: @tr("From");
                        font-size: Typo.caption;
                        color: Theme.text-secondary;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: WalletState.active-key;
                        font-size: Typo.caption;
                        font-weight: Typo.w-medium;
                        color: Theme.text-primary;
                    }
                }
                Text {
                    text: WalletState.address;
                    font-family: Typo.mono;
                    font-size: Typo.num-sm;
                    color: Theme.text-tertiary;
                    overflow: elide;
                }
                KeyPicker {}

                // Which of the key's two balances pays.
                //
                // Only when there are two. A key with no shielded account gets
                // no selector rather than a disabled one — there is nothing to
                // choose, and a greyed control invites somebody to work out why
                // it is greyed.
                //
                // Never preselected by which balance covers the amount. That
                // would decide, silently, whether a payment is traceable.
                if SendState.shielded-available: VerticalLayout {
                    spacing: Sp.s3;

                    HorizontalLayout {
                        spacing: Sp.s3;

                        Btn {
                            text: @tr("Transparent");
                            // `secondary`, not `ghost`, for the unchosen side.
                            // A ghost button beside a filled one reads as a
                            // label rather than a control — the reference image
                            // showed a screen that appeared to offer no choice
                            // at all. The key picker above makes the same pair
                            // the same way.
                            variant: SendState.from-shielded ? "secondary" : "primary";
                            horizontal-stretch: 1;
                            clicked => {
                                SendState.from-shielded = false;
                                Actions.validate-draft(SendState.to-draft, SendState.amount-draft, false, SendState.send-all);
                            }
                        }
                        Btn {
                            text: @tr("Shielded");
                            variant: SendState.from-shielded ? "primary" : "secondary";
                            horizontal-stretch: 1;
                            clicked => {
                                SendState.from-shielded = true;
                                // Cleared on the way over rather than carried:
                                // the control is not offered on this side, and
                                // a mode still switched on behind a control
                                // nobody can see is a mode nobody can switch
                                // off.
                                SendState.send-all = false;
                                Actions.validate-draft(SendState.to-draft, SendState.amount-draft, true, false);
                            }
                        }
                    }

                    Text {
                        text: !SendState.from-shielded
                                ? @tr("Amounts and addresses are public")
                            : !SendState.shielded-scanned
                                ? @tr("Not scanned — set a shielded server in Settings")
                            : @tr("{} shielded", SendState.shielded-balance);
                        font-size: Typo.caption;
                        color: Theme.text-tertiary;
                        wrap: word-wrap;
                    }
                }
            }

            Rectangle { height: 1px; background: Theme.border-subtle; }

            VerticalLayout {
                spacing: Sp.s3;
                Text {
                    text: @tr("Recipient");
                    font-size: Typo.caption;
                    color: Theme.text-secondary;
                }
                to := Field {
                    mono: true;
                    // The two shapes this accepts, so nobody has to find out by
                    // being refused. Not an example address anybody could copy:
                    // the prefix and the ellipsis are the whole point. The
                    // trailing `@` is not decoration — it is what a VerusID
                    // actually ends with.
                    //
                    // The word "Address" is there because "R… or name@" on its
                    // own reads as a placeholder that got clipped — a leading
                    // ellipsis is what truncation looks like, and a field that
                    // appears broken before it has been typed in is not a field
                    // anybody trusts.
                    placeholder: @tr("Address (R…) or name@");
                    text <=> SendState.to-draft;
                    invalid: SendState.to-draft != "" && !SendState.to-valid;
                    edited => { root.check(); }
                }
                if SendState.to-note.code != "": NoteText {
                    note: SendState.to-note;
                    problem: !SendState.to-valid;
                }
            }

            VerticalLayout {
                spacing: Sp.s3;
                HorizontalLayout {
                    Text {
                        text: @tr("Amount");
                        font-size: Typo.caption;
                        color: Theme.text-secondary;
                        horizontal-stretch: 1;
                    }
                    Text {
                        // Follows the source selector, for the same reason
                        // the summary line does: with the shielded balance
                        // paying, the transparent figure here is a number that
                        // is true about the wallet and false about the payment.
                        //
                        // And the **active key's** figure, not the wallet's,
                        // for the second half of the same reason. This form
                        // pays from one key; `WalletState.spendable` is the sum
                        // over every address the wallet holds, and printing it
                        // over prose that says "everything this key can spend"
                        // quotes another key's money as this one's.
                        text: !SendState.from-shielded
                                ? @tr("{} spendable", SendState.key-spendable)
                            // Empty means nothing has been scanned, which is a
                            // different statement from a balance of zero — and
                            // the wrong one to make silently on the line
                            // somebody checks before pressing send.
                            : !SendState.shielded-scanned
                                ? @tr("not scanned yet")
                            : @tr("{} shielded", SendState.shielded-balance);
                        font-family: Typo.mono;
                        font-size: Typo.num-sm;
                        color: Theme.text-tertiary;
                    }
                }

                // ── Emptying the key ────────────────────────────────────
                //
                // Still no "Max" button, and still for the reason the design
                // was told no the first time: the fee is not known until the
                // builder has chosen coins, so a Max that copied the spendable
                // balance into the field would put a number there that cannot
                // be built — a control that is wrong exactly when somebody uses
                // it.
                //
                // This is not that. It is a **mode**, not a fill: while it is
                // on the amount field is gone from the form and the figure is
                // worked out in the builder, from the coins, at the moment they
                // are selected. The first resolved number anybody sees is on
                // the review, read back out of a transaction that has already
                // been signed. So the invariant the old comment was protecting
                // — no unbuildable number ever appears in the amount field —
                // holds here in its strongest form: there is no field to put
                // one in.
                //
                // Called "Send everything" rather than "Max" deliberately. Max
                // is a fill-the-field verb and invites somebody to expect a
                // number to appear.
                //
                // Absent, not disabled, while the shielded balance is paying —
                // the same convention as the pool selector above. The core
                // refuses the flag on that route, and a greyed control would
                // only invite somebody to work out why it is greyed.
                if !SendState.from-shielded: HorizontalLayout {
                    alignment: start;
                    Btn {
                        text: @tr("Send everything");
                        variant: SendState.send-all ? "primary" : "secondary";
                        clicked => {
                            SendState.send-all = !SendState.send-all;
                            root.check();
                        }
                    }
                }

                if !SendState.send-all: Field {
                    mono: true;
                    placeholder: "0.0000 0000";
                    text <=> SendState.amount-draft;
                    invalid: SendState.amount-draft != "" && !SendState.amount-valid;
                    edited => { root.check(); }
                    accepted => { root.review(); }
                }

                // What replaces the field: a sentence, and where the numbers
                // will be. Not a figure — see the comment above.
                //
                // Both paragraphs sit **directly** in this layout rather than
                // in a `VerticalLayout` of their own. A wrapping `Text` is
                // measured against the width it has been given, and a nested
                // layout reported a height for one line where four were drawn —
                // so the Review button was placed on top of the last sentence.
                // The reference image is what caught it, which is the argument
                // for looking at these rather than blessing them.
                //
                // The second sentence is not padding. `resolve_send_all`
                // deliberately leaves behind any coin that costs more to spend
                // than it is worth — past the fee floor an input costs about
                // 1 800 satoshis — so without it "everything" is a promise the
                // builder does not keep. What is still missing is the figure:
                // it is not known until coins have been selected, which is the
                // same reason there is no amount field here. `docs/LATER.md`
                // §13 has what naming it on the review would cost.
                if SendState.send-all: Text {
                    text: @tr("Everything this key can spend goes, less the network fee — both figures are on the next step, read back from the transaction that was signed. A coin worth less than it costs to move stays where it is.");
                    font-size: Typo.caption;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }

                // The one thing this screen has never said, and the one that
                // costs money if it stays unsaid.
                //
                // Coins that have not matured are not spendable, so they are
                // not swept — and somebody emptying a key before they
                // decommission the machine holding it will read "sent
                // everything" as "this key is finished". A staking wallet's
                // maturing balance would still be arriving afterwards, to an
                // address nobody is watching any more.
                //
                // The **active key's** maturing coins. `WalletState.immature`
                // is the wallet's, summed over every address, and this sentence
                // names a key — in a two-key wallet it would quote the other
                // key's coins as this one's, on the screen where somebody is
                // deciding whether the key is finished with.
                //
                // Empty rather than zero when there is nothing maturing: the
                // bridge blanks it, and a "0.0000 0000 is still maturing" under
                // every send-all would be the wallet making a statement about
                // coins it does not have.
                if SendState.send-all && SendState.key-immature != "": Text {
                    text: @tr("{} in this key has not matured yet and stays behind. It will arrive here later.", SendState.key-immature);
                    font-size: Typo.caption;
                    color: Theme.text-tertiary;
                    wrap: word-wrap;
                }

                if SendState.amount-note.code != "": NoteText {
                    note: SendState.amount-note;
                    problem: true;
                }
            }

            HorizontalLayout {
                alignment: end;
                Btn {
                    text: SendState.busy ? @tr("Building…") : @tr("Review payment");
                    variant: "primary";
                    enabled: SendState.ready && !SendState.busy;
                    clicked => { root.review(); }
                }
            }
        }
    }

    // ── What is known before anything is built ──────────────────────────
    //
    // The design puts Fee, Time and Total here, on the form. **This wallet
    // cannot know any of them yet.** The fee depends on which coins the builder
    // picks, which happens when the transaction is built — that is the whole
    // reason there is a review step, and the review reads its figures back out
    // of something already signed rather than out of what was typed.
    //
    // So this panel says what is true now, and says where the rest comes from.
    // A quoted fee that turned out to be a different fee would undo the one
    // thing the review is for.
    VerticalLayout {
        spacing: Sp.s4;
        width: 27%;

        Eyebrow { text: @tr("THIS PAYMENT"); }

        Card {
            VerticalLayout {
                padding: Sp.s5;
                spacing: Sp.s4;

                QuoteLine {
                    label: @tr("Paying from");
                    value: WalletState.active-key;
                }
                QuoteLine {
                    // The balance this payment is actually coming out of.
                    //
                    // It used to be `WalletState.spendable` unconditionally,
                    // which is the transparent one. With the shielded source
                    // selected that line offered a figure this route cannot
                    // reach — the reference image showed "12 382.42" beside a
                    // shielded balance of 2.5. A number that is true about the
                    // wallet and false about the payment is worse on this
                    // screen than no number — which is also why the transparent
                    // arm is now the active key's figure rather than the
                    // wallet's sum. Same failure, other axis.
                    label: SendState.from-shielded ? @tr("Shielded") : @tr("Spendable");
                    value: !SendState.from-shielded ? SendState.key-spendable
                        : !SendState.shielded-scanned ? @tr("not scanned")
                        : SendState.shielded-balance;
                }

                Rectangle { height: 1px; background: Theme.border-subtle; }

                // What this payment will be, in a sentence, before it is built.
                //
                // The route is not a detail: it decides what the chain records
                // about the payment, and it is decided by two controls that sit
                // apart from each other — the source selector above and the
                // address field between them. Somebody who set one and forgot
                // the other cannot see the combination anywhere else.
                //
                // Only for the three that are not ordinary. A transparent
                // payment needs no explanation on a screen whose every other
                // word already assumes one.
                if SendState.route != "transparent": Text {
                    text: SendState.route == "shield"
                            ? @tr("This moves coin from your public balance into your shielded one. The amount and where it came from stay visible; where it went does not.")
                        : SendState.route == "private"
                            ? @tr("This pays from your shielded balance to a shielded address. Nothing about it is public except that a shielded transaction happened.")
                        : @tr("This pays from your shielded balance to a public address. The amount and the recipient become visible; you do not.");
                    font-size: Typo.caption;
                    color: Theme.accent;
                    wrap: word-wrap;
                }

                // Said before the wait, not during it. Proving takes tens of
                // seconds and the button simply goes quiet; somebody who was not
                // told reads that as a hang and presses it again.
                if SendState.route != "transparent": Text {
                    text: @tr("Shielded payments are proved on this machine, which takes a little while after you press Review.");
                    font-size: Typo.micro;
                    color: Theme.text-tertiary;
                    wrap: word-wrap;
                }

                Text {
                    text: @tr("The fee and the total appear on the next step. They are read back from the signed transaction, not estimated here.");
                    font-size: Typo.micro;
                    color: Theme.text-tertiary;
                    wrap: word-wrap;
                }

                // Which currency this form is about — the one thing it never
                // said, on a screen with no currency field to give it away.
                //
                // Only for a wallet that holds a token, because that is the
                // only person it is about: somebody who read "48.5000 0000"
                // off a Bridge.vETH row and typed it in here would otherwise
                // send 48.5 of the chain's own coin, and the review would show
                // the amount and the recipient and never the currency.
                //
                // Stated as a property of this build, in the present tense,
                // and naming the thing that does work in the same breath. No
                // button beside it: `SendScreen` is mounted bare and has no
                // way to navigate, and the shortcut already lives on the asset
                // row this sentence points back at.
                //
                // Three wordings, on the same three halt states the dashboard
                // caption splits and for the reason written down there: only
                // one of them is "conversions work", and pointing at Convert
                // in the other two is directions to a door this screen has no
                // idea is shut.
                if WalletState.holds-tokens: Text {
                    text: HaltState.conversions-halted
                        ? @tr("This form sends {}. Sending a token is not built yet, and this chain has conversions switched off — so a token cannot be moved at all.", WalletState.ticker)
                        : HaltState.severity == "" || HaltState.severity == "unknown"
                        ? @tr("This form sends {}. Sending a token is not built yet, and this wallet does not know whether this chain is taking conversions — the Convert screen will say.", WalletState.ticker)
                        : @tr("This form sends {}. Sending a token is not built yet; a token is moved by converting it on the Convert screen.", WalletState.ticker);
                    font-size: Typo.micro;
                    color: Theme.text-tertiary;
                    wrap: word-wrap;
                }
            }
        }

        // What the core made of the recipient. Worth its own place: it is the
        // only thing on this screen that can catch an address which is valid
        // and still wrong.
        if SendState.to-note.code != "" || SendState.to-label != "": Card {
            VerticalLayout {
                padding: Sp.s5;
                spacing: Sp.s3;
                Eyebrow {
                    text: SendState.to-valid ? @tr("RECIPIENT") : @tr("PROBLEM");
                    color: SendState.to-valid ? Theme.text-tertiary : Theme.negative;
                }
                NoteText {
                    note: SendState.to-note;
                    problem: !SendState.to-valid;
                }
                // The name this wallet gave the address, on its own line. The
                // core used to glue it onto the sentence with a separator it
                // could not see the width of.
                if SendState.to-label != "": Text {
                    text: SendState.to-label;
                    font-size: Typo.caption;
                    font-weight: Typo.w-bold;
                    color: Theme.text-primary;
                }
            }
        }

        Rectangle { vertical-stretch: 1; }
    }

    function check() {
        Actions.validate-draft(SendState.to-draft, SendState.amount-draft, SendState.from-shielded, SendState.send-all);
    }

    function review() {
        if (!SendState.ready) { return; }
        Actions.prepare-send(SendState.to-draft, SendState.amount-draft, SendState.from-shielded, SendState.send-all);
    }
}

export component SendScreen inherits VerticalLayout {
    spacing: Sp.s7;

    if SendState.step == "form": SendForm {}

    // ── Step 2: what was actually built ─────────────────────────────────
    if SendState.step == "review": HorizontalLayout {
        alignment: center;
        Card {
            width: 560px;
            VerticalLayout {
                padding: Sp.s8;
                spacing: Sp.s6;

                VerticalLayout {
                    spacing: Sp.s2;
                    Text {
                        text: @tr("Check this payment");
                        font-size: Typo.title2;
                        font-weight: Typo.w-bold;
                        color: Theme.text-primary;
                    }
                    Text {
                        // Says exactly what it is, because that is what makes
                        // this step worth reading.
                        text: @tr("Read back from the transaction that was signed — not from what you typed.");
                        font-size: Typo.caption;
                        color: Theme.text-tertiary;
                        wrap: word-wrap;
                    }
                }

                // Above the outputs, because it is about the one line down
                // there that matters and somebody should read it first.
                // The one thing a wallet can check that a checksum cannot. A
                // mistyped address that happens to be valid looks exactly like
                // a correct one, and coins sent to it are gone.
                if SendState.first-time-recipient: Notice {
                    headline: @tr("You have not paid this address before");
                    body: @tr("Check it against where you got it from. A valid address that belongs to somebody else looks exactly like the right one, and nothing can undo the payment.");
                }

                // What was asked for, above what was built. A VerusID is a
                // question put to a node; this is the question, and the outputs
                // below are the answer the transaction actually pays.
                if SendState.recipient-name != "": VerticalLayout {
                    spacing: Sp.s2;
                    Eyebrow { text: @tr("ADDRESSED TO"); }
                    Text {
                        text: SendState.recipient-name;
                        font-family: Typo.mono;
                        font-size: Typo.num;
                        color: Theme.text-primary;
                        wrap: word-wrap;
                    }
                    Text {
                        text: @tr("Resolved by the node this wallet is connected to. The address it resolved to is below.");
                        font-size: Typo.caption;
                        color: Theme.text-tertiary;
                        wrap: word-wrap;
                    }
                }

                // Which of this wallet's addresses is paying.
                //
                // Also computed and also unread until now. A wallet with more
                // than one key can build a payment from any of them, the form
                // has a key picker at the top of it, and the review — the
                // screen whose whole job is "check this before it is
                // irreversible" — did not say which one the transaction it
                // signed actually spends from.
                if SendState.from-address != "": VerticalLayout {
                    spacing: Sp.s2;
                    Eyebrow { text: @tr("PAID FROM"); }
                    Text {
                        text: SendState.from-address;
                        font-family: Typo.mono;
                        font-size: Typo.num-sm;
                        color: Theme.text-secondary;
                        wrap: char-wrap;
                    }
                }

                // Who else was asked about these coins.
                //
                // Under the funding address rather than above the outputs,
                // because it is about where the coins came from and not about
                // where they are going. Shown only when there was a second
                // node: an empty line reading "nothing checked this" on every
                // ordinary payment is a warning people learn to stop seeing,
                // and the wallet ships one endpoint per chain, so that would be
                // most of them.
                //
                // The second line is here rather than on the Network screen
                // because this is where it is true: the address above was sent
                // to that endpoint to ask about, and it went before this screen
                // appeared, so there was no point earlier at which cancelling
                // would have stopped it.
                if SendState.corroboration.code != "": VerticalLayout {
                    spacing: Sp.s2;
                    Eyebrow { text: @tr("CHECKED AGAINST"); }
                    NoteText {
                        note: SendState.corroboration;
                        font-size: Typo.caption;
                        color: Theme.text-tertiary;
                        wrap: word-wrap;
                    }
                    Text {
                        text: @tr("The address above was sent to it to ask about.");
                        font-size: Typo.caption;
                        color: Theme.text-tertiary;
                        wrap: word-wrap;
                    }
                }

                VerticalLayout {
                    spacing: Sp.s2;
                    Eyebrow { text: @tr("OUTPUTS"); }

                    // Change is drawn quieter than the payment, and that is a
                    // safety decision rather than a stylistic one.
                    //
                    // Both rows used to render identically: same size, same
                    // colour, same weight. But only one of them is the question
                    // being asked. Somebody checking an address under time
                    // pressure reads the first mono line they land on, and if
                    // the change output is above the payment — which it can be,
                    // since the order is the transaction's, not ours — they
                    // check the wrong one and approve.
                    //
                    // Change is still shown in full. Hiding it would mean the
                    // amounts on screen no longer add up to what leaves the
                    // wallet, and a review somebody cannot reconcile is a review
                    // they stop reading.
                    for output in SendState.outputs: HorizontalLayout {
                        spacing: Sp.s5;
                        padding-top: Sp.s3;
                        padding-bottom: Sp.s3;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: output.address == "" ? @tr("Unknown destination") : output.address;
                                font-family: Typo.mono;
                                font-size: Typo.num-sm;
                                color: output.address == "" ? Theme.negative
                                    : output.is-change ? Theme.text-tertiary
                                    : Theme.text-primary;
                                wrap: char-wrap;
                            }
                            // Not "Payment · change". Change is not a payment
                            // to anybody; it is the part that never left.
                            if output.is-change: Text {
                                text: @tr("Change · back to your wallet");
                                font-size: Typo.caption;
                                color: Theme.text-disabled;
                            }
                            if !output.is-change: NoteText {
                                note: output.kind;
                                font-size: Typo.caption;
                                color: Theme.text-tertiary;
                            }
                        }

                        Money {
                            amount: output.amount;
                            show-currency: false;
                            size: output.is-change ? Typo.num-sm : Typo.num;
                            tone: output.is-change ? "muted" : "neutral";
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.border-subtle;
                }

                VerticalLayout {
                    spacing: Sp.s3;
                    HorizontalLayout {
                        Text {
                            text: @tr("Fee");
                            font-size: Typo.body;
                            color: Theme.text-secondary;
                            horizontal-stretch: 1;
                        }
                        Money { amount: SendState.fee; currency: WalletState.ticker; size: Typo.num; }
                    }
                    HorizontalLayout {
                        Text {
                            text: @tr("Leaving your wallet");
                            font-size: Typo.body;
                            font-weight: Typo.w-medium;
                            color: Theme.text-primary;
                            horizontal-stretch: 1;
                        }
                        Money { amount: SendState.total; currency: WalletState.ticker; size: Typo.num-lg; }
                    }
                    // What is left afterwards.
                    //
                    // The core has computed this since the review screen was
                    // written — `balance_after_display`, carried through the
                    // protocol and set on this global — and **nothing read it**.
                    // It is the question somebody actually has after "how much
                    // is leaving", and the wallet already knew the answer.
                    if SendState.balance-after != "": HorizontalLayout {
                        Text {
                            text: @tr("Left afterwards");
                            font-size: Typo.caption;
                            color: Theme.text-tertiary;
                            horizontal-stretch: 1;
                        }
                        Money {
                            amount: SendState.balance-after;
                            currency: WalletState.ticker;
                            size: Typo.num-sm;
                            tone: "muted";
                        }
                    }
                }

                if SendState.problem.code != "": NoticeTitle {
                    note: SendState.problem;
                    font-size: Typo.caption;
                    color: Theme.negative;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: Sp.s4;
                    Btn {
                        text: @tr("Back");
                        variant: "ghost";
                        clicked => {
                            Actions.cancel-send(SendState.ticket);
                            SendState.problem = { code: "", args: [] };
                            SendState.step = "form";
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Btn {
                        text: SendState.busy ? @tr("Sending…") : @tr("Send now");
                        variant: "primary";
                        enabled: !SendState.busy;
                        clicked => { Actions.confirm-send(SendState.ticket); }
                    }
                }
            }
        }
    }

    // ── Step 3: what happened ───────────────────────────────────────────
    if SendState.step == "sent" || SendState.step == "uncertain": HorizontalLayout {
        alignment: center;
        Card {
            // Wide enough that a 64-character transaction id sits on **one**
            // line. A hash is read by comparing it against another one, and a
            // hash split across two lines at an arbitrary character is a hash
            // nobody can compare.
            width: 640px;
            VerticalLayout {
                padding: Sp.s8;
                spacing: Sp.s6;

                Text {
                    text: SendState.step == "sent" ? @tr("Payment sent") : @tr("We could not confirm your payment was sent");
                    font-size: Typo.title2;
                    font-weight: Typo.w-bold;
                    color: SendState.step == "sent" ? Theme.positive : Theme.warning;
                    wrap: word-wrap;
                }

                // Handed over, not confirmed. The distinction is the whole
                // difference between this screen and Activity, and a headline
                // reading "Payment sent" with nothing under it invites somebody
                // to treat a mempool transaction as a settled one.
                if SendState.step == "sent": Text {
                    text: @tr("A node has taken it. It settles when a block includes it — Activity is where that shows up.");
                    font-size: Typo.body;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }

                // The most important paragraph in the application. Someone who
                // resends here can pay twice.
                if SendState.step == "uncertain": Text {
                    text: @tr("It may already be on its way. Pecu has saved the exact transaction and can check on it. Do not send it again — that could send the money twice.");
                    font-size: Typo.body;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }

                TxId {
                    txid: SendState.txid;
                    explorer: SendState.explorer;
                    open-link(url) => { Actions.open-link(url); }
                }

                HorizontalLayout {
                    Rectangle { horizontal-stretch: 1; }
                    Btn {
                        text: @tr("Done");
                        variant: "primary";
                        clicked => {
                            SendState.problem = { code: "", args: [] };
                            SendState.step = "form";
                        }
                    }
                }
            }
        }
    }

    Rectangle { vertical-stretch: 1; }

}
