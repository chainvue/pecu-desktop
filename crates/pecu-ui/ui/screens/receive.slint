// Being paid: an address, a QR, and the names that also reach this wallet.

import { R, Sp, Theme, Typo } from "../theme/theme.slint";
import { Btn, Card, Eyebrow, StatusPill } from "../components/base.slint";
import { NoticeBody, NoticeTitle } from "../components/note.slint";
import { IdentityState, NetworkState, WalletState } from "../vm/state.slint";
import { KeyPicker } from "../components/form.slint";

export component ReceiveScreen inherits VerticalLayout {
    spacing: Sp.s7;

    HorizontalLayout {
        alignment: center;
        KeyPicker {}
    }

    HorizontalLayout {
        alignment: center;
        spacing: Sp.s7;

        Card {
            width: 420px;

            VerticalLayout {
                padding: Sp.s8;
                spacing: Sp.s6;

                // The QR sits on WHITE even in the dark theme. Inverted codes
                // fail on a fair number of scanners, and this happens to be
                // exactly the Apple Wallet look.
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: WalletState.qr-side + Sp.s6 * 2;
                        height: self.width;
                        background: #FFFFFF;
                        border-radius: R.lg;

                        if WalletState.address != "": Image {
                            source: WalletState.qr;
                            width: WalletState.qr-side;
                            height: WalletState.qr-side;
                            // Rules 4 and 5 from `src/qr.rs`: any residual
                            // scaling is nearest-neighbour, and the image is
                            // never stretched by a layout.
                            image-rendering: pixelated;
                            image-fit: contain;
                        }

                        if WalletState.address == "": Text {
                            text: @tr("No address yet");
                            font-size: Typo.caption;
                            color: #6E747E;
                        }
                    }
                }

                VerticalLayout {
                    spacing: Sp.s3;

                    Eyebrow { text: @tr("YOUR {} ADDRESS", WalletState.ticker); }

                    // Selectable, monospace, and wrapping mid-string: an
                    // address is read character by character when it is checked
                    // against something, and a proportional font makes that
                    // needlessly hard.
                    // Set at the size of a thing that gets checked, not at the
                    // size of a caption.
                    //
                    // This is what somebody reads character by character against
                    // whatever the sender is showing them, and it was two points
                    // smaller than the balance's currency label. It wraps to two
                    // lines here, which is the right trade: an address that
                    // fits on one line and cannot be read is not a saving.
                    //
                    // Not grouped into blocks of four, tempting as that is —
                    // Copy works by selecting this element's own text, since
                    // Slint gives an application no clipboard of its own, so
                    // spaces on screen would be spaces on the clipboard.
                    address := TextInput {
                        text: WalletState.address;
                        read-only: true;
                        font-family: Typo.mono;
                        font-size: Typo.num-lg;
                        color: Theme.text-primary;
                        wrap: char-wrap;
                        // Announced in four-character groups, because a screen
                        // reader saying raw base58 at speaking speed produces
                        // something nobody can transcribe or check.
                        accessible-role: AccessibleRole.text;
                        accessible-label: @tr("Receive address");
                        accessible-value: WalletState.address-spoken;
                    }
                }

                HorizontalLayout {
                    spacing: Sp.s4;
                    Btn {
                        text: @tr("Copy address");
                        variant: "primary";
                        horizontal-stretch: 1;
                        clicked => {
                            // The copy happens in Slint, not in Rust: Slint 1.17
                            // exposes no clipboard API to an application, only
                            // to a platform back-end. `TextInput` has one, so
                            // the address goes out through the element that
                            // already holds it.
                            address.select-all();
                            address.copy();
                        }
                    }
                }

                // The single most useful sentence on this screen, and it used to
                // be drawn as the least: centred, grey, caption-sized, below the
                // fold of the eye. A comment calling something the most
                // important thing here while the styling says otherwise is the
                // styling winning.
                //
                // Sending mainnet coins to a testnet address loses them, and the
                // two kinds of address look identical. So it gets a surface,
                // left alignment, and the chain's name in the weight of a fact.
                Rectangle {
                    background: NetworkState.effective == ""
                        ? Theme.warning-soft
                        : Theme.bg-inset;
                    border-radius: R.md;
                    // Its own children's height, not the layout's guess at it.
                    // A `Rectangle` in a `VerticalLayout` does not take its
                    // height from a `VerticalLayout` inside it, so a sentence
                    // that wraps to one more line than the parent expected
                    // renders outside the tint — see `Notice`, which exists
                    // because this was live on the send review.
                    height: chainwarning.preferred-height;
                    chainwarning := VerticalLayout {
                        padding: Sp.s4;
                        Text {
                            // One sentence with the chain in it, not a
                            // sentence sawn in half around a name — the second
                            // clause lands in a different place in most
                            // languages, including the one this is being
                            // translated into first.
                            text: NetworkState.effective == ""
                                ? @tr("No node has confirmed which chain this is — check before sharing it.")
                                : @tr("This address is on {}. Coins from any other chain sent here are lost.",
                                      NetworkState.effective);
                            font-size: Typo.caption;
                            font-weight: Typo.w-medium;
                            color: NetworkState.effective == ""
                                ? Theme.warning
                                : Theme.text-secondary;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        // The other ways to be paid, in one column.
        //
        // Shielded and by-name are alternatives to the address on the
        // left, so they stack rather than each claiming a column of their
        // own. Three 320px columns beside the address card overflowed the
        // window at the width this screen is rendered at, and the names
        // panel was clipped off the right edge — visible in the reference
        // image, which is what it is for.
        //
        // The wrapper carries the width so that neither child has to know
        // whether the other is present: either, both or neither can be
        // absent and the column is simply as tall as what is in it.
        VerticalLayout {
            width: 320px;
            spacing: Sp.s7;
            alignment: start;

            // The shielded address, when this key has one.
            //
            // Beside the transparent address rather than under it, because they
            // are not two spellings of one thing: coins sent to each are visible
            // to different people. Labelling both is the only presentation that
            // does not invite copying the wrong one.
            //
            // # Two cards rather than one card with an `if` in it
            //
            // The first version put both states inside a single `Card` and
            // branched within it. The paragraphs then rendered *below the
            // card's own bottom edge*, overlapping the eyebrow underneath, and
            // the last line was clipped — visible in the reference image, which
            // is what it is for. Binding the card's height to its inner
            // layout's `preferred-height` did not fix it: wrapping text cannot
            // report a height before it knows its width, and behind an `if`
            // that measurement came back short.
            //
            // The names card below has never had the problem, and the
            // difference is that its children are plain elements. So this
            // follows the shape that works — the branch is outside, and each
            // card holds nothing but ordinary children.
            if WalletState.shielded-address != "": VerticalLayout {
                spacing: Sp.s4;
                alignment: start;

                Eyebrow { text: @tr("OR PRIVATELY"); }

                Card {
                    // Its own content's height, stated rather than inferred.
                    //
                    // `Card` is a `Rectangle` with `@children`, and a
                    // `Rectangle` does not take its height from a
                    // `VerticalLayout` inside it — the same trap the chain
                    // warning on the left documents and `Notice` exists to
                    // solve. Without this the card came out about fifty pixels
                    // short: exactly the two extra lines the closing paragraph
                    // wraps onto. It rendered outside the card's bottom edge
                    // and over the section below.
                    //
                    // The names card gets away without it because its content
                    // happens to fit the guess, which is luck rather than a
                    // difference worth relying on.
                    height: shieldedbody.preferred-height;
                    shieldedbody := VerticalLayout {
                        padding: Sp.s5;
                        spacing: Sp.s4;

                        Text {
                            text: @tr("Paid here, the amount and the sender stay off the public chain. Only this wallet can see what arrives.");
                            font-size: Typo.caption;
                            color: Theme.text-secondary;
                            wrap: word-wrap;
                        }

                        // Same treatment as the transparent address, and for the
                        // same reason: read character by character, so monospace
                        // and wrapping mid-string. At body size rather than the
                        // larger one because it is more than twice as long and
                        // would otherwise take four lines.
                        shielded := TextInput {
                            text: WalletState.shielded-address;
                            read-only: true;
                            font-family: Typo.mono;
                            font-size: Typo.body;
                            color: Theme.text-primary;
                            wrap: char-wrap;
                            accessible-role: AccessibleRole.text;
                            accessible-label: @tr("Shielded receive address");
                            accessible-value: WalletState.shielded-address-spoken;
                        }

                        Btn {
                            text: @tr("Copy shielded address");
                            variant: "ghost";
                            clicked => {
                                // Through the element that holds it, exactly as
                                // the transparent address does — Slint gives an
                                // application no clipboard of its own.
                                shielded.select-all();
                                shielded.copy();
                            }
                        }

                        // Said plainly rather than discovered by trying: this
                        // wallet can see this money and cannot move it, because
                        // the code that builds a shielded spend is not compiled
                        // into this build at all.
                        Text {
                            text: @tr("Receiving only, for now");
                            font-size: Typo.body;
                            font-weight: Typo.w-medium;
                            color: Theme.accent;
                            wrap: word-wrap;
                        }
                        Text {
                            text: @tr("This wallet can show what arrives here and cannot yet send it on. Spending from a shielded address needs a part that is not built yet.");
                            font-size: Typo.caption;
                            color: Theme.text-secondary;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            // Why this key has none, when it can never have one.
            //
            // Its own card for the reason above, and shown only for the
            // permanent refusals: a locked wallet has not been refused
            // anything, so it gets no panel at all.
            if WalletState.shielded-address == "" && WalletState.shielded-note.code != "": VerticalLayout {
                spacing: Sp.s4;
                alignment: start;

                Eyebrow { text: @tr("OR PRIVATELY"); }

                Card {
                    VerticalLayout {
                        padding: Sp.s5;
                        spacing: Sp.s2;

                        // Not tinted. This is a fact about how the key arrived,
                        // not a warning, and the card is already a surface.
                        NoticeTitle {
                            note: WalletState.shielded-note;
                            font-size: Typo.body;
                            color: Theme.text-primary;
                            wrap: word-wrap;
                        }
                        NoticeBody {
                            note: WalletState.shielded-note;
                            font-size: Typo.caption;
                            color: Theme.text-secondary;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            // The other way to be paid.
            //
            // A VerusID receives, and a name is the one identifier on this screen
            // that a person can check by reading it. Thirty-four base58 characters
            // are compared by eye and got wrong; `robert.VRSCTEST@` is not.
            //
            // Only shown when this wallet actually controls a name — an empty
            // panel explaining a feature nobody has is an advertisement, and this
            // screen is not the place for one.
            if IdentityState.rows.length > 0: VerticalLayout {
                spacing: Sp.s4;
                alignment: start;

                Eyebrow { text: @tr("OR BY NAME"); }

                Card {
                    VerticalLayout {
                        padding: Sp.s5;
                        spacing: Sp.s4;

                        Text {
                            text: @tr("These names reach this wallet too. A name can be read back and checked; an address is thirty-four characters somebody compares by eye.");
                            font-size: Typo.caption;
                            color: Theme.text-secondary;
                            wrap: word-wrap;
                        }

                        for row in IdentityState.rows: VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: row.name;
                                font-family: Typo.mono;
                                font-size: Typo.body;
                                font-weight: Typo.w-bold;
                                color: Theme.text-primary;
                                overflow: elide;
                            }
                            // The status matters here in a way it does not on the
                            // profile screen: a revoked or locked name is one that
                            // should not be handed to somebody as a way to pay.
                            StatusPill {
                                state: row.tone;
                                text: row.status;
                            }
                        }
                    }
                }
            }
        }

    }

    Rectangle { vertical-stretch: 1; }
}
