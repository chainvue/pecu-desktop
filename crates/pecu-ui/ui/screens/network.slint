// Which chain, and which node on it.

import { Sp, Theme, Typo } from "../theme/theme.slint";
import { Btn, Card, EmptyState, Eyebrow, ListRow, Segmented, StatusPill } from "../components/base.slint";
import { Actions, NetworkState } from "../vm/state.slint";
import { Field } from "../components/form.slint";

// Configuring an endpoint of your own.
//
// Its own component because its two inputs have to be readable from one place —
// an input declared inside an `if` cannot be reached from outside it — and
// because the form has to be able to clear itself once the node is accepted.
export component AddNodeForm inherits VerticalLayout {
    spacing: Sp.s4;

    HorizontalLayout {
        spacing: Sp.s4;

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Sp.s3;
            Text {
                text: @tr("Address");
                font-size: Typo.caption;
                color: Theme.text-secondary;
            }
            url := Field {
                mono: true;
                placeholder: "https://my-node.example:27486";
                text <=> NetworkState.draft-url;
                accepted => { root.submit(); }
                edited => { NetworkState.problem = ""; }
            }
        }

        VerticalLayout {
            width: 200px;
            spacing: Sp.s3;
            Text {
                text: @tr("Name (optional)");
                font-size: Typo.caption;
                color: Theme.text-secondary;
            }
            name := Field {
                placeholder: @tr("my node");
                text <=> NetworkState.draft-label;
                accepted => { root.submit(); }
            }
        }
    }

    if NetworkState.problem != "": Text {
        text: NetworkState.problem;
        font-size: Typo.caption;
        color: Theme.negative;
        wrap: word-wrap;
    }

    HorizontalLayout {
        spacing: Sp.s5;
        Text {
            horizontal-stretch: 1;
            // The one sentence worth having here. Someone typing an address in
            // is about to be told "no" by a rule they cannot see otherwise.
            text: @tr("Pecu only talks to encrypted endpoints, so an https:// address is required unless the node is on this machine. It never sends a key to a node.");
            font-size: Typo.caption;
            color: Theme.text-tertiary;
            wrap: word-wrap;
            vertical-alignment: center;
        }
        Btn {
            text: @tr("Add node");
            variant: "primary";
            enabled: url.text != "";
            y: (parent.height - self.height) / 2;
            clicked => { root.submit(); }
        }
    }

    // The fields are NOT cleared here. Rust clears them once the node has
    // actually been accepted — so a refused address is still on screen to be
    // corrected rather than retyped from memory.
    function submit() {
        if (url.text == "") { return; }
        NetworkState.problem = "";
        Actions.add-node(name.text, url.text);
    }
}

export component NodesScreen inherits VerticalLayout {
    spacing: Sp.s7;

    HorizontalLayout {
        spacing: Sp.s5;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Sp.s2;
            // No screen heading here: the title bar already says "Network", and
            // the two sat one above the other. Visible in a render, invisible
            // in the source.
            Text {
                // The distinction that matters: what you asked for versus what
                // the node says it is. Only the second decides anything.
                // Whole sentences, not fragments glued together: a language
                // that puts the verb last cannot be built from "Requested " +
                // a name + " · connected to " + another one.
                text: NetworkState.effective == ""
                    ? @tr("Requested {} · no node has answered yet", NetworkState.requested)
                    : @tr("Requested {} · connected to {}",
                          NetworkState.requested, NetworkState.effective);
                font-size: Typo.caption;
                color: Theme.text-secondary;
            }
        }
        Btn {
            text: @tr("Probe nodes");
            y: (parent.height - self.height) / 2;
            clicked => { Actions.probe-nodes(); }
        }
    }

    // Not offered in the demo build. There is one scripted chain, and a chooser
    // that moved a scripted wallet between two directories would be a control
    // whose only effect is to lose the demo.
    if !NetworkState.mock-mode: VerticalLayout {
        spacing: Sp.s2;
        Eyebrow { text: @tr("CHAIN"); }
        Card {
            VerticalLayout {
                padding: Sp.s5;
                spacing: Sp.s3;
                Segmented {
                    width: 320px;
                    options: [@tr("Testnet"), @tr("Mainnet")];
                    index <=> NetworkState.chain-index;
                    changed(i) => {
                        Actions.set-requested-network(i == 1 ? "VRSC" : "VRSCTEST");
                    }
                }
                Text {
                    text: @tr("Each chain is a separate wallet: its own keys, its own history, its own saved nodes. Nothing is shared between them, and changing chains locks the wallet.");
                    font-size: Typo.caption;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
            }
        }
    }

    Card {
        VerticalLayout {
            padding: Sp.s3;

            if NetworkState.nodes.length == 0: Rectangle {
                height: 120px;
                EmptyState {
                    glyph: "◌";
                    title: @tr("No nodes configured");
                    body: @tr("Pecu needs a Verus RPC endpoint to read the chain. It never sends a key to one.");
                }
            }

            for node in NetworkState.nodes: ListRow {
                glyph: node.active ? "●" : "○";
                glyph-tone: node.status == "online" ? Theme.positive
                    : node.status == "degraded" ? Theme.warning
                    : node.status == "offline" ? Theme.negative
                    : Theme.text-tertiary;
                title: node.label;
                subtitle: node.url;
                subtitle-mono: true;
                selected: node.active;
                clicked => { Actions.select-node(node.id); }

                HorizontalLayout {
                    spacing: Sp.s5;
                    alignment: end;

                    if node.note != "": Text {
                        text: node.note;
                        font-size: Typo.caption;
                        color: Theme.warning;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    // Which chain this node says it is on. Never derived from
                    // the URL — a hostname containing "test" proves nothing.
                    if node.network != "": Text {
                        text: node.network;
                        font-size: Typo.caption;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }

                    if node.tip != "": Text {
                        text: node.tip;
                        font-family: Typo.mono;
                        font-size: Typo.num-sm;
                        color: Theme.text-tertiary;
                        vertical-alignment: center;
                    }

                    if node.latency != "": Text {
                        text: node.latency;
                        font-family: Typo.mono;
                        font-size: Typo.num-sm;
                        color: Theme.text-tertiary;
                        vertical-alignment: center;
                    }

                    // The status word, not the chain name. Colour is never the
                    // only signal that a node is reachable — a green dot beside
                    // "Testnet" says which chain and nothing at all about
                    // whether it answered.
                    //
                    // Fixed width so the pills line up down the column. Every
                    // item before this one is optional, so without it each row
                    // ends wherever its own content happens to run out.
                    StatusPill {
                        width: 88px;
                        state: node.status;
                        // The core names the state; the words are here. Four
                        // values, so a ternary rather than a component — the
                        // same rule `note.slint` applies to a refusal.
                        text: node.status == "online" ? @tr("online")
                            : node.status == "degraded" ? @tr("degraded")
                            : node.status == "offline" ? @tr("offline")
                            : node.status;
                        y: (parent.height - self.height) / 2;
                    }

                    // The slot is always here; the button is not. Reserving the
                    // space keeps the status column straight whether or not the
                    // row can be removed — and a column that shifts by a button
                    // width is the sort of thing that reads as unfinished
                    // without anyone being able to say why.
                    Rectangle {
                        width: 96px;

                        // Only what the user added. A built-in comes from the
                        // build, so removing one would last until the next
                        // start and then quietly undo itself — the core refuses
                        // it, and offering a button that cannot work is worse
                        // than not offering one.
                        if !node.builtin: Btn {
                            text: @tr("Remove");
                            x: parent.width - self.width;
                            y: (parent.height - self.height) / 2;
                            clicked => { Actions.remove-node(node.id); }
                        }
                    }
                }
            }
        }
    }

    VerticalLayout {
        spacing: Sp.s4;
        Eyebrow { text: @tr("ADD A NODE"); }
        Card {
            VerticalLayout {
                padding: Sp.card-pad;
                AddNodeForm {}
            }
        }
    }

    Rectangle { vertical-stretch: 1; }
}
