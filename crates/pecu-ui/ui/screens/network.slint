// Which chain, and which node on it.

import { Sp, Theme, Typo } from "../theme/theme.slint";
import { Btn, Card, EmptyState, Eyebrow, ListRow, Segmented, StatusPill } from "../components/base.slint";
import { Actions, NetworkState } from "../vm/state.slint";
import { Field } from "../components/form.slint";
import { NoteText, NoticeTitle } from "../components/note.slint";

export component NodesScreen inherits VerticalLayout {
    spacing: Sp.s7;

    HorizontalLayout {
        spacing: Sp.s5;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Sp.s2;
            // No screen heading here: the title bar already says "Network", and
            // the two sat one above the other. Visible in a render, invisible
            // in the source.
            Text {
                // The distinction that matters: what you asked for versus what
                // the node says it is. Only the second decides anything.
                // Whole sentences, not fragments glued together: a language
                // that puts the verb last cannot be built from "Requested " +
                // a name + " · connected to " + another one.
                //
                // `effective` is empty in two states, not one: nothing has
                // answered yet, and the active node answered with a name and a
                // chain id that contradict each other. "No node has answered
                // yet" is false in the second, and on this screen it would sit
                // directly above a row reading "calls itself VRSCTEST but
                // reports chain id i5w5…". One sentence is true of both — in
                // neither case has anything said which chain this is — and the
                // row underneath is where the difference belongs.
                text: NetworkState.effective == ""
                    ? @tr("Requested {} · no node has said which chain it is on", NetworkState.requested)
                    : @tr("Requested {} · connected to {}",
                          NetworkState.requested, NetworkState.effective);
                font-size: Typo.caption;
                color: Theme.text-secondary;
            }
        }
        Btn {
            text: @tr("Probe nodes");
            y: (parent.height - self.height) / 2;
            clicked => { Actions.probe-nodes(); }
        }
    }

    // Not offered in the demo build. There is one scripted chain, and a chooser
    // that moved a scripted wallet between two directories would be a control
    // whose only effect is to lose the demo.
    if !NetworkState.mock-mode: VerticalLayout {
        spacing: Sp.s2;
        Eyebrow { text: @tr("CHAIN"); }
        Card {
            VerticalLayout {
                padding: Sp.s5;
                spacing: Sp.s3;
                // One button per chain, from the core.
                //
                // Not a `Segmented` any more: that takes a fixed list of
                // labels and gives back an index, so the interface had to turn
                // the index back into a name — which it did with a ternary
                // holding `"VRSC"` and `"VRSCTEST"` as literals. Five chains
                // is where that stops being possible and starts being wrong.
                //
                // What goes back is `chain.name`, never `chain.title`: the
                // title is for reading and the name is what every guard in the
                // core compares against.
                HorizontalLayout {
                    spacing: Sp.s3;
                    alignment: start;
                    for chain in NetworkState.chains: Btn {
                        text: chain.title;
                        variant: NetworkState.requested-name == chain.name ? "primary" : "";
                        clicked => { Actions.set-requested-network(chain.name); }
                    }
                }
                Text {
                    text: @tr("Each chain is a separate wallet: its own keys, its own history, its own coins. Nothing is shared between them, and changing chains locks the wallet.");
                    font-size: Typo.caption;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
            }
        }
    }

    // Where shielded notes come from.
    //
    // Its own card, below the nodes, because it is not one of them: an RPC node
    // answers about transparent addresses over JSON-RPC, and this streams
    // compact blocks over gRPC so a wallet can trial-decrypt them without
    // telling anyone which notes are its own. A wallet can have a healthy node
    // and no shielded server, which is the ordinary state.
    Eyebrow { text: @tr("SHIELDED"); }

    Card {
        VerticalLayout {
            padding: Sp.s5;
            spacing: Sp.s4;

            Text {
                text: NetworkState.light-server == ""
                    ? @tr("Without one, this wallet cannot look for shielded notes — so it says nothing about the balance rather than reporting zero.")
                    : @tr("Shielded notes are read from here. Nothing about which notes are yours is sent to it.");
                font-size: Typo.caption;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }

            lightserver := Field {
                mono: true;
                placeholder: @tr("http://127.0.0.1:9067");
                text: NetworkState.light-server;
            }

            HorizontalLayout {
                spacing: Sp.s4;
                // Sized to their words. Without this a single button stretches
                // to the card's full width and reads as a banner rather than
                // something to press.
                alignment: start;
                Btn {
                    text: @tr("Use this server");
                    variant: "primary";
                    clicked => { Actions.set-light-server(lightserver.text); }
                }
                if NetworkState.light-server != "": Btn {
                    text: @tr("Forget it");
                    variant: "secondary";
                    clicked => {
                        lightserver.text = "";
                        Actions.set-light-server("");
                    }
                }
            }

            Text {
                text: @tr("It sees which blocks are asked for, and from where — never which of them hold your notes, and never a key. Testnet defaults to Verus' own server; a lightwalletd of your own works here too.");
                font-size: Typo.micro;
                color: Theme.text-tertiary;
                wrap: word-wrap;
            }
        }
    }

    Card {
        VerticalLayout {
            padding: Sp.s3;

            if NetworkState.nodes.length == 0: Rectangle {
                height: 120px;
                EmptyState {
                    glyph: "◌";
                    title: @tr("No nodes configured");
                    body: @tr("Pecu needs a Verus RPC endpoint to read the chain. It never sends a key to one.");
                }
            }

            for node in NetworkState.nodes: ListRow {
                glyph: node.active ? "●" : "○";
                glyph-tone: node.status == "online" ? Theme.positive
                    : node.status == "degraded" ? Theme.warning
                    : node.status == "offline" ? Theme.negative
                    : Theme.text-tertiary;
                title: node.label;
                subtitle: node.url;
                subtitle-mono: true;
                selected: node.active;
                clicked => { Actions.select-node(node.id); }

                HorizontalLayout {
                    spacing: Sp.s5;
                    alignment: end;

                    if node.note.code != "": NoteText {
                        note: node.note;
                        font-size: Typo.caption;
                        color: Theme.warning;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    // Which chain this node says it is on. Never derived from
                    // the URL — a hostname containing "test" proves nothing.
                    if node.network != "": Text {
                        text: node.network;
                        font-size: Typo.caption;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }

                    if node.tip != "": Text {
                        text: node.tip;
                        font-family: Typo.mono;
                        font-size: Typo.num-sm;
                        color: Theme.text-tertiary;
                        vertical-alignment: center;
                    }

                    if node.latency != "": Text {
                        text: node.latency;
                        font-family: Typo.mono;
                        font-size: Typo.num-sm;
                        color: Theme.text-tertiary;
                        vertical-alignment: center;
                    }

                    // The status word, not the chain name. Colour is never the
                    // only signal that a node is reachable — a green dot beside
                    // "Testnet" says which chain and nothing at all about
                    // whether it answered.
                    //
                    // Fixed width so the pills line up down the column. Every
                    // item before this one is optional, so without it each row
                    // ends wherever its own content happens to run out.
                    StatusPill {
                        width: 88px;
                        state: node.status;
                        // The core names the state; the words are here. Four
                        // values, so a ternary rather than a component — the
                        // same rule `note.slint` applies to a refusal.
                        text: node.status == "online" ? @tr("online")
                            : node.status == "degraded" ? @tr("degraded")
                            : node.status == "offline" ? @tr("offline")
                            : node.status;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }
        }
    }

    // There was an "ADD A NODE" form here, and a Remove button on every row
    // somebody had added.
    //
    // Both are gone while the shipped list is one endpoint per chain. A node is
    // where this wallet reads balances and hands over signed transactions, so
    // choosing one is a security decision — and the form asked for it in a text
    // box, on a screen most people pass through once. What is offered now is
    // what this build ships and has been checked against.
    //
    // The core still refuses to remove a built-in, and `Command::AddNode` still
    // exists: nothing was taken out of the wallet, only out of the way in.
    Rectangle { vertical-stretch: 1; }
}
