// The one thing taken from the standard widget set, and taken by name.
//
// `ListView` is the only element in Slint that builds just the rows somebody can
// see. Everything else here is drawn from scratch on this project's own tokens —
// but there is no lower-level virtualising repeater to build on, and a plain
// `for` over a real transaction history costs 2.9 seconds of frozen UI thread at
// fifty thousand rows (`examples/scroll_cost.rs`).
//
// Imported by name rather than wholesale: `std-widgets.slint` exports `Palette`,
// which collides with this project's own theme global. One name, one collision
// avoided, and the widget style reaches nothing else.
import { ListView } from "std-widgets.slint";
import { Theme, Sp, R, Typo, Motion, InputMode } from "theme/theme.slint";
import { Btn, Card, Eyebrow, Money, StatusPill, Skeleton, EmptyState, ListRow, Segmented } from "components/base.slint";
import { NavRail, TitleBar, StatusBar } from "components/shell.slint";
import { AppIcon } from "icon.slint";
import { NavItem, NodeRow, KeyRow, KnownAddressRow, AssetRow, ActivityRow, SeedWord, ReviewOutput, PendingRow, ToastRow, IdentityRow, ContentEntry, CurrencyRow, EligibleIdentity, CurrencySlice, CurrencyField, CurrencyProblem, FlowStep, ReserveEntry, PreallocEntry, CurrencyPick } from "vm/structs.slint";

// Re-exported from the compile root so `slint-build` generates Rust types for
// them. A global that is only imported here stays invisible to Rust — `Theme`
// has to be reachable so the binary can flip dark/light.
export { NavItem, NodeRow, KeyRow, KnownAddressRow, AssetRow, ActivityRow, SeedWord, ReviewOutput, PendingRow, ToastRow, IdentityRow, ContentEntry, CurrencyRow, EligibleIdentity, CurrencySlice, CurrencyField, CurrencyProblem, FlowStep, ReserveEntry, PreallocEntry, CurrencyPick }
export { Theme, Motion, InputMode }
// Rendered to a PNG by `examples/render_icon.rs`, never shown. Exported from
// here because this file is the one compile root — see `build.rs`.
export { AppIcon }

// ── The data the UI is given ────────────────────────────────────────────────
//
// One global per state slice, mirroring the `Event` enum on the Rust side.
// Nothing here is a handle or a key — every value is a finished view model, and
// every amount is a pre-formatted string (see `vm/structs.slint` for why money
// cannot be an `int` or a `float` in Slint).

export global WalletState {
    in property <bool> exists: false;
    in property <bool> locked: true;
    in property <string> name: "";
    // The ACTIVE key's address — what Receive shows and what Send pays from.
    in property <string> address: "";
    // The same address in four-character groups, for `accessible-value` only.
    // Never rendered: a space somebody copies is an address that fails its
    // checksum. See `pecu_ui::spoken`.
    in property <string> address-spoken: "";
    // Every key in the vault. Readable while locked, because an address is
    // public: that is what lets someone be paid without unlocking anything.
    in property <[KeyRow]> keys: [];
    in property <string> active-key: "";
    // Which key the rename form is open on, and what is being typed into it.
    // Held here rather than inside the row so that only one row can be in edit
    // at a time, and so Rust can close the form when the rename actually lands
    // — but not when it is refused, which would take away the name someone was
    // halfway through fixing.
    in-out property <string> renaming: "";
    in-out property <string> rename-draft: "";
    in-out property <string> new-key-draft: "";
    // Why the last key operation was refused, shown on the keys section.
    in-out property <string> key-problem: "";
    in property <bool> loading: true;
    in property <bool> busy: false;
    /// Set when unlocking or creating failed, cleared on the next attempt.
    in property <string> problem: "";

    // What to write next to an amount. From the node's own chain name, never
    // a default: a screen that labels testnet coins "VRSC" has stopped being
    // able to tell you which money you are looking at.
    in property <string> ticker: "VRSC";
    in property <string> total: "0.0000 0000";
    in property <string> spendable: "0.0000 0000";
    in property <string> immature: "0.0000 0000";
    in property <string> pending: "0.0000 0000";
    // Only shown when it differs from the total — a wallet with everything
    // spendable stays calm and says nothing extra.
    in property <bool> has-breakdown: false;
    in property <string> matures-in: "";

    in property <[AssetRow]> assets: [];
    // The dashboard's short list, and the whole thing for the Activity screen.
    // Two models rather than one sliced, because Slint's `for` has no window.
    in property <[ActivityRow]> activity: [];
    in property <[ActivityRow]> history: [];
    // The scan has reached the start of the chain. Until it has, there may be
    // older transactions nobody has looked for yet — which is not the same as
    // there being none.
    in property <bool> history-complete: false;
    in property <bool> loading-history: false;
    // The chain tip, so a row can work out its own confirmations. A new block
    // updates ONE integer and every visible row recomputes itself — no model
    // mutation, no notification storm.
    in property <int> tip-height: 0;
    // Arriving: seen in the mempool, not yet mined.
    in property <string> incoming: "";
    // The figures are from an earlier read and the last one did not finish.
    // Distinct from "loading": these numbers were true, just not now.
    in property <bool> stale: false;

    /// Minutes of inactivity before the wallet locks itself; 0 means never.
    in property <int> auto-lock: 5;
    /// Where the wallet file is, for the About section.
    in property <string> vault-path: "";

    /// The receive address, as a QR code. Rendered in Rust because the module
    /// size has to be a whole number of PHYSICAL pixels — see `src/qr.rs`.
    in property <image> qr;
    /// The logical size to draw it at, so one buffer pixel is one device pixel.
    in property <length> qr-side: 240px;

    /// The label of a key whose recovery phrase nobody has written down, or
    /// empty. Persisted in the vault file, so this survives a restart — a
    /// wallet created and then closed mid-backup still finds its way back to
    /// its own words.
    in property <string> backup-key: "";
}

// The one screen that shows a recovery phrase.
//
// The words are only ever in `words` while the reveal button is physically
// held down. The rest of the time Rust has overwritten every row with bullets,
// which is why concealing is not the same as emptying the model.
export global SeedState {
    // "" (closed) | "passphrase" | "phrase" | "verify"
    //
    // The UI owns this: the screen is a place the user is, not a fact about the
    // wallet. Rust opens it (a phrase exists to show) and closes it (the backup
    // was recorded); everything in between is navigation.
    in-out property <string> step: "";
    in property <[SeedWord]> words: [];
    /// 1-based positions the confirmation step asks for. Chosen in core — a
    /// screen that picked its own could pick the same three every time.
    in property <[int]> challenge: [];
    in-out property <string> problem: "";
    in property <bool> busy: false;
}

// Sending.
//
// Nothing here is secret — an address and an amount are public the moment the
// transaction is. What is deliberately absent is the signed transaction: the UI
// holds a ticket number, and the bytes stay in the core. A UI that held them
// would be a UI that could be made to send them.
export global SendState {
    // "form" | "review" | "sent" | "uncertain"
    in-out property <string> step: "form";
    in property <bool> busy: false;

    // What is in the two boxes.
    //
    // Held here rather than inside the form, for the reason `restoring` gives
    // itself on the onboarding screen: a state no test can reach is a state
    // that quietly rots. These were local element text, so **no fixture could
    // put a recipient or an amount on the send screen** — which is why the only
    // reference image of this form is an empty one, and why the note under the
    // amount field had never been photographed at any length.
    //
    // The interface's own drafts, not the core's: nothing is sent from here
    // until Review. The wallet already keeps `rename-draft` and `lookup-draft`
    // the same way, and for the second half of the same reason — Rust can clear
    // them, on success only.
    in-out property <string> to-draft: "";
    in-out property <string> amount-draft: "";

    // Verdicts from core, which owns address parsing and the fee rules.
    in property <bool> to-valid: false;
    in property <string> to-note: "";
    in property <bool> amount-valid: false;
    in property <string> amount-note: "";
    in property <bool> ready: false;

    // The review, decoded from the signed transaction.
    in property <int> ticket: 0;
    in property <[ReviewOutput]> outputs: [];
    in property <string> amount: "";
    in property <string> fee: "";
    in property <string> total: "";
    in property <string> change: "";
    in property <string> balance-after: "";
    in property <string> from-address: "";
    // This wallet has never successfully paid the recipient before. Worth
    // saying: a mistyped address that happens to be valid looks exactly like a
    // correct one, and "you have paid this before" is the only thing the wallet
    // can offer that a checksum cannot.
    in property <bool> first-time-recipient: false;
    // The VerusID name this was addressed to, when it was addressed by name.
    // Empty for an address typed out.
    //
    // Shown beside the outputs, never instead of them. Somebody who typed
    // `meineid@` has no way to check an i-address they have never seen — and
    // somebody shown only the name is being asked to trust a lookup nobody told
    // them happened. Both halves, or neither is worth anything.
    in property <string> recipient-name: "";

    // Payments handed over whose outcome is unknown. Survives a restart,
    // because the bytes do.
    in property <[PendingRow]> pending-rows: [];

    // Who this wallet has paid. On the settings screen, and consulted by the
    // recipient field — a name is only worth having where somebody is checking
    // an address they just pasted.
    in property <[KnownAddressRow]> known: [];
    // Which address the naming form is open on, and what is being typed.
    in-out property <string> naming: "";
    in-out property <string> name-draft: "";

    // The outcome.
    in property <string> txid: "";
    in-out property <string> problem: "";
}

// One transaction, opened.
// The VerusIDs screen.
//
// One list, not two. An identity somebody looked up sits beside their own, and
// `mine` on the row is what tells them apart — two lists would let the same
// identity appear twice and answer differently.
// The currencies this wallet's identities define.
//
// Two lists from one walk, and they are the two halves of the same question:
// every identity either defines a currency or could still define one. They
// arrive in a single event so the picker can never offer a name the list above
// it has just shown as taken.
export global CurrencyState {
    in property <[CurrencyRow]> rows: [];
    in property <[EligibleIdentity]> eligible: [];
    in property <bool> busy: false;

    // ── Configuring one ─────────────────────────────────────────────────
    // Whether the form is open. Purely the interface's business until somebody
    // presses the button — same shape as `IdentityState.claiming`, and here for
    // the same reason: the form's Cancel and the window's Escape both reach it.
    in-out property <bool> defining: false;
    // Which question the form is on:
    // "kind" → "under" → ("authority" when a name is being claimed) → "setup"
    // → "review". Same shape as `SendState.step` and `IdentityState.claim-step`,
    // and reset with `defining` for the same reason: a form reopened later must
    // not start halfway through somebody else's answers.
    in-out property <string> form-step: "kind";

    // The draft, held here so a fixture can put a half-configured currency on
    // screen. Element text cannot be reached from outside an `if`, and a state
    // no test can reach is a state that quietly rots.
    in-out property <string> kind: "token";
    in-out property <string> identity: "";
    // Its name, for the collapsed row. Carried beside the address rather than
    // looked up again: the picker already had it, and searching the list for a
    // name the wallet is holding is a second source of the same fact.
    in-out property <string> identity-name: "";
    in-out property <bool> mintable: false;
    in-out property <string> start-delay: "20";
    // The rows are edited through `Actions`, because adding and removing one
    // changes the length of a model and Slint cannot do that from a binding.
    in-out property <[ReserveEntry]> reserve-rows: [];
    in-out property <[PreallocEntry]> supply-rows: [];

    // ── Choosing a reserve ──────────────────────────────────────────────
    // Which reserve row the picker is open for. `-1` is closed — one field
    // rather than a flag and an index, the same rule `TxState.txid` follows, so
    // the overlay and the row it will write to cannot disagree.
    in-out property <int> picking-reserve: -1;
    in-out property <string> choices-query: "";
    // What the chain's list holds that matches. Built in core: Slint cannot
    // filter a model in a binding, and what counts as a match is a rule worth a
    // test rather than a binding nobody can check.
    in property <[CurrencyPick]> choices: [];
    // How many more matched than are carried. A list that truncated silently
    // would read as "that is all there is" while hiding the one being looked
    // for.
    in property <int> choices-more: 0;
    in property <bool> choices-busy: false;
    in property <string> choices-problem: "";

    // What core makes of it. Everything below is computed there — the bars, the
    // captions beside them and the preview are three renderings of one
    // arithmetic, and three places dividing the same totals will one day
    // disagree in front of somebody spending two hundred coins.
    in property <[CurrencyProblem]> problems: [];
    in property <bool> ready: false;
    in property <[CurrencySlice]> slices: [];
    in property <string> weights-total: "";
    in property <string> supply-total: "";
    in property <[CurrencySlice]> supply-slices: [];
    in property <string> start-block: "";
    in property <string> fee: "";
    in property <[CurrencyField]> preview: [];
    // Where the launch has got to. Four steps, and two of them cost money.
    in property <[FlowStep]> steps: [];

    // ── The last moment before it is irreversible ───────────────────────
    // A ticket of 0 means there is no review open. One field, not two — the
    // same rule the identity sheet follows, so the two cannot disagree.
    in property <int> launch-ticket: 0;
    in property <string> launch-name: "";
    in property <string> launch-description: "";
    in property <string> launch-fee: "";
    in property <string> launch-deposit: "";
    in property <string> launch-burned: "";
    // The height the currency begins at, off the signed bytes rather than off
    // the form. A launch is not instant and this is the last screen that can
    // say when it starts.
    in property <string> launch-start-block: "";
    in property <bool> launch-busy: false;
    // How many of `problems` stop the launch. Counted in the bridge because
    // Slint cannot filter a model in a binding, and the pinned bar needs the
    // number rather than the list.
    in property <int> blocking-count: 0;

    // ── A currency waiting for its name ─────────────────────────────────
    // Non-empty when one is unfinished. Two waits, and they are not the same:
    // waiting for a name may still be abandoned for nothing, while waiting to
    // define under one that already exists means an identity has been paid for
    // with nothing made under it — and it can never be used for a different
    // currency.
    in property <string> pending-identity: "";
    in property <string> pending-note: "";
    in property <bool> pending-can-continue: false;
    // The same diagram the form drew as a plan, now as progress. Its own
    // property rather than `steps`, because one is what will happen and the
    // other is what has — and a single model would make the form's plan flicker
    // into progress for a launch it is not describing.
    in property <[FlowStep]> pending-steps: [];

    // ── Claiming a name as part of the launch ───────────────────────────
    // Which of the two ways in is showing. The interface's own business — core
    // is told nothing until a button is pressed — but it lives here so the
    // chooser and the form can both reach it.
    in-out property <bool> claiming: false;
    // Non-empty when the currency is to be defined under a name that does not
    // exist yet. Exactly one of this and `identity` is ever set; core refuses a
    // draft carrying both rather than picking one.
    in-out property <string> new-name: "";
    // What the chain and the local rule make of that name, and what claiming it
    // costs. Both arrive from the same check the identity screen uses.
    in property <string> new-name-problem: "";
    in property <string> new-name-fee: "";
    // Who may revoke and who may recover the identity that gets claimed.
    //
    // Offered here rather than left to a later update because leaving them
    // blank makes the identity its own authority, which means it can never be
    // revoked — and finding that out afterwards costs another transaction.
    in-out property <string> new-revocation: "";
    in-out property <string> new-recovery: "";
    // The answer to that question: "" | "none" | "other". Empty is not a
    // default — it is the step being unanswered, and the form will not move past
    // it. The same rule `IdentityState.claim-authority` follows, because it is
    // the same decision with the same permanent consequence.
    in-out property <string> new-authority: "";
}

export global IdentityState {
    // Yours, and the ones somebody looked up. Two lists, because they answer
    // different questions — one is a fact about your keys, the other is what
    // you just asked about. One list forced the heading to lie about one of
    // them, and it did: a stranger's identity sat under "found by asking the
    // chain which names your keys control" until the wallet was restarted.
    in property <[IdentityRow]> rows: [];
    in property <[IdentityRow]> looked-up: [];
    in property <bool> busy: false;
    // Whether the claim form is open.
    //
    // Purely the interface's business — the core is told nothing until somebody
    // presses the button — but it lives here rather than on the screen so the
    // form's own Cancel and the window's Escape can both reach it.
    //
    // Claiming a name is rare and looking one up is not, and the form is three
    // fields and a paragraph tall. Left permanently open it pushed the lookup
    // below the fold on the screen whose whole purpose is finding an identity.
    in-out property <bool> claiming: false;
    // Whether the authority form inside the detail sheet is open. Same
    // reasoning as `claiming`, one level down.
    in-out property <bool> changing-authorities: false;
    // The lookup field, kept here so Rust can clear it on success only.
    in-out property <string> lookup-draft: "";
    // Why a lookup found nothing. Empty when there is nothing to say.
    in-out property <string> lookup-problem: "";

    // ── The detail sheet ────────────────────────────────────────────────
    //
    // Open exactly when `address` is non-empty. No second flag that could
    // disagree with it, the same rule `TxState.txid` follows.
    in-out property <string> address: "";
    in property <string> name: "";
    in property <string> status: "";
    in property <string> tone: "";
    in property <[string]> primary-addresses: [];
    in property <string> signatures-required: "";
    in property <string> control-note: "";
    // Whether this wallet can sign for it. Decides which actions are offered —
    // a fact, not something read out of the sentence above.
    in property <bool> can-sign: false;
    in property <string> revocation-authority: "";
    in property <string> recovery-authority: "";
    // The identity's recovery authority is itself, which makes it
    // UNREVOKABLE — consensus refuses a revocation whose subject is its own
    // recovery authority. A fresh registration lands on exactly this by
    // default and nothing says so at the time.
    in property <bool> cannot-be-revoked: false;
    in property <string> timelock-note: "";
    in property <string> balance: "";

    // What it holds now, and everything it has ever published. Two different
    // questions with two different answers, so two lists rather than one
    // toggle over the same rows.
    in property <[ContentEntry]> content: [];
    in property <[ContentEntry]> content-history: [];
    in-out property <int> content-view: 0;

    // ── Claiming a name ─────────────────────────────────────────────────
    // Which question the form is on: "name" | "authority" | "review". Same
    // shape as `SendState.step`, and reset with `claiming` so a form reopened
    // later does not start halfway through somebody else's answers.
    in-out property <string> claim-step: "name";
    // The answer to the second question: "" | "none" | "other". Empty is not a
    // default — it is the step being unanswered, and the form will not move
    // past it. That is the point of the step existing.
    in-out property <string> claim-authority: "";
    in-out property <string> name-draft: "";
    // Why the name will not do. Empty when it is fine.
    in property <string> name-problem: "";
    // What registering it would cost. Empty until a node has said.
    in property <string> name-fee: "";
    // Who may revoke and who may recover. Blank leaves the identity as its
    // own — which makes it unrevokable until somebody changes it.
    in-out property <string> revocation-draft: "";
    in-out property <string> recovery-draft: "";

    // A claim in progress. Empty step means there is none.
    in property <string> reg-step: "";
    in property <string> reg-name: "";
    in property <string> reg-note: "";
    // The block the claim must be registered by. This is the fact worth the
    // whole panel: the window is about twenty blocks and missing it spends
    // the fee for nothing.
    in property <string> reg-deadline: "";
    in property <string> reg-fee: "";
    in property <string> reg-address: "";
    // The three transactions a claim is made of, and how far it has got. Built
    // in the core — how many there are and which cost money are chain facts.
    // Empty when the claim ended without finishing, because a diagram of a
    // journey nobody is on any more is worse than none.
    in property <[FlowStep]> reg-steps: [];
    in property <bool> reg-busy: false;
    in property <bool> reg-cannot-be-revoked: false;

    // ── Changing the open identity ──────────────────────────────────────
    in-out property <string> new-revocation: "";
    in-out property <string> new-recovery: "";
    in-out property <string> lock-blocks: "";
    // A change built and signed but not sent. A ticket of 0 means none.
    in property <int> change-ticket: 0;
    in property <string> change-description: "";
    in property <string> change-fee: "";
    in property <bool> change-busy: false;
    // The word that has to be typed before this can be sent, empty when none
    // is needed. Only a revocation asks for one.
    //
    // The word rather than a flag, so the prompt, the placeholder and the
    // button's gate all read it from the core instead of each spelling
    // "revoke" out again.
    in property <string> change-confirmation: "";
    in-out property <string> change-typed: "";

    // The try-a-key search. The forward direction is the only one there is.
    in-out property <string> key-draft: "";
    in property <string> derived-key: "";
    in property <bool> derived-present: false;
}

export global TxState {
    // Empty when nothing is open. The sheet is the txid being non-empty —
    // there is no second flag that could disagree with it.
    in-out property <string> txid: "";
    in property <string> when: "";
    in property <string> amount: "";
    in property <string> direction: "in";
    // False when the amount is already a token line naming its own currency —
    // appending the chain's ticker would read as "12 345 mambo VRSCTEST".
    in property <bool> amount-is-native: true;
    in property <string> confirmations: "";
    in property <string> height: "";
    // Empty when the node did not volunteer one. A fee is inputs minus
    // outputs, and the input values live in other transactions.
    in property <string> fee: "";
    in property <[string]> currency-lines: [];
    in property <string> explorer: "";
    // Arrives one request later, so the sheet opens instantly and this fills in.
    in property <string> raw: "";
    in-out property <bool> advanced: false;
}

export global NetworkState {
    in property <[NodeRow]> nodes: [];
    in property <string> requested: "Testnet";
    // The same answer as `requested`, as the index of the chain chooser.
    //
    // Two-way bound, so the control follows the wallet rather than the other
    // way round: a switch the core refuses — there is a payment in flight —
    // puts the selection back where it was, instead of leaving a chooser
    // pointing at a chain nobody is on.
    in-out property <int> chain-index: 0;
    // What the active node actually reported. Only this decides anything —
    // never the URL.
    in property <string> effective: "";
    in property <string> node-state: "unknown";
    in property <string> tip: "";
    in property <string> latency: "";
    in property <string> endpoint: "not configured";
    in property <bool> mock-mode: false;
    in property <bool> allow-mainnet-spend: false;
    // The active node is behind the chain. Distinct from offline: it answers,
    // but a balance read against a stale tip is wrong in a way that only shows
    // up when a transaction is rejected.
    in property <bool> syncing: false;
    // Why the last node the user tried was refused. Shown on the network
    // screen, because that is where the button they pressed is — a refusal that
    // appears somewhere else is indistinguishable from nothing happening.
    in-out property <string> problem: "";
    // What is in the add-a-node form.
    //
    // Held here rather than inside the form so that Rust can clear it when the
    // node is actually accepted — and, more to the point, so that it is NOT
    // cleared when the node is refused. A rejected address that vanishes from
    // the field takes with it the only copy of what the person typed.
    in-out property <string> draft-url: "";
    in-out property <string> draft-label: "";
}

// The balance over time.
//
// Everything here is computed in Rust by `src/chart.rs`, which owns the
// readings and the geometry. Slint holds two path strings and a cursor
// position — no arithmetic on money happens on this side.
export global ChartState {
    // SVG path data for a given element size, in that element's own
    // coordinates. There is no viewbox, so one pixel of stroke means one pixel
    // — see `pecu_chart::Viewport`.
    //
    // Callbacks rather than properties, and used directly in a binding: a
    // `pure callback` re-evaluates when its ARGUMENTS change, so the geometry
    // follows the element through every layout including the first. A property
    // pushed from a `changed width` handler cannot do that — the handler fires
    // only after a size exists, and only under a running event loop.
    pure callback line-at(length, length) -> string;
    // Empty when the balance never moved: a gradient fading downwards from a
    // horizontal line reads as a chart that failed to load.
    pure callback area-at(length, length) -> string;
    // Where the line ends, so the "now" dot can sit exactly on it.
    pure callback end-x-at(length, length) -> length;
    pure callback end-y-at(length, length) -> length;
    in property <bool> has-data: false;
    in property <string> ticker: "VRSC";
    // What moved across the window, and whether that is good news.
    in property <string> change: "";
    in property <string> change-tone: "neutral";
    // What the picture is of. A chart over a window the wallet has not fully
    // scanned is true about the window and silent about everything before it,
    // and that difference is invisible in the drawing.
    in property <string> caption: "";

    // Where the axis begins, in words. There are no gridlines and no tick
    // labels, so without this the chart cannot say what period it covers.
    in property <string> span-from: "";
    // What the bottom and the top of the plot are worth, pre-formatted.
    //
    // The vertical axis is scaled to the data rather than to zero, so the shape
    // alone says nothing about magnitude — the same staircase is drawn by a
    // wallet that moved one coin and by one that moved ten thousand. Empty when
    // the balance never moved.
    in property <string> span-range: "";

    // -1 when the pointer is not over the chart.
    in property <int> hover: -1;
    // Where the crosshair sits: on the nearest SAMPLE, not under the pointer.
    // A dot floating between two readings points at a balance never held.
    in property <length> hover-x: 0px;
    in property <length> hover-y: 0px;
    in property <string> hover-amount: "";
    in property <string> hover-when: "";

    callback hovered(length);
    callback left();
}

// What the wallet has said and nobody has read yet.
export global ToastState {
    in property <[ToastRow]> rows: [];
    callback dismiss(int);
    // Dismiss everything. Offered once there is more than one, because a wallet
    // that has just failed six times should not need six clicks.
    callback dismiss-all();
}

export global AppInfo {
    in property <string> sdk-rev: "unknown";
    // Where the log files are. On screen because a wallet started from the
    // Finder has no terminal, so this is the only way anybody finds them.
    in property <string> log-path: "";
}

// Every UI→core call lives in this one global.
//
// Keeping the outbound API to a single readable block is what makes it possible
// to see, at a glance, which calls carry secret material — and to notice
// immediately when one is added.
export global Actions {
    // ── The secret-bearing calls ──────────────────────────────────────────
    //
    // Five, and this comment is the record. Each clears its backing property
    // inside the same callback, before returning — see `PassphraseForm.submit`,
    // `RestoreForm.submit` and `BackupPassphrase.submit`. A fifth belongs in a
    // review, not in a commit.
    callback create-wallet(string);
    callback unlock(string);
    // Restoring: the key material AND a new passphrase for this machine, in
    // one call. Both are blanked before the callback returns.
    callback restore-wallet(string, string, string);
    // The vault passphrase again, to show a phrase that was never written down.
    // Asking twice is the point: the highest-consequence read in the wallet
    // must not ride on a session someone unlocked twenty minutes ago.
    callback reveal-backup(string);
    // Old and new, in one call. Both are blanked before it returns.
    // Declared with the other Settings actions below, next to what it belongs
    // with — this list is the record of WHICH calls carry secrets, not where
    // they are written.

    // Three words the user is copying off the screen in front of them. Not
    // wrapped as secret material, and that is a judgement rather than an
    // oversight: three of twenty-four leaves twenty-one unknown words from a
    // 2048-word list. Still cleared in the same callback, like the rest.
    callback confirm-phrase(string, string, string);

    // ── The backup screen ─────────────────────────────────────────────────
    // Hold-to-reveal: press asks for the words, release throws away the copy
    // the UI was given. Leaving the screen throws away core's copy too.
    callback reveal-phrase();
    callback hide-phrase();
    callback cancel-backup();

    // Settings. `change-passphrase` carries two secrets and is the fifth
    // secret-bearing call — counted in the block above.
    callback change-passphrase(string, string);
    callback set-auto-lock(int);
    callback set-mainnet-spend(bool, string);

    // Keys. None of these carries a secret — a label is a name, and adding a
    // key needs the wallet open rather than the passphrase again.
    callback label-address(string, string);
    callback forget-address(string);
    callback add-key(string);
    callback rename-key(string, string);
    callback select-key(string);
    // How the window looks, and whether it moves. Sent so the core can write
    // them down — a preference that resets every launch is not a preference.
    callback set-appearance(bool, bool);

    // Sending. None of these carries a secret; the signed bytes never leave
    // the core, and what crosses here is a ticket number.
    callback validate-draft(string, string);
    callback prepare-send(string, string);
    callback confirm-send(int);
    callback cancel-send(int);
    // "check" | "resend" | "abandon" — for a payment whose fate is unknown.
    callback resolve-pending(int, string);
    callback load-older();
    callback open-tx(string);

    callback lock();
    callback navigate(string);
    callback refresh();
    callback probe-nodes();
    // Which chain to open, by its consensus name — "VRSC" or "VRSCTEST", not
    // the label beside it. Everything durable is chosen from this, so the core
    // is what decides; this only asks.
    callback set-requested-network(string);

    // ── Currencies ──────────────────────────────────────────────────────
    // Reads only. Defining one is a later step and is not wired here yet.
    callback refresh-currencies();
    callback open-currency(string);
    // Re-check the draft. Called on every edit; the core answers from memory.
    //
    // No arguments: the draft lives on `CurrencyState`, and a callback with
    // eight parameters — two of them lists — would be a signature nobody could
    // change without changing five call sites.
    callback check-currency();
    // Adding and removing a row changes the length of a model, which Slint
    // cannot do from a binding. Rust rebuilds it and the form re-checks.
    callback add-reserve();
    callback remove-reserve(int);
    // Narrow the chain's currency list. Debounced by the picker: the first of
    // these fetches half a megabyte, the rest are answered from memory.
    callback search-currencies(string);
    // How big the window is now, in logical pixels. Debounced by the window —
    // see `AppWindow`.
    callback remember-window(int, int);
    // Row index, the chosen name, and its i-address — all three, because the
    // draft carries the address and the form reads the name, and looking one up
    // from the other here would be a second source of the same fact.
    callback choose-reserve(int, string, string);
    callback add-preallocation();
    callback remove-preallocation(int);
    // Whether that name can be claimed, and what it would cost. Same check the
    // identity screen makes, because it is the same question.
    callback check-currency-name(string);
    // Build and sign it. Nothing is sent — the review that follows is decoded
    // from what this produced.
    callback prepare-launch();
    // Claim the name, then define the currency under it. One press, because it
    // is one decision — and the currency is written down before the
    // registration is paid for, so a wallet that dies in between knows what the
    // identity it just bought was for.
    callback start-currency-from-new-name();
    // Pick up a currency whose identity landed while the wallet was closed.
    // Never automatic: nobody was watching, and signing a two hundred coin
    // launch because an application was opened is not a decision to make on
    // somebody's behalf.
    callback resume-launch();
    callback abandon-launch();
    callback confirm-launch(int);
    callback cancel-launch(int);

    // ── VerusIDs ────────────────────────────────────────────────────────
    // None of these carries a secret. Reading an identity needs no key, and
    // the write operations that will need one are not here yet.
    callback refresh-identities();
    callback look-up-identity(string);
    callback open-identity(string);
    callback close-identity();
    callback derive-content-key(string);
    callback clear-lookups();
    callback unwatch-identity(string);
    callback check-name(string);
    callback start-registration(string, string, string);
    callback finish-registration();
    callback abandon-registration();
    callback set-identity-authorities(string, string, string);
    callback lock-identity(string, int);
    callback unlock-identity(string, int);
    callback confirm-identity-change(int, string);
    callback cancel-identity-change(int);
    callback revoke-identity(string);
    callback recover-identity(string);
    callback select-node(int);
    // Label then URL. The URL is checked in the core, by the SDK's own
    // transport — which is what refuses plaintext to anything but loopback.
    callback add-node(string, string);
    callback remove-node(int);
    callback toggle-theme();
}

// ── Screens ─────────────────────────────────────────────────────────────────

// A single-line input.
//
// Shared by every screen that takes one line of text, so the focus ring, the error border and the height cannot drift apart
// between them.
component Field inherits Rectangle {
    in property <bool> password: false;
    in property <bool> invalid: false;
    // A recovery phrase is typed VISIBLY, unlike a passphrase. Masking it would
    // make the one thing that matters here — spotting a mistyped word before
    // committing to a wallet with no funds in it — impossible, and the person
    // typing it is by definition its owner.
    in property <bool> multiline: false;
    in property <bool> mono: false;
    // Shown only while the field is empty. An example of the shape expected,
    // never a label — a placeholder that stands in for a label disappears
    // exactly when someone starts typing and needs it most.
    in property <string> placeholder: "";
    in-out property <string> text <=> input.text;
    callback accepted();
    callback edited();

    forward-focus: input;
    height: 42px;
    background: Theme.bg-inset;
    border-radius: R.md;
    border-width: 1px;
    border-color: root.invalid ? Theme.negative
        : input.has-focus ? Theme.accent
        : Theme.border-default;
    animate border-color { duration: Motion.fast; enabled: Motion.enabled; }

    // Behind the input, and non-interactive: it must never intercept a click
    // aimed at the field it is sitting in.
    if root.placeholder != "" && input.text == "": Text {
        text: root.placeholder;
        font-family: root.mono ? Typo.mono : "";
        font-size: Typo.body;
        color: Theme.text-disabled;
        x: Sp.s5;
        width: parent.width - Sp.s5 * 2;
        height: parent.height;
        vertical-alignment: root.multiline ? top : center;
        overflow: elide;
    }

    // The label a screen reader reads. The placeholder is the only description
    // most of these fields have on screen, so it is the honest source for it.
    accessible-role: AccessibleRole.text-input;
    accessible-label: root.placeholder;
    // Deliberately NOT `accessible-value: input.text` when masked. A password
    // field that publishes its contents to the accessibility tree has undone
    // the masking for anything that can read that tree.
    accessible-value: root.password ? "" : input.text;

    input := TextInput {
        // Never rendered as glyphs, and never logged.
        input-type: root.password ? InputType.password : InputType.text;
        font-family: root.mono ? Typo.mono : "";
        font-size: Typo.body;
        color: Theme.text-primary;
        single-line: !root.multiline;
        wrap: root.multiline ? TextWrap.word-wrap : TextWrap.no-wrap;
        x: Sp.s5;
        y: root.multiline ? Sp.s4 : 0;
        width: parent.width - Sp.s5 * 2;
        height: root.multiline ? parent.height - Sp.s4 * 2 : parent.height;
        vertical-alignment: root.multiline ? top : center;
        accepted => { root.accepted(); }
        edited => { root.edited(); }
    }
}

// Choosing a passphrase, or entering it again.
component PassphraseForm inherits VerticalLayout {
    // "create" | "unlock"
    in property <string> mode;
    in property <string> wallet-name;
    in property <bool> busy;
    in property <string> problem;
    callback restore();

    // Whether the two boxes agree, and whether to say so yet.
    //
    // `matched` is true while unlocking, where there is only one box. `mismatch`
    // stays quiet until the second box has something in it — complaining at the
    // first keystroke of a confirmation nobody has finished typing is a form
    // shouting at somebody for not having finished.
    // Held here rather than read off the field, because the field lives inside
    // an `if` and Slint cannot address an element through one.
    property <string> again;
    property <bool> matched: root.mode != "create" || field.text == root.again;
    property <bool> mismatch: root.mode == "create" && root.again != "" && !root.matched;

    spacing: Sp.s7;

    VerticalLayout {
        spacing: Sp.s3;
        Text {
            text: root.mode == "create" ? "Set up Pecu" : "Welcome back";
            font-size: Typo.title1;
            font-weight: Typo.w-bold;
            color: Theme.text-primary;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center;
            Text {
                width: 420px;
                text: root.mode == "create"
                    ? "Choose a passphrase. It encrypts your keys on this machine, and nobody can recover it for you."
                    : root.wallet-name;
                font-size: Typo.body;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }

    HorizontalLayout {
        alignment: center;
        field := Field {
            width: 360px;
            password: true;
            // A masked box with nothing in it and no label above it is
            // indistinguishable from a box that is broken. The sentence above
            // explains what a passphrase IS; this says what to put here.
            placeholder: root.mode == "create"
                ? "A passphrase you will remember"
                : "Passphrase";
            invalid: root.problem != "";
            accepted => { root.submit(); }
        }
    }

    // Typed twice, and only when a wallet is being made.
    //
    // # Why this is not a formality
    //
    // The sentence above says nobody can recover this, and that is literally
    // true: the passphrase is the only input to the key that decrypts the
    // vault, and there is no reset, no hint and no second copy anywhere. A
    // single mistyped character in a masked box therefore produces a wallet
    // that opens exactly once — for the rest of this session, because the key
    // is already in memory — and never again.
    //
    // That is the worst possible failure shape: it does not announce itself at
    // the moment of the mistake, it announces itself at the next launch, by
    // which time somebody has generated a phrase, written it down, and put
    // money in. The wallet was asking for a secret it could not check, and then
    // acting on the first answer.
    //
    // Unlocking asks once, because there the vault itself is the check.
    if root.mode == "create": HorizontalLayout {
        alignment: center;
        Field {
            width: 360px;
            password: true;
            placeholder: "Type it again";
            text <=> root.again;
            invalid: root.mismatch;
            accepted => { root.submit(); }
        }
    }

    if root.mismatch: Text {
        text: "The two do not match.";
        font-size: Typo.caption;
        color: Theme.negative;
        horizontal-alignment: center;
    }

    if root.problem != "": Text {
        text: root.problem;
        font-size: Typo.caption;
        color: Theme.negative;
        horizontal-alignment: center;
    }

    HorizontalLayout {
        alignment: center;
        Btn {
            text: root.busy
                ? "Working…"
                : root.mode == "create" ? "Create wallet" : "Unlock";
            variant: "primary";
            enabled: !root.busy && field.text != "" && root.matched;
            clicked => { root.submit(); }
        }
    }

    // Only offered before a wallet exists. Restoring into an existing one is a
    // different act — adding a key — and belongs with the key list, not here.
    if root.mode == "create": HorizontalLayout {
        alignment: center;
        Btn {
            text: "I already have a wallet";
            variant: "ghost";
            clicked => { root.restore(); }
        }
    }

    if root.mode == "create": Text {
        text: "Pecu starts on testnet. Spending real coins stays off until you turn it on.";
        font-size: Typo.caption;
        color: Theme.text-tertiary;
        horizontal-alignment: center;
    }

    // Read the field, hand it over, and blank the property IN THE SAME
    // callback. Slint's `SharedString` is refcounted and cannot be wiped from
    // Rust, so clearing it here is the only reach we have — the residual is
    // documented on `pecu_protocol::Secret`.
    function submit() {
        if (field.text == "") { return; }
        if (root.mode == "create") {
            if (!root.matched) { return; }
            Actions.create-wallet(field.text);
        } else {
            Actions.unlock(field.text);
        }
        field.text = "";
        // The confirmation is a copy of the same secret and gets the same
        // treatment. Blanked whatever the mode, since a stale value here would
        // otherwise decide `matched` for the next wallet.
        root.again = "";
    }
}

// Restoring a wallet that already exists somewhere else.
component RestoreForm inherits VerticalLayout {
    in property <bool> busy;
    in property <string> problem;
    callback cancelled();

    property <bool> matched: pass.text == again.text;
    property <bool> mismatch: again.text != "" && !root.matched;

    spacing: Sp.s6;

    VerticalLayout {
        spacing: Sp.s3;
        Text {
            text: "Restore your wallet";
            font-size: Typo.title1;
            font-weight: Typo.w-bold;
            color: Theme.text-primary;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center;
            Text {
                width: 460px;
                text: "Enter what you wrote down. Pecu checks a recovery phrase before it creates anything, so a typo costs you a second attempt rather than an empty wallet.";
                font-size: Typo.body;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }

    HorizontalLayout {
        alignment: center;
        kind := Segmented {
            width: 420px;
            // "Free text" is offered rather than hidden because Verus hashes a
            // transparent phrase verbatim: some wallets really do hold a key
            // made from a sentence, and refusing it would strand those funds.
            options: ["Recovery phrase", "Free text", "Private key"];
        }
    }

    HorizontalLayout {
        alignment: center;
        material := Field {
            width: 420px;
            height: 92px;
            multiline: true;
            mono: true;
            // An empty bordered box with the hint underneath it is a box that
            // could be anything. The placeholder says what shape goes in.
            placeholder: kind.index == 2
                ? "U…"
                : kind.index == 1
                ? "The exact text you used"
                : "abandon abandon abandon …";
            invalid: root.problem != "";
        }
    }

    HorizontalLayout {
        alignment: center;
        Text {
            width: 420px;
            text: kind.index == 2
                ? "A Verus private key, starting with U."
                : kind.index == 1
                ? "Hashed exactly as typed, including spacing. Nothing can check it for you."
                : "12, 15, 18, 21 or 24 words, separated by spaces.";
            font-size: Typo.caption;
            color: Theme.text-tertiary;
            wrap: word-wrap;
        }
    }

    // Under the box it is about.
    //
    // This sat below the passphrase field, two controls away from the phrase it
    // describes — so "there is a typo in that phrase" appeared to be a
    // complaint about the passphrase somebody had just chosen.
    if root.problem != "": HorizontalLayout {
        alignment: center;
        Text {
            width: 420px;
            text: root.problem;
            font-size: Typo.caption;
            color: Theme.negative;
            wrap: word-wrap;
        }
    }

    VerticalLayout {
        spacing: Sp.s3;
        HorizontalLayout {
            alignment: center;
            Text {
                width: 420px;
                text: "New passphrase for this machine";
                font-size: Typo.caption;
                color: Theme.text-secondary;
            }
        }
        HorizontalLayout {
            alignment: center;
            pass := Field {
                width: 420px;
                password: true;
                placeholder: "A passphrase you will remember";
            }
        }
        // The third place this wallet asked for an unrecoverable secret once
        // and believed the answer.
        //
        // Restoring is the case where it stings most. Somebody arrives here
        // holding a phrase precisely because something went wrong last time —
        // and a typo in this box hands them a vault sealed with a string they
        // have never seen, on top of the phrase they came to rescue.
        HorizontalLayout {
            alignment: center;
            again := Field {
                width: 420px;
                password: true;
                placeholder: "Type it again";
                invalid: root.mismatch;
                accepted => { root.submit(); }
            }
        }
        if root.mismatch: HorizontalLayout {
            alignment: center;
            Text {
                width: 420px;
                text: "The two do not match.";
                font-size: Typo.caption;
                color: Theme.negative;
            }
        }
    }

    HorizontalLayout {
        alignment: center;
        spacing: Sp.s4;
        Btn {
            text: "Back";
            variant: "ghost";
            clicked => {
                root.clear();
                root.cancelled();
            }
        }
        Btn {
            text: root.busy ? "Working…" : "Restore wallet";
            variant: "primary";
            enabled: !root.busy && material.text != "" && pass.text != "" && root.matched;
            clicked => { root.submit(); }
        }
    }

    // Both secrets leave in one call and every field is blanked before it
    // returns, same as every other secret-bearing path here.
    function submit() {
        if (material.text == "" || pass.text == "" || !root.matched) { return; }
        Actions.restore-wallet(
            kind.index == 2 ? "wif" : kind.index == 1 ? "text" : "phrase",
            material.text,
            pass.text,
        );
        root.clear();
    }

    function clear() {
        material.text = "";
        pass.text = "";
        again.text = "";
    }
}

// The screen shown whenever there is no unlocked wallet.
// A payment we could not confirm reached the network.
//
// Given the top of the dashboard because it is the one thing in this wallet
// that is genuinely unresolved, and because the wrong move — sending again —
// is the tempting one.
component PendingPayments inherits VerticalLayout {
    spacing: Sp.s4;
    Eyebrow { text: "UNCONFIRMED"; }

    Card {
        VerticalLayout {
            padding: Sp.card-pad;
            spacing: Sp.s5;

            for row in SendState.pending-rows: VerticalLayout {
                // Whether "Stop tracking" has been pressed once.
                //
                // Two presses, because abandoning is not merely forgetting. The
                // stored bytes go with the record, and those bytes are the only
                // safe way to finish this payment — resending them cannot pay
                // twice, and rebuilding is forbidden precisely because it can.
                // So this discards the one recovery there is, from a ghost
                // button, in one click, with nothing asked.
                //
                // A second press rather than a dialog: the weight is real but
                // it is not a revocation, and a modal over the dashboard for
                // every abandoned record would be its own problem.
                property <bool> confirming: false;

                spacing: Sp.s4;

                HorizontalLayout {
                    spacing: Sp.s5;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text {
                            text: row.state == "absent"
                                ? "This payment has not appeared on the network"
                                : "We could not confirm this payment was sent";
                            font-size: Typo.body;
                            font-weight: Typo.w-medium;
                            color: Theme.warning;
                            wrap: word-wrap;
                        }
                        Text {
                            text: row.state == "absent"
                                ? "Asked " + row.checks + " times and the node has never seen it. Sending the same transaction again is safe — it is the same bytes, so it cannot pay twice."
                                : "It may already be on its way. Do not send it again yet — that could send the money twice. Pecu is checking.";
                            font-size: Typo.caption;
                            color: Theme.text-secondary;
                            wrap: word-wrap;
                        }
                    }
                    Money {
                        amount: row.amount;
                        currency: WalletState.ticker;
                        y: (parent.height - self.height) / 2;
                    }
                }

                Text {
                    text: row.txid;
                    font-family: Typo.mono;
                    font-size: Typo.num-sm;
                    color: Theme.text-tertiary;
                    wrap: char-wrap;
                }

                HorizontalLayout {
                    spacing: Sp.s4;
                    Btn {
                        text: "Check now";
                        clicked => { Actions.resolve-pending(row.id, "check"); }
                    }
                    // Only once the node has been asked repeatedly and never
                    // seen it. Offering this earlier would be offering the one
                    // action that can pay twice.
                    if row.state == "absent": Btn {
                        text: "Send the same transaction again";
                        variant: "primary";
                        clicked => { Actions.resolve-pending(row.id, "resend"); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if !confirming: Btn {
                        text: "Stop tracking";
                        variant: "ghost";
                        clicked => { confirming = true; }
                    }
                    if confirming: Btn {
                        text: "Keep it";
                        variant: "ghost";
                        clicked => { confirming = false; }
                    }
                    if confirming: Btn {
                        text: "Discard the record";
                        variant: "destructive";
                        clicked => {
                            confirming = false;
                            Actions.resolve-pending(row.id, "abandon");
                        }
                    }
                }

                if confirming: Text {
                    text: "Pecu will stop asking about this payment and will drop the signed transaction it kept. If it never reached the network, there is then no way to send it that is guaranteed not to pay twice.";
                    font-size: Typo.caption;
                    color: Theme.warning;
                    wrap: word-wrap;
                }
            }
        }
    }
}

// The plotted area: two paths, a wipe, and a crosshair.
//
// Its own component because the draw-in needs a clip rectangle wrapping a
// holder pinned at full size, and because the touch area has to be able to
// address the paths — neither survives being written inline.
component ChartPlot inherits Rectangle {
    // Slint has no stroke-dasharray and no path-length animation, so the
    // draw-in is a **clip wipe**: an outer rectangle whose width animates from
    // nothing to full, containing a holder that is always the full size. The
    // paths never move; what moves is how much of them is visible. Zero
    // per-frame path work, and it works identically for the gradient.
    in-out property <float> progress: 0;

    // Runs once when the data arrives. Reversing it on every re-plot would
    // mean the chart redrew itself every fifteen seconds when the tip poll
    // finds a new block, which is a wallet fidgeting at you.
    states [
        drawn when ChartState.has-data: {
            progress: 1;
            in {
                animate progress {
                    duration: Motion.draw;
                    easing: cubic-bezier(0.22, 1, 0.36, 1);
                    enabled: Motion.enabled;
                }
            }
        }
    ]

    // The fill first, so the stroke is never drawn under it.
    Rectangle {
        width: parent.width * root.progress;
        clip: true;

        Rectangle {
            width: root.width;
            height: root.height;

            Path {
                commands: ChartState.area-at(root.width, root.height);
                // Faded to nothing at the baseline. The stroke has to stay
                // readable against the fill directly beneath it, so the fill
                // never gets close to the stroke's own weight.
                // Faded to nothing well before the baseline. A fill still
                // visible at the bottom reads as a filled shape rather than as
                // depth under a line, and it competes with the stroke it is
                // supposed to sit beneath.
                //
                // The top stop is chosen to look right **without** the fade as
                // well: the software renderer — which is what draws the
                // reference images, and what would draw the wallet on a machine
                // with no working GPU path — fills a `Path` with the first stop
                // and ignores the rest. A gradient whose top end is too strong
                // to stand on its own would then look correct in review and
                // wrong on somebody's laptop.
                fill: @linear-gradient(180deg,
                    Theme.chart-line.with-alpha(0.16) 0%,
                    Theme.chart-line.with-alpha(0.05) 60%,
                    Theme.chart-line.with-alpha(0.0) 100%);
            }

            Path {
                commands: ChartState.line-at(root.width, root.height);
                stroke: Theme.chart-line;
                stroke-width: 2px;
            }
        }
    }

    // Where the line ends — which is now. The one point on the chart that is
    // still moving, and the anchor the wipe appears to be drawn by.
    if ChartState.hover < 0: Rectangle {
        x: ChartState.end-x-at(root.width, root.height) - 4px;
        y: ChartState.end-y-at(root.width, root.height) - 4px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: Theme.chart-line;
        opacity: root.progress;
    }

    // The crosshair. Only while a pointer is actually over the chart.
    if ChartState.hover >= 0: Rectangle {
        x: ChartState.hover-x;
        width: 1px;
        y: 0;
        height: root.height;
        background: Theme.chart-grid.with-alpha(0.14);
    }

    if ChartState.hover >= 0: Rectangle {
        x: ChartState.hover-x - 5px;
        y: ChartState.hover-y - 5px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: Theme.chart-line;
        border-width: 2px;
        border-color: Theme.bg-surface;
        // Gliding between samples rather than teleporting is most of the
        // difference between this and a chart library.
        animate x { duration: 90ms; easing: ease-out; enabled: Motion.enabled; }
        animate y { duration: 90ms; easing: ease-out; enabled: Motion.enabled; }
    }

    touch := TouchArea {
        // `mouse-x` updates on hover; `moved()` only fires while pressed, so
        // this is a binding rather than a callback.
        changed mouse-x => {
            if (touch.has-hover) { ChartState.hovered(touch.mouse-x); }
        }
        changed has-hover => {
            if (!touch.has-hover) { ChartState.left(); }
        }
    }
}

// The balance over time, with its range control and its own empty state.
component BalanceChart inherits VerticalLayout {
    spacing: Sp.s4;

    Rectangle {
        height: 200px;

        ChartPlot {
            width: parent.width;
            height: parent.height;
        }
    }

    if ChartState.has-data: HorizontalLayout {
        spacing: Sp.s5;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            // While hovering, the header reads the value AT THE CURSOR. The
            // change figure keeps describing the window, which is what makes
            // the two useful together.
            Text {
                text: ChartState.hover >= 0
                    ? ChartState.hover-amount + " " + ChartState.ticker
                    : ChartState.change;
                font-family: Typo.mono;
                font-size: Typo.num-sm;
                color: ChartState.hover >= 0 ? Theme.text-primary
                    : ChartState.change-tone == "positive" ? Theme.positive
                    : ChartState.change-tone == "negative" ? Theme.negative
                    : Theme.text-secondary;
            }
            Text {
                text: ChartState.hover >= 0 ? ChartState.hover-when : ChartState.caption;
                font-size: Typo.caption;
                color: Theme.text-tertiary;
                overflow: elide;
            }
        }

        // What period this is a picture of. The chart has no gridlines and no
        // tick labels, so this is the only thing that says so — a question the
        // range buttons used to answer by implication, and which nothing
        // answered once they were gone.
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: ChartState.span-from == "" ? "" : ChartState.span-from + " → now";
                font-size: Typo.caption;
                color: Theme.text-tertiary;
                horizontal-alignment: right;
            }
            // And what the plot's floor and ceiling are worth — the other axis,
            // which had no label at all.
            if ChartState.span-range != "": Text {
                text: ChartState.span-range;
                font-family: Typo.mono;
                font-size: Typo.micro;
                color: Theme.text-disabled;
                horizontal-alignment: right;
            }
        }
    }
}

component DashboardScreen inherits VerticalLayout {
    spacing: Sp.section-gap;

    if SendState.pending-rows.length > 0: PendingPayments {}

    // A wallet whose phrase has never been written down is one disk failure
    // from being gone. That is worth the top of the screen, and worth staying
    // there — it disappears when the backup is confirmed, not when dismissed.
    if WalletState.backup-key != "": Card {
        VerticalLayout {
            padding: Sp.card-pad;

            HorizontalLayout {
                spacing: Sp.s5;

                Rectangle {
                    width: 34px;
                    height: 34px;
                    y: (parent.height - self.height) / 2;
                    border-radius: R.full;
                    background: Theme.warning-soft;
                    Text {
                        text: "!";
                        font-size: 15px;
                        font-weight: Typo.w-bold;
                        color: Theme.warning;
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: "Your recovery phrase is not written down";
                        font-size: Typo.body;
                        font-weight: Typo.w-medium;
                        color: Theme.text-primary;
                    }
                    Text {
                        text: "Without it, nothing can restore this wallet — not us, not anyone.";
                        font-size: Typo.caption;
                        color: Theme.text-secondary;
                    }
                }

                Btn {
                    text: "Back up now";
                    variant: "primary";
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        SeedState.problem = "";
                        SeedState.step = "passphrase";
                    }
                }
            }
        }
    }

    // The hero. Total first, because that is the number people quote — with the
    // breakdown directly beneath it, because a Verus balance is genuinely
    // several numbers and a wallet that shows one cannot explain "you have 500
    // but can spend 20".
    VerticalLayout {
        spacing: Sp.s4;

        HorizontalLayout {
            spacing: Sp.s4;
            alignment: start;
            Eyebrow { text: "TOTAL BALANCE"; }
            // "These numbers were true, just not now" — which is a different
            // statement from "loading", and the one worth making when a read
            // fails against a wallet that already has figures on screen.
            if WalletState.stale: Eyebrow {
                text: "· NOT UP TO DATE";
                color: Theme.warning;
            }
        }

        if WalletState.loading: Skeleton {
            width: 320px;
            height: 48px;
        }

        if !WalletState.loading: Money {
            amount: WalletState.total;
            currency: WalletState.ticker;
            size: Typo.hero;
            mono: false;
        }

        // The parts of the total, as separate figures rather than one sentence.
        //
        // This was a single dot-separated run at caption size: three long
        // monospace numbers, three different meanings, one line. Nobody parses
        // that — and the one that decides whether a payment can be made at all,
        // spendable, was the least prominent number on a screen whose headline
        // is a total that includes money nobody can spend.
        //
        // Value above label, mono, generously spaced: the same arrangement the
        // eye is given for any row of statistics, and each column can now be
        // read on its own.
        if !WalletState.loading && WalletState.has-breakdown: HorizontalLayout {
            spacing: Sp.s9;
            alignment: start;

            VerticalLayout {
                spacing: 2px;
                Text {
                    text: WalletState.spendable;
                    font-family: Typo.mono;
                    font-size: Typo.num;
                    color: Theme.text-primary;
                }
                Text {
                    text: "spendable";
                    font-size: Typo.micro;
                    color: Theme.text-tertiary;
                }
            }

            if WalletState.immature != "": VerticalLayout {
                spacing: 2px;
                Text {
                    text: WalletState.immature;
                    font-family: Typo.mono;
                    font-size: Typo.num;
                    color: Theme.warning;
                }
                Text {
                    // The wait belongs with the figure it qualifies, not in a
                    // parenthesis inside a longer sentence.
                    text: WalletState.matures-in == ""
                        ? "maturing"
                        : "maturing · " + WalletState.matures-in;
                    font-size: Typo.micro;
                    color: Theme.text-tertiary;
                }
            }

            if WalletState.incoming != "": VerticalLayout {
                spacing: 2px;
                Text {
                    text: WalletState.incoming;
                    font-family: Typo.mono;
                    font-size: Typo.num;
                    color: Theme.positive;
                }
                Text {
                    text: "arriving";
                    font-size: Typo.micro;
                    color: Theme.text-tertiary;
                }
            }

            // Money that has left and not settled. Never drawn until now,
            // though it has always been one of the three states that make this
            // row appear at all.
            if WalletState.pending != "": VerticalLayout {
                spacing: 2px;
                Text {
                    text: WalletState.pending;
                    font-family: Typo.mono;
                    font-size: Typo.num;
                    color: Theme.text-secondary;
                }
                Text {
                    text: "leaving";
                    font-size: Typo.micro;
                    color: Theme.text-tertiary;
                }
            }
        }
    }

    // The balance over time. Directly under the figure it is a chart of, so
    // the two can be read as one statement rather than as two facts that
    // happen to share a screen.
    //
    // Absent entirely until there is something to draw. A wallet with no
    // transactions would otherwise stack three empty states — "no chart", "no
    // assets", "no transactions" — which says one thing three times and makes
    // the screen look broken rather than new. The card arriving with the first
    // transaction is information; a placeholder for it is not.
    if ChartState.has-data: Card {
        VerticalLayout {
            padding: Sp.card-pad;
            BalanceChart {}
        }
    }

    // Assets
    VerticalLayout {
        spacing: Sp.s4;
        Eyebrow { text: "ASSETS"; }

        Card {
            VerticalLayout {
                padding: Sp.s3;

                if WalletState.assets.length == 0 && !WalletState.loading: Rectangle {
                    height: 88px;
                    EmptyState {
                        glyph: "◇";
                        title: "No assets yet";
                        body: "Receive VRSC to get started.";
                    }
                }

                if WalletState.loading: Rectangle {
                    height: 64px;
                    HorizontalLayout {
                        padding: Sp.s5;
                        spacing: Sp.s5;
                        Skeleton { width: 34px; height: 34px; radius: R.full; }
                        VerticalLayout {
                            alignment: center;
                            spacing: Sp.s2;
                            Skeleton { width: 120px; height: 13px; }
                            Skeleton { width: 72px; height: 11px; }
                        }
                    }
                }

                for asset in WalletState.assets: ListRow {
                    // `◈` was here and drew nothing — the third glyph in this
                    // file to do that. `◆` is one the system font is known to
                    // carry, because it is already on screen in the nav rail.
                    glyph: asset.native ? "◆" : "◇";
                    glyph-tone: asset.native ? Theme.accent : Theme.text-secondary;
                    title: asset.name;
                    subtitle: asset.secondary;
                    interactive: false;

                    // Right-aligned, so a column of amounts lines up on the
                    // decimal point rather than floating in the middle of the
                    // row. Together with the monospace family this is what
                    // makes two balances comparable at a glance.
                    HorizontalLayout {
                        alignment: end;
                        Money {
                            amount: asset.amount;
                            show-currency: false;
                            size: Typo.num-lg;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
            }
        }
    }

    // Recent activity
    VerticalLayout {
        spacing: Sp.s4;

        HorizontalLayout {
            Eyebrow { text: "RECENT ACTIVITY"; horizontal-stretch: 1; }
        }

        Card {
            VerticalLayout {
                padding: Sp.s3;

                if WalletState.activity.length == 0 && !WalletState.loading: Rectangle {
                    height: 120px;
                    EmptyState {
                        glyph: "○";
                        title: "No transactions yet";
                        body: "Activity appears here once your wallet has been paid.";
                    }
                }

                for tx in WalletState.activity: ListRow {
                    glyph: tx.direction == "in" ? "↓" : tx.direction == "out" ? "↑" : "↔";
                    glyph-tone: tx.direction == "in" ? Theme.positive
                        : tx.direction == "out" ? Theme.negative
                        : Theme.text-secondary;
                    title: tx.direction == "in" ? "Received" : tx.direction == "out" ? "Sent" : "Moved";
                    subtitle: tx.when;
                    interactive: true;

                    HorizontalLayout {
                        spacing: Sp.s5;
                        alignment: end;

                        // The pill goes BEFORE the amount, so a pending row
                        // does not push its figure out of the column every
                        // other row lines up in. Alignment is what makes a
                        // list of amounts readable; the pill can move.
                        if tx.pending: StatusPill {
                            state: "pending";
                            text: "Pending";
                            y: (parent.height - self.height) / 2;
                        }

                        Money {
                            amount: tx.amount;
                            show-currency: false;
                            tone: tx.direction == "in" ? "positive" : tx.direction == "out" ? "negative" : "neutral";
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
            }
        }
    }

    Rectangle { vertical-stretch: 1; }
}

// Configuring an endpoint of your own.
//
// Its own component because its two inputs have to be readable from one place —
// an input declared inside an `if` cannot be reached from outside it — and
// because the form has to be able to clear itself once the node is accepted.
component AddNodeForm inherits VerticalLayout {
    spacing: Sp.s4;

    HorizontalLayout {
        spacing: Sp.s4;

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Sp.s3;
            Text {
                text: "Address";
                font-size: Typo.caption;
                color: Theme.text-secondary;
            }
            url := Field {
                mono: true;
                placeholder: "https://my-node.example:27486";
                text <=> NetworkState.draft-url;
                accepted => { root.submit(); }
                edited => { NetworkState.problem = ""; }
            }
        }

        VerticalLayout {
            width: 200px;
            spacing: Sp.s3;
            Text {
                text: "Name (optional)";
                font-size: Typo.caption;
                color: Theme.text-secondary;
            }
            name := Field {
                placeholder: "my node";
                text <=> NetworkState.draft-label;
                accepted => { root.submit(); }
            }
        }
    }

    if NetworkState.problem != "": Text {
        text: NetworkState.problem;
        font-size: Typo.caption;
        color: Theme.negative;
        wrap: word-wrap;
    }

    HorizontalLayout {
        spacing: Sp.s5;
        Text {
            horizontal-stretch: 1;
            // The one sentence worth having here. Someone typing an address in
            // is about to be told "no" by a rule they cannot see otherwise.
            text: "Pecu only talks to encrypted endpoints, so an https:// address is required unless the node is on this machine. It never sends a key to a node.";
            font-size: Typo.caption;
            color: Theme.text-tertiary;
            wrap: word-wrap;
            vertical-alignment: center;
        }
        Btn {
            text: "Add node";
            variant: "primary";
            enabled: url.text != "";
            y: (parent.height - self.height) / 2;
            clicked => { root.submit(); }
        }
    }

    // The fields are NOT cleared here. Rust clears them once the node has
    // actually been accepted — so a refused address is still on screen to be
    // corrected rather than retyped from memory.
    function submit() {
        if (url.text == "") { return; }
        NetworkState.problem = "";
        Actions.add-node(name.text, url.text);
    }
}

component NodesScreen inherits VerticalLayout {
    spacing: Sp.s7;

    HorizontalLayout {
        spacing: Sp.s5;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Sp.s2;
            // No screen heading here: the title bar already says "Network", and
            // the two sat one above the other. Visible in a render, invisible
            // in the source.
            Text {
                // The distinction that matters: what you asked for versus what
                // the node says it is. Only the second decides anything.
                text: NetworkState.effective == ""
                    ? "Requested " + NetworkState.requested + " · no node has answered yet"
                    : "Requested " + NetworkState.requested + " · connected to " + NetworkState.effective;
                font-size: Typo.caption;
                color: Theme.text-secondary;
            }
        }
        Btn {
            text: "Probe nodes";
            y: (parent.height - self.height) / 2;
            clicked => { Actions.probe-nodes(); }
        }
    }

    // Not offered in the demo build. There is one scripted chain, and a chooser
    // that moved a scripted wallet between two directories would be a control
    // whose only effect is to lose the demo.
    if !NetworkState.mock-mode: VerticalLayout {
        spacing: Sp.s2;
        Eyebrow { text: "CHAIN"; }
        Card {
            VerticalLayout {
                padding: Sp.s5;
                spacing: Sp.s3;
                Segmented {
                    width: 320px;
                    options: ["Testnet", "Mainnet"];
                    index <=> NetworkState.chain-index;
                    changed(i) => {
                        Actions.set-requested-network(i == 1 ? "VRSC" : "VRSCTEST");
                    }
                }
                Text {
                    text: "Each chain is a separate wallet: its own keys, its own history, its own saved nodes. Nothing is shared between them, and changing chains locks the wallet.";
                    font-size: Typo.caption;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
            }
        }
    }

    Card {
        VerticalLayout {
            padding: Sp.s3;

            if NetworkState.nodes.length == 0: Rectangle {
                height: 120px;
                EmptyState {
                    glyph: "◌";
                    title: "No nodes configured";
                    body: "Pecu needs a Verus RPC endpoint to read the chain. It never sends a key to one.";
                }
            }

            for node in NetworkState.nodes: ListRow {
                glyph: node.active ? "●" : "○";
                glyph-tone: node.status == "online" ? Theme.positive
                    : node.status == "degraded" ? Theme.warning
                    : node.status == "offline" ? Theme.negative
                    : Theme.text-tertiary;
                title: node.label;
                subtitle: node.url;
                subtitle-mono: true;
                selected: node.active;
                clicked => { Actions.select-node(node.id); }

                HorizontalLayout {
                    spacing: Sp.s5;
                    alignment: end;

                    if node.note != "": Text {
                        text: node.note;
                        font-size: Typo.caption;
                        color: Theme.warning;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    // Which chain this node says it is on. Never derived from
                    // the URL — a hostname containing "test" proves nothing.
                    if node.network != "": Text {
                        text: node.network;
                        font-size: Typo.caption;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }

                    if node.tip != "": Text {
                        text: node.tip;
                        font-family: Typo.mono;
                        font-size: Typo.num-sm;
                        color: Theme.text-tertiary;
                        vertical-alignment: center;
                    }

                    if node.latency != "": Text {
                        text: node.latency;
                        font-family: Typo.mono;
                        font-size: Typo.num-sm;
                        color: Theme.text-tertiary;
                        vertical-alignment: center;
                    }

                    // The status word, not the chain name. Colour is never the
                    // only signal that a node is reachable — a green dot beside
                    // "Testnet" says which chain and nothing at all about
                    // whether it answered.
                    //
                    // Fixed width so the pills line up down the column. Every
                    // item before this one is optional, so without it each row
                    // ends wherever its own content happens to run out.
                    StatusPill {
                        width: 88px;
                        state: node.status;
                        text: node.status;
                        y: (parent.height - self.height) / 2;
                    }

                    // The slot is always here; the button is not. Reserving the
                    // space keeps the status column straight whether or not the
                    // row can be removed — and a column that shifts by a button
                    // width is the sort of thing that reads as unfinished
                    // without anyone being able to say why.
                    Rectangle {
                        width: 96px;

                        // Only what the user added. A built-in comes from the
                        // build, so removing one would last until the next
                        // start and then quietly undo itself — the core refuses
                        // it, and offering a button that cannot work is worse
                        // than not offering one.
                        if !node.builtin: Btn {
                            text: "Remove";
                            x: parent.width - self.width;
                            y: (parent.height - self.height) / 2;
                            clicked => { Actions.remove-node(node.id); }
                        }
                    }
                }
            }
        }
    }

    VerticalLayout {
        spacing: Sp.s4;
        Eyebrow { text: "ADD A NODE"; }
        Card {
            VerticalLayout {
                padding: Sp.card-pad;
                AddNodeForm {}
            }
        }
    }

    Rectangle { vertical-stretch: 1; }
}

// Which key the wallet is receiving to and paying from.
//
// One control, one fact. Receive and Send both act on whichever key is active,
// so a picker that meant something different on each screen would be two
// notions of "the key in use" — and the one that decides where money arrives
// must not be able to disagree with the one that decides where it leaves.
//
// Absent when there is nothing to pick: a control with one option in it is a
// question nobody asked.
component KeyPicker inherits HorizontalLayout {
    // Left, like everything else in a form. The receive screen centres it by
    // wrapping it, which is the one place the surrounding column is centred.
    alignment: start;
    spacing: Sp.s3;

    if WalletState.keys.length > 1: HorizontalLayout {
        spacing: Sp.s3;
        for entry in WalletState.keys: Btn {
            text: entry.label;
            variant: entry.active ? "primary" : "secondary";
            clicked => { Actions.select-key(entry.label); }
        }
    }
}

// What to send, and where.
//
// Its own component because its two inputs have to be readable from one place —
// an input declared inside an `if` cannot be reached from outside it.
component SendForm inherits HorizontalLayout {
    alignment: center;

    Card {
        width: 520px;
        VerticalLayout {
            padding: Sp.s8;
            spacing: Sp.s6;

            // Which key is paying. Named on the form rather than only in the
            // review, because "where is this coming from" is a question about
            // the payment somebody is composing, not about the one they are
            // being asked to confirm.
            VerticalLayout {
                spacing: Sp.s3;
                HorizontalLayout {
                    Text {
                        text: "From";
                        font-size: Typo.caption;
                        color: Theme.text-secondary;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: WalletState.active-key;
                        font-size: Typo.caption;
                        font-weight: Typo.w-medium;
                        color: Theme.text-primary;
                    }
                }
                Text {
                    text: WalletState.address;
                    font-family: Typo.mono;
                    font-size: Typo.num-sm;
                    color: Theme.text-tertiary;
                    overflow: elide;
                }
                KeyPicker {}
            }

            Rectangle { height: 1px; background: Theme.border-subtle; }

            VerticalLayout {
                spacing: Sp.s3;
                Text {
                    text: "Recipient";
                    font-size: Typo.caption;
                    color: Theme.text-secondary;
                }
                to := Field {
                    mono: true;
                    // The two shapes this accepts, so nobody has to find out by
                    // being refused. Not an example address anybody could copy:
                    // the prefix and the ellipsis are the whole point. The
                    // trailing `@` is not decoration — it is what a VerusID
                    // actually ends with.
                    //
                    // The word "Address" is there because "R… or name@" on its
                    // own reads as a placeholder that got clipped — a leading
                    // ellipsis is what truncation looks like, and a field that
                    // appears broken before it has been typed in is not a field
                    // anybody trusts.
                    placeholder: "Address (R…) or name@";
                    text <=> SendState.to-draft;
                    invalid: SendState.to-draft != "" && !SendState.to-valid;
                    edited => { root.check(); }
                }
                if SendState.to-note != "": Text {
                    text: SendState.to-note;
                    font-size: Typo.caption;
                    color: SendState.to-valid ? Theme.text-tertiary : Theme.negative;
                    wrap: word-wrap;
                }
            }

            VerticalLayout {
                spacing: Sp.s3;
                HorizontalLayout {
                    Text {
                        text: "Amount";
                        font-size: Typo.caption;
                        color: Theme.text-secondary;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: WalletState.spendable + " spendable";
                        font-family: Typo.mono;
                        font-size: Typo.num-sm;
                        color: Theme.text-tertiary;
                    }
                }
                Field {
                    mono: true;
                    placeholder: "0.0000 0000";
                    text <=> SendState.amount-draft;
                    invalid: SendState.amount-draft != "" && !SendState.amount-valid;
                    edited => { root.check(); }
                    accepted => { root.review(); }
                }
                if SendState.amount-note != "": Text {
                    text: SendState.amount-note;
                    font-size: Typo.caption;
                    color: Theme.negative;
                    wrap: word-wrap;
                }
            }

            // No "Max" button, deliberately. The fee is not known until the
            // builder has chosen coins, so a Max that filled in the whole
            // spendable balance would produce an amount that cannot be built —
            // a button that is wrong exactly when someone uses it.
            HorizontalLayout {
                alignment: end;
                Btn {
                    text: SendState.busy ? "Building…" : "Review payment";
                    variant: "primary";
                    enabled: SendState.ready && !SendState.busy;
                    clicked => { root.review(); }
                }
            }
        }
    }

    function check() {
        Actions.validate-draft(SendState.to-draft, SendState.amount-draft);
    }

    function review() {
        if (!SendState.ready) { return; }
        Actions.prepare-send(SendState.to-draft, SendState.amount-draft);
    }
}

component SendScreen inherits VerticalLayout {
    spacing: Sp.s7;

    if SendState.step == "form": SendForm {}

    // ── Step 2: what was actually built ─────────────────────────────────
    if SendState.step == "review": HorizontalLayout {
        alignment: center;
        Card {
            width: 560px;
            VerticalLayout {
                padding: Sp.s8;
                spacing: Sp.s6;

                VerticalLayout {
                    spacing: Sp.s2;
                    Text {
                        text: "Check this payment";
                        font-size: Typo.title2;
                        font-weight: Typo.w-bold;
                        color: Theme.text-primary;
                    }
                    Text {
                        // Says exactly what it is, because that is what makes
                        // this step worth reading.
                        text: "Read back from the transaction that was signed — not from what you typed.";
                        font-size: Typo.caption;
                        color: Theme.text-tertiary;
                        wrap: word-wrap;
                    }
                }

                // Above the outputs, because it is about the one line down
                // there that matters and somebody should read it first.
                if SendState.first-time-recipient: Rectangle {
                    background: Theme.warning-soft;
                    border-radius: R.md;
                    VerticalLayout {
                        padding: Sp.s5;
                        spacing: Sp.s2;
                        Text {
                            text: "You have not paid this address before";
                            font-size: Typo.body;
                            font-weight: Typo.w-medium;
                            color: Theme.warning;
                            wrap: word-wrap;
                        }
                        Text {
                            // The one thing a wallet can check that a checksum
                            // cannot. A mistyped address that happens to be
                            // valid looks exactly like a correct one, and coins
                            // sent to it are gone.
                            text: "Check it against where you got it from. A valid address that belongs to somebody else looks exactly like the right one, and nothing can undo the payment.";
                            font-size: Typo.caption;
                            color: Theme.text-secondary;
                            wrap: word-wrap;
                        }
                    }
                }

                // What was asked for, above what was built. A VerusID is a
                // question put to a node; this is the question, and the outputs
                // below are the answer the transaction actually pays.
                if SendState.recipient-name != "": VerticalLayout {
                    spacing: Sp.s2;
                    Eyebrow { text: "ADDRESSED TO"; }
                    Text {
                        text: SendState.recipient-name;
                        font-family: Typo.mono;
                        font-size: Typo.num;
                        color: Theme.text-primary;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "Resolved by the node this wallet is connected to. The address it resolved to is below.";
                        font-size: Typo.caption;
                        color: Theme.text-tertiary;
                        wrap: word-wrap;
                    }
                }

                // Which of this wallet's addresses is paying.
                //
                // Also computed and also unread until now. A wallet with more
                // than one key can build a payment from any of them, the form
                // has a key picker at the top of it, and the review — the
                // screen whose whole job is "check this before it is
                // irreversible" — did not say which one the transaction it
                // signed actually spends from.
                if SendState.from-address != "": VerticalLayout {
                    spacing: Sp.s2;
                    Eyebrow { text: "PAID FROM"; }
                    Text {
                        text: SendState.from-address;
                        font-family: Typo.mono;
                        font-size: Typo.num-sm;
                        color: Theme.text-secondary;
                        wrap: char-wrap;
                    }
                }

                VerticalLayout {
                    spacing: Sp.s2;
                    Eyebrow { text: "OUTPUTS"; }

                    // Change is drawn quieter than the payment, and that is a
                    // safety decision rather than a stylistic one.
                    //
                    // Both rows used to render identically: same size, same
                    // colour, same weight. But only one of them is the question
                    // being asked. Somebody checking an address under time
                    // pressure reads the first mono line they land on, and if
                    // the change output is above the payment — which it can be,
                    // since the order is the transaction's, not ours — they
                    // check the wrong one and approve.
                    //
                    // Change is still shown in full. Hiding it would mean the
                    // amounts on screen no longer add up to what leaves the
                    // wallet, and a review somebody cannot reconcile is a review
                    // they stop reading.
                    for output in SendState.outputs: HorizontalLayout {
                        spacing: Sp.s5;
                        padding-top: Sp.s3;
                        padding-bottom: Sp.s3;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: output.address == "" ? "Unknown destination" : output.address;
                                font-family: Typo.mono;
                                font-size: Typo.num-sm;
                                color: output.address == "" ? Theme.negative
                                    : output.is-change ? Theme.text-tertiary
                                    : Theme.text-primary;
                                wrap: char-wrap;
                            }
                            Text {
                                // Not "Payment · change". Change is not a
                                // payment to anybody; it is the part that never
                                // left.
                                text: output.is-change
                                    ? "Change · back to your wallet"
                                    : output.kind;
                                font-size: Typo.caption;
                                color: output.is-change ? Theme.text-disabled : Theme.text-tertiary;
                            }
                        }

                        Money {
                            amount: output.amount;
                            show-currency: false;
                            size: output.is-change ? Typo.num-sm : Typo.num;
                            tone: output.is-change ? "muted" : "neutral";
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.border-subtle;
                }

                VerticalLayout {
                    spacing: Sp.s3;
                    HorizontalLayout {
                        Text {
                            text: "Fee";
                            font-size: Typo.body;
                            color: Theme.text-secondary;
                            horizontal-stretch: 1;
                        }
                        Money { amount: SendState.fee; currency: WalletState.ticker; size: Typo.num; }
                    }
                    HorizontalLayout {
                        Text {
                            text: "Leaving your wallet";
                            font-size: Typo.body;
                            font-weight: Typo.w-medium;
                            color: Theme.text-primary;
                            horizontal-stretch: 1;
                        }
                        Money { amount: SendState.total; currency: WalletState.ticker; size: Typo.num-lg; }
                    }
                    // What is left afterwards.
                    //
                    // The core has computed this since the review screen was
                    // written — `balance_after_display`, carried through the
                    // protocol and set on this global — and **nothing read it**.
                    // It is the question somebody actually has after "how much
                    // is leaving", and the wallet already knew the answer.
                    if SendState.balance-after != "": HorizontalLayout {
                        Text {
                            text: "Left afterwards";
                            font-size: Typo.caption;
                            color: Theme.text-tertiary;
                            horizontal-stretch: 1;
                        }
                        Money {
                            amount: SendState.balance-after;
                            currency: WalletState.ticker;
                            size: Typo.num-sm;
                            tone: "muted";
                        }
                    }
                }

                if SendState.problem != "": Text {
                    text: SendState.problem;
                    font-size: Typo.caption;
                    color: Theme.negative;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: Sp.s4;
                    Btn {
                        text: "Back";
                        variant: "ghost";
                        clicked => {
                            Actions.cancel-send(SendState.ticket);
                            SendState.problem = "";
                            SendState.step = "form";
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Btn {
                        text: SendState.busy ? "Sending…" : "Send now";
                        variant: "primary";
                        enabled: !SendState.busy;
                        clicked => { Actions.confirm-send(SendState.ticket); }
                    }
                }
            }
        }
    }

    // ── Step 3: what happened ───────────────────────────────────────────
    if SendState.step == "sent" || SendState.step == "uncertain": HorizontalLayout {
        alignment: center;
        Card {
            width: 520px;
            VerticalLayout {
                padding: Sp.s8;
                spacing: Sp.s6;

                Text {
                    text: SendState.step == "sent" ? "Payment sent" : "We could not confirm your payment was sent";
                    font-size: Typo.title2;
                    font-weight: Typo.w-bold;
                    color: SendState.step == "sent" ? Theme.positive : Theme.warning;
                    wrap: word-wrap;
                }

                // The most important paragraph in the application. Someone who
                // resends here can pay twice.
                if SendState.step == "uncertain": Text {
                    text: "It may already be on its way. Pecu has saved the exact transaction and can check on it. Do not send it again — that could send the money twice.";
                    font-size: Typo.body;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }

                VerticalLayout {
                    spacing: Sp.s2;
                    Eyebrow { text: "TRANSACTION ID"; }
                    txid := TextInput {
                        text: SendState.txid;
                        read-only: true;
                        font-family: Typo.mono;
                        font-size: Typo.num-sm;
                        color: Theme.text-primary;
                        wrap: char-wrap;
                    }
                }

                HorizontalLayout {
                    spacing: Sp.s4;
                    Btn {
                        text: "Copy id";
                        clicked => {
                            txid.select-all();
                            txid.copy();
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Btn {
                        text: "Done";
                        variant: "primary";
                        clicked => {
                            SendState.problem = "";
                            SendState.step = "form";
                        }
                    }
                }
            }
        }
    }

    Rectangle { vertical-stretch: 1; }

}

// One labelled block of settings.
component Section inherits VerticalLayout {
    in property <string> title;
    in property <string> body;
    spacing: Sp.s4;

    VerticalLayout {
        spacing: Sp.s2;
        Eyebrow { text: root.title; }
        if root.body != "": Text {
            text: root.body;
            font-size: Typo.caption;
            color: Theme.text-tertiary;
            wrap: word-wrap;
        }
    }

    Card {
        VerticalLayout {
            padding: Sp.card-pad;
            spacing: Sp.s5;
            @children
        }
    }
}

// The typing-the-word half, separate so its field is addressable — an input
// declared inside an `if` cannot be reached from outside it.
component MainnetArm inherits HorizontalLayout {
    spacing: Sp.s4;

    confirm := Field {
        horizontal-stretch: 1;
        mono: true;
        placeholder: "mainnet";
        accepted => { root.arm(); }
    }
    Btn {
        // The word is checked in the CORE, not here. A confirmation the UI
        // could skip would be theatre.
        text: "Type mainnet to enable";
        enabled: confirm.text != "";
        y: (parent.height - self.height) / 2;
        clicked => { root.arm(); }
    }

    function arm() {
        if (confirm.text == "") { return; }
        Actions.set-mainnet-spend(true, confirm.text);
        confirm.text = "";
    }
}

// Turning on the one thing that can lose real money.
component MainnetToggle inherits VerticalLayout {
    spacing: Sp.s4;

    HorizontalLayout {
        spacing: Sp.s5;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: NetworkState.allow-mainnet-spend
                    ? "Spending on mainnet is ON"
                    : "Spending on mainnet is off";
                font-size: Typo.body;
                font-weight: Typo.w-medium;
                color: NetworkState.allow-mainnet-spend ? Theme.warning : Theme.text-primary;
            }
            Text {
                text: "Reading a mainnet balance is always allowed. This is only about signing away real coins, and it turns itself off again every time Pecu starts.";
                font-size: Typo.caption;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }
        }

        if NetworkState.allow-mainnet-spend: Btn {
            text: "Turn off";
            variant: "destructive";
            y: (parent.height - self.height) / 2;
            clicked => { Actions.set-mainnet-spend(false, ""); }
        }
    }

    if !NetworkState.allow-mainnet-spend: MainnetArm {}
}

// Replacing the passphrase. Costs two key derivations and re-seals 32 bytes —
// no key is re-encrypted, which is why this is cheap regardless of how many
// keys the wallet holds.
component PassphraseChange inherits VerticalLayout {
    spacing: Sp.s4;

    property <bool> matched: fresh.text == again.text;
    property <bool> mismatch: again.text != "" && !root.matched;

    // A heading and a sentence, like the block above it.
    //
    // This sat under a divider as two bare fields with no title. Inside a card
    // headed "Lock after", which made a passphrase change look like part of the
    // timeout setting — two unrelated controls reading as one.
    VerticalLayout {
        spacing: Sp.s3;
        Text {
            text: "Change passphrase";
            font-size: Typo.body;
            font-weight: Typo.w-medium;
            color: Theme.text-primary;
        }
        Text {
            text: "The vault is re-encrypted with the new one. The old passphrase stops working, and nobody can recover the new one for you.";
            font-size: Typo.caption;
            color: Theme.text-secondary;
            wrap: word-wrap;
        }
    }

    VerticalLayout {
        spacing: Sp.s3;
        Text {
            text: "Current passphrase";
            font-size: Typo.caption;
            color: Theme.text-secondary;
        }
        current := Field {
            password: true;
            placeholder: "Passphrase";
        }
    }

    VerticalLayout {
        spacing: Sp.s3;
        Text {
            text: "New passphrase";
            font-size: Typo.caption;
            color: Theme.text-secondary;
        }
        fresh := Field {
            password: true;
            placeholder: "A new passphrase";
        }
    }

    // The same confirmation the setup screen now asks for, and for a worse
    // reason.
    //
    // Setting up with a typo loses a wallet that is empty. Changing to one with
    // a typo re-seals a vault that already holds money — the old passphrase is
    // gone the moment this succeeds, and the new one is a string nobody has
    // ever seen. The wallet keeps working for the rest of the session, because
    // the key is already in memory, and is unopenable at the next launch.
    VerticalLayout {
        spacing: Sp.s3;
        Text {
            text: "New passphrase again";
            font-size: Typo.caption;
            color: root.mismatch ? Theme.negative : Theme.text-secondary;
        }
        again := Field {
            password: true;
            placeholder: "Type it again";
            invalid: root.mismatch;
            accepted => { root.submit(); }
        }
        if root.mismatch: Text {
            text: "The two do not match.";
            font-size: Typo.caption;
            color: Theme.negative;
        }
    }

    HorizontalLayout {
        alignment: end;
        Btn {
            text: "Change passphrase";
            variant: "primary";
            enabled: current.text != "" && fresh.text != "" && root.matched;
            clicked => { root.submit(); }
        }
    }

    // Both secrets leave in one call and every field is blanked before it
    // returns — the same discipline as every other secret-bearing path here.
    function submit() {
        if (current.text == "" || fresh.text == "" || !root.matched) { return; }
        Actions.change-passphrase(current.text, fresh.text);
        current.text = "";
        fresh.text = "";
        again.text = "";
    }
}

// Renaming one key.
//
// Its own component because its input has to be addressable, and because the
// form has to be able to submit from two places — the button and the Return
// key — without duplicating the guard.
component RenameKeyForm inherits VerticalLayout {
    in property <string> label;
    spacing: Sp.s3;

    HorizontalLayout {
        spacing: Sp.s4;

        field := Field {
            horizontal-stretch: 1;
            mono: true;
            placeholder: "savings";
            text <=> WalletState.rename-draft;
            accepted => { root.submit(); }
        }

        Btn {
            text: "Save";
            variant: "primary";
            enabled: field.text != "" && field.text != root.label;
            y: (parent.height - self.height) / 2;
            clicked => { root.submit(); }
        }

        Btn {
            text: "Cancel";
            variant: "ghost";
            y: (parent.height - self.height) / 2;
            clicked => {
                WalletState.renaming = "";
                WalletState.key-problem = "";
            }
        }
    }

    // Under the form, not at the foot of the list. A refusal that appears
    // three rows away from the field it is about is one someone has to go
    // looking for.
    if WalletState.key-problem != "": Text {
        text: WalletState.key-problem;
        font-size: Typo.caption;
        color: Theme.negative;
        wrap: word-wrap;
    }

    // The form is not closed here. Rust closes it when the rename actually
    // lands — a name the vault refuses must not vanish off the screen along
    // with the message explaining why.
    function submit() {
        if (field.text == "" || field.text == root.label) { return; }
        WalletState.key-problem = "";
        Actions.rename-key(root.label, field.text);
    }
}

// Adding a key to a wallet that already exists.
component AddKeyForm inherits HorizontalLayout {
    spacing: Sp.s4;

    field := Field {
        horizontal-stretch: 1;
        mono: true;
        placeholder: "savings";
        text <=> WalletState.new-key-draft;
        accepted => { root.submit(); }
    }

    Btn {
        text: "Generate a key";
        enabled: field.text != "";
        y: (parent.height - self.height) / 2;
        clicked => { root.submit(); }
    }

    function submit() {
        if (field.text == "") { return; }
        WalletState.key-problem = "";
        Actions.add-key(field.text);
    }
}

// One key in the list.
//
// Its own component for the usual reason: the rename form lives inside an `if`,
// and an element declared inside one cannot be reached from outside it.
component KeyRowItem inherits VerticalLayout {
    in property <KeyRow> entry;
    spacing: Sp.s3;

    ListRow {
        // Filled for the active key, hollow for the rest — the same shape the
        // node list uses, so "this is the one in use" reads the same way in
        // both places.
        glyph: root.entry.active ? "●" : "○";
        glyph-tone: root.entry.active ? Theme.accent : Theme.text-tertiary;
        title: root.entry.label;
        subtitle: root.entry.address;
        subtitle-mono: true;
        selected: root.entry.active;
        clicked => { Actions.select-key(root.entry.label); }

        HorizontalLayout {
            spacing: Sp.s5;
            alignment: end;

            // A key whose phrase nobody has written down is one power cut away
            // from being gone. Worth saying on the row, not only on a banner
            // somebody has already dismissed.
            if !root.entry.backed-up: StatusPill {
                state: "pending";
                text: "not backed up";
                y: (parent.height - self.height) / 2;
            }

            // A WIF import never had a phrase, so there is nothing to write
            // down and nothing to warn about. Saying it once here is what
            // stops it reading as a missing backup.
            if root.entry.origin == "wif": Text {
                text: "no recovery phrase";
                font-size: Typo.caption;
                color: Theme.text-tertiary;
                vertical-alignment: center;
            }

            // Bordered, like Remove on the node list. A bare word at the end
            // of a row reads as a label, and the two lists should not disagree
            // about what a row-level action looks like.
            Rectangle {
                width: 100px;
                Btn {
                    text: "Rename";
                    x: parent.width - self.width;
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        WalletState.key-problem = "";
                        WalletState.renaming = root.entry.label;
                        WalletState.rename-draft = root.entry.label;
                    }
                }
            }
        }
    }

    if WalletState.renaming == root.entry.label: RenameKeyForm {
        label: root.entry.label;
    }
}

// Naming one address.
//
// Its own component because its input has to be addressable, and because a
// form that lives inside an `if` cannot be reached from outside it.
component NameAddressForm inherits HorizontalLayout {
    in property <string> address;
    spacing: Sp.s4;

    field := Field {
        horizontal-stretch: 1;
        placeholder: "the exchange";
        text <=> SendState.name-draft;
        accepted => { root.submit(); }
    }

    Btn {
        text: "Save";
        variant: "primary";
        y: (parent.height - self.height) / 2;
        clicked => { root.submit(); }
    }

    Btn {
        text: "Cancel";
        variant: "ghost";
        y: (parent.height - self.height) / 2;
        clicked => { SendState.naming = ""; }
    }

    // An empty name is allowed, and it means "forget the name" rather than
    // "forget the address" — the wallet still knows it was paid, which is what
    // stops the review warning about it again.
    function submit() {
        Actions.label-address(root.address, field.text);
    }
}

// One address the wallet has paid.
component KnownAddressItem inherits VerticalLayout {
    in property <KnownAddressRow> entry;
    spacing: Sp.s3;

    ListRow {
        // The name where there is one, the address where there is not. An
        // unnamed row must not read as an empty row.
        title: root.entry.label == "" ? root.entry.address : root.entry.label;
        title-mono: root.entry.label == "";
        subtitle: root.entry.label == "" ? root.entry.summary : root.entry.address;
        subtitle-mono: root.entry.label != "";
        interactive: false;

        HorizontalLayout {
            spacing: Sp.s5;
            alignment: end;

            if root.entry.label != "": Text {
                text: root.entry.summary;
                font-size: Typo.caption;
                color: Theme.text-tertiary;
                vertical-alignment: center;
            }

            Rectangle {
                width: 88px;
                Btn {
                    text: root.entry.label == "" ? "Name" : "Rename";
                    x: parent.width - self.width;
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        SendState.naming = root.entry.address;
                        SendState.name-draft = root.entry.label;
                    }
                }
            }

            Rectangle {
                width: 88px;
                Btn {
                    // Not destructive-red. Forgetting an address costs nothing
                    // and undoes nothing — the payment already happened and is
                    // on the chain. What it does is make the review warn about
                    // that address again, which is what somebody removing it
                    // is asking for.
                    text: "Forget";
                    x: parent.width - self.width;
                    y: (parent.height - self.height) / 2;
                    clicked => { Actions.forget-address(root.entry.address); }
                }
            }
        }
    }

    if SendState.naming == root.entry.address: NameAddressForm {
        address: root.entry.address;
    }
}

// Settings, in four parts rather than one scroll.
//
// # Why this is not one long page any more
//
// It was six sections stacked: security, keys, addresses, appearance, network,
// about. At the window's own preferred height you saw the first and the top of
// the second, and everything else was below the fold — so somebody looking up
// who they had paid scrolled past a passphrase-change form to get there, every
// time.
//
// The switcher also makes the page photographable. Three of the four Settings
// reference images used to be the same picture of the top of the same page,
// because a fixture cannot scroll a flickable, and a screen no reference image
// covers is a screen that changes without anybody seeing it.
component SettingsScreen inherits VerticalLayout {
    // 0 security · 1 keys · 2 addresses · 3 general
    in-out property <int> tab: 0;

    spacing: Sp.section-gap;
    property <[int]> lock-choices: [1, 5, 15, 60, 0];

    HorizontalLayout {
        alignment: start;
        Segmented {
            width: 460px;
            options: ["Security", "Keys", "Addresses", "General"];
            index <=> root.tab;
        }
    }

    // Applied here AND sent to be written down. Applying it locally rather than
    // waiting for the core to echo it back is what keeps the button feeling
    // immediate; the core's copy is only read at the next start.
    function appearance(dark: bool, reduce: bool) {
        Theme.dark = dark;
        Motion.enabled = !reduce;
        Actions.set-appearance(dark, reduce);
    }

    if root.tab == 0: Section {
        title: "SECURITY";

        VerticalLayout {
            spacing: Sp.s3;
            Text {
                text: "Lock after";
                font-size: Typo.body;
                font-weight: Typo.w-medium;
                color: Theme.text-primary;
            }
            Text {
                text: "Locking drops the key that decrypts your wallet, so every key in it becomes unreadable until you enter the passphrase again.";
                font-size: Typo.caption;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: Sp.s3;
                alignment: start;
                for minutes in root.lock-choices: Btn {
                    text: minutes == 0 ? "Never"
                        : minutes == 60 ? "1 hour"
                        : minutes + " min";
                    variant: WalletState.auto-lock == minutes ? "primary" : "secondary";
                    clicked => { Actions.set-auto-lock(minutes); }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border-subtle; }

        PassphraseChange {}
    }

    if root.tab == 1: Section {
        title: "KEYS";
        body: "A Pecu wallet holds any number of keys, and the dashboard adds up all of them. One passphrase protects the lot — adding a key does not ask for it again.";

        for entry in WalletState.keys: KeyRowItem {
            entry: entry;
        }

        Rectangle { height: 1px; background: Theme.border-subtle; }

        VerticalLayout {
            spacing: Sp.s3;
            Text {
                text: "Add a key";
                font-size: Typo.body;
                font-weight: Typo.w-medium;
                color: Theme.text-primary;
            }
            Text {
                // Verus transparent keys are not hierarchical-deterministic:
                // one phrase is one key. Somebody who expects a second key to
                // fall out of the phrase they already wrote down needs to hear
                // otherwise before they generate one, not after.
                text: "A new key comes with its own recovery phrase, and you will be asked to write it down. Verus keys are not derived from one another — the phrase you already have does not restore this one.";
                font-size: Typo.caption;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }
            AddKeyForm {}

            // Only when no rename is open — that form shows its own copy under
            // itself, and one message rendered twice reads as two problems.
            if WalletState.key-problem != "" && WalletState.renaming == "": Text {
                text: WalletState.key-problem;
                font-size: Typo.caption;
                color: Theme.negative;
                wrap: word-wrap;
            }
        }
    }

    if root.tab == 2: Section {
        title: "ADDRESSES";
        body: "Who this wallet has paid. Pecu records a recipient once a node has accepted the payment, so it can tell you when you are paying somewhere new — the one check it can make that a checksum cannot.";

        if SendState.known.length == 0: Text {
            text: "Nothing yet. An address appears here the first time you pay it.";
            font-size: Typo.caption;
            color: Theme.text-tertiary;
        }

        for entry in SendState.known: KnownAddressItem {
            entry: entry;
        }
    }

    if root.tab == 3: Section {
        title: "APPEARANCE";

        VerticalLayout {
            spacing: Sp.s3;
            Text {
                text: "Theme";
                font-size: Typo.body;
                font-weight: Typo.w-medium;
                color: Theme.text-primary;
            }
            HorizontalLayout {
                spacing: Sp.s3;
                alignment: start;
                Btn {
                    text: "Dark";
                    variant: Theme.dark ? "primary" : "secondary";
                    clicked => { root.appearance(true, !Motion.enabled); }
                }
                Btn {
                    text: "Light";
                    variant: Theme.dark ? "secondary" : "primary";
                    clicked => { root.appearance(false, !Motion.enabled); }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border-subtle; }

        VerticalLayout {
            spacing: Sp.s3;
            Text {
                text: "Motion";
                font-size: Typo.body;
                font-weight: Typo.w-medium;
                color: Theme.text-primary;
            }
            Text {
                // What "reduced" actually means here, because the usual
                // implementation of this switch is "nothing happens at all"
                // and that is not what this one does.
                text: "Reduced motion removes movement, scaling and the chart's draw-in. Cross-fades stay: opacity is not a vestibular trigger, and a hard swap is jarring for motion-sensitive people too.";
                font-size: Typo.caption;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: Sp.s3;
                alignment: start;
                Btn {
                    text: "Full motion";
                    variant: Motion.enabled ? "primary" : "secondary";
                    clicked => { root.appearance(Theme.dark, false); }
                }
                Btn {
                    text: "Reduced";
                    variant: Motion.enabled ? "secondary" : "primary";
                    clicked => { root.appearance(Theme.dark, true); }
                }
            }
        }
    }

    if root.tab == 3: Section {
        title: "NETWORK";
        MainnetToggle {}
    }

    if root.tab == 3: Section {
        title: "ABOUT";

        VerticalLayout {
            spacing: Sp.s4;

            HorizontalLayout {
                Text {
                    text: "Wallet file";
                    font-size: Typo.body;
                    color: Theme.text-secondary;
                    horizontal-stretch: 1;
                }
                Text {
                    text: WalletState.vault-path;
                    font-family: Typo.mono;
                    font-size: Typo.num-sm;
                    color: Theme.text-tertiary;
                    overflow: elide;
                }
            }

            HorizontalLayout {
                Text {
                    text: "Logs";
                    font-size: Typo.body;
                    color: Theme.text-secondary;
                    horizontal-stretch: 1;
                }
                Text {
                    text: AppInfo.log-path;
                    font-family: Typo.mono;
                    font-size: Typo.num-sm;
                    color: Theme.text-tertiary;
                    overflow: elide;
                }
            }

            // The fonts are compiled into this binary, and the SIL Open Font
            // License requires its notice to travel with them — which means it
            // travels with the executable, not just with the source tree. This
            // line is that notice. See `ui/fonts/README.md`.
            HorizontalLayout {
                Text {
                    text: "Typeset in";
                    font-size: Typo.body;
                    color: Theme.text-secondary;
                    horizontal-stretch: 1;
                }
                Text {
                    text: "Space Grotesk and JetBrains Mono NL · SIL OFL 1.1";
                    font-size: Typo.caption;
                    color: Theme.text-tertiary;
                }
            }

            HorizontalLayout {
                Text {
                    text: "Verus SDK";
                    font-size: Typo.body;
                    color: Theme.text-secondary;
                    horizontal-stretch: 1;
                }
                Text {
                    // Which revision is in the build is a fact worth being able
                    // to read off a screen rather than out of a lock file.
                    text: AppInfo.sdk-rev;
                    font-family: Typo.mono;
                    font-size: Typo.num-sm;
                    color: Theme.text-tertiary;
                }
            }
        }
    }

    Rectangle { vertical-stretch: 1; }
}

// One transaction, in the list.
component ActivityRowItem inherits VerticalLayout {
    in property <ActivityRow> entry;
    // Mined, and therefore in a block with a time and a depth.
    property <bool> settled: !root.entry.pending && root.entry.height > 0;
    // Depth, guarded and capped.
    //
    // Guarded because a tip that is briefly behind a block — during a reorg, or
    // between a new block arriving and the next poll — would otherwise print a
    // negative count. Capped because past a thousand the exact number carries
    // no information anybody uses: what matters is 1 (it is in a block) and
    // 100 (a coinbase has matured), and "1 187 402 confirmations" is a figure
    // that only makes the useful ones harder to read.
    property <int> depth: max(0, WalletState.tip-height - root.entry.height + 1);
    spacing: Sp.s2;

    // The day heading, above the first row of that day. Its own layout so the
    // breathing room above it is padding rather than a Text property that
    // silently does nothing.
    if root.entry.group != "": VerticalLayout {
        padding-top: Sp.s5;
        padding-left: Sp.s5;
        padding-bottom: Sp.s2;
        Text {
            text: root.entry.group;
            font-size: Typo.micro;
            font-weight: Typo.w-medium;
            letter-spacing: 0.6px;
            color: Theme.text-tertiary;
        }
    }

    ListRow {
        glyph: root.entry.direction == "in" ? "↓" : root.entry.direction == "out" ? "↑" : "↔";
        glyph-tone: root.entry.direction == "in" ? Theme.positive
            : root.entry.direction == "out" ? Theme.negative
            : Theme.text-secondary;
        title: root.entry.direction == "in" ? "Received"
            : root.entry.direction == "out" ? "Sent"
            : "Moved";
        // When, not which transaction.
        //
        // This line used to carry the abbreviated txid, and it made every row
        // in the list look like every other: sixty-four hex characters elided
        // to eight are not something a person tells apart, so a screen of them
        // reads as one repeated row. The time differs between rows, which is
        // the whole job of a subtitle in a list somebody scans.
        //
        // The id is not lost — it is in the sheet a click away, in full and
        // beside an explorer link, which is where somebody who wants a
        // transaction id is actually going.
        //
        // The chain has nothing better to offer here. The history comes from
        // address deltas, and a delta names no counterparty: putting "to
        // robert@" on this line would cost a `getrawtransaction` per row.
        subtitle: root.settled ? root.entry.when : "";
        interactive: true;
        clicked => { Actions.open-tx(root.entry.txid); }

        HorizontalLayout {
            spacing: Sp.s5;
            alignment: end;

            VerticalLayout {
                alignment: center;
                spacing: 2px;

                if root.settled: Text {
                    // Derived, never stored: `tip - height + 1`. A new block
                    // changes one number and every row here follows.
                    text: WalletState.tip-height == 0 ? ""
                        : root.depth == 1 ? "1 confirmation"
                        : root.depth > 999 ? "999+ confirmations"
                        : root.depth + " confirmations";
                    font-size: Typo.micro;
                    color: Theme.text-disabled;
                    horizontal-alignment: right;
                }
                if !root.settled: Text {
                    text: "unconfirmed";
                    font-size: Typo.caption;
                    color: Theme.warning;
                    horizontal-alignment: right;
                }
            }

            Money {
                amount: root.entry.amount;
                show-currency: false;
                tone: root.entry.direction == "in" ? "positive"
                    : root.entry.direction == "out" ? "negative"
                    : "neutral";
                y: (parent.height - self.height) / 2;
            }
        }
    }
}

// The one screen that scrolls itself.
//
// # Why it is not inside the shared page scroller
//
// Every other screen is a page of a known height, and one `Flickable` around all
// of them is right. This one is as long as somebody's history — and it used to
// be a plain `for`, which builds every row as a live component whether or not
// anybody can see it. Measured, release build, in `examples/scroll_cost.rs`:
//
// | rows | build + layout |
// |-----:|---------------:|
// |  100 |        17.6 ms |
// | 1000 |        56.6 ms |
// | 10k  |         552 ms |
// | 50k  |          2.9 s |
//
// Linear, and paid on the thread the interface answers on. Slint's software
// renderer will not even draw past about a thousand rows: it works in i16
// fixed-point coordinates and a column that tall overflows them.
//
// `ListView` builds only what is visible. It is also a scroller, and a scroller
// inside a `Flickable` is two of them fighting over one wheel — which is why
// this screen is hoisted out of the shared one rather than dropped into it.
// Looking one up: anyone's identity, not only your own.
component LookUpForm inherits VerticalLayout {
    spacing: Sp.s3;

    function submit() {
        if (field.text == "") { return; }
        IdentityState.lookup-problem = "";
        Actions.look-up-identity(field.text);
    }

    HorizontalLayout {
        spacing: Sp.s4;
        field := Field {
            horizontal-stretch: 1;
            mono: true;
            placeholder: "name@ or i-address";
            text <=> IdentityState.lookup-draft;
            invalid: IdentityState.lookup-problem != "";
            accepted => { root.submit(); }
        }
        Btn {
            text: "Look up";
            y: (parent.height - self.height) / 2;
            clicked => { root.submit(); }
        }
    }

    if IdentityState.lookup-problem != "": Text {
        text: IdentityState.lookup-problem;
        font-size: Typo.caption;
        color: Theme.negative;
        wrap: word-wrap;
    }
}

// What happens, in order, and where it has got to.
//
// # Why this exists rather than a spinner
//
// Creating a currency from a new name is two transactions with a wait between
// them, and the wallet does the second one by itself. "Happening in the
// background" is the whole promise, and a spinner is the shape that promise
// takes when nobody makes it legible — so this names the four steps and marks
// the two that spend money, which is what somebody would want to stop before.
component FlowStepper inherits HorizontalLayout {
    in property <[FlowStep]> steps;
    spacing: Sp.s2;
    alignment: start;

    for step[i] in root.steps: HorizontalLayout {
        spacing: Sp.s2;

        VerticalLayout {
            spacing: Sp.s2;
            alignment: center;

            HorizontalLayout {
                spacing: Sp.s3;
                alignment: center;
                Rectangle {
                    width: 20px;
                    height: 20px;
                    border-radius: 10px;
                    background: step.state == "done" ? Theme.positive
                        : step.state == "now" ? Theme.accent
                        : step.state == "failed" ? Theme.negative
                        : Theme.bg-inset;
                    border-width: step.state == "later" ? 1px : 0px;
                    border-color: Theme.border-default;
                    Text {
                        // A tick, a dot, an exclamation, or the step's number.
                        //
                        // Mono, because `✓` and `●` are in JetBrains Mono NL and
                        // in **none** of the three Space Grotesk weights — read
                        // out of the `cmap` tables, not assumed. Drawn in the UI
                        // face they fall through to whatever the system has,
                        // which is the per-platform fork the bundled fonts
                        // exist to prevent. This file has been caught by a
                        // missing glyph three times; this is the fourth.
                        text: step.state == "done" ? "✓"
                            : step.state == "now" ? "●"
                            : step.state == "failed" ? "!"
                            : (i + 1);
                        font-family: Typo.mono;
                        font-size: Typo.micro;
                        font-weight: Typo.w-medium;
                        color: step.state == "later" ? Theme.text-tertiary : Theme.text-on-accent;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                VerticalLayout {
                    spacing: 0px;
                    alignment: center;
                    Text {
                        text: step.label;
                        font-size: Typo.caption;
                        font-weight: step.state == "now" ? Typo.w-medium : Typo.w-regular;
                        color: step.state == "later" ? Theme.text-tertiary : Theme.text-primary;
                    }
                    if step.costs: Text {
                        text: "costs a fee";
                        font-size: Typo.micro;
                        color: Theme.warning;
                    }
                }
            }
        }

        // The connector, on every step but the last.
        if i < root.steps.length - 1: Rectangle {
            width: 24px;
            height: 1px;
            y: 10px;
            background: Theme.border-default;
        }
    }
}

// Claiming a name: three questions, one at a time.
//
// # Why this is stepped and the send form is not
//
// Because one of the three is a decision people do not know they are making.
// The authority fields, left blank, make the identity its own authority — and
// consensus refuses a revocation whose subject is its own recovery authority,
// so the name is then **unrevokable, permanently**, until a later transaction
// pays to change it. On one flat form that outcome was what happened to
// somebody who read nothing: the explanation was the biggest block of text on
// the screen, sitting between the two fields it was about, and the way past it
// was to ignore it.
//
// A step cannot be ignored. It can only be answered.
component RegisterForm inherits VerticalLayout {
    spacing: Sp.s6;

    // The breadcrumb is built here, unlike the currency form's diagram, which
    // comes from the core.
    //
    // The difference is what each one is about. That one draws **transactions**
    // — how many there are and which cost money are facts about the chain, and
    // an interface deciding them for itself would be a second opinion about
    // what is being spent. This draws where somebody is in a form, which is
    // this file's own business and has no chain fact in it at all. Routing it
    // through the core would put a round trip between pressing Next and seeing
    // the step change.
    FlowStepper {
        steps: [
            {
                label: "Choose the name",
                state: IdentityState.claim-step == "name" ? "now" : "done",
                costs: false,
            },
            {
                label: "Who can take it back",
                state: IdentityState.claim-step == "name" ? "later"
                    : IdentityState.claim-step == "authority" ? "now" : "done",
                costs: false,
            },
            {
                label: "Check and claim",
                state: IdentityState.claim-step == "review" ? "now" : "later",
                costs: false,
            },
        ];
    }

    // ── 1 · The name ────────────────────────────────────────────────────
    if IdentityState.claim-step == "name": VerticalLayout {
        spacing: Sp.s3;
        Text {
            text: "The name this identity will be known by. It becomes an address that never changes, and it cannot be renamed later.";
            font-size: Typo.caption;
            color: Theme.text-secondary;
            wrap: word-wrap;
        }
        // Same debounce as the currency form's name field, for the same reason:
        // two chain requests per keystroke.
        //
        // One difference worth stating: there, the local rule about what a name
        // may contain still runs immediately, because the draft check runs it
        // too. Here `check-name` is the only path, so a capital letter is now
        // flagged after the pause rather than on the keystroke. That is a third
        // of a second on a message nobody is racing, against sixteen requests
        // for an eight-letter name.
        namecheck := Timer {
            interval: 350ms;
            running: false;
            triggered => {
                self.running = false;
                Actions.check-name(IdentityState.name-draft);
            }
        }
        name := Field {
            mono: true;
            placeholder: "lowercase, digits, _ and -";
            text <=> IdentityState.name-draft;
            invalid: name.text != "" && IdentityState.name-problem != "";
            edited => {
                namecheck.running = false;
                namecheck.running = true;
            }
        }
        if IdentityState.name-problem != "": Text {
            text: IdentityState.name-problem;
            font-size: Typo.caption;
            color: Theme.negative;
            wrap: word-wrap;
        }
        if IdentityState.name-problem == "" && IdentityState.name-fee != "": Text {
            text: "Free to claim · costs " + IdentityState.name-fee + " " + WalletState.ticker;
            font-size: Typo.caption;
            color: Theme.text-tertiary;
            wrap: word-wrap;
        }
    }

    // ── 2 · Who can take it back ────────────────────────────────────────
    //
    // Two answers, both of them written down. Neither is preselected: the whole
    // reason this is a step is that the dangerous answer used to be what
    // happened when nobody chose.
    if IdentityState.claim-step == "authority": VerticalLayout {
        spacing: Sp.s3;
        Text {
            text: "If this name is ever stolen — a key copied, a machine lost — revoking it is what stops the thief using it. Revoking needs a recovery authority that is not the identity itself, and that can only be set for free now.";
            font-size: Typo.caption;
            color: Theme.text-secondary;
            wrap: word-wrap;
        }

        choice := VerticalLayout {
            spacing: Sp.s3;

            Rectangle {
                border-radius: R.md;
                border-width: 1px;
                border-color: IdentityState.claim-authority == "other"
                    ? Theme.accent : Theme.border-subtle;
                background: IdentityState.claim-authority == "other"
                    ? Theme.accent-soft : Theme.bg-surface;
                VerticalLayout {
                    padding: Sp.s4;
                    spacing: 2px;
                    Text {
                        text: "Another identity can recover it";
                        font-size: Typo.body;
                        color: Theme.text-primary;
                    }
                    Text {
                        text: "The one to choose if this name matters. Name an identity you also control, or one you trust.";
                        font-size: Typo.caption;
                        color: Theme.text-secondary;
                        wrap: word-wrap;
                    }
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { IdentityState.claim-authority = "other"; }
                }
                accessible-role: AccessibleRole.button;
                accessible-label: "Another identity can recover it. The one to choose if this name matters.";
                accessible-action-default => { IdentityState.claim-authority = "other"; }
            }

            Rectangle {
                border-radius: R.md;
                border-width: 1px;
                border-color: IdentityState.claim-authority == "none"
                    ? Theme.warning : Theme.border-subtle;
                background: IdentityState.claim-authority == "none"
                    ? Theme.warning-soft : Theme.bg-surface;
                VerticalLayout {
                    padding: Sp.s4;
                    spacing: 2px;
                    Text {
                        text: "Nobody — it can never be revoked";
                        font-size: Typo.body;
                        color: Theme.text-primary;
                    }
                    Text {
                        text: "The identity becomes its own authority, and the chain refuses a revocation whose subject is its own recovery authority. Changing this later costs another transaction.";
                        font-size: Typo.caption;
                        color: Theme.text-secondary;
                        wrap: word-wrap;
                    }
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        IdentityState.claim-authority = "none";
                        // Cleared, so what the review shows and what the command
                        // carries cannot disagree with the answer given here.
                        IdentityState.revocation-draft = "";
                        IdentityState.recovery-draft = "";
                    }
                }
                accessible-role: AccessibleRole.button;
                accessible-label: "Nobody. It can never be revoked.";
                accessible-action-default => {
                    IdentityState.claim-authority = "none";
                    IdentityState.revocation-draft = "";
                    IdentityState.recovery-draft = "";
                }
            }
        }

        if IdentityState.claim-authority == "other": VerticalLayout {
            spacing: Sp.s3;
            HorizontalLayout {
                spacing: Sp.s4;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: Sp.s2;
                    Text {
                        text: "Recovery — required";
                        font-size: Typo.caption;
                        color: Theme.text-secondary;
                    }
                    Field {
                        mono: true;
                        placeholder: "name@ or i-address";
                        text <=> IdentityState.recovery-draft;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: Sp.s2;
                    Text {
                        text: "Revocation — optional";
                        font-size: Typo.caption;
                        color: Theme.text-secondary;
                    }
                    Field {
                        mono: true;
                        placeholder: "name@ or i-address";
                        text <=> IdentityState.revocation-draft;
                    }
                }
            }
            // Which of the two actually decides this, said plainly. It is not
            // obvious and it is the reason one field is required and the other
            // is not.
            Text {
                text: "Recovery is the one that matters: leave it blank and the identity is its own recovery authority again, whatever revocation says. Left blank, revocation becomes the identity itself, which can revoke itself — that is fine.";
                font-size: Typo.caption;
                color: Theme.text-tertiary;
                wrap: word-wrap;
            }
        }
    }

    // ── 3 · Check and claim ─────────────────────────────────────────────
    if IdentityState.claim-step == "review": VerticalLayout {
        spacing: Sp.s5;

        VerticalLayout {
            spacing: 2px;
            Text {
                text: IdentityState.name-draft + "@";
                font-family: Typo.mono;
                font-size: Typo.title3;
                color: Theme.text-primary;
                wrap: char-wrap;
            }
            Text {
                text: IdentityState.claim-authority == "none"
                    ? "Nobody can revoke it, ever."
                    : "Recoverable by " + IdentityState.recovery-draft;
                font-size: Typo.body;
                color: IdentityState.claim-authority == "none"
                    ? Theme.warning : Theme.text-secondary;
                wrap: word-wrap;
            }
        }

        // What the chain is about to be asked to do. Stated in words rather
        // than drawn as a second diagram: the one above says where you are in
        // this form, and two three-step pictures on one screen is a puzzle.
        //
        // The deadline belongs here, before the first fee, and not only in the
        // panel that appears after it has been paid.
        Rectangle {
            background: Theme.bg-inset;
            border-radius: R.md;
            VerticalLayout {
                padding: Sp.s5;
                spacing: Sp.s3;
                Eyebrow { text: "WHAT HAPPENS NEXT · TWO TRANSACTIONS"; }
                Text {
                    text: "1 · The claim is signed and sent, and it costs a fee.";
                    font-size: Typo.caption;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                Text {
                    text: "2 · It has to be mined, which takes a few minutes. Pecu may be closed while that happens — the claim is written down and picked up again.";
                    font-size: Typo.caption;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                Text {
                    text: "3 · The name is registered, which costs the rest of the fee. This must happen within about twenty blocks: the deadline is inside the bytes the claim was signed with, so it cannot be extended, and missing it spends the first fee for nothing.";
                    font-size: Typo.caption;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
            }
        }

        if IdentityState.claim-authority == "none": Rectangle {
            background: Theme.warning-soft;
            border-radius: R.md;
            VerticalLayout {
                padding: Sp.s5;
                spacing: Sp.s2;
                Text {
                    text: "This name will not be revokable";
                    font-size: Typo.body;
                    font-weight: Typo.w-medium;
                    color: Theme.warning;
                    wrap: word-wrap;
                }
                Text {
                    text: "If its keys are ever copied, there is nothing that stops the copy being used. Naming a recovery authority is free right now and costs a transaction afterwards.";
                    font-size: Typo.caption;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
            }
        }
    }
}

// A claim that is under way. Two transactions with a deadline between them.
component RegistrationPanel inherits VerticalLayout {
    spacing: Sp.s4;

    Text {
        text: IdentityState.reg-name;
        font-family: Typo.mono;
        font-size: Typo.title3;
        color: Theme.text-primary;
        wrap: char-wrap;
    }

    Text {
        text: IdentityState.reg-note;
        font-size: Typo.body;
        color: Theme.text-secondary;
        wrap: word-wrap;
    }

    // Where the claim has got to, in the same diagram the review described it
    // with. Empty when the claim ended without finishing — the note above
    // already says the fee is spent and the name was not registered, and a
    // path somebody might still walk would be the wrong picture of that.
    if IdentityState.reg-steps.length > 0: FlowStepper {
        steps: IdentityState.reg-steps;
    }

    // The deadline, in the shape the send screen uses for a warning — because
    // it is one. The window is about twenty blocks and it cannot be extended:
    // the expiry is inside the bytes the claim was signed with.
    if IdentityState.reg-deadline != "": Rectangle {
        background: Theme.warning-soft;
        border-radius: R.md;
        VerticalLayout {
            padding: Sp.s5;
            spacing: Sp.s2;
            Text {
                text: IdentityState.reg-deadline;
                font-size: Typo.body;
                font-weight: Typo.w-medium;
                color: Theme.warning;
                wrap: word-wrap;
            }
            Text {
                text: "Safe to close Pecu — the claim is written down and will be picked up. Do not start the same name again; that would spend a second fee.";
                font-size: Typo.caption;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }
        }
    }

    // What the claim costs.
    //
    // Set by the core when the name was checked and never shown once the claim
    // was under way — so the panel could tell somebody a fee had been spent
    // without ever telling them how much. The third value in this interface
    // that was computed, carried and then dropped.
    if IdentityState.reg-fee != "": HorizontalLayout {
        Text {
            text: "Fee";
            font-size: Typo.body;
            color: Theme.text-secondary;
            horizontal-stretch: 1;
        }
        Money {
            amount: IdentityState.reg-fee;
            currency: WalletState.ticker;
            size: Typo.num;
        }
    }

    if IdentityState.reg-address != "": VerticalLayout {
        spacing: Sp.s2;
        Eyebrow { text: "ITS ADDRESS"; }
        Text {
            text: IdentityState.reg-address;
            font-family: Typo.mono;
            font-size: Typo.num-sm;
            color: Theme.text-primary;
            wrap: char-wrap;
        }
    }

    if IdentityState.reg-step == "done" && IdentityState.reg-cannot-be-revoked: Rectangle {
        background: Theme.warning-soft;
        border-radius: R.md;
        VerticalLayout {
            padding: Sp.s5;
            spacing: Sp.s2;
            Text {
                text: "This VerusID cannot be revoked yet";
                font-size: Typo.body;
                font-weight: Typo.w-medium;
                color: Theme.warning;
                wrap: word-wrap;
            }
            Text {
                text: "It is its own recovery authority. Pointing recovery at another identity is what makes revocation work, and your keys can still do that.";
                font-size: Typo.caption;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }
        }
    }

    HorizontalLayout {
        spacing: Sp.s4;
        alignment: end;
        if IdentityState.reg-step != "done": Btn {
            text: "Abandon";
            variant: "ghost";
            enabled: !IdentityState.reg-busy;
            clicked => { Actions.abandon-registration(); }
        }
        if IdentityState.reg-step == "ready": Btn {
            text: IdentityState.reg-busy ? "Registering…" : "Register the name";
            variant: "primary";
            enabled: !IdentityState.reg-busy;
            clicked => { Actions.finish-registration(); }
        }
        if IdentityState.reg-step == "done": Btn {
            text: "Done";
            variant: "primary";
            clicked => { Actions.abandon-registration(); }
        }
    }
}

// What this wallet's identities define, and what they could still define.
//
// # Why the second list is on the same screen
//
// A currency cannot exist without an identity of the same name, and an identity
// may define exactly one, once. So "which of my names are still free for this"
// is not a separate question somebody goes looking for — it is the other half
// of the list they are already reading, and the place a launch starts from.
// A proportional bar: slices side by side, each as wide as its share.
//
// # Why a bar and not a pie
//
// The arithmetic is the same; the reading is not. A pie needs path arcs — new
// geometry code in a crate that plots time series — and at this size it makes
// two similar shares indistinguishable. A bar is rectangles with proportional
// widths, which Slint lays out for free, and it can draw **short**: a basket
// whose weights do not add to one whole leaves a visible gap, which is the one
// mistake on this screen that cannot be fixed after the launch.
//
// A pie normalised to its own total is always full, and would have hidden it.
// One answer, with its consequence written inside the thing you press.
//
// # Why a row rather than a segmented control
//
// Every either/or in the currency form is difficult for the same reason: the
// labels are short and what they commit to is not. A segmented control can hold
// "Token · Basket · NFT" and nothing else, so the explanation ends up in a
// paragraph underneath that changes as the selection moves — which is a caption
// about a control rather than a description of a choice, and it is read last if
// it is read at all.
//
// A row carries the sentence. That is also what a screen reader announces,
// because the label is built from both halves.
component ChoiceRow inherits Rectangle {
    in property <string> title;
    in property <string> body;
    // A value belonging to the answer rather than a sentence about it — an
    // i-address, so far. Monospaced and last, because it is what somebody checks
    // rather than what they read.
    in property <string> note;
    in property <bool> selected: false;
    // An answer that is on screen to be read rather than pressed, with `body`
    // carrying the reason. Refused options stay visible: a wallet whose
    // unusable identities had silently vanished would look identical to one
    // with no identities at all.
    in property <bool> enabled: true;
    // "accent" for an ordinary answer, "warning" for one with no way back.
    in property <string> tone: "accent";
    callback chosen();

    border-radius: R.md;
    // A refused answer loses its outline as well as its colour. With one, it
    // reads as a control that happens to be off; without one, it reads as a note
    // — which is what it is, and the difference has to survive a dark palette
    // where a disabled fill and a live one are four per cent apart.
    border-width: root.enabled || root.selected ? 1px : 0px;
    border-color: root.selected
        ? (root.tone == "warning" ? Theme.warning : Theme.accent)
        : Theme.border-subtle;
    background: root.selected
        ? (root.tone == "warning" ? Theme.warning-soft : Theme.accent-soft)
        : root.enabled ? Theme.bg-surface : Theme.bg-inset;
    animate border-color, background { duration: Motion.fast; enabled: Motion.enabled; }

    VerticalLayout {
        padding: Sp.s4;
        spacing: 2px;
        Text {
            text: root.title;
            font-size: Typo.body;
            font-weight: root.selected ? Typo.w-medium : Typo.w-regular;
            color: root.enabled ? Theme.text-primary : Theme.text-tertiary;
            wrap: word-wrap;
        }
        if root.body != "": Text {
            text: root.body;
            font-size: Typo.caption;
            color: root.enabled ? Theme.text-secondary : Theme.text-tertiary;
            wrap: word-wrap;
        }
        if root.note != "": Text {
            text: root.note;
            font-family: Typo.mono;
            font-size: Typo.num-sm;
            color: Theme.text-tertiary;
            wrap: char-wrap;
        }
    }

    if root.enabled: TouchArea {
        mouse-cursor: pointer;
        clicked => { root.chosen(); }
    }

    // The role has to be a constant — the same rule `ListRow` records — so a
    // refused answer is announced as a button that cannot be pressed, with the
    // reason in its label, rather than being silently inert.
    accessible-role: AccessibleRole.button;
    accessible-enabled: root.enabled;
    accessible-label: root.body == "" ? root.title : root.title + ". " + root.body;
    accessible-action-default => {
        if (root.enabled) {
            root.chosen();
        }
    }
}

// The question a step is asking, and one line on why it matters.
//
// Every step starts with one of these, so a person who has just pressed Next
// lands on a sentence rather than on a field.
component StepHead inherits VerticalLayout {
    in property <string> title;
    in property <string> body;
    spacing: Sp.s2;

    Text {
        text: root.title;
        font-size: Typo.title3;
        font-weight: Typo.w-bold;
        color: Theme.text-primary;
        wrap: word-wrap;
    }
    if root.body != "": Text {
        text: root.body;
        font-size: Typo.caption;
        color: Theme.text-secondary;
        wrap: word-wrap;
    }
}

component ProportionBar inherits VerticalLayout {
    in property <[CurrencySlice]> slices;
    // What an empty bar should say. An empty bar is not a neutral state here —
    // for a token it means a currency that can never hold anything.
    in property <string> empty-note;
    spacing: Sp.s3;

    // The slices are placed by hand rather than by a horizontal layout, and the
    // reason is a compile error rather than a preference.
    //
    // A slice's width is a share of the track — `track.width * percent / 100`.
    // Inside a layout, that width feeds the layout's minimum width, which feeds
    // its parent's, and once this bar sits in a column whose own width is being
    // negotiated the chain closes: the enclosing `Flickable` derives its
    // viewport width from the content's minimum width, which now depends on the
    // track's width, which depends on the viewport. Slint refuses to compile a
    // binding loop, and it is right to — the layout would have no fixed point.
    //
    // Placed absolutely, a slice reports no minimum of its own and the loop is
    // gone. The cost is that the running offset has to be carried, which is what
    // `offset-percent` is for; the core computes it beside the share, from the
    // same arithmetic, so the two cannot disagree about where a slice starts.
    track := Rectangle {
        height: 14px;
        border-radius: R.sm;
        background: Theme.bg-inset;
        clip: true;

        for slice in root.slices: Rectangle {
            // The one place numbers cross this boundary unformatted, and they
            // are proportions rather than amounts — see `CurrencySlice`.
            x: track.width * slice.offset-percent / 100;
            // Two pixels of daylight between neighbours, taken off the right so
            // the first slice still starts at the left edge.
            width: max(0px, track.width * slice.percent / 100 - 2px);
            height: parent.height;
            border-radius: R.sm;
            background: slice.tone == "accent" ? Theme.accent
                : slice.tone == "positive" ? Theme.positive
                : slice.tone == "warning" ? Theme.warning
                : Theme.text-tertiary;
        }
    }

    if root.slices.length == 0 && root.empty-note != "": Text {
        text: root.empty-note;
        font-size: Typo.caption;
        color: Theme.text-tertiary;
        wrap: word-wrap;
    }

    // The legend. Colour is never the only signal — every slice is named and
    // its share written out, which is also what a screen reader gets.
    if root.slices.length > 0: VerticalLayout {
        spacing: Sp.s2;
        for slice in root.slices: HorizontalLayout {
            spacing: Sp.s3;
            Rectangle {
                width: 8px;
                height: 8px;
                y: 4px;
                border-radius: 2px;
                background: slice.tone == "accent" ? Theme.accent
                    : slice.tone == "positive" ? Theme.positive
                    : slice.tone == "warning" ? Theme.warning
                    : Theme.text-tertiary;
            }
            Text {
                text: slice.label == "" ? "—" : slice.label;
                font-size: Typo.caption;
                color: Theme.text-secondary;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Text {
                text: slice.percent-display;
                font-family: Typo.mono;
                font-size: Typo.num-sm;
                color: Theme.text-primary;
            }
        }
    }
}


// What would go on the chain, updating as the form is edited.
//
// The permanent fields are marked, and that marking is the reason the panel is
// here: everything else it shows is also in the form above it.
component DefinitionPreview inherits VerticalLayout {
    in property <[CurrencyField]> fields;
    spacing: Sp.s3;

    // Label beside value, in two columns.
    //
    // It was stacked for a while, and the reason was real: this panel lived in a
    // 360px column, where the value got whatever the label left of it and an
    // i-address does not fit in that — so the preview clipped, and a preview
    // showing a different definition from the one being made is worse than no
    // preview.
    //
    // The panel is on a full-width review now. Seven label/value pairs stacked
    // is fourteen lines of alternating type sizes that has to be read in order
    // to be read at all; in two columns it is a table, which is what somebody
    // checking a definition against what they meant actually wants. The label
    // column is fixed so the values line up down the page.
    for field in root.fields: HorizontalLayout {
        spacing: Sp.s5;
        Text {
            text: field.label;
            width: 180px;
            font-size: Typo.caption;
            color: Theme.text-tertiary;
            wrap: word-wrap;
        }
        Text {
            text: field.value;
            horizontal-stretch: 1;
            font-family: Typo.mono;
            font-size: Typo.num-sm;
            color: Theme.text-primary;
            // `char-wrap`, not `word-wrap`. Half of these are single unbroken
            // tokens — an i-address has no spaces to break at — and
            // word-wrapping one just clips it.
            wrap: char-wrap;
        }
    }
}

// Configuring a currency: one question at a time.
//
// # Why this is stepped now, when it deliberately was not before
//
// It used to be one page — the kind, the identity, the reserves, the supply,
// two permanent switches and a start height down the left, with a live picture
// of the definition on the right. The argument for that shape was written into
// this file: every field here is permanent, and a stepped flow hides the
// consequence of step two while somebody is on step one.
//
// That was the wrong conclusion from a true premise. Nothing was hidden and
// nothing was legible either: two of the six sections did not apply to the kind
// that was selected, the right-hand panel restated six values that were already
// on the left, and the whole form was three windows tall in a column 420px
// wide. "Everything visible at once" had become "none of it readable".
//
// So the premise is answered where it belongs instead. Each step asks one
// thing, and the **last step is the whole definition at full width** — every
// value, both bars, the fee, and every warning — which is the screen the old
// side panel was trying to be. Nothing is signed before it has been seen, and
// the review after it still reads its figures off the transaction rather than
// off this form.
component CurrencyForm inherits VerticalLayout {
    spacing: Sp.s6;

    // Where the form is, as a number, so the breadcrumb is written once rather
    // than five times. The claiming path has one more question in the middle —
    // see `plan()` in the core for why that path is a different journey rather
    // than this one with a step inserted.
    property <int> at: CurrencyState.form-step == "kind" ? 0
        : CurrencyState.form-step == "under" ? 1
        : CurrencyState.form-step == "authority" ? 2
        : CurrencyState.form-step == "setup" ? (CurrencyState.claiming ? 3 : 2)
        : (CurrencyState.claiming ? 4 : 3);

    // Re-checking the draft is cheap in the core — arithmetic over what was
    // typed, no node asked — but the answer rebuilds five models: the problems,
    // both bars' slices, the preview and the step list. Done on every keystroke
    // that is five model swaps and a repaint per character, which is what typing
    // into a weight or an amount felt like.
    //
    // A tenth of a second collapses a burst into one check and is under the
    // threshold where a preview reads as lagging behind the field.
    //
    // Only the typed fields go through here. Choosing a kind, picking an
    // identity or adding a row are single acts with nothing to collapse, and
    // they still check immediately.
    draftcheck := Timer {
        interval: 120ms;
        running: false;
        triggered => {
            self.running = false;
            Actions.check-currency();
        }
    }

    function recheck() {
        draftcheck.running = false;
        draftcheck.running = true;
    }

    // The breadcrumb, built here rather than in the core.
    //
    // The difference from `CurrencyState.steps` is what each one is about. That
    // one draws **transactions** — how many there are and which cost money are
    // facts about the chain, and an interface deciding them for itself would be
    // a second opinion about what is being spent. This draws where somebody is
    // in a form, which is this file's own business. The same split the identity
    // claim form records.
    //
    // Two of them rather than one with a conditional entry, because the two
    // paths have a different number of questions and a step that appears and
    // disappears under the current position is worse than two honest pictures.
    if !CurrencyState.claiming: FlowStepper {
        steps: [
            {
                label: "Kind",
                state: root.at == 0 ? "now" : "done",
                costs: false,
            },
            {
                label: "Identity",
                state: root.at < 1 ? "later" : root.at == 1 ? "now" : "done",
                costs: false,
            },
            {
                label: "Set it up",
                state: root.at < 2 ? "later" : root.at == 2 ? "now" : "done",
                costs: false,
            },
            {
                label: "Check and launch",
                state: root.at < 3 ? "later" : "now",
                costs: false,
            },
        ];
    }
    if CurrencyState.claiming: FlowStepper {
        steps: [
            {
                label: "Kind",
                state: root.at == 0 ? "now" : "done",
                costs: false,
            },
            {
                label: "Name",
                state: root.at < 1 ? "later" : root.at == 1 ? "now" : "done",
                costs: false,
            },
            {
                label: "Who can take it back",
                state: root.at < 2 ? "later" : root.at == 2 ? "now" : "done",
                costs: false,
            },
            {
                label: "Set it up",
                state: root.at < 3 ? "later" : root.at == 3 ? "now" : "done",
                costs: false,
            },
            {
                label: "Check and launch",
                state: root.at < 4 ? "later" : "now",
                costs: false,
            },
        ];
    }

    // ── 1 · What kind ───────────────────────────────────────────────────
    //
    // First, because it decides which questions come after it.
    if CurrencyState.form-step == "kind": VerticalLayout {
        spacing: Sp.s4;

        StepHead {
            title: "What kind of currency?";
            body: "This decides what the rest of the form asks for, and it is fixed at launch.";
        }

        ChoiceRow {
            title: "Token";
            body: "A plain token. It exists in whatever quantity you allocate at launch, or that you mint later.";
            selected: CurrencyState.kind == "token";
            chosen => {
                CurrencyState.kind = "token";
                Actions.check-currency();
            }
        }
        ChoiceRow {
            title: "Basket";
            body: "Holds reserves of other currencies and converts between them. You set each reserve's share of the whole, and consensus reads those shares exactly.";
            selected: CurrencyState.kind == "basket";
            chosen => {
                CurrencyState.kind = "basket";
                Actions.check-currency();
            }
        }
        ChoiceRow {
            title: "NFT";
            body: "A single indivisible unit. No supply to set and no reserves to hold.";
            selected: CurrencyState.kind == "nft";
            chosen => {
                CurrencyState.kind = "nft";
                Actions.check-currency();
            }
        }
    }

    // ── 2 · Which identity ──────────────────────────────────────────────
    //
    // One list, not a chooser above a list.
    //
    // This step used to ask twice: a pair of rows for *where the identity comes
    // from*, and then, underneath, the identities themselves in rows that looked
    // exactly the same. Two levels of the same control, and the reader had to
    // work out which pair was the question.
    //
    // There is only one question — which name does this currency take — and a
    // name that does not exist yet is one of its answers. So it is one list with
    // exactly one selection, and the last entry is the one that has to be
    // claimed first.
    if CurrencyState.form-step == "under": VerticalLayout {
        spacing: Sp.s4;

        StepHead {
            title: "Which name will it use?";
            body: "The currency takes that identity's address and its name, and that identity can never define another one.";
        }

        // Collapsed the moment it is answered.
        //
        // Every identity in the wallet, listed in full, is as tall as the wallet
        // is old — and the field that appears when a new name is chosen sat
        // below all of them, off the bottom of the window. Choosing is a step,
        // and a finished step should take one row.
        if CurrencyState.claiming || CurrencyState.identity != "": HorizontalLayout {
            spacing: Sp.s4;
            Rectangle {
                horizontal-stretch: 1;
                border-radius: R.md;
                border-width: 1px;
                border-color: Theme.accent;
                background: Theme.accent-soft;
                VerticalLayout {
                    padding: Sp.s4;
                    spacing: 2px;
                    Text {
                        text: CurrencyState.claiming
                            ? "A new name, claimed as part of this launch"
                            : CurrencyState.identity-name == ""
                                ? CurrencyState.identity
                                : CurrencyState.identity-name;
                        font-size: Typo.body;
                        color: Theme.text-primary;
                        wrap: word-wrap;
                    }
                    if !CurrencyState.claiming: Text {
                        text: CurrencyState.identity;
                        font-family: Typo.mono;
                        font-size: Typo.num-sm;
                        color: Theme.text-tertiary;
                        wrap: char-wrap;
                    }
                }
            }
            Btn {
                text: "Change";
                variant: "ghost";
                y: (parent.height - self.height) / 2;
                clicked => {
                    CurrencyState.claiming = false;
                    CurrencyState.identity = "";
                    CurrencyState.identity-name = "";
                    CurrencyState.new-name = "";
                    Actions.check-currency();
                }
            }
        }

        // Wrapped in a layout because Slint cannot put a `for` directly after
        // an `if` — the condition takes one element, and a repeater is not one.
        if !CurrencyState.claiming && CurrencyState.identity == "": VerticalLayout {
            spacing: Sp.s3;

            for entry in CurrencyState.eligible: ChoiceRow {
                title: entry.name;
                // The refusal when there is one, and the address when there is
                // not. Never both: a row that can be pressed does not need to
                // explain itself, and one that cannot has nothing else to say.
                body: entry.refusal;
                note: entry.refusal == "" ? entry.address : "";
                enabled: entry.refusal == "";
                selected: !CurrencyState.claiming && CurrencyState.identity == entry.address;
                chosen => {
                    CurrencyState.claiming = false;
                    CurrencyState.new-name = "";
                    CurrencyState.identity = entry.address;
                    CurrencyState.identity-name = entry.name;
                    Actions.check-currency();
                }
            }

            // The answer that makes this screen usable on a wallet with no spare
            // identity — which is every wallet, the first time. An entry in the
            // same list rather than a link somewhere below, because it answers
            // the same question the rows above it do.
            ChoiceRow {
                title: "A new name";
                body: "Claim one as part of this launch. The identity and the currency share the name and the address, and the wallet does the two in order.";
                selected: CurrencyState.claiming;
                chosen => {
                    CurrencyState.claiming = true;
                    // Clearing the other answer, because core refuses a draft
                    // that carries both — and it is right to: guessing which was
                    // meant would define a currency under an identity nobody
                    // chose.
                    CurrencyState.identity = "";
                    CurrencyState.identity-name = "";
                    Actions.check-currency();
                }
            }
        }

        // Directly under the row it belongs to, so the field and the answer that
        // asked for it read as one thing.
        if CurrencyState.claiming: VerticalLayout {
            spacing: Sp.s3;

            // Asking the chain about a name costs two requests — is it taken,
            // and what does it cost — and firing them on every keystroke sent
            // sixteen of them for the word "livecoin", each one landing out of
            // order and rewriting the field's answer as it went. That is what
            // the screen feeling slow actually was.
            //
            // The local rule still runs on every keystroke: it is arithmetic
            // over a string and it is what refuses a capital letter instantly.
            // Only the chain waits for a pause.
            namecheck := Timer {
                interval: 350ms;
                running: false;
                triggered => {
                    self.running = false;
                    Actions.check-currency-name(CurrencyState.new-name);
                }
            }
            Text {
                text: "The name to claim";
                font-size: Typo.caption;
                color: Theme.text-secondary;
            }
            newname := Field {
                mono: true;
                placeholder: "lowercase, digits, _ and -";
                text <=> CurrencyState.new-name;
                invalid: newname.text != "" && CurrencyState.new-name-problem != "";
                edited => {
                    // Restarted, not merely started: each keystroke pushes the
                    // question back, so it is asked once about the name
                    // somebody stopped typing.
                    namecheck.running = false;
                    namecheck.running = true;
                    root.recheck();
                }
            }
            if CurrencyState.new-name-problem != "": Text {
                text: CurrencyState.new-name-problem;
                font-size: Typo.caption;
                color: Theme.negative;
                wrap: word-wrap;
            }
            // Both fees, together. They are charged by two different
            // transactions and a screen that showed one of them would understate
            // what this commits to by the larger half.
            if CurrencyState.new-name-problem == "" && CurrencyState.new-name-fee != "": Text {
                text: "Free to claim · the name costs " + CurrencyState.new-name-fee + " " + WalletState.ticker
                    + ", and the launch costs " + CurrencyState.fee + " " + WalletState.ticker + " on top.";
                font-size: Typo.caption;
                color: Theme.text-tertiary;
                wrap: word-wrap;
            }
        }
    }
    // ── 3 · Who can take the name back ──────────────────────────────────
    //
    // Only on the path that claims one, and the same question the identity
    // screen asks in the same words — because it is the same decision with the
    // same permanent consequence, and two wordings for it would be two answers.
    //
    // Neither answer is preselected. The whole reason this is a step is that the
    // dangerous one used to be what happened when nobody chose.
    if CurrencyState.form-step == "authority": VerticalLayout {
        spacing: Sp.s4;

        StepHead {
            title: "Who can take this name back?";
            body: "If it is ever stolen — a key copied, a machine lost — revoking it is what stops the thief using it. Revoking needs a recovery authority that is not the identity itself, and that is free to set only now.";
        }

        ChoiceRow {
            title: "Another identity can recover it";
            body: "The one to choose if this name matters. Name an identity you also control, or one you trust.";
            selected: CurrencyState.new-authority == "other";
            chosen => { CurrencyState.new-authority = "other"; }
        }
        ChoiceRow {
            title: "Nobody — it can never be revoked";
            tone: "warning";
            body: "The identity becomes its own authority, and the chain refuses a revocation whose subject is its own recovery authority. Changing this later costs another transaction.";
            selected: CurrencyState.new-authority == "none";
            chosen => {
                CurrencyState.new-authority = "none";
                // Cleared, so what the review shows and what the command carries
                // cannot disagree with the answer given here.
                CurrencyState.new-revocation = "";
                CurrencyState.new-recovery = "";
            }
        }

        if CurrencyState.new-authority == "other": VerticalLayout {
            spacing: Sp.s3;
            HorizontalLayout {
                spacing: Sp.s4;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: Sp.s2;
                    Text {
                        text: "Recovery — required";
                        font-size: Typo.caption;
                        color: Theme.text-secondary;
                    }
                    Field {
                        mono: true;
                        placeholder: "name@ or i-address";
                        text <=> CurrencyState.new-recovery;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: Sp.s2;
                    Text {
                        text: "Revocation — optional";
                        font-size: Typo.caption;
                        color: Theme.text-secondary;
                    }
                    Field {
                        mono: true;
                        placeholder: "name@ or i-address";
                        text <=> CurrencyState.new-revocation;
                    }
                }
            }
            // Which of the two actually decides this, said plainly. It is not
            // obvious and it is the reason one field is required and the other
            // is not.
            Text {
                text: "Recovery is the one that matters: leave it blank and the identity is its own recovery authority again, whatever revocation says. Left blank, revocation becomes the identity itself, which can revoke itself — that is fine.";
                font-size: Typo.caption;
                color: Theme.text-tertiary;
                wrap: word-wrap;
            }
        }
    }

    // ── 4 · Set it up ───────────────────────────────────────────────────
    //
    // The kind-specific questions, and the two permanent switches that are not
    // amounts. Each table has its bar directly underneath rather than in a
    // column beside the form: the bar is feedback on the rows above it, and at
    // full width its legend stops reflowing every time a row is added.
    if CurrencyState.form-step == "setup": VerticalLayout {
        spacing: Sp.s6;

        StepHead {
            title: CurrencyState.kind == "basket" ? "Set up the basket"
                : CurrencyState.kind == "nft" ? "Set up the NFT"
                : "Set up the token";
            body: CurrencyState.kind == "nft"
                ? "An NFT is one indivisible unit, so there is no supply to allocate and no reserve to hold."
                : "Everything here is fixed at launch.";
        }

        // Reserves — a basket only.
        if CurrencyState.kind == "basket": VerticalLayout {
            spacing: Sp.s3;
            HorizontalLayout {
                Text {
                    text: "Reserves";
                    font-size: Typo.body;
                    font-weight: Typo.w-medium;
                    color: Theme.text-primary;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                Btn {
                    text: "Add a reserve";
                    clicked => { Actions.add-reserve(); }
                }
            }
            Text {
                text: "The weights are shares of one whole and must add to 100%. Consensus reads them exactly, and a basket launched with the wrong ones has the wrong prices in it forever.";
                font-size: Typo.caption;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }
            // Column names, because a placeholder disappears the moment somebody
            // types into the field it was describing — which is when a bare `50`
            // in a narrow column stops saying what it is a share of.
            if CurrencyState.reserve-rows.length > 0: HorizontalLayout {
                spacing: Sp.s4;
                Text {
                    text: "CURRENCY";
                    font-size: Typo.micro;
                    color: Theme.text-tertiary;
                    horizontal-stretch: 1;
                }
                Text {
                    text: "SHARE %";
                    font-size: Typo.micro;
                    color: Theme.text-tertiary;
                    width: 120px;
                }
                Rectangle { width: 108px; }
            }
            for entry[i] in CurrencyState.reserve-rows: HorizontalLayout {
                spacing: Sp.s4;
                // Chosen, not typed.
                //
                // The definition carries a currency's **i-address**, and this
                // field used to take a name — so a basket with `VRSCTEST` as a
                // reserve was accepted by every check on this screen and then
                // refused by the builder, after the launch had been agreed to,
                // with a message about i-addresses that nothing had mentioned.
                // A list of what the chain actually has cannot be typed wrong.
                Rectangle {
                    horizontal-stretch: 1;
                    height: 42px;
                    border-radius: R.md;
                    border-width: 1px;
                    border-color: pick.has-focus && InputMode.keyboard
                        ? Theme.accent
                        : Theme.border-default;
                    background: touch.has-hover ? Theme.bg-hover : Theme.bg-inset;
                    animate background, border-color { duration: Motion.fast; enabled: Motion.enabled; }

                    HorizontalLayout {
                        padding-left: Sp.s5;
                        padding-right: Sp.s5;
                        spacing: Sp.s3;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 0px;
                            Text {
                                text: entry.name == ""
                                    ? (entry.currency == "" ? "Choose a currency" : entry.currency)
                                    : entry.name;
                                font-size: Typo.body;
                                color: entry.currency == "" ? Theme.text-disabled : Theme.text-primary;
                                overflow: elide;
                            }
                            if entry.name != "": Text {
                                text: entry.currency;
                                font-family: Typo.mono;
                                font-size: Typo.micro;
                                color: Theme.text-tertiary;
                                overflow: elide;
                            }
                        }
                        Text {
                            text: "▾";
                            font-family: Typo.mono;
                            font-size: Typo.caption;
                            color: Theme.text-tertiary;
                            vertical-alignment: center;
                        }
                    }

                    pick := FocusScope {
                        key-pressed(event) => {
                            if (event.text == "\n" || event.text == " ") {
                                CurrencyState.picking-reserve = i;
                                Actions.search-currencies("");
                                return EventResult.accept;
                            }
                            return EventResult.reject;
                        }
                    }
                    // Outside the shape, and only while the keyboard is
                    // driving — the rule `Btn` documents.
                    if pick.has-focus && InputMode.keyboard: Rectangle {
                        x: -3px;
                        y: -3px;
                        width: parent.width + 6px;
                        height: parent.height + 6px;
                        border-radius: R.md + 3px;
                        border-width: 2px;
                        border-color: Theme.accent-ring;
                    }

                    touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            InputMode.keyboard = false;
                            pick.focus();
                            CurrencyState.picking-reserve = i;
                            // Opened on an empty query, which is the start of
                            // the whole list rather than nothing at all.
                            Actions.search-currencies("");
                        }
                    }

                    accessible-role: AccessibleRole.button;
                    accessible-label: entry.name == ""
                        ? "Choose a currency for this reserve"
                        : "Reserve currency, " + entry.name + ". Choose a different one.";
                    accessible-action-default => {
                        CurrencyState.picking-reserve = i;
                        Actions.search-currencies("");
                    }
                }
                // Seeded on `init`, not bound.
                //
                // `Field.text` is an alias for its inner input's text. A one-way
                // binding on it — `text: entry.weight` — fights the typing: the
                // binding re-evaluates and puts the old value back, so the field
                // silently refuses everything typed into it. And `<=>` cannot
                // point at a model element; Slint requires a property reference.
                //
                // So the row seeds itself once when it is built and writes back
                // on every edit. The model stays the source of truth for Rust,
                // and the field owns what is in it while somebody is typing.
                Field {
                    width: 120px;
                    mono: true;
                    placeholder: "%";
                    init => { self.text = entry.weight; }
                    edited => {
                        CurrencyState.reserve-rows[i].weight = self.text;
                        root.recheck();
                    }
                }
                Btn {
                    text: "Remove";
                    variant: "ghost";
                    width: 108px;
                    clicked => { Actions.remove-reserve(i); }
                }
            }
            // The total beside the bar, in the tone the bar is drawn in, so the
            // picture and the number say the same thing.
            HorizontalLayout {
                height: 16px;
                Eyebrow {
                    text: "SHARES OF THE WHOLE";
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                Text {
                    text: CurrencyState.weights-total;
                    font-family: Typo.mono;
                    font-size: Typo.num-sm;
                    color: CurrencyState.weights-total == "100%"
                        ? Theme.positive
                        : Theme.warning;
                    vertical-alignment: center;
                }
            }
            ProportionBar {
                slices: CurrencyState.slices;
                empty-note: "No reserves yet. A basket without them holds nothing.";
            }
        }

        // Starting supply — everything except an NFT, which is always exactly
        // one unit.
        if CurrencyState.kind != "nft": VerticalLayout {
            spacing: Sp.s3;
            HorizontalLayout {
                Text {
                    text: "Starting supply";
                    font-size: Typo.body;
                    font-weight: Typo.w-medium;
                    color: Theme.text-primary;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                Btn {
                    text: "Allocate to an identity";
                    clicked => { Actions.add-preallocation(); }
                }
            }
            Text {
                text: "Allocations go to identities, not to addresses. Nothing here means the currency starts empty — which is only useful if it can be minted.";
                font-size: Typo.caption;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }
            if CurrencyState.supply-rows.length > 0: HorizontalLayout {
                spacing: Sp.s4;
                Text {
                    text: "IDENTITY";
                    font-size: Typo.micro;
                    color: Theme.text-tertiary;
                    horizontal-stretch: 1;
                }
                Text {
                    text: "AMOUNT";
                    font-size: Typo.micro;
                    color: Theme.text-tertiary;
                    width: 160px;
                }
                Rectangle { width: 108px; }
            }
            for entry[i] in CurrencyState.supply-rows: HorizontalLayout {
                spacing: Sp.s4;
                Field {
                    horizontal-stretch: 1;
                    mono: true;
                    placeholder: "name@ or i-address";
                    init => { self.text = entry.recipient; }
                    edited => {
                        CurrencyState.supply-rows[i].recipient = self.text;
                        root.recheck();
                    }
                }
                Field {
                    width: 160px;
                    mono: true;
                    placeholder: "0.0000 0000";
                    init => { self.text = entry.amount; }
                    edited => {
                        CurrencyState.supply-rows[i].amount = self.text;
                        root.recheck();
                    }
                }
                Btn {
                    text: "Remove";
                    variant: "ghost";
                    width: 108px;
                    clicked => { Actions.remove-preallocation(i); }
                }
            }
            HorizontalLayout {
                height: 16px;
                Eyebrow {
                    text: "ALLOCATED AT LAUNCH";
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                Text {
                    text: CurrencyState.supply-total;
                    font-family: Typo.mono;
                    font-size: Typo.num-sm;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                }
            }
            ProportionBar {
                slices: CurrencyState.supply-slices;
                empty-note: "Nothing allocated. The currency starts empty.";
            }
        }

        // Can the supply grow. Two rows rather than a segmented control,
        // because the two answers are a sentence apart and one of them cannot be
        // undone.
        VerticalLayout {
            spacing: Sp.s3;
            Text {
                text: "Can more be minted later?";
                font-size: Typo.body;
                font-weight: Typo.w-medium;
                color: Theme.text-primary;
            }
            ChoiceRow {
                title: "No — fixed at launch";
                body: "The supply is what it is, and nothing can add to it, ever.";
                selected: !CurrencyState.mintable;
                chosen => {
                    CurrencyState.mintable = false;
                    Actions.check-currency();
                }
            }
            ChoiceRow {
                title: "Yes — this identity can mint more";
                body: "Whoever controls the identity can create more at any time. Whoever holds the currency is trusting that.";
                selected: CurrencyState.mintable;
                chosen => {
                    CurrencyState.mintable = true;
                    Actions.check-currency();
                }
            }
        }

        // When it begins. A launch is not instant, and consensus refuses a
        // currency that starts at or before the block it was mined in.
        VerticalLayout {
            spacing: Sp.s3;
            Text {
                text: "When does it start?";
                font-size: Typo.body;
                font-weight: Typo.w-medium;
                color: Theme.text-primary;
            }
            HorizontalLayout {
                spacing: Sp.s5;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: "Blocks from now";
                        font-size: Typo.caption;
                        color: Theme.text-secondary;
                    }
                    Text {
                        text: CurrencyState.start-block == ""
                            ? "Consensus refuses a currency that begins at or before the current block."
                            : "Block " + CurrencyState.start-block + ", roughly " + CurrencyState.start-delay + " minutes away.";
                        font-size: Typo.caption;
                        color: Theme.text-tertiary;
                        wrap: word-wrap;
                    }
                }
                delay := Field {
                    width: 160px;
                    mono: true;
                    placeholder: "20";
                    y: (parent.height - self.height) / 2;
                    init => { self.text = CurrencyState.start-delay; }
                    edited => {
                        CurrencyState.start-delay = delay.text;
                        root.recheck();
                    }
                }
            }
        }

        // Why the button is off, or what the chain will say yes to anyway.
        // Blocking first — one of them is the reason Next does not move.
        if CurrencyState.problems.length > 0: VerticalLayout {
            spacing: Sp.s3;
            for problem in CurrencyState.problems: Rectangle {
                background: problem.blocking ? Theme.negative-soft : Theme.warning-soft;
                border-radius: R.md;
                VerticalLayout {
                    padding: Sp.s5;
                    Text {
                        text: problem.text;
                        font-size: Typo.caption;
                        color: problem.blocking ? Theme.negative : Theme.warning;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }

    // ── 5 · Check and launch ────────────────────────────────────────────
    //
    // The whole definition at full width, which is what the old side panel was
    // trying to be in 360px beside a form that already said most of it.
    if CurrencyState.form-step == "review": VerticalLayout {
        spacing: Sp.s5;

        StepHead {
            title: "Check it, then launch";
            body: "Every value here is fixed when the definition is mined. An identity defines one currency, once.";
        }

        Rectangle {
            background: Theme.bg-inset;
            border-radius: R.md;
            VerticalLayout {
                padding: Sp.s5;
                spacing: Sp.s4;
                // Said once, here, rather than tagged on every row. Every field
                // of a currency definition is permanent, and a "permanent" mark
                // beside all six of them is six copies of one sentence.
                Eyebrow { text: "WHAT GOES ON THE CHAIN · ALL OF IT PERMANENT"; }
                DefinitionPreview { fields: CurrencyState.preview; }
            }
        }

        if CurrencyState.kind == "basket": VerticalLayout {
            spacing: Sp.s3;
            HorizontalLayout {
                height: 16px;
                Eyebrow {
                    text: "RESERVES";
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                Text {
                    text: CurrencyState.weights-total;
                    font-family: Typo.mono;
                    font-size: Typo.num-sm;
                    color: CurrencyState.weights-total == "100%"
                        ? Theme.positive
                        : Theme.warning;
                    vertical-alignment: center;
                }
            }
            ProportionBar {
                slices: CurrencyState.slices;
                empty-note: "No reserves. A basket without them holds nothing.";
            }
        }

        if CurrencyState.kind != "nft": VerticalLayout {
            spacing: Sp.s3;
            HorizontalLayout {
                height: 16px;
                Eyebrow {
                    text: "STARTING SUPPLY";
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                Text {
                    text: CurrencyState.supply-total;
                    font-family: Typo.mono;
                    font-size: Typo.num-sm;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                }
            }
            ProportionBar {
                slices: CurrencyState.supply-slices;
                empty-note: "Nothing allocated. The currency starts empty.";
            }
        }

        if CurrencyState.fee != "": VerticalLayout {
            spacing: Sp.s2;
            HorizontalLayout {
                Text {
                    text: "Launch fee";
                    font-size: Typo.body;
                    font-weight: Typo.w-medium;
                    color: Theme.text-primary;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                Money {
                    amount: CurrencyState.fee;
                    currency: WalletState.ticker;
                    size: Typo.num;
                }
            }
            // The half that is burned is not a detail. The SDK's own capture
            // shows 205 in, 105 out and 100 unaccounted for, and the miner fee
            // is on top of all of it.
            Text {
                text: "Half of this becomes the new currency's reserve deposit and half is burned. The miner fee is on top and is not included here.";
                font-size: Typo.caption;
                color: Theme.text-tertiary;
                wrap: word-wrap;
            }
        }

        // What the chain is about to be asked to do, from the core — how many
        // transactions there are and which cost money are its facts, not this
        // file's. Written as a list rather than drawn with `FlowStepper`,
        // because the breadcrumb at the top of this form is already a stepper
        // and two of those on one screen is a puzzle.
        if CurrencyState.steps.length > 0: Rectangle {
            background: Theme.bg-inset;
            border-radius: R.md;
            VerticalLayout {
                padding: Sp.s5;
                spacing: Sp.s3;
                Eyebrow {
                    text: CurrencyState.steps.length == 1
                        ? "WHAT HAPPENS NEXT · ONE TRANSACTION"
                        : "WHAT HAPPENS NEXT · " + CurrencyState.steps.length + " STEPS";
                }
                for step[i] in CurrencyState.steps: HorizontalLayout {
                    spacing: Sp.s3;
                    Text {
                        text: i + 1;
                        font-family: Typo.mono;
                        font-size: Typo.num-sm;
                        color: Theme.text-tertiary;
                    }
                    Text {
                        text: step.label;
                        font-size: Typo.caption;
                        color: Theme.text-secondary;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }
                    if step.costs: Text {
                        text: "costs a fee";
                        font-size: Typo.micro;
                        color: Theme.warning;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Rectangle {
            background: Theme.warning-soft;
            border-radius: R.md;
            VerticalLayout {
                padding: Sp.s5;
                spacing: Sp.s2;
                Text {
                    text: "This cannot be undone or repeated";
                    font-size: Typo.body;
                    font-weight: Typo.w-medium;
                    color: Theme.warning;
                    wrap: word-wrap;
                }
                Text {
                    text: CurrencyState.claiming
                        ? "The next press claims the name and pays for it. The launch itself is reviewed afterwards, once the name is on the chain."
                        : "The next press builds and signs the definition and shows the exact fee. Nothing is sent until that review is agreed to.";
                    font-size: Typo.caption;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
            }
        }

        if CurrencyState.problems.length > 0: VerticalLayout {
            spacing: Sp.s3;
            for problem in CurrencyState.problems: Rectangle {
                background: problem.blocking ? Theme.negative-soft : Theme.warning-soft;
                border-radius: R.md;
                VerticalLayout {
                    padding: Sp.s5;
                    Text {
                        text: problem.text;
                        font-size: Typo.caption;
                        color: problem.blocking ? Theme.negative : Theme.warning;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}

// The last moment before something irreversible.
//
// Its own layer over the screen rather than a section inside it, for the reason
// the send review and the identity change review are: this is not one heading
// among eight. Everything on it was read back off the transaction that was
// actually built and signed — the fee especially, which comes from chain policy
// and not from anything typed into the form.
component LaunchReview inherits Rectangle {
    background: Theme.dark ? #0B0C0EE0 : #FBFBFCE0;
    TouchArea {}

    Card {
        elevated: true;
        width: 520px;
        height: content.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        content := VerticalLayout {
            padding: Sp.s8;
            spacing: Sp.s5;

            VerticalLayout {
                spacing: Sp.s2;
                Text {
                    text: "Launch this currency";
                    font-size: Typo.title2;
                    font-weight: Typo.w-bold;
                    color: Theme.text-primary;
                }
                Text {
                    text: CurrencyState.launch-name;
                    font-family: Typo.mono;
                    font-size: Typo.num-sm;
                    color: Theme.text-secondary;
                }
            }

            Text {
                text: CurrencyState.launch-description;
                font-size: Typo.body;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }

            // Three figures, because one would understate it. The fee splits in
            // half and both halves are funded — only one comes back as an
            // output — and the miner fee is on top of both.
            VerticalLayout {
                spacing: Sp.s3;
                HorizontalLayout {
                    Text {
                        text: "Launch fee";
                        font-size: Typo.body;
                        font-weight: Typo.w-medium;
                        color: Theme.text-primary;
                        horizontal-stretch: 1;
                    }
                    Money {
                        amount: CurrencyState.launch-fee;
                        currency: WalletState.ticker;
                        size: Typo.num;
                    }
                }
                HorizontalLayout {
                    Text {
                        text: "of which, the currency's reserve deposit";
                        font-size: Typo.caption;
                        color: Theme.text-tertiary;
                        horizontal-stretch: 1;
                    }
                    Money {
                        amount: CurrencyState.launch-deposit;
                        currency: WalletState.ticker;
                        size: Typo.num-sm;
                        tone: "muted";
                        show-currency: false;
                    }
                }
                HorizontalLayout {
                    Text {
                        text: "of which, burned";
                        font-size: Typo.caption;
                        color: Theme.text-tertiary;
                        horizontal-stretch: 1;
                    }
                    Money {
                        amount: CurrencyState.launch-burned;
                        currency: WalletState.ticker;
                        size: Typo.num-sm;
                        tone: "muted";
                        show-currency: false;
                    }
                }
                Text {
                    text: "The miner fee is on top of this and is not included.";
                    font-size: Typo.caption;
                    color: Theme.text-tertiary;
                    wrap: word-wrap;
                }
            }

            // When it begins, which is not now. A currency exists from the
            // moment this transaction is mined and does nothing until its start
            // block — and somebody who is not told that reads the first quiet
            // hour as a failed launch.
            HorizontalLayout {
                Text {
                    text: "Begins at block";
                    font-size: Typo.body;
                    font-weight: Typo.w-medium;
                    color: Theme.text-primary;
                    horizontal-stretch: 1;
                }
                Text {
                    text: CurrencyState.launch-start-block;
                    font-family: Typo.mono;
                    font-size: Typo.num;
                    color: Theme.text-primary;
                }
            }

            Rectangle {
                background: Theme.warning-soft;
                border-radius: R.md;
                VerticalLayout {
                    padding: Sp.s5;
                    spacing: Sp.s2;
                    Text {
                        text: "This cannot be undone or repeated";
                        font-size: Typo.body;
                        font-weight: Typo.w-medium;
                        color: Theme.warning;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "An identity defines one currency, once. Every value in this definition is fixed at launch.";
                        font-size: Typo.caption;
                        color: Theme.text-secondary;
                        wrap: word-wrap;
                    }
                }
            }

            HorizontalLayout {
                spacing: Sp.s4;
                alignment: end;
                Btn {
                    text: "Back";
                    variant: "ghost";
                    enabled: !CurrencyState.launch-busy;
                    clicked => { Actions.cancel-launch(CurrencyState.launch-ticket); }
                }
                Btn {
                    text: CurrencyState.launch-busy ? "Sending…" : "Launch it";
                    variant: "primary";
                    enabled: !CurrencyState.launch-busy;
                    clicked => { Actions.confirm-launch(CurrencyState.launch-ticket); }
                }
            }
        }
    }
}

// What the form costs and what it is waiting for, pinned below the scroller.
//
// # Why this is not inside the form
//
// Because the form is taller than the window and gets taller with every reserve
// somebody adds. Everything that decides whether to go ahead — the fee, what is
// still blocking, and the button itself — sat under the fold, while the thing
// that caused the blockage sat at the top. A basket with weights that do not add
// up showed an amber `70%` beside the bar and nothing else: the sentence
// explaining it, and the disabled button it explains, were both off screen.
//
// So it lives between the scrolling area and the status bar, as a real layout
// row rather than an overlay. That means no coordinate arithmetic against the
// nav rail's width, and nothing to keep in step when the window resizes.
// Choosing a reserve out of what the chain actually has.
//
// # Why an overlay rather than a dropdown under the row
//
// Because the list is long — 290 currencies on VRSCTEST — and it has to be
// searched. A menu that opens inside a scrolling form either clips at the card's
// edge or has to be positioned against coordinates the layout owns, and it has
// nowhere to put a search field. This is the shape the wallet already uses for
// "one decision, on top of everything": the transaction sheet, the identity
// sheet, both reviews.
//
// # Why the search runs in the core
//
// Slint cannot filter a model in a binding, so it could not be done here even if
// it should be. It should not: what counts as a match, and what ranks above
// what, is a rule — and `currency::choices` is where it is written down with a
// test against it.
component ReservePicker inherits Rectangle {
    background: Theme.dark ? #0B0C0EE0 : #FBFBFCE0;

    // Swallows clicks aimed at the form behind, and closes on one that lands on
    // nothing — the same behaviour every other overlay in this file has.
    TouchArea {
        clicked => { root.dismiss(); }
    }

    function dismiss() {
        CurrencyState.picking-reserve = -1;
        CurrencyState.choices-query = "";
    }

    Card {
        elevated: true;
        width: 560px;
        height: 560px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        // Over the dismissing area below it, so a click inside the card does
        // not close it.
        TouchArea {}

        VerticalLayout {
            padding: Sp.s7;
            spacing: Sp.s5;

            VerticalLayout {
                spacing: Sp.s2;
                Text {
                    text: "Choose a reserve";
                    font-size: Typo.title2;
                    font-weight: Typo.w-bold;
                    color: Theme.text-primary;
                }
                Text {
                    text: "Every currency this chain knows about. What goes into the definition is the address, not the name — which is why this is a list rather than a field.";
                    font-size: Typo.caption;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
            }

            // The same reason the name fields debounce: a keystroke here is a
            // message to the core and a rebuild of the list model. Local work
            // rather than a request, so a shorter wait than the 350ms the chain
            // lookups use.
            narrowing := Timer {
                interval: 120ms;
                running: false;
                triggered => {
                    self.running = false;
                    Actions.search-currencies(CurrencyState.choices-query);
                }
            }

            query := Field {
                placeholder: "Search by name or address";
                text <=> CurrencyState.choices-query;
                // Focused on open, so the list can be narrowed by typing
                // without reaching for the pointer first.
                init => { query.focus(); }
                edited => {
                    narrowing.running = false;
                    narrowing.running = true;
                }
            }

            if CurrencyState.choices-busy: Text {
                text: "Asking the node for the chain's currency list. This is one large reply and it is only fetched once.";
                font-size: Typo.caption;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }

            if CurrencyState.choices-problem != "": Rectangle {
                background: Theme.negative-soft;
                border-radius: R.md;
                VerticalLayout {
                    padding: Sp.s5;
                    spacing: Sp.s3;
                    Text {
                        text: CurrencyState.choices-problem;
                        font-size: Typo.caption;
                        color: Theme.negative;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: start;
                        Btn {
                            text: "Try again";
                            clicked => { Actions.search-currencies(CurrencyState.choices-query); }
                        }
                    }
                }
            }

            if !CurrencyState.choices-busy && CurrencyState.choices-problem == ""
                && CurrencyState.choices.length == 0: Text {
                text: CurrencyState.choices-query == ""
                    ? "This chain lists no currencies that are not already reserves of this basket."
                    : "Nothing on this chain matches that.";
                font-size: Typo.caption;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }

            Flickable {
                vertical-stretch: 1;
                viewport-height: list.preferred-height;

                list := VerticalLayout {
                    spacing: Sp.s2;
                    alignment: start;

                    for row in CurrencyState.choices: Rectangle {
                        height: line.preferred-height;
                        border-radius: R.md;
                        background: hover.has-hover ? Theme.bg-hover : transparent;

                        line := HorizontalLayout {
                            padding: Sp.s4;
                            spacing: Sp.s4;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text {
                                    text: row.name;
                                    font-size: Typo.body;
                                    color: Theme.text-primary;
                                    overflow: elide;
                                }
                                Text {
                                    text: row.address;
                                    font-family: Typo.mono;
                                    font-size: Typo.micro;
                                    color: Theme.text-tertiary;
                                    overflow: elide;
                                }
                                // Only when there is something to say. A
                                // reserve that has not started yet is a reserve
                                // holding something that does not exist.
                                if row.note != "": Text {
                                    text: row.note;
                                    font-size: Typo.micro;
                                    color: Theme.warning;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                StatusPill {
                                    state: "online";
                                    text: row.kind;
                                }
                            }
                        }

                        hover := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                Actions.choose-reserve(
                                    CurrencyState.picking-reserve, row.name, row.address);
                                root.dismiss();
                            }
                        }

                        accessible-role: AccessibleRole.button;
                        accessible-label: row.name + ", " + row.kind
                            + (row.note == "" ? "" : ", " + row.note);
                        accessible-action-default => {
                            Actions.choose-reserve(
                                CurrencyState.picking-reserve, row.name, row.address);
                            root.dismiss();
                        }
                    }
                }
            }

            // Said rather than hidden. A list that stopped at forty without
            // saying so reads as "that is all there is" while holding back the
            // currency somebody came here for.
            if CurrencyState.choices-more > 0: Text {
                text: CurrencyState.choices-more + " more match. Narrow the search to see them.";
                font-size: Typo.caption;
                color: Theme.text-tertiary;
                wrap: word-wrap;
            }

            HorizontalLayout {
                alignment: end;
                Btn {
                    text: "Cancel";
                    variant: "ghost";
                    clicked => { root.dismiss(); }
                }
            }
        }
    }
}

// What a form costs and what it is waiting for, pinned below the scroller.
//
// # Why this is not inside the form
//
// Because both forms that use it are taller than the window and get taller as
// they are filled in. Everything that decides whether to go ahead — the fee,
// what is still blocking, and the button itself — sat under the fold, while the
// thing that caused the blockage sat at the top. A basket with weights that do
// not add up showed an amber `70%` beside the bar and nothing else: the
// sentence explaining it, and the disabled button it explains, were both off
// screen.
//
// So it lives between the scrolling area and the status bar, as a real layout
// row rather than an overlay. That means no coordinate arithmetic against the
// nav rail's width, and nothing to keep in step when the window resizes.
//
// It knows nothing about either screen. Both pass their own words in, which is
// what stopped the second one being a copy of the first.
component ActionBar inherits Rectangle {
    // What the press will cost, in one line. Never empty: a bar that shows
    // buttons and no figure invites the press it exists to qualify.
    in property <string> cost;
    // Why the button is off, or what it will do when it is on.
    in property <string> note;
    // Whether that note is a refusal. Decides its colour, so a screen cannot
    // say "1 thing to fix" in the tone of an aside.
    in property <bool> note-bad: false;
    in property <string> back-text: "Cancel";
    in property <string> primary-text;
    in property <bool> primary-enabled: true;
    callback back();
    callback primary();

    background: Theme.bg-surface;
    height: 68px;

    // A hairline, so the bar reads as pinned rather than as the last card
    // having drifted to the bottom of the page.
    Rectangle {
        height: 1px;
        y: 0;
        background: Theme.border-subtle;
    }

    HorizontalLayout {
        padding-left: Sp.screen-pad;
        padding-right: Sp.screen-pad;
        spacing: Sp.s5;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.cost;
                font-size: Typo.body;
                font-weight: Typo.w-medium;
                color: Theme.text-primary;
                overflow: elide;
            }
            Text {
                text: root.note;
                font-size: Typo.caption;
                color: root.note-bad ? Theme.negative : Theme.text-tertiary;
                overflow: elide;
            }
        }

        HorizontalLayout {
            alignment: end;
            spacing: Sp.s3;
            Btn {
                text: root.back-text;
                variant: "ghost";
                y: (parent.height - self.height) / 2;
                clicked => { root.back(); }
            }
            Btn {
                text: root.primary-text;
                variant: "primary";
                y: (parent.height - self.height) / 2;
                enabled: root.primary-enabled;
                clicked => { root.primary(); }
            }
        }
    }
}

// The glyph is `⊙`, and it was chosen by looking rather than by taste.
//
// Under the previous pair of fonts `◈` — the obvious currency mark — was absent
// and drew nothing at all, so `⊙` was picked as the nearest thing that existed.
// With Space Grotesk and JetBrains Mono NL the coverage is different: `◈`, `◉`
// and `⊙` are all present in the mono face and **none of them** is in any Space
// Grotesk weight, so the family matters more than the character now. `⬡`, `♦`
// and `⧫` are still in neither.
//
// `⊙` is kept rather than swapped back to `◈`, because `◈` is what the design
// reserves for shielded items and giving it a second meaning here would spend
// it. A glyph is only a glyph if the shipped font has it, and only useful if it
// means one thing.
component CurrenciesScreen inherits VerticalLayout {
    spacing: Sp.s7;

    // Opening the form is three statements, and all three have to happen from
    // both places that offer it — the button in the corner and the one in the
    // middle of the empty state. A form reopened later must not resume halfway
    // through somebody else's answers, and least of all on a review.
    function open-form() {
        CurrencyState.form-step = "kind";
        CurrencyState.new-authority = "";
        CurrencyState.defining = true;
        Actions.check-currency();
    }

    // The list and everything about it steps aside while the form is open.
    //
    // It used to stay: the currencies, the heading, the count and the identity
    // list all sat above and below a form that was itself taller than the
    // window. Configuring one currency and reading about the others are not the
    // same task, and putting both on screen made the one being done the harder
    // of the two to find.
    if !CurrencyState.defining: HorizontalLayout {
        spacing: Sp.s5;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Sp.s2;
            Text {
                text: CurrencyState.rows.length == 0
                    ? "No currencies yet"
                    : CurrencyState.rows.length == 1
                        ? "1 currency your identities define"
                        : CurrencyState.rows.length + " currencies your identities define";
                font-size: Typo.caption;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }
        }
        Btn {
            text: CurrencyState.busy ? "Reading…" : "Refresh";
            enabled: !CurrencyState.busy;
            y: (parent.height - self.height) / 2;
            clicked => { Actions.refresh-currencies(); }
        }
        // Hidden when the list is empty, because the empty state carries the
        // same action in the middle of the card, where somebody reading the
        // explanation actually is. Two identical primary buttons on one screen
        // make a reader stop and work out which is which, and the answer is
        // that there is no difference.
        if !(CurrencyState.rows.length == 0 && !CurrencyState.busy): Btn {
            text: "Define a currency";
            variant: "primary";
            y: (parent.height - self.height) / 2;
            clicked => { root.open-form(); }
        }
    }

    if !CurrencyState.defining: Card {
        VerticalLayout {
            padding: Sp.s3;

            // The action belongs in the empty state, not only in the corner.
            //
            // This is the one screen state whose entire content is "there is
            // nothing here" — and the thing to do about it was a button at the
            // far top right, past the heading, in the place the eye goes last.
            // An empty state that explains a feature and does not offer it is a
            // leaflet.
            if CurrencyState.rows.length == 0 && !CurrencyState.busy: Rectangle {
                height: 200px;
                EmptyState {
                    glyph: "⊙";
                    title: "None of your identities defines a currency";
                    body: "A currency in Verus is a name you already own, wearing a second hat — its address is the identity's. Defining one is permanent, and an identity can do it once.";
                    action-text: "Define a currency";
                    action => { root.open-form(); }
                }
            }

            for row in CurrencyState.rows: ListRow {
                glyph: "⊙";
                glyph-tone: Theme.accent;
                title: row.name;
                subtitle: row.address;
                subtitle-mono: true;
                interactive: true;
                clicked => { Actions.open-currency(row.address); }

                HorizontalLayout {
                    spacing: Sp.s5;
                    alignment: end;

                    // Fixed, so the pills line up down the column rather than
                    // following the note beside them — the same reason the
                    // identity list fixes this width.
                    VerticalLayout {
                        width: 300px;
                        alignment: center;
                        spacing: 2px;
                        HorizontalLayout {
                            alignment: end;
                            spacing: Sp.s3;
                            // Said in words, not by the pill's colour alone.
                            // Whether the supply can still grow is a different
                            // promise to whoever holds it, and it is permanent.
                            if row.mintable: Text {
                                text: "mintable";
                                font-size: Typo.micro;
                                color: Theme.warning;
                                vertical-alignment: center;
                            }
                            StatusPill {
                                state: row.tone;
                                text: row.kind;
                            }
                        }
                        // A launch is not instant. Between the definition being
                        // mined and the start block the currency exists and
                        // does nothing — and a row that omitted this showed it
                        // exactly as it shows one that has been running for a
                        // month. Said only while it is true.
                        if !row.started: Text {
                            text: "Starts at block " + row.start-block;
                            font-size: Typo.caption;
                            color: Theme.warning;
                            horizontal-alignment: right;
                        }
                        if row.note != "": Text {
                            text: row.note;
                            font-size: Typo.caption;
                            color: Theme.text-tertiary;
                            horizontal-alignment: right;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }

    // An unfinished currency, said before anything else on this screen.
    //
    // It has already cost something — a name claim, or an identity that is
    // registered and paid for — and the second of those can never be spent on a
    // different currency. That is not a thing to leave a person to discover.
    if CurrencyState.pending-identity != "" && !CurrencyState.defining: VerticalLayout {
        spacing: Sp.s4;
        Eyebrow { text: "UNFINISHED"; }
        Card {
            VerticalLayout {
                padding: Sp.card-pad;
                spacing: Sp.s4;
                Text {
                    text: CurrencyState.pending-identity;
                    font-family: Typo.mono;
                    font-size: Typo.title3;
                    color: Theme.text-primary;
                }
                Text {
                    text: CurrencyState.pending-note;
                    font-size: Typo.body;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                // The same diagram the form drew as a plan, now saying which of
                // those steps have actually happened — and which of the ones
                // that have were paid for.
                FlowStepper { steps: CurrencyState.pending-steps; }
                HorizontalLayout {
                    spacing: Sp.s3;
                    alignment: end;
                    Btn {
                        text: "Abandon";
                        variant: "ghost";
                        clicked => { Actions.abandon-launch(); }
                    }
                    if CurrencyState.pending-can-continue: Btn {
                        text: "Define the currency";
                        variant: "primary";
                        clicked => { Actions.resume-launch(); }
                    }
                }
            }
        }
    }

    // Configuring one. The form is the screen while it is open.
    if CurrencyState.defining: VerticalLayout {
        spacing: Sp.s4;
        Eyebrow { text: "DEFINE A CURRENCY"; }
        // Capped, not stretched. A question at a time does not need a second
        // column beside it, and a line of body text running the full width of a
        // 1400px window is a line nobody finishes.
        //
        // A fixed width rather than a maximum: `max-width` here is negotiated
        // against the shared `Flickable`'s viewport, and the viewport's width is
        // derived from this content's minimum — a loop Slint refuses to compile.
        // A constant depends on nothing, so there is no loop to close, and 780px
        // is inside the 880px minimum window this wallet declares.
        HorizontalLayout {
            Card {
                width: 780px;
                VerticalLayout {
                    padding: Sp.card-pad;
                    spacing: Sp.s6;

                    CurrencyForm {}

                    // The buttons are NOT here. They live in the pinned
                    // `ActionBar`, outside the scroller — see that component.
                    // What stays is the padding it would otherwise sit on top of.
                    Rectangle { height: Sp.s8; }
                }
            }
            // Takes the rest, so the card stays at the left edge rather than
            // being centred by a layout that has one child.
            Rectangle { horizontal-stretch: 1; }
        }
    }

    // The other half. Every identity, with whether it may still be used —
    // including the ones that may not, and why.
    if CurrencyState.eligible.length > 0 && !CurrencyState.defining: VerticalLayout {
        spacing: Sp.s4;
        Eyebrow { text: "YOUR IDENTITIES"; }
        Card {
            VerticalLayout {
                padding: Sp.s3;
                for entry in CurrencyState.eligible: ListRow {
                    glyph: "◇";
                    glyph-tone: entry.refusal == "" ? Theme.positive : Theme.text-tertiary;
                    title: entry.name;
                    subtitle: entry.address;
                    subtitle-mono: true;
                    interactive: false;

                    HorizontalLayout {
                        spacing: Sp.s5;
                        alignment: end;
                        VerticalLayout {
                            width: 420px;
                            alignment: center;
                            Text {
                                text: entry.refusal == ""
                                    ? "Free to define a currency"
                                    : entry.refusal;
                                font-size: Typo.caption;
                                color: entry.refusal == ""
                                    ? Theme.text-secondary
                                    : Theme.text-tertiary;
                                horizontal-alignment: right;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }

    Rectangle { vertical-stretch: 1; }
}

component IdentitiesScreen inherits VerticalLayout {
    spacing: Sp.s7;

    HorizontalLayout {
        spacing: Sp.s5;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Sp.s2;
            Text {
                // Describes the list below it and nothing else. The looked-up
                // section has its own heading and its own count, because this
                // sentence is a claim about your keys and would be false over
                // anything that is not yours.
                // Says how many and then why, rather than opening with the
                // method. Somebody arriving here wants the count; the sentence
                // explaining where it came from is the reassurance underneath
                // it, not the headline.
                text: IdentityState.rows.length == 0
                    ? "No names your keys control"
                    : IdentityState.rows.length == 1
                        ? "1 name your keys control"
                        : IdentityState.rows.length + " names your keys control";
                font-size: Typo.caption;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }
        }
        Btn {
            text: IdentityState.busy ? "Reading…" : "Refresh";
            enabled: !IdentityState.busy;
            y: (parent.height - self.height) / 2;
            clicked => { Actions.refresh-identities(); }
        }
        // Hidden while the form is open or a claim is running, because the
        // thing it opens is already on screen and a button that does nothing
        // is a button somebody presses twice wondering why.
        if !IdentityState.claiming && IdentityState.reg-step == "": Btn {
            text: "Claim a name";
            variant: "primary";
            y: (parent.height - self.height) / 2;
            clicked => {
                IdentityState.claiming = true;
                // From the beginning, every time. Reopening onto somebody's
                // half-finished answers — above all an authority step already
                // ticked — is how a considered choice becomes an inherited one.
                IdentityState.claim-step = "name";
                IdentityState.claim-authority = "";
            }
        }
    }

    Card {
        VerticalLayout {
            padding: Sp.s3;

            if IdentityState.rows.length == 0 && !IdentityState.busy: Rectangle {
                height: 120px;
                EmptyState {
                    glyph: "◇";
                    title: "No VerusIDs yet";
                    body: "A VerusID is a name you own on the chain. It can receive payments, hold currencies, and publish data. You can also look up anybody else's below.";
                }
            }

            for row in IdentityState.rows: ListRow {
                glyph: "◇";
                glyph-tone: row.tone == "online" ? Theme.positive
                    : row.tone == "degraded" ? Theme.warning
                    : row.tone == "offline" ? Theme.negative
                    : Theme.text-tertiary;
                title: row.name;
                subtitle: row.address;
                subtitle-mono: true;
                interactive: true;
                clicked => { Actions.open-identity(row.address); }

                HorizontalLayout {
                    spacing: Sp.s5;
                    alignment: end;

                    // Fixed, so the pills line up down the column. Left to size
                    // themselves they follow the note beneath, and four rows
                    // with four different notes put four pills in four places.
                    VerticalLayout {
                        width: 260px;
                        alignment: center;
                        spacing: 2px;
                        HorizontalLayout {
                            alignment: end;
                            StatusPill {
                                state: row.tone;
                                text: row.status;
                            }
                        }
                        if row.note != "": Text {
                            text: row.note;
                            font-size: Typo.micro;
                            color: Theme.text-tertiary;
                            horizontal-alignment: right;
                            wrap: word-wrap;
                        }
                    }

                }
            }
        }
    }

    // A claim in progress replaces the form: there is deliberately only ever
    // one, because each carries its own deadline and two clocks running at once
    // is one more than anybody can watch.
    //
    // A running claim shows itself whatever the form is doing. It has a
    // deadline measured in blocks, and a deadline nobody can see is a fee
    // already spent.
    if IdentityState.claiming || IdentityState.reg-step != "": VerticalLayout {
        spacing: Sp.s4;
        Eyebrow {
            text: IdentityState.reg-step == "" ? "CLAIM A NAME" : "CLAIMING A NAME";
        }
        Card {
            VerticalLayout {
                padding: Sp.card-pad;
                if IdentityState.reg-step == "": RegisterForm {}
                if IdentityState.reg-step != "": RegistrationPanel {}
            }
        }
    }

    VerticalLayout {
        spacing: Sp.s4;
        Eyebrow { text: "LOOK ONE UP"; }
        Card {
            VerticalLayout {
                padding: Sp.card-pad;
                LookUpForm {}
            }
        }
    }

    // Anything looked up that is not yours. Its own section, its own heading,
    // and a way to be rid of it — an aside, not a second list competing with
    // the one above.
    if IdentityState.looked-up.length > 0: VerticalLayout {
        spacing: Sp.s4;
        HorizontalLayout {
            spacing: Sp.s5;
            Eyebrow {
                text: "LOOKED UP · NOT YOURS";
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Btn {
                text: "Clear";
                variant: "ghost";
                y: (parent.height - self.height) / 2;
                clicked => { Actions.clear-lookups(); }
            }
        }
        Card {
            VerticalLayout {
                padding: Sp.s3;
                for row in IdentityState.looked-up: ListRow {
                    glyph: "◇";
                    glyph-tone: Theme.text-tertiary;
                    title: row.name;
                    subtitle: row.address;
                    subtitle-mono: true;
                    interactive: true;
                    clicked => { Actions.open-identity(row.address); }

                    HorizontalLayout {
                        spacing: Sp.s5;
                        alignment: end;
                        VerticalLayout {
                            width: 260px;
                            alignment: center;
                            spacing: 2px;
                            HorizontalLayout {
                                alignment: end;
                                StatusPill {
                                    state: row.tone;
                                    text: row.status;
                                }
                            }
                            if row.note != "": Text {
                                text: row.note;
                                font-size: Typo.micro;
                                color: Theme.text-tertiary;
                                horizontal-alignment: right;
                                wrap: word-wrap;
                            }
                        }
                        // One at a time, beside Clear for all of them. A list
                        // that can only be emptied wholesale makes keeping one
                        // entry cost keeping every entry.
                        Rectangle {
                            width: 88px;
                            Btn {
                                text: "Remove";
                                variant: "ghost";
                                x: parent.width - self.width;
                                y: (parent.height - self.height) / 2;
                                clicked => { Actions.unwatch-identity(row.address); }
                            }
                        }
                    }
                }
            }
        }
    }

    Rectangle { vertical-stretch: 1; }
}

component ActivityScreen inherits VerticalLayout {
    padding: Sp.screen-pad;
    // Both were the shared page layout's job until this screen left it.
    max-width: Sp.content-max;
    spacing: Sp.s5;

    if WalletState.history.length == 0 && !WalletState.loading: Card {
        VerticalLayout {
            padding: Sp.s11;
            EmptyState {
                glyph: "○";
                title: "No transactions yet";
                body: "Everything this wallet has ever sent or received appears here.";
            }
        }
    }

    if WalletState.history.length > 0: Card {
        // Takes whatever the footer leaves, so a long history fills the window
        // and "Load older" stays reachable rather than being pushed off the end
        // of a list that grows every time it is pressed.
        // And fills it, rather than hugging its contents.
        //
        // A `ListView` cannot size to what is in it: knowing the content height
        // means laying the content out, and not laying out what nobody can see
        // is the entire point. Binding the card to `viewport-height` compiles to
        // a binding loop, which is the compiler saying the same thing.
        //
        // So the list occupies the pane the way a list does everywhere else —
        // rows at the top, the rest empty on a short history. The footer below
        // it is better off for it: "Load older" now sits at a fixed place
        // instead of after a list that grows every time it is pressed.
        vertical-stretch: 1;
        VerticalLayout {
            padding: Sp.s3;
            // Every transaction, newest first, and only the visible ones built.
            // The day headings ride along inside the row that starts a day —
            // computed in core, which can see the row before this one — so this
            // stays one flat model rather than a tree the list cannot page.
            list := ListView {
                for item in WalletState.history: ActivityRowItem {
                    entry: item;
                }
            }
        }
    }

    // Offered until the scan has actually reached the start of the chain.
    // History is fetched in windows of blocks, so an empty stretch is not the
    // end of the list — and a wallet that stopped at the first quiet week would
    // simply be hiding transactions.
    if WalletState.history.length > 0 && !WalletState.history-complete: HorizontalLayout {
        alignment: center;
        Btn {
            text: WalletState.loading-history ? "Reading…" : "Load older transactions";
            enabled: !WalletState.loading-history;
            clicked => { Actions.load-older(); }
        }
    }

    if WalletState.history.length > 0 && WalletState.history-complete: Text {
        text: "That is everything on the chain for this wallet.";
        font-size: Typo.caption;
        color: Theme.text-tertiary;
        horizontal-alignment: center;
    }

    // No trailing spacer here, unlike the other screens. The list above is what
    // takes the leftover height — a spacer competing for it would split the
    // difference and leave the list half a window tall with empty space beneath.
    if WalletState.history.length == 0: Rectangle { vertical-stretch: 1; }
}

// Where to look a transaction up.
//
// Shown, not opened. Launching a browser is a capability a wallet does not
// otherwise have, and it is one process spawn away from being a way to run
// something else.
component ExplorerLink inherits VerticalLayout {
    spacing: Sp.s3;
    Eyebrow { text: "LOOK IT UP"; }

    HorizontalLayout {
        spacing: Sp.s4;
        link := TextInput {
            horizontal-stretch: 1;
            text: TxState.explorer;
            read-only: true;
            font-family: Typo.mono;
            font-size: Typo.num-sm;
            color: Theme.text-secondary;
            wrap: char-wrap;
        }
        Btn {
            text: "Copy link";
            y: 0;
            clicked => {
                link.select-all();
                link.copy();
            }
        }
    }
}

// One transaction, over whatever is behind it.
//
// A sheet rather than a screen: it is a detour, and coming back should not need
// a decision about where you were.
// One key's worth of published content.
//
// Its own component because the key heading is drawn only on the first row of
// each key, and an element declared inside an `if` cannot be addressed from
// outside it.
component ContentRow inherits VerticalLayout {
    in property <ContentEntry> entry;
    spacing: Sp.s2;

    if root.entry.first: VerticalLayout {
        padding-top: Sp.s4;
        spacing: 2px;
        Text {
            text: root.entry.name != "" ? root.entry.name : "Unnamed key";
            font-size: Typo.caption;
            font-weight: Typo.w-medium;
            color: Theme.text-primary;
        }
        Text {
            text: root.entry.key;
            font-family: Typo.mono;
            font-size: Typo.micro;
            color: Theme.text-tertiary;
            wrap: char-wrap;
        }
        if root.entry.name == "": Text {
            // Not "we could not look it up yet". A VDXF key is a one-way hash
            // of a name, so for a key somebody else published there is nothing
            // to look up and never will be.
            text: "This key's name cannot be recovered — VDXF keys are one-way hashes.";
            font-size: Typo.micro;
            color: Theme.text-tertiary;
            wrap: word-wrap;
        }
    }

    Rectangle {
        background: Theme.bg-inset;
        border-radius: R.md;
        VerticalLayout {
            padding: Sp.s4;
            spacing: Sp.s2;

            if root.entry.structured != "": Text {
                // The daemon recognised the key and rendered it. The only
                // structure anybody gets for free.
                text: root.entry.structured;
                font-family: Typo.mono;
                font-size: Typo.micro;
                color: Theme.text-primary;
                wrap: word-wrap;
            }

            if root.entry.text != "": Text {
                text: root.entry.text;
                font-size: Typo.body;
                color: Theme.text-primary;
                wrap: word-wrap;
            }

            if root.entry.hex != "": Text {
                // Always shown, under the reading rather than instead of it:
                // the text is an interpretation, the bytes are the fact.
                text: root.entry.hex;
                font-family: Typo.mono;
                font-size: Typo.micro;
                color: root.entry.text != "" ? Theme.text-tertiary : Theme.text-primary;
                wrap: char-wrap;
            }

            if root.entry.text == "" && root.entry.size != "": Text {
                text: root.entry.size;
                font-size: Typo.micro;
                color: Theme.text-tertiary;
            }
        }
    }
}

// Deriving a key from a name, which is the only direction that exists.
component TryKeyForm inherits VerticalLayout {
    spacing: Sp.s3;

    Text {
        // Says plainly what it is. The SDK's own words: trying candidate names
        // against the derivation is a search, not a lookup.
        text: "A key is a hash of a name, so it cannot be read backwards. Type a name you expect and see whether this identity published under it.";
        font-size: Typo.caption;
        color: Theme.text-secondary;
        wrap: word-wrap;
    }

    HorizontalLayout {
        spacing: Sp.s4;
        key := Field {
            horizontal-stretch: 1;
            mono: true;
            placeholder: "vrsc::identity.profile";
            text <=> IdentityState.key-draft;
            accepted => { Actions.derive-content-key(key.text); }
        }
        Btn {
            text: "Try it";
            y: (parent.height - self.height) / 2;
            clicked => { Actions.derive-content-key(key.text); }
        }
    }

    if IdentityState.derived-key != "": VerticalLayout {
        spacing: 2px;
        Text {
            text: IdentityState.derived-key;
            font-family: Typo.mono;
            font-size: Typo.num-sm;
            color: Theme.text-primary;
            wrap: char-wrap;
        }
        Text {
            text: IdentityState.derived-present
                ? "This identity has published under that name."
                : "This identity has nothing under that name.";
            font-size: Typo.caption;
            color: IdentityState.derived-present ? Theme.positive : Theme.text-tertiary;
            wrap: word-wrap;
        }
    }
}

// One VerusID, in full.
//
// Sections in order of consequence rather than in the order the fields arrive:
// who can sign, who can take it away, whether it is held, and only then what it
// has published.
// A change built and signed, waiting to be sent.
//
// Its own layer over the sheet rather than a section inside it, for the reason
// the send review is its own step: this is the last moment before something
// irreversible, and it should not be one heading among eight.
component IdentityChangeReview inherits Rectangle {
    background: Theme.dark ? #0B0C0EE0 : #FBFBFCE0;
    TouchArea {}

    Card {
        // Above a sheet that is itself elevated, so this one needs the same
        // treatment or the last step before something irreversible would be the
        // flattest surface on screen.
        elevated: true;
        width: 520px;
        height: content.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        content := VerticalLayout {
            padding: Sp.s8;
            spacing: Sp.s5;

            VerticalLayout {
                spacing: Sp.s2;
                Text {
                    text: "Check this change";
                    font-size: Typo.title2;
                    font-weight: Typo.w-bold;
                    color: Theme.text-primary;
                }
                // Which identity. The sheet behind this one names it, and the
                // sheet behind this one is under a scrim — so a dialog about
                // revoking something did not say what it was about.
                Text {
                    text: IdentityState.name;
                    font-family: Typo.mono;
                    font-size: Typo.num-sm;
                    color: Theme.text-secondary;
                }
            }
            Text {
                text: IdentityState.change-description;
                font-size: Typo.body;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }

            HorizontalLayout {
                Text {
                    text: "Fee";
                    font-size: Typo.caption;
                    color: Theme.text-secondary;
                    horizontal-stretch: 1;
                }
                Money {
                    amount: IdentityState.change-fee;
                    currency: WalletState.ticker;
                    size: Typo.num;
                }
            }

            // A word, for the one change nobody can undo. The same shape the
            // mainnet spending switch uses — and checked in the core, not here,
            // so a different interface cannot skip it.
            if IdentityState.change-confirmation != "": VerticalLayout {
                spacing: Sp.s3;
                Rectangle {
                    background: Theme.negative-soft;
                    border-radius: R.md;
                    VerticalLayout {
                        padding: Sp.s5;
                        spacing: Sp.s2;
                        Text {
                            text: "This cannot be undone from here";
                            font-size: Typo.body;
                            font-weight: Typo.w-medium;
                            color: Theme.negative;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "Only the recovery authority can bring a revoked identity back — and if that authority is the identity itself, nobody can.";
                            font-size: Typo.caption;
                            color: Theme.text-secondary;
                            wrap: word-wrap;
                        }
                    }
                }
                Text {
                    text: "Type " + IdentityState.change-confirmation + " to confirm";
                    font-size: Typo.caption;
                    color: Theme.text-secondary;
                }
                Field {
                    mono: true;
                    placeholder: IdentityState.change-confirmation;
                    text <=> IdentityState.change-typed;
                }
            }

            HorizontalLayout {
                spacing: Sp.s4;
                alignment: end;
                Btn {
                    text: "Back";
                    variant: "ghost";
                    clicked => { Actions.cancel-identity-change(IdentityState.change-ticket); }
                }
                // Off until the word is typed.
                //
                // It used to be live from the moment the review opened: the
                // affirmative, destructive-red button on the one screen in this
                // wallet that revokes an identity, pressable with the box
                // empty. The core refused, so nothing was lost — but a button
                // that invites a press and then declines it teaches somebody
                // that the confirmation is a formality, which is the opposite
                // of what a confirmation is for.
                Btn {
                    text: IdentityState.change-busy ? "Sending…" : "Send it";
                    variant: IdentityState.change-confirmation != "" ? "destructive" : "primary";
                    enabled: !IdentityState.change-busy
                        && (IdentityState.change-confirmation == ""
                            || IdentityState.change-typed == IdentityState.change-confirmation);
                    clicked => {
                        Actions.confirm-identity-change(
                            IdentityState.change-ticket,
                            IdentityState.change-typed,
                        );
                    }
                }
            }
        }
    }
}

component IdentitySheet inherits Rectangle {
    background: Theme.dark ? #0B0C0EC0 : #FBFBFCC0;

    // The authority form is shut and emptied by `close-identity`, which every
    // route out of this sheet goes through — the scrim, the button and Escape.
    // Not on `init` here: that would also fire after a fixture had opened the
    // form on purpose, and the reference image would stop covering it.

    // Swallows clicks on the scrim and closes.
    TouchArea {
        clicked => { Actions.close-identity(); }
    }

    Card {
        elevated: true;
        width: 640px;
        height: min(root.height - Sp.s11 * 2, content.preferred-height);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        // The card itself must not close it.
        TouchArea {}

        Flickable {
            viewport-height: content.preferred-height;

            content := VerticalLayout {
                padding: Sp.s8;
                spacing: Sp.s6;

                HorizontalLayout {
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: Sp.s2;
                        Text {
                            text: IdentityState.name;
                            font-size: Typo.title2;
                            font-weight: Typo.w-bold;
                            color: Theme.text-primary;
                            wrap: word-wrap;
                        }
                        Text {
                            text: IdentityState.address;
                            font-family: Typo.mono;
                            font-size: Typo.num-sm;
                            color: Theme.text-tertiary;
                            wrap: char-wrap;
                        }
                    }
                    Btn {
                        text: "Close";
                        y: 0;
                        clicked => { Actions.close-identity(); }
                    }
                }

                HorizontalLayout {
                    spacing: Sp.s5;
                    StatusPill {
                        state: IdentityState.tone;
                        text: IdentityState.status;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Money {
                        amount: IdentityState.balance;
                        currency: WalletState.ticker;
                        size: Typo.num;
                    }
                }

                // ── The warning that outranks everything on this screen ──
                if IdentityState.cannot-be-revoked: Rectangle {
                    background: Theme.warning-soft;
                    border-radius: R.md;
                    VerticalLayout {
                        padding: Sp.s5;
                        spacing: Sp.s2;
                        Text {
                            text: "This VerusID cannot be revoked";
                            font-size: Typo.body;
                            font-weight: Typo.w-medium;
                            color: Theme.warning;
                            wrap: word-wrap;
                        }
                        Text {
                            // The default a fresh registration lands on, and
                            // the one nobody is told about at the time.
                            text: "Its recovery authority is itself, and the chain refuses a revocation whose subject is its own recovery authority. Setting a different recovery authority is what makes it revocable.";
                            font-size: Typo.caption;
                            color: Theme.text-secondary;
                            wrap: word-wrap;
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.border-subtle; }

                VerticalLayout {
                    spacing: Sp.s3;
                    Eyebrow { text: "WHO CAN SIGN"; }
                    for address in IdentityState.primary-addresses: Text {
                        text: address;
                        font-family: Typo.mono;
                        font-size: Typo.num-sm;
                        color: Theme.text-primary;
                        wrap: char-wrap;
                    }
                    Text {
                        text: IdentityState.signatures-required + " signatures required";
                        font-size: Typo.caption;
                        color: Theme.text-tertiary;
                    }
                    Text {
                        text: IdentityState.control-note;
                        font-size: Typo.caption;
                        color: Theme.text-secondary;
                        wrap: word-wrap;
                    }
                }

                Rectangle { height: 1px; background: Theme.border-subtle; }

                VerticalLayout {
                    spacing: Sp.s3;
                    Eyebrow { text: "WHO CAN TAKE IT AWAY"; }
                    HorizontalLayout {
                        spacing: Sp.s5;
                        Text {
                            text: "Revocation";
                            font-size: Typo.caption;
                            color: Theme.text-secondary;
                            width: 96px;
                        }
                        Text {
                            text: IdentityState.revocation-authority;
                            font-family: Typo.mono;
                            font-size: Typo.num-sm;
                            color: Theme.text-primary;
                            horizontal-stretch: 1;
                            wrap: char-wrap;
                        }
                    }
                    HorizontalLayout {
                        spacing: Sp.s5;
                        Text {
                            text: "Recovery";
                            font-size: Typo.caption;
                            color: Theme.text-secondary;
                            width: 96px;
                        }
                        Text {
                            text: IdentityState.recovery-authority;
                            font-family: Typo.mono;
                            font-size: Typo.num-sm;
                            color: Theme.text-primary;
                            horizontal-stretch: 1;
                            wrap: char-wrap;
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.border-subtle; }

                // Only offered where this wallet can actually sign. A button
                // that builds a transaction the chain will refuse is worse than
                // no button: it costs a fee to learn.
                // Behind a button, like the claim form on the screen behind
                // this one and for the same reason: it is three controls and a
                // paragraph, it is used once in the life of an identity, and
                // left open it pushed the timelock and everything this identity
                // has published below the bottom of a sheet somebody has to
                // scroll.
                if IdentityState.can-sign && !IdentityState.changing-authorities:
                HorizontalLayout {
                    alignment: start;
                    Btn {
                        text: "Change the authorities";
                        clicked => { IdentityState.changing-authorities = true; }
                    }
                }

                if IdentityState.can-sign && IdentityState.changing-authorities:
                VerticalLayout {
                    spacing: Sp.s3;
                    Eyebrow { text: "POINT THE AUTHORITIES SOMEWHERE ELSE"; }
                    Text {
                        text: "Whoever you name here can take this identity from you, and this wallet cannot take it back. That is the point of them — and the reason it is worth being sure.";
                        font-size: Typo.caption;
                        color: Theme.text-secondary;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: Sp.s4;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: Sp.s2;
                            Text {
                                text: "Revocation";
                                font-size: Typo.caption;
                                color: Theme.text-secondary;
                            }
                            Field {
                                mono: true;
                                placeholder: "i-address";
                                text <=> IdentityState.new-revocation;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: Sp.s2;
                            Text {
                                text: "Recovery";
                                font-size: Typo.caption;
                                color: Theme.text-secondary;
                            }
                            Field {
                                mono: true;
                                placeholder: "i-address";
                                text <=> IdentityState.new-recovery;
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: Sp.s3;
                        Btn {
                            text: "Cancel";
                            variant: "ghost";
                            enabled: !IdentityState.change-busy;
                            clicked => {
                                IdentityState.changing-authorities = false;
                                // Cleared with the form. A half-typed i-address
                                // left behind would reappear the next time this
                                // opens, against whichever identity that is.
                                IdentityState.new-revocation = "";
                                IdentityState.new-recovery = "";
                            }
                        }
                        Btn {
                            text: "Review this change";
                            enabled: !IdentityState.change-busy
                                && (IdentityState.new-revocation != ""
                                    || IdentityState.new-recovery != "");
                            clicked => {
                                Actions.set-identity-authorities(
                                    IdentityState.address,
                                    IdentityState.new-revocation,
                                    IdentityState.new-recovery,
                                );
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.border-subtle; }

                VerticalLayout {
                    spacing: Sp.s3;
                    Eyebrow { text: "TIMELOCK"; }
                    Text {
                        // Never "locked: true". The two locked states behave
                        // nothing alike and only one of them ends on its own.
                        text: IdentityState.timelock-note;
                        font-size: Typo.body;
                        color: Theme.text-secondary;
                        wrap: word-wrap;
                    }

                    if IdentityState.can-sign: HorizontalLayout {
                        spacing: Sp.s4;
                        blocks := Field {
                            horizontal-stretch: 1;
                            mono: true;
                            placeholder: IdentityState.status == "Locked"
                                ? "extra blocks on top of the delay"
                                : "blocks to wait once unlocking is asked for";
                            text <=> IdentityState.lock-blocks;
                        }
                        if IdentityState.status != "Locked": Btn {
                            text: "Lock";
                            y: (parent.height - self.height) / 2;
                            enabled: !IdentityState.change-busy && blocks.text != "";
                            clicked => {
                                Actions.lock-identity(IdentityState.address, blocks.text.to-float());
                            }
                        }
                        if IdentityState.status == "Locked": Btn {
                            text: "Start unlocking";
                            y: (parent.height - self.height) / 2;
                            enabled: !IdentityState.change-busy;
                            clicked => {
                                Actions.unlock-identity(IdentityState.address, blocks.text.to-float());
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.border-subtle; }

                // Last, and deliberately so: these are the two that end an
                // identity's ordinary life, and they belong below everything
                // somebody might have come here to read.
                if IdentityState.can-sign: VerticalLayout {
                    spacing: Sp.s3;
                    Eyebrow { text: "TAKE IT OUT OF SERVICE"; }
                    HorizontalLayout {
                        spacing: Sp.s4;
                        alignment: start;
                        if IdentityState.status != "Revoked": Btn {
                            text: "Revoke";
                            variant: "destructive";
                            enabled: !IdentityState.change-busy;
                            clicked => { Actions.revoke-identity(IdentityState.address); }
                        }
                        if IdentityState.status == "Revoked": Btn {
                            text: "Recover";
                            variant: "primary";
                            enabled: !IdentityState.change-busy;
                            clicked => { Actions.recover-identity(IdentityState.address); }
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.border-subtle; }

                VerticalLayout {
                    spacing: Sp.s4;
                    Eyebrow { text: "PUBLISHED CONTENT"; }
                    Segmented {
                        width: 320px;
                        options: ["Now", "Over time"];
                        index <=> IdentityState.content-view;
                    }
                    Text {
                        text: IdentityState.content-view == 0
                            ? "What this identity holds right now."
                            : "Every value it has ever published, oldest first — a key written twice appears twice.";
                        font-size: Typo.caption;
                        color: Theme.text-tertiary;
                        wrap: word-wrap;
                    }

                    if IdentityState.content-view == 0 && IdentityState.content.length == 0: Text {
                        text: "Nothing published.";
                        font-size: Typo.caption;
                        color: Theme.text-tertiary;
                    }
                    if IdentityState.content-view == 1 && IdentityState.content-history.length == 0: Text {
                        text: "No history available — this node does not answer for it.";
                        font-size: Typo.caption;
                        color: Theme.text-tertiary;
                        wrap: word-wrap;
                    }

                    if IdentityState.content-view == 0: VerticalLayout {
                        spacing: Sp.s2;
                        for entry in IdentityState.content: ContentRow { entry: entry; }
                    }
                    if IdentityState.content-view == 1: VerticalLayout {
                        spacing: Sp.s2;
                        for entry in IdentityState.content-history: ContentRow { entry: entry; }
                    }
                }

                Rectangle { height: 1px; background: Theme.border-subtle; }

                VerticalLayout {
                    spacing: Sp.s3;
                    Eyebrow { text: "TRY A KEY"; }
                    TryKeyForm {}
                }
            }
        }
    }
}

component TxSheet inherits Rectangle {
    // Dims what is behind without hiding it, so the list is still the context.
    background: Theme.dark ? #0B0C0EC0 : #FBFBFCC0;

    // Swallows clicks so nothing behind the sheet can be pressed through it,
    // and closes on a click outside the card.
    TouchArea {
        clicked => { TxState.txid = ""; }
    }

    Card {
        elevated: true;
        width: 600px;
        height: min(root.height - Sp.s11 * 2, content.preferred-height);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        // The card itself must not close it.
        TouchArea {}

        Flickable {
            viewport-height: content.preferred-height;

            content := VerticalLayout {
                padding: Sp.s8;
                spacing: Sp.s6;

                HorizontalLayout {
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: Sp.s2;
                        Text {
                            text: TxState.direction == "in" ? "Received"
                                : TxState.direction == "out" ? "Sent"
                                : "Moved between your own addresses";
                            font-size: Typo.title2;
                            font-weight: Typo.w-bold;
                            color: Theme.text-primary;
                        }
                        Text {
                            text: TxState.when;
                            font-size: Typo.caption;
                            color: Theme.text-tertiary;
                        }
                    }
                    Btn {
                        text: "Close";
                        variant: "ghost";
                        y: 0;
                        clicked => { TxState.txid = ""; }
                    }
                }

                Money {
                    amount: TxState.amount;
                    currency: WalletState.ticker;
                    show-currency: TxState.amount-is-native;
                    size: Typo.title1;
                    mono: false;
                    tone: TxState.direction == "in" ? "positive"
                        : TxState.direction == "out" ? "negative"
                        : "neutral";
                }

                for line in TxState.currency-lines: Text {
                    text: line;
                    font-family: Typo.mono;
                    font-size: Typo.num;
                    color: Theme.text-secondary;
                }

                Rectangle { height: 1px; background: Theme.border-subtle; }

                VerticalLayout {
                    spacing: Sp.s4;

                    HorizontalLayout {
                        Text {
                            text: "Confirmations";
                            font-size: Typo.body;
                            color: Theme.text-secondary;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: TxState.confirmations == "" ? "unconfirmed" : TxState.confirmations;
                            font-family: Typo.mono;
                            font-size: Typo.num;
                            color: TxState.confirmations == "" ? Theme.warning : Theme.text-primary;
                        }
                    }

                    HorizontalLayout {
                        Text {
                            text: "Block";
                            font-size: Typo.body;
                            color: Theme.text-secondary;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: TxState.height == "0" ? "not mined yet" : TxState.height;
                            font-family: Typo.mono;
                            font-size: Typo.num;
                            color: Theme.text-primary;
                        }
                    }

                    HorizontalLayout {
                        Text {
                            text: "Fee";
                            font-size: Typo.body;
                            color: Theme.text-secondary;
                            horizontal-stretch: 1;
                        }
                        Text {
                            // "Not reported" rather than a zero. A fee is
                            // inputs minus outputs, and the input values live
                            // in other transactions — a wallet that printed 0
                            // here would be stating something it does not know.
                            text: TxState.fee == "" ? "not reported by this node" : TxState.fee;
                            font-family: TxState.fee == "" ? "" : Typo.mono;
                            font-size: TxState.fee == "" ? Typo.caption : Typo.num;
                            color: TxState.fee == "" ? Theme.text-tertiary : Theme.text-primary;
                        }
                    }
                }

                // The button that copies the id, beside the id.
                //
                // It used to be in the footer, two sections below — after the
                // explorer link, which has its own Copy sitting right next to
                // the thing it copies. So the sheet taught one arrangement and
                // then used the other for the field above it.
                VerticalLayout {
                    spacing: Sp.s3;
                    Eyebrow { text: "TRANSACTION ID"; }
                    HorizontalLayout {
                        spacing: Sp.s4;
                        txid := TextInput {
                            horizontal-stretch: 1;
                            text: TxState.txid;
                            read-only: true;
                            font-family: Typo.mono;
                            font-size: Typo.num-sm;
                            color: Theme.text-primary;
                            wrap: char-wrap;
                        }
                        Btn {
                            text: "Copy id";
                            y: 0;
                            clicked => {
                                txid.select-all();
                                txid.copy();
                            }
                        }
                    }
                }

                // Its own component, so the field and the button that copies
                // it live in the same scope — an element declared inside an
                // `if` cannot be reached from outside it.
                if TxState.explorer != "": ExplorerLink {}

                HorizontalLayout {
                    alignment: start;
                    Btn {
                        text: TxState.advanced ? "Hide raw transaction" : "Show raw transaction";
                        variant: "ghost";
                        clicked => { TxState.advanced = !TxState.advanced; }
                    }
                }

                if TxState.advanced: Rectangle {
                    height: 220px;
                    background: Theme.bg-inset;
                    border-radius: R.md;

                    Flickable {
                        viewport-height: raw.preferred-height;
                        raw := Text {
                            text: TxState.raw == "" ? "Waiting for the node…" : TxState.raw;
                            font-family: Typo.mono;
                            font-size: Typo.micro;
                            color: Theme.text-secondary;
                            wrap: word-wrap;
                            x: Sp.s5;
                            width: parent.width - Sp.s5 * 2;
                        }
                    }
                }
            }
        }
    }
}

component ReceiveScreen inherits VerticalLayout {
    spacing: Sp.s7;

    HorizontalLayout {
        alignment: center;
        KeyPicker {}
    }

    HorizontalLayout {
        alignment: center;
        Card {
            width: 420px;

            VerticalLayout {
                padding: Sp.s8;
                spacing: Sp.s6;

                // The QR sits on WHITE even in the dark theme. Inverted codes
                // fail on a fair number of scanners, and this happens to be
                // exactly the Apple Wallet look.
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: WalletState.qr-side + Sp.s6 * 2;
                        height: self.width;
                        background: #FFFFFF;
                        border-radius: R.lg;

                        if WalletState.address != "": Image {
                            source: WalletState.qr;
                            width: WalletState.qr-side;
                            height: WalletState.qr-side;
                            // Rules 4 and 5 from `src/qr.rs`: any residual
                            // scaling is nearest-neighbour, and the image is
                            // never stretched by a layout.
                            image-rendering: pixelated;
                            image-fit: contain;
                        }

                        if WalletState.address == "": Text {
                            text: "No address yet";
                            font-size: Typo.caption;
                            color: #6E747E;
                        }
                    }
                }

                VerticalLayout {
                    spacing: Sp.s3;

                    Eyebrow { text: "YOUR " + WalletState.ticker + " ADDRESS"; }

                    // Selectable, monospace, and wrapping mid-string: an
                    // address is read character by character when it is checked
                    // against something, and a proportional font makes that
                    // needlessly hard.
                    // Set at the size of a thing that gets checked, not at the
                    // size of a caption.
                    //
                    // This is what somebody reads character by character against
                    // whatever the sender is showing them, and it was two points
                    // smaller than the balance's currency label. It wraps to two
                    // lines here, which is the right trade: an address that
                    // fits on one line and cannot be read is not a saving.
                    //
                    // Not grouped into blocks of four, tempting as that is —
                    // Copy works by selecting this element's own text, since
                    // Slint gives an application no clipboard of its own, so
                    // spaces on screen would be spaces on the clipboard.
                    address := TextInput {
                        text: WalletState.address;
                        read-only: true;
                        font-family: Typo.mono;
                        font-size: Typo.num-lg;
                        color: Theme.text-primary;
                        wrap: char-wrap;
                        // Announced in four-character groups, because a screen
                        // reader saying raw base58 at speaking speed produces
                        // something nobody can transcribe or check.
                        accessible-role: AccessibleRole.text;
                        accessible-label: "Receive address";
                        accessible-value: WalletState.address-spoken;
                    }
                }

                HorizontalLayout {
                    spacing: Sp.s4;
                    Btn {
                        text: "Copy address";
                        variant: "primary";
                        horizontal-stretch: 1;
                        clicked => {
                            // The copy happens in Slint, not in Rust: Slint 1.17
                            // exposes no clipboard API to an application, only
                            // to a platform back-end. `TextInput` has one, so
                            // the address goes out through the element that
                            // already holds it.
                            address.select-all();
                            address.copy();
                        }
                    }
                }

                // The single most useful sentence on this screen, and it used to
                // be drawn as the least: centred, grey, caption-sized, below the
                // fold of the eye. A comment calling something the most
                // important thing here while the styling says otherwise is the
                // styling winning.
                //
                // Sending mainnet coins to a testnet address loses them, and the
                // two kinds of address look identical. So it gets a surface,
                // left alignment, and the chain's name in the weight of a fact.
                Rectangle {
                    background: NetworkState.effective == ""
                        ? Theme.warning-soft
                        : Theme.bg-inset;
                    border-radius: R.md;
                    VerticalLayout {
                        padding: Sp.s4;
                        Text {
                            text: NetworkState.effective == ""
                                ? "No node has confirmed which chain this is — check before sharing it."
                                : "This address is on " + NetworkState.effective
                                  + ". Coins from any other chain sent here are lost.";
                            font-size: Typo.caption;
                            font-weight: Typo.w-medium;
                            color: NetworkState.effective == ""
                                ? Theme.warning
                                : Theme.text-secondary;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }

    Rectangle { vertical-stretch: 1; }
}

// The stack of things the wallet has said.
//
// Bottom right, over everything including the backup screen — a recovery phrase
// on screen does not make a rejected payment less worth knowing about. Newest
// at the bottom, so the position of what you are reading does not move when
// another arrives.
component ToastHost inherits Rectangle {
    // Wide enough for two lines of detail at this size, narrow enough not to
    // read as a panel taking over the screen.
    property <length> panel-width: 380px;

    // ONE opaque panel, not a stack of floating cards.
    //
    // Separate cards leave gaps, and a gap over a dashboard shows whatever is
    // behind it — an asset amount peeking between two notices reads as a
    // rendering fault rather than as depth. A single surface with hairlines
    // between the entries has the same structure and no holes.
    Rectangle {
        x: parent.width - root.panel-width - Sp.s8;
        y: parent.height - self.height - Sp.s8;
        width: root.panel-width;
        height: stack.preferred-height;

        background: Theme.bg-raised;
        border-radius: R.lg;
        border-width: 1px;
        border-color: Theme.border-strong;
        // In both themes. `Card` shadows only in light, because a card sits IN
        // the page; this floats above it and has to say so on a dark ground
        // too.
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 6px;
        drop-shadow-color: Theme.dark ? #00000066 : #10111426;

        stack := VerticalLayout {
            for entry[i] in ToastState.rows: VerticalLayout {
                if i > 0: Rectangle {
                    height: 1px;
                    background: Theme.border-subtle;
                }

                HorizontalLayout {
                    padding: Sp.card-pad;
                    spacing: Sp.s4;

                    // Colour is never the only signal — the severity is also in
                    // the wording, and the title carries the tone.
                    Rectangle {
                        width: 3px;
                        border-radius: 2px;
                        background: entry.severity == "danger" ? Theme.negative
                            : entry.severity == "warning" ? Theme.warning
                            : Theme.accent;
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: Sp.s2;

                        Text {
                            // The count rather than one card per occurrence: a
                            // refresh failing every fifteen seconds is one
                            // problem, and forty cards is a wallet nobody can
                            // use.
                            text: entry.count > 1
                                ? entry.title + " (" + entry.count + "×)"
                                : entry.title;
                            font-size: Typo.body;
                            font-weight: Typo.w-medium;
                            color: entry.severity == "danger" ? Theme.negative
                                : entry.severity == "warning" ? Theme.warning
                                : Theme.text-primary;
                            wrap: word-wrap;
                        }

                        if entry.detail != "": Text {
                            text: entry.detail;
                            font-size: Typo.caption;
                            color: Theme.text-secondary;
                            wrap: word-wrap;
                        }
                    }

                    Btn {
                        text: "Close";
                        variant: "ghost";
                        y: 0;
                        clicked => { ToastState.dismiss(i); }
                    }
                }
            }

            // Offered only once there is more than one: a wallet that has just
            // failed six times should not need six clicks.
            if ToastState.rows.length > 1: Rectangle {
                height: 1px;
                background: Theme.border-subtle;
            }
            if ToastState.rows.length > 1: HorizontalLayout {
                padding: Sp.s4;
                padding-right: Sp.card-pad;
                alignment: end;
                Btn {
                    text: "Dismiss all";
                    variant: "ghost";
                    clicked => { ToastState.dismiss-all(); }
                }
            }
        }
    }
}

component ComingSoon inherits VerticalLayout {
    in property <string> title;
    in property <string> body;
    alignment: center;
    EmptyState {
        glyph: "◔";
        title: root.title;
        body: root.body;
    }
}


component Onboarding inherits Rectangle {
    // "create" | "unlock"
    in property <string> mode;
    in property <string> wallet-name;
    in property <bool> busy;
    in property <string> problem;

    // Which of the two forms is up. Pure navigation — there is no wallet state
    // that corresponds to "is currently typing a phrase" — but `in-out` rather
    // than private, for the same reason `screen` is: a snapshot has to be able
    // to put the window into this state, and a state no test can reach is a
    // state that quietly rots.
    in-out property <bool> restoring: false;

    background: Theme.bg-base;

    VerticalLayout {
        alignment: center;
        spacing: Sp.s7;
        padding: Sp.s8;

        HorizontalLayout {
            alignment: center;
            Text {
                text: "◆";
                font-family: Typo.mono;
                font-size: 34px;
                color: Theme.accent;
            }
        }

        if !root.restoring: PassphraseForm {
            mode: root.mode;
            wallet-name: root.wallet-name;
            busy: root.busy;
            problem: root.problem;
            restore => { root.restoring = true; }
        }

        if root.restoring: RestoreForm {
            busy: root.busy;
            problem: root.problem;
            cancelled => { root.restoring = false; }
        }
    }
}

// The 24 words, laid out in a grid.
//
// Absolute positions computed from the row index rather than a `GridLayout`,
// because the words arrive as a flat model and Slint's grid wants elements
// declared per cell. The arithmetic is the entire trick.
component PhraseGrid inherits Rectangle {
    property <float> columns: 4;
    property <length> cell-height: 36px;

    height: Math.ceil(SeedState.words.length / root.columns) * root.cell-height;

    for word[i] in SeedState.words: Rectangle {
        x: Math.mod(i, root.columns) * (root.width / root.columns);
        y: Math.floor(i / root.columns) * root.cell-height;
        width: root.width / root.columns;
        height: root.cell-height;

        HorizontalLayout {
            padding-left: Sp.s3;
            padding-right: Sp.s3;
            spacing: Sp.s4;

            Text {
                text: word.index;
                font-family: Typo.mono;
                font-size: Typo.num-sm;
                color: Theme.text-tertiary;
                horizontal-alignment: right;
                vertical-alignment: center;
                width: 22px;
                // Not announced. A screen reader reciting a recovery phrase in
                // a shared office is a real failure mode, and the words must be
                // read aloud only when someone asks for it — an opt-in button
                // that is NOT built yet. Until it is, silence is the safe side.
                accessible-role: AccessibleRole.none;
            }

            Text {
                text: word.word;
                font-family: Typo.mono;
                font-size: Typo.num;
                color: Theme.text-primary;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: AccessibleRole.none;
            }
        }
    }
}

// One word of the confirmation step.
component WordCheck inherits VerticalLayout {
    in property <int> position;
    in property <bool> invalid: false;
    in-out property <string> text <=> field.text;
    callback accepted();

    spacing: Sp.s3;

    HorizontalLayout {
        spacing: Sp.s2;
        alignment: start;
        Text {
            text: "Word";
            font-size: Typo.caption;
            color: Theme.text-secondary;
        }
        Text {
            text: root.position;
            font-family: Typo.mono;
            font-size: Typo.caption;
            color: Theme.text-primary;
        }
    }

    field := Field {
        invalid: root.invalid;
        accepted => { root.accepted(); }
    }
}

// ── The three steps of a backup ─────────────────────────────────────────────
//
// Each is its own component because each owns an input, and an input declared
// inside an `if` cannot be reached from outside it. Splitting them is what lets
// every field be read and blanked in the same callback — and it means leaving a
// step destroys its fields rather than leaving them holding what was typed.

// Prove who you are. Only on the way back to a backup that was interrupted:
// a phrase just generated is already in front of the person who generated it.
component BackupPassphrase inherits VerticalLayout {
    callback closed();
    spacing: Sp.s6;

    VerticalLayout {
        spacing: Sp.s3;
        Text {
            text: "Show your recovery phrase";
            font-size: Typo.title1;
            font-weight: Typo.w-bold;
            color: Theme.text-primary;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center;
            Text {
                width: 460px;
                text: "Enter your passphrase again. Pecu asks every time these words are shown, rather than once per session.";
                font-size: Typo.body;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }

    HorizontalLayout {
        alignment: center;
        field := Field {
            width: 360px;
            password: true;
            placeholder: "Passphrase";
            invalid: SeedState.problem != "";
            accepted => { root.submit(); }
        }
    }

    if SeedState.problem != "": Text {
        text: SeedState.problem;
        font-size: Typo.caption;
        color: Theme.negative;
        horizontal-alignment: center;
    }

    HorizontalLayout {
        alignment: center;
        spacing: Sp.s4;
        Btn {
            text: "Not now";
            variant: "ghost";
            clicked => { root.closed(); }
        }
        Btn {
            text: "Show phrase";
            variant: "primary";
            enabled: field.text != "" && !SeedState.busy;
            clicked => { root.submit(); }
        }
    }

    function submit() {
        if (field.text == "") { return; }
        Actions.reveal-backup(field.text);
        field.text = "";
    }
}

// Read the words.
component BackupPhrase inherits VerticalLayout {
    callback closed();
    callback written-down();

    // Whether the words have ever been on screen in this sitting.
    //
    // "I've written it down" used to be enabled from the moment the screen
    // appeared, so the whole step could be cleared with one click by somebody
    // who never saw a single word — and the sentence on the button is a claim
    // they would be making about themselves. The verify step behind it does
    // catch the lie, but a primary button that invites the wrong answer is
    // still a primary button that invites the wrong answer.
    //
    // Not persisted, and deliberately: coming back to this screen means being
    // asked to look again, which is the correct answer to "have you got these
    // written down" when the wallet cannot know.
    property <bool> seen: false;

    spacing: Sp.s6;

    VerticalLayout {
        spacing: Sp.s3;
        Text {
            text: "Write down your recovery phrase";
            font-size: Typo.title1;
            font-weight: Typo.w-bold;
            color: Theme.text-primary;
            horizontal-alignment: center;
        }
        // Wrapped by an explicit width rather than `max-width`: inside a
        // vertical layout the text is handed the full column and wraps against
        // that, so a max-width alone let this run the width of the window.
        HorizontalLayout {
            alignment: center;
            Text {
                width: 520px;
                text: "These words are the only way to restore this wallet, and anyone who reads them can spend your coins.";
                font-size: Typo.body;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }

    HorizontalLayout {
        alignment: center;
        Card {
            width: 660px;
            VerticalLayout {
                padding: Sp.s5;
                PhraseGrid {}
            }
        }
    }

    HorizontalLayout {
        alignment: center;
        Rectangle {
            height: 36px;
            width: hold-label.preferred-width + Sp.s7 * 2;
            border-radius: R.md;
            border-width: 1px;
            border-color: hold.pressed ? Theme.accent : Theme.border-default;
            background: hold.pressed ? Theme.accent-soft : Theme.bg-surface;
            animate background { duration: Motion.fast; enabled: Motion.enabled; }
            animate border-color { duration: Motion.fast; enabled: Motion.enabled; }

            hold-label := Text {
                text: hold.pressed ? "Release to hide" : "Hold to reveal";
                font-size: Typo.body;
                font-weight: Typo.w-medium;
                color: Theme.text-primary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // Press asks core for the words, release throws them away. This
            // watches `pressed` rather than handling a click because `pressed`
            // also goes false when the pointer is released outside the button
            // or the gesture is cancelled — and every one of those has to
            // conceal the phrase.
            hold := TouchArea {
                mouse-cursor: pointer;
                changed pressed => {
                    if (hold.pressed) {
                        root.seen = true;
                        Actions.reveal-phrase();
                    } else {
                        Actions.hide-phrase();
                    }
                }
            }

            accessible-role: AccessibleRole.button;
            accessible-label: "Hold to reveal the recovery phrase";
        }
    }

    HorizontalLayout {
        alignment: center;
        Text {
            width: 560px;
            text: "Write them on paper. There is no Copy button and no Save to file, on purpose — those are the two ways a phrase usually ends up somewhere it can be read by something else.";
            font-size: Typo.caption;
            color: Theme.text-tertiary;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }

    HorizontalLayout {
        alignment: center;
        spacing: Sp.s4;
        Btn {
            text: "Later";
            variant: "ghost";
            clicked => { root.closed(); }
        }
        Btn {
            text: "I've written it down";
            variant: "primary";
            enabled: root.seen;
            clicked => { root.written-down(); }
        }
    }

    if !root.seen: HorizontalLayout {
        alignment: center;
        Text {
            text: "Hold the button above to see the words first.";
            font-size: Typo.caption;
            color: Theme.text-tertiary;
        }
    }
}

// Type three of them back.
component BackupVerify inherits VerticalLayout {
    callback back();
    spacing: Sp.s6;

    VerticalLayout {
        spacing: Sp.s3;
        Text {
            text: "Check your copy";
            font-size: Typo.title1;
            font-weight: Typo.w-bold;
            color: Theme.text-primary;
            horizontal-alignment: center;
        }
        Text {
            text: "Type three of the words back, from what you wrote down.";
            font-size: Typo.body;
            color: Theme.text-secondary;
            horizontal-alignment: center;
        }
    }

    HorizontalLayout {
        alignment: center;
        spacing: Sp.s5;

        first := WordCheck {
            width: 180px;
            position: SeedState.challenge[0];
            invalid: SeedState.problem != "";
            accepted => { root.submit(); }
        }
        second := WordCheck {
            width: 180px;
            position: SeedState.challenge[1];
            invalid: SeedState.problem != "";
            accepted => { root.submit(); }
        }
        third := WordCheck {
            width: 180px;
            position: SeedState.challenge[2];
            invalid: SeedState.problem != "";
            accepted => { root.submit(); }
        }
    }

    if SeedState.problem != "": Text {
        // Which word was wrong is never said. Saying it would turn this screen
        // into a checker that could be fed guesses one position at a time.
        text: SeedState.problem;
        font-size: Typo.caption;
        color: Theme.negative;
        horizontal-alignment: center;
    }

    HorizontalLayout {
        alignment: center;
        spacing: Sp.s4;
        Btn {
            text: "Show the words again";
            variant: "ghost";
            clicked => { root.back(); }
        }
        Btn {
            text: "Confirm";
            variant: "primary";
            enabled: first.text != "" && second.text != "" && third.text != "";
            clicked => { root.submit(); }
        }
    }

    // Hand the words over and blank the fields in the same callback, exactly as
    // the passphrase inputs do.
    function submit() {
        if (first.text == "" || second.text == "" || third.text == "") { return; }
        Actions.confirm-phrase(first.text, second.text, third.text);
        first.text = "";
        second.text = "";
        third.text = "";
    }
}

// Showing a recovery phrase — the highest-consequence screen in the wallet.
component BackupScreen inherits Rectangle {
    background: Theme.bg-base;

    VerticalLayout {
        alignment: center;
        spacing: Sp.s6;
        padding: Sp.s8;
        padding-left: Sp.s11;
        padding-right: Sp.s11;

        if SeedState.step == "passphrase": BackupPassphrase {
            closed => { root.close(); }
        }

        if SeedState.step == "phrase": BackupPhrase {
            closed => { root.close(); }
            written-down => {
                // Conceal before moving on: the next screen has no business
                // having the words sitting behind it.
                Actions.hide-phrase();
                SeedState.problem = "";
                SeedState.step = "verify";
            }
        }

        if SeedState.step == "verify" && SeedState.challenge.length == 3: BackupVerify {
            back => {
                SeedState.problem = "";
                SeedState.step = "phrase";
            }
        }
    }

    // Leaving without finishing. The key keeps its "not backed up" flag, so the
    // offer comes back — this abandons the attempt, it does not decline it
    // permanently.
    function close() {
        SeedState.problem = "";
        SeedState.step = "";
        Actions.cancel-backup();
    }
}

// ── The window ──────────────────────────────────────────────────────────────

// What a second copy of the wallet shows instead of a wallet.
//
// # Why this is a window rather than an exit
//
// Because the application was double-clicked. A process that starts, notices
// another one has the files, and exits silently is indistinguishable from one
// that crashed on launch — and a wallet that appears to crash is a wallet
// somebody starts hunting for their money in. It says what happened and closes
// when acknowledged.
//
// It shares the theme and the type scale and nothing else. In particular it
// touches no `WalletState`: there is no core behind this window, and it must be
// constructible before anything has been opened.
export component AlreadyRunning inherits Window {
    title: "Pecu";
    background: Theme.bg-base;
    default-font-family: Typo.ui;
    default-font-size: Typo.body;
    width: 460px;
    height: 260px;

    callback dismissed();

    VerticalLayout {
        padding: Sp.s8;
        spacing: Sp.s5;
        alignment: center;

        Text {
            text: "Pecu is already open";
            font-size: Typo.title2;
            font-weight: Typo.w-bold;
            color: Theme.text-primary;
            horizontal-alignment: center;
        }
        Text {
            text: "Only one copy at a time can use this wallet. Two would each keep their own idea of what has been sent and what is waiting, and the last one to write would win — including for a name registration that has already been paid for.";
            font-size: Typo.caption;
            color: Theme.text-secondary;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: center;
            Btn {
                text: "Close";
                variant: "primary";
                clicked => { root.dismissed(); }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Pecu";
    background: Theme.bg-base;
    // Set once, here, so every element that leaves `font-family` unset gets the
    // bundled face rather than whatever the platform happens to have.
    default-font-family: Typo.ui;
    default-font-size: Typo.body;
    // The design names 960×600 as the floor and 1060×640 as its reference. The
    // floor is taken as given; the default is larger, because the reference was
    // drawn with a phone's type scale in it and this interface uses a desktop
    // one — see `Typo`. Below the floor the layout is meant to fall back to the
    // two-column arrangement, which is not built yet.
    min-width: 960px;
    min-height: 600px;
    preferred-width: 1240px;
    preferred-height: 800px;

    in-out property <string> screen: "dashboard";

    // Which part of Settings is showing. See `SettingsScreen`.
    //
    // On the window rather than in a global, for the same reason `screen` is:
    // it is navigation, not wallet state, and a fixture has to be able to put
    // the window into it. Before this existed, three of the four Settings
    // reference images were the same picture of the top of one long page.
    in-out property <int> settings-tab: 0;

    // Whether the nav rail shows labels.
    //
    // Deliberately a STORED property updated by a `changed` handler, not a
    // binding on `root.width`. Binding it would make the rail's width depend on
    // the window width, which the horizontal layout is itself computing — a
    // binding loop that Slint now warns about and that it says "may cause panic
    // at runtime". A wallet must not have one of those. The `changed` callback
    // fires outside layout resolution, so the cycle is broken.
    in-out property <bool> nav-expanded: true;

    // Glyphs are restricted to characters the macOS system font actually
    // carries. `◈` and `◌` rendered as empty boxes and `⚙` came out as a
    // colour emoji — all three only visible in a screenshot, not in the source.
    // A real icon set (Path commands) replaces these later; until then the rule
    // is: nothing here that has ever rendered as a box.
    property <[NavItem]> nav: [
        { id: "dashboard", label: "Dashboard", icon: "wallet",     enabled: true, badge: "" },
        { id: "send",      label: "Send",      icon: "send",       enabled: true, badge: "" },
        { id: "receive",   label: "Receive",   icon: "receive",    enabled: true, badge: "" },
        { id: "activity",  label: "Activity",  icon: "history",    enabled: true, badge: "" },
        { id: "nodes",     label: "Network",   icon: "network",    enabled: true, badge: "" },
        { id: "identities",label: "Identities",icon: "profile",    enabled: true, badge: "" },
        { id: "currencies",label: "Currencies",icon: "currency",   enabled: true, badge: "" },
        { id: "settings",  label: "Settings",  icon: "settings",   enabled: true, badge: "" },
    ];

    // Before anything else: if there is no wallet, or it is locked, that is the
    // only thing on screen. A dashboard behind a lock screen is a dashboard
    // showing numbers nobody has authenticated for.
    in-out property <bool> restoring: false;

    // Navigating is two statements — what the window shows, and telling the
    // core which screen is open so it can start or stop screen-scoped polling.
    // Both have to happen together, from the rail and from the keyboard alike.
    function go(screen: string) {
        root.screen = screen;
        Actions.navigate(screen);
    }

    // Keyboard shortcuts, and the switch that turns focus rings on.
    //
    // # Why this ENCLOSES the interface rather than sitting beside it
    //
    // Slint delivers a key to the focused element first and offers it to an
    // ANCESTOR only when that element rejects it. A scope declared as a sibling
    // would never see a key at all; one declared as an ancestor sees exactly
    // what nothing else wanted. So a text field keeps every character somebody
    // types, and only the command-modified keys and Escape reach here — a
    // grabbing scope would eat the letter `l` out of a passphrase.
    //
    // Nothing in here can spend or reveal anything. `⌘L` locks, which is the
    // safe direction; there is deliberately no shortcut that unlocks, sends, or
    // shows a recovery phrase.
    // Whether the wallet's own screens are showing, as opposed to the unlock
    // form or the backup screen.
    //
    // Watched rather than merely used, because the swap DESTROYS whatever had
    // focus — the passphrase field, on the way in — and Slint responds to a
    // focused item disappearing by setting focus to nothing at all. From that
    // moment there is no chain for a key to travel up and no shortcut works,
    // which is exactly what unlocking used to do to them.
    property <bool> shell-showing: WalletState.exists && !WalletState.locked
        && SeedState.step == "";
    changed shell-showing => {
        root.focus-shortcuts();
    }

    // Called from Rust after the window is shown — see `main`. There is no way
    // to reach a nested element from outside the component, so the component
    // has to offer one.
    public function focus-shortcuts() {
        shortcuts.focus();
    }

    // How big the window is, remembered.
    //
    // Debounced, because a drag produces a resize event per frame and each one
    // would otherwise be a message to the core and a row written to SQLite.
    // Half a second after somebody stops dragging is the same answer for a
    // fraction of the writes.
    //
    // Size only, never position. A window restored to coordinates from a
    // different monitor arrangement opens off-screen, and this application has
    // no way to ask what monitors exist — so the failure mode is a wallet
    // nobody can see, in exchange for a convenience nobody asks for.
    remember := Timer {
        interval: 500ms;
        running: false;
        triggered => {
            self.running = false;
            Actions.remember-window(root.width / 1px, root.height / 1px);
        }
    }
    changed width => {
        // Both things a width change means, in one handler because Slint allows
        // exactly one per property. The rail is decided immediately; the size is
        // written down once the dragging stops.
        root.nav-expanded = root.width > 1000px;
        remember.running = false;
        remember.running = true;
    }
    changed height => {
        remember.running = false;
        remember.running = true;
    }

    shortcuts := FocusScope {
        width: 100%;
        height: 100%;

        // Focused at startup so the shortcuts work before anything has been
        // clicked. Focus moves away the moment a field or a button takes it,
        // and the shortcuts keep working because keys bubble back up here.
        //
        // `init` alone is not enough in a real window. It runs when the
        // component is built, and the windowing backend sets up focus when the
        // window is *shown* — which is afterwards, and which leaves nothing
        // focused. With no focus item Slint's delivery loop has no chain to
        // walk, so no scope sees a key at all; Tab still works because the
        // window handles that itself, after the loop. That is exactly the shape
        // of "only Tab does anything".
        init => { shortcuts.focus(); }

        // Any click that lands on nothing else puts keyboard focus back here.
        //
        // Declared FIRST, so it is underneath everything: later siblings get a
        // pointer event before earlier ones, and a click on a button or a field
        // never reaches this. Only a click on bare background does.
        //
        // It exists because focus can end up nowhere — the window can be active
        // with no focus item, and Slint's key delivery starts at the focused
        // item and walks up, so with none there is no chain and no scope hears
        // anything. Rather than reason about every route into that state, any
        // click on the window puts it back.
        TouchArea {
            clicked => {
                InputMode.keyboard = false;
                shortcuts.focus();
            }
        }

        key-pressed(event) => {
            // The first key press is what says a keyboard is in use. From here
            // focus rings render, until a pointer press says otherwise.
            InputMode.keyboard = true;

            // Both, and on macOS that is not belt-and-braces.
            //
            // Slint's winit backend swaps them on Apple platforms — Command
            // arrives as `control` and the physical Control key as `meta`,
            // deliberately, to match Qt. So `control` is the ⌘ case there and
            // the Ctrl case everywhere else, which is exactly the primary
            // modifier on each. Checking only `meta` would have made every
            // shortcut here dead on a Mac.
            if (event.modifiers.control || event.modifiers.meta) {
                if (event.text == "1") { root.go("dashboard"); return EventResult.accept; }
                if (event.text == "2") { root.go("send"); return EventResult.accept; }
                if (event.text == "3") { root.go("receive"); return EventResult.accept; }
                if (event.text == "4") { root.go("activity"); return EventResult.accept; }
                if (event.text == "5") { root.go("nodes"); return EventResult.accept; }
                if (event.text == "6") { root.go("identities"); return EventResult.accept; }
                if (event.text == "7") { root.go("currencies"); return EventResult.accept; }
                if (event.text == ",") { root.go("settings"); return EventResult.accept; }
                // Slint reports the character produced, and `⌘L` without shift
                // produces a lower-case `l`.
                if (event.text == "l") { Actions.lock(); return EventResult.accept; }
                if (event.text == "r") { Actions.refresh(); return EventResult.accept; }
            }

            // Escape closes whatever is over the screen, innermost first.
            if (event.text == Key.Escape) {
                // First of all, because it is opened from a form that Escape
                // also closes — and shutting the form out from under the picker
                // would leave the picker writing into a row nobody can see.
                if (CurrencyState.picking-reserve >= 0) {
                    CurrencyState.picking-reserve = -1;
                    CurrencyState.choices-query = "";
                    return EventResult.accept;
                }
                if (TxState.txid != "") {
                    TxState.txid = "";
                    return EventResult.accept;
                }
                if (IdentityState.address != "") {
                    Actions.close-identity();
                    return EventResult.accept;
                }
                // Below the sheet in this chain, because a sheet opened from
                // this screen sits on top of the form and Escape should shut
                // what is in front. Not offered while a claim is running: the
                // panel is not a form to dismiss, it is a deadline.
                if (IdentityState.claiming && IdentityState.reg-step == "") {
                    IdentityState.claiming = false;
                    // Back to the first question, and with the second one
                    // unanswered. A form reopened later must not start halfway
                    // through somebody else's answers — and least of all with
                    // the authority step already ticked.
                    IdentityState.claim-step = "name";
                    IdentityState.claim-authority = "";
                    return EventResult.accept;
                }
                if (CurrencyState.defining) {
                    CurrencyState.defining = false;
                    // Back to the first question, with the one that has no
                    // default unanswered. A form reopened later must not start
                    // halfway through somebody else's answers — and least of all
                    // on the review.
                    CurrencyState.form-step = "kind";
                    CurrencyState.new-authority = "";
                    return EventResult.accept;
                }
                if (SendState.step != "form") {
                    SendState.step = "form";
                    return EventResult.accept;
                }
            }

            return EventResult.reject;
        }

        if !WalletState.exists || WalletState.locked: Onboarding {
            restoring <=> root.restoring;
            mode: WalletState.exists ? "unlock" : "create";
            wallet-name: WalletState.name;
            busy: WalletState.busy;
            problem: WalletState.problem;
        }

        // And before the shell too: a phrase on screen is the only thing that
        // should be on screen. Nothing behind it is worth the risk of a stray
        // click landing somewhere else while 24 words are visible.
        if WalletState.exists && !WalletState.locked && SeedState.step != "": BackupScreen {}

        if WalletState.exists && !WalletState.locked && SeedState.step == "": HorizontalLayout {
            NavRail {
                items: root.nav;
                active: root.screen;
                // Below ~1000px the rail collapses to glyphs so the content column
                // keeps its shape rather than being squeezed. See `nav-expanded`.
                expanded: root.nav-expanded;
                selected(id) => { root.go(id); }
            }

            VerticalLayout {
                TitleBar {
                    title: root.screen == "dashboard" ? "Dashboard"
                        : root.screen == "nodes" ? "Network"
                        : root.screen == "receive" ? "Receive"
                        : root.screen == "send" ? "Send"
                        : root.screen == "settings" ? "Settings"
                        : root.screen == "activity" ? "Activity"
                        : root.screen == "identities" ? "Identities"
                        : root.screen == "currencies" ? "Currencies"
                        : root.screen;
                    network: NetworkState.effective;
                    node-state: NetworkState.node-state;
                    mock-mode: NetworkState.mock-mode;
                    busy: WalletState.busy;
                    can-refresh: true;
                    toggle-theme => { Actions.toggle-theme(); }
                    lock => { Actions.lock(); }
                    refresh => { Actions.refresh(); }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.bg-base;
                    clip: true;

                    // Activity brings its own scroller — see `ActivityScreen`.
                    // Beside the shared one rather than inside it, because two
                    // scrollers stacked over the same area fight over the wheel
                    // and the outer one wins.
                    if root.screen == "activity": ActivityScreen {}

                    if root.screen != "activity": Flickable {
                        viewport-height: content.preferred-height;

                        content := VerticalLayout {
                            padding: Sp.screen-pad;
                            // Caps line length on a wide display. Cards that
                            // stretch to 2000px read as a dashboard, not a product.
                            max-width: Sp.content-max;

                            if root.screen == "dashboard": DashboardScreen {}
                            if root.screen == "send": SendScreen {}
                            if root.screen == "identities": IdentitiesScreen {}
                            if root.screen == "currencies": CurrenciesScreen {}
                            if root.screen == "receive": ReceiveScreen {}
                            if root.screen == "settings": SettingsScreen {
                                tab <=> root.settings-tab;
                            }
                            if root.screen == "nodes": NodesScreen {}
                            if root.screen != "dashboard" && root.screen != "nodes"
                                && root.screen != "receive" && root.screen != "send"
                                && root.screen != "settings" && root.screen != "activity"
                                && root.screen != "identities"
                                && root.screen != "currencies": ComingSoon {
                                title: "Not built yet";
                                body: "This part of the wallet is still being written.";
                            }
                        }
                    }
                }

                // Pinned under the scroller, above the status bar, and only
                // while a form that spends money is open. Outside the
                // `Flickable` on purpose — see `ActionBar`.
                if root.screen == "currencies" && WalletState.exists && !WalletState.locked
                    && CurrencyState.defining: ActionBar {
                    // What it costs, always, on every step — the figure that
                    // decides whether to go on should not appear only on the
                    // screen where it is too late to matter. On the path that
                    // claims a name this is two fees charged by two
                    // transactions, and naming one of them would understate the
                    // press by the larger half.
                    cost: CurrencyState.fee == ""
                        ? "The fee is not known yet"
                        : CurrencyState.claiming && CurrencyState.new-name-fee != ""
                            ? "The name costs " + CurrencyState.new-name-fee + " " + WalletState.ticker
                                + " and the launch " + CurrencyState.fee + " " + WalletState.ticker
                            : CurrencyState.fee + " " + WalletState.ticker + " · half of it burned";
                    // Why the button is off, per step, because per step there is
                    // exactly one answer missing. Only the last two steps quote a
                    // count: by then the sentences are on screen beside the
                    // fields they are about, and repeating one here would put
                    // half a problem in two places.
                    note: CurrencyState.form-step == "kind"
                        ? "Nothing is spent yet."
                        : CurrencyState.form-step == "under"
                            ? (CurrencyState.claiming
                                ? (CurrencyState.new-name == ""
                                    ? "Type a name to continue"
                                    : CurrencyState.new-name-problem != ""
                                        ? CurrencyState.new-name-problem
                                        : "Nothing is spent yet.")
                                : CurrencyState.identity == ""
                                    ? "Choose an identity, or claim a new name."
                                    : "Nothing is spent yet.")
                            : CurrencyState.form-step == "authority"
                                ? (CurrencyState.new-authority == ""
                                    ? "Choose one. This cannot be changed for free later."
                                    : CurrencyState.new-authority == "other"
                                        && CurrencyState.new-recovery == ""
                                        ? "Name the recovery authority, or choose the other answer."
                                        : "Nothing is spent yet.")
                                : CurrencyState.blocking-count > 0
                                    ? (CurrencyState.blocking-count == 1
                                        ? "1 thing to fix, above"
                                        : CurrencyState.blocking-count + " things to fix, above")
                                    : CurrencyState.form-step == "setup"
                                        ? "Nothing is spent yet."
                                        // Not the same sentence on both paths.
                                        // Under an identity that exists, the
                                        // next screen is a review and nothing
                                        // has been spent when it appears.
                                        // Claiming a name broadcasts a
                                        // registration on this press — "nothing
                                        // is blocking it" is true and reads as
                                        // reassurance, which is the wrong note
                                        // above a button that spends a hundred
                                        // coins.
                                        : CurrencyState.claiming
                                            ? "This press claims the name and pays for it. The launch is reviewed after."
                                            : "Nothing is blocking it. The next screen is a review — nothing is spent yet.";
                    note-bad: CurrencyState.form-step == "under"
                        ? (CurrencyState.claiming
                            ? CurrencyState.new-name-problem != ""
                            : false)
                        : CurrencyState.form-step == "authority"
                            ? CurrencyState.new-authority == ""
                            : CurrencyState.blocking-count > 0;
                    back-text: CurrencyState.form-step == "kind" ? "Cancel" : "Back";
                    // Three different last presses, because they commit to
                    // different things. Under an identity that exists the last
                    // one signs and shows a review, and nothing has been spent
                    // when it appears. Claiming a name **broadcasts a
                    // registration** — real money, immediately. A button that
                    // said the same word for both would be describing the safe
                    // one.
                    primary-text: CurrencyState.form-step != "review"
                        ? "Next"
                        : CurrencyState.claiming
                            ? "Claim the name and start"
                            : "Review the launch";
                    // Each step gates on its own answer. The last two gate on
                    // the core's verdict — warnings do not count, they are
                    // things to read rather than things to fix.
                    primary-enabled: CurrencyState.form-step == "kind"
                        ? true
                        : CurrencyState.form-step == "under"
                            ? (CurrencyState.claiming
                                ? (CurrencyState.new-name != "" && CurrencyState.new-name-problem == "")
                                : CurrencyState.identity != "")
                            : CurrencyState.form-step == "authority"
                                ? (CurrencyState.new-authority == "none"
                                    || (CurrencyState.new-authority == "other"
                                        && CurrencyState.new-recovery != ""))
                                : CurrencyState.ready
                                    && (!CurrencyState.claiming
                                        || CurrencyState.new-name-problem == "");
                    back => {
                        if (CurrencyState.form-step == "review") {
                            CurrencyState.form-step = "setup";
                        } else if (CurrencyState.form-step == "setup") {
                            CurrencyState.form-step = CurrencyState.claiming ? "authority" : "under";
                        } else if (CurrencyState.form-step == "authority") {
                            CurrencyState.form-step = "under";
                        } else if (CurrencyState.form-step == "under") {
                            CurrencyState.form-step = "kind";
                        } else {
                            CurrencyState.defining = false;
                            CurrencyState.new-authority = "";
                        }
                    }
                    primary => {
                        if (CurrencyState.form-step == "kind") {
                            CurrencyState.form-step = "under";
                        } else if (CurrencyState.form-step == "under") {
                            CurrencyState.form-step = CurrencyState.claiming ? "authority" : "setup";
                        } else if (CurrencyState.form-step == "authority") {
                            CurrencyState.form-step = "setup";
                        } else if (CurrencyState.form-step == "setup") {
                            CurrencyState.form-step = "review";
                            // The review reads the preview, the fee and the
                            // transaction list off the last check. Asked again
                            // on the way in so that a debounce still in flight
                            // cannot leave a stale figure on the one screen that
                            // exists to be read.
                            Actions.check-currency();
                        } else if (CurrencyState.claiming) {
                            Actions.start-currency-from-new-name();
                        } else {
                            Actions.prepare-launch();
                        }
                    }
                }

                // The same bar, for the other form that spends money. Three
                // questions, and only the last press costs anything — so the
                // primary says "Next" until it does not.
                if root.screen == "identities" && WalletState.exists && !WalletState.locked
                    && IdentityState.claiming && IdentityState.reg-step == "": ActionBar {
                    cost: IdentityState.name-fee == ""
                        ? "The fee is not known yet"
                        : IdentityState.name-fee + " " + WalletState.ticker + " · in two transactions";
                    note: IdentityState.claim-step == "name"
                        ? (IdentityState.name-draft == ""
                            ? "Type a name to continue"
                            : IdentityState.name-problem != ""
                                ? IdentityState.name-problem
                                : "Nothing is spent yet.")
                        : IdentityState.claim-step == "authority"
                            ? (IdentityState.claim-authority == ""
                                ? "Choose one. This cannot be changed for free later."
                                : IdentityState.claim-authority == "other"
                                    && IdentityState.recovery-draft == ""
                                    ? "Name the recovery authority, or choose the other answer."
                                    : "Nothing is spent yet.")
                            : "This press signs and sends the first transaction.";
                    note-bad: IdentityState.claim-step == "name"
                        ? IdentityState.name-problem != ""
                        : IdentityState.claim-step == "authority" && IdentityState.claim-authority == "";
                    back-text: IdentityState.claim-step == "name" ? "Cancel" : "Back";
                    primary-text: IdentityState.claim-step == "review"
                        ? (IdentityState.reg-busy ? "Working…" : "Claim this name")
                        : "Next";
                    primary-enabled: IdentityState.claim-step == "name"
                        ? (IdentityState.name-draft != "" && IdentityState.name-problem == "")
                        : IdentityState.claim-step == "authority"
                            ? (IdentityState.claim-authority == "none"
                                || (IdentityState.claim-authority == "other"
                                    && IdentityState.recovery-draft != ""))
                            : !IdentityState.reg-busy;
                    back => {
                        if (IdentityState.claim-step == "review") {
                            IdentityState.claim-step = "authority";
                        } else if (IdentityState.claim-step == "authority") {
                            IdentityState.claim-step = "name";
                        } else {
                            IdentityState.claiming = false;
                            IdentityState.claim-authority = "";
                        }
                    }
                    primary => {
                        if (IdentityState.claim-step == "name") {
                            IdentityState.claim-step = "authority";
                        } else if (IdentityState.claim-step == "authority") {
                            IdentityState.claim-step = "review";
                        } else {
                            Actions.start-registration(
                                IdentityState.name-draft,
                                IdentityState.revocation-draft,
                                IdentityState.recovery-draft,
                            );
                        }
                    }
                }

                StatusBar {
                    tip: NetworkState.tip;
                    latency: NetworkState.latency;
                    endpoint: NetworkState.endpoint;
                    sdk-rev: AppInfo.sdk-rev;
                    syncing: NetworkState.syncing;
                }
            }
        }

        // Over everything, including the nav rail: a detail sheet that left the
        // rail clickable would let someone navigate away from a transaction they
        // are in the middle of reading.
        if WalletState.exists && !WalletState.locked && SeedState.step == ""
            && TxState.txid != "": TxSheet {}

        // Same rule as the transaction sheet: open exactly when the address is
        // non-empty, over everything including the nav rail — navigating away
        // from an identity somebody is reading is not a thing to allow by
        // accident.
        if WalletState.exists && !WalletState.locked && SeedState.step == ""
            && IdentityState.address != "": IdentitySheet {}

        // Above the sheet: the last moment before something irreversible.
        if WalletState.exists && !WalletState.locked && IdentityState.change-ticket != 0:
            IdentityChangeReview {}

        if WalletState.exists && !WalletState.locked && CurrencyState.launch-ticket != 0:
            LaunchReview {}

        // Above the form it writes into, and below nothing: it is opened from
        // the form and it is the only thing being decided while it is up.
        if WalletState.exists && !WalletState.locked && CurrencyState.picking-reserve >= 0:
            ReservePicker {}

        // Above even the phrase screen. A recovery phrase being on screen does
        // not make a rejected payment less worth knowing about, and the toast
        // sits in a corner rather than over the words.
        if ToastState.rows.length > 0: ToastHost {
            width: 100%;
            height: 100%;
        }
    }
}
