// The compile root.
//
// `build.rs` hands this one file to `slint-build`; everything else is reached
// from here, so there is a single place where the component tree starts.
//
// # Why it is only two windows now
//
// It used to be all of them — 9 836 lines, every screen, every overlay and
// every global. Slint generates one Rust file from this tree, and past about
// nine thousand lines of `.slint` the code generator and then `rustc` became
// the slowest part of every build: a one-line change to a colour cost minutes.
//
// So the screens live in `screens/`, the shared pieces in `components/`, and
// the state in `vm/state.slint`. **Nothing moved but the text** — the split was
// checked by re-rendering all 112 reference images and finding them identical,
// which is the only assurance worth having for a change of this shape.
//
// # The one thing taken from the standard widget set, and taken by name
//
// `ListView` is the only element in Slint that builds just the rows somebody can
// see. Everything else here is drawn from scratch on this project's own tokens —
// but there is no lower-level virtualising repeater to build on, and a plain
// `for` over a real transaction history costs 2.9 seconds of frozen UI thread at
// fifty thousand rows (`examples/scroll_cost.rs`).
//
// Imported by name rather than wholesale: `std-widgets.slint` exports `Palette`,
// which collides with this project's own theme global.
import { ListView } from "std-widgets.slint";
import { Theme, Sp, R, Typo, Motion, InputMode } from "theme/theme.slint";
import { Btn, Card, Eyebrow, Money, StatusPill, Skeleton, EmptyState, ListRow, Segmented } from "components/base.slint";
import { NavRail, TitleBar, StatusBar } from "components/shell.slint";
import { AppIcon } from "icon.slint";
import { Icon } from "components/icons.slint";
import { NavItem, NodeRow, KeyRow, KnownAddressRow, AssetRow, ActivityRow, SeedWord, ReviewOutput, PendingRow, ToastRow, IdentityRow, ContentEntry, CurrencyRow, EligibleIdentity, CurrencySlice, CurrencyField, CurrencyProblem, FlowStep, ReserveEntry, PreallocEntry, CurrencyPick, SearchHit, MarketRow, Venue, Stat } from "vm/structs.slint";
import { WalletState, SeedState, SendState, CurrencyState, IdentityState, TxState, NetworkState, ChartState, ActivityState, ConvertState, MarketState, SearchState, ToastState, AppInfo, Actions } from "vm/state.slint";
import { CommandPalette, ToastHost, ComingSoon } from "components/overlay.slint";
import { Onboarding, BackupScreen } from "screens/onboarding.slint";
import { DashboardScreen } from "screens/dashboard.slint";
import { NodesScreen } from "screens/network.slint";
import { SendScreen } from "screens/send.slint";
import { SettingsScreen } from "screens/settings.slint";
import { ActivityScreen, TxSheet } from "screens/activity.slint";
import { IdentitiesScreen, IdentityChangeReview, IdentitySheet } from "screens/identities.slint";
import { CurrenciesScreen, LaunchReview, ReservePicker, ActionBar } from "screens/currencies.slint";
import { MarketsScreen } from "screens/markets.slint";
import { ConvertPicker, ConvertScreen } from "screens/convert.slint";
import { ReceiveScreen } from "screens/receive.slint";

// Re-exported from the compile root so `slint-build` generates Rust types for
// them. A type or global that is only imported here stays invisible to Rust —
// `Theme` has to be reachable so the binary can flip dark/light, and every
// global below is written to by `bridge.rs`.
export { NavItem, NodeRow, KeyRow, KnownAddressRow, AssetRow, ActivityRow, SeedWord, ReviewOutput, PendingRow, ToastRow, IdentityRow, ContentEntry, CurrencyRow, EligibleIdentity, CurrencySlice, CurrencyField, CurrencyProblem, FlowStep, ReserveEntry, PreallocEntry, CurrencyPick, SearchHit, MarketRow, Venue, Stat }
export { Theme, Motion, InputMode }
export { WalletState, SeedState, SendState, CurrencyState, IdentityState, TxState, NetworkState, ChartState, ActivityState, ConvertState, MarketState, SearchState, ToastState, AppInfo, Actions }
// Rendered to a PNG by `examples/render_icon.rs`, never shown. Exported from
// here because this file is the one compile root — see `build.rs`.
export { AppIcon }

// What a second copy of the wallet shows instead of a wallet.
//
// # Why this is a window rather than an exit
//
// Because the application was double-clicked. A process that starts, notices
// another one has the files, and exits silently is indistinguishable from one
// that crashed on launch — and a wallet that appears to crash is a wallet
// somebody starts hunting for their money in. It says what happened and closes
// when acknowledged.
//
// It shares the theme and the type scale and nothing else. In particular it
// touches no `WalletState`: there is no core behind this window, and it must be
// constructible before anything has been opened.
export component AlreadyRunning inherits Window {
    // The application's own name — the same word in every language, and what a
    // window manager and a task switcher match on.
    title: "Pecu";
    background: Theme.bg-base;
    default-font-family: Typo.ui;
    default-font-size: Typo.body;
    width: 460px;
    height: 260px;

    callback dismissed();

    VerticalLayout {
        padding: Sp.s8;
        spacing: Sp.s5;
        alignment: center;

        Text {
            text: @tr("Pecu is already open");
            font-size: Typo.title2;
            font-weight: Typo.w-bold;
            color: Theme.text-primary;
            horizontal-alignment: center;
        }
        Text {
            text: @tr("Only one copy at a time can use this wallet. Two would each keep their own idea of what has been sent and what is waiting, and the last one to write would win — including for a name registration that has already been paid for.");
            font-size: Typo.caption;
            color: Theme.text-secondary;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: center;
            Btn {
                text: @tr("Close");
                variant: "primary";
                clicked => { root.dismissed(); }
            }
        }
    }
}

export component AppWindow inherits Window {
    // The application's own name — the same word in every language, and what a
    // window manager and a task switcher match on.
    title: "Pecu";
    background: Theme.bg-base;
    // Set once, here, so every element that leaves `font-family` unset gets the
    // bundled face rather than whatever the platform happens to have.
    default-font-family: Typo.ui;
    default-font-size: Typo.body;
    // The design names 960×600 as the floor and 1060×640 as its reference. The
    // floor is taken as given; the default is larger, because the reference was
    // drawn with a phone's type scale in it and this interface uses a desktop
    // one — see `Typo`. Below the floor the layout is meant to fall back to the
    // two-column arrangement, which is not built yet.
    min-width: 960px;
    min-height: 600px;
    preferred-width: 1240px;
    preferred-height: 800px;

    in-out property <string> screen: "dashboard";

    // Which part of Settings is showing. See `SettingsScreen`.
    //
    // On the window rather than in a global, for the same reason `screen` is:
    // it is navigation, not wallet state, and a fixture has to be able to put
    // the window into it. Before this existed, three of the four Settings
    // reference images were the same picture of the top of one long page.
    in-out property <int> settings-tab: 0;

    // Whether the nav rail shows labels.
    //
    // Deliberately a STORED property updated by a `changed` handler, not a
    // binding on `root.width`. Binding it would make the rail's width depend on
    // the window width, which the horizontal layout is itself computing — a
    // binding loop that Slint now warns about and that it says "may cause panic
    // at runtime". A wallet must not have one of those. The `changed` callback
    // fires outside layout resolution, so the cycle is broken.
    in-out property <bool> nav-expanded: true;

    // Glyphs are restricted to characters the macOS system font actually
    // carries. `◈` and `◌` rendered as empty boxes and `⚙` came out as a
    // colour emoji — all three only visible in a screenshot, not in the source.
    // A real icon set (Path commands) replaces these later; until then the rule
    // is: nothing here that has ever rendered as a box.
    property <[NavItem]> nav: [
        // `id` and `icon` are names the code matches on and must never be
        // translated. `label` is the only thing here a person reads.
        { id: "dashboard", label: @tr("Dashboard"),  icon: "wallet",   enabled: true, badge: "" },
        { id: "markets",   label: @tr("Markets"),    icon: "markets",  enabled: true, badge: "" },
        { id: "convert",   label: @tr("Convert"),    icon: "convert",  enabled: true, badge: "" },
        { id: "send",      label: @tr("Send"),       icon: "send",     enabled: true, badge: "" },
        { id: "receive",   label: @tr("Receive"),    icon: "receive",  enabled: true, badge: "" },
        { id: "activity",  label: @tr("Activity"),   icon: "history",  enabled: true, badge: "" },
        { id: "nodes",     label: @tr("Network"),    icon: "network",  enabled: true, badge: "" },
        // "Profile", not "Identities", and the screen behind it is unchanged:
        // it is where you are, and where the other names you hold are listed.
        { id: "identities",label: @tr("Profile"),    icon: "profile",  enabled: true, badge: "" },
        { id: "currencies",label: @tr("Currencies"), icon: "currency", enabled: true, badge: "" },
        { id: "settings",  label: @tr("Settings"),   icon: "settings", enabled: true, badge: "" },
    ];

    // Which entry of `nav` the current screen is, or -1 for a screen that has
    // no rail entry of its own. Only ids appear here; see `TitleBar`'s `title`.
    property <int> nav-index:
          root.screen == "dashboard"  ? 0
        : root.screen == "markets"    ? 1
        : root.screen == "convert"    ? 2
        : root.screen == "send"       ? 3
        : root.screen == "receive"    ? 4
        : root.screen == "activity"   ? 5
        : root.screen == "nodes"      ? 6
        : root.screen == "identities" ? 7
        : root.screen == "currencies" ? 8
        : root.screen == "settings"   ? 9
        : -1;

    // Before anything else: if there is no wallet, or it is locked, that is the
    // only thing on screen. A dashboard behind a lock screen is a dashboard
    // showing numbers nobody has authenticated for.
    in-out property <bool> restoring: false;

    // Navigating is two statements — what the window shows, and telling the
    // core which screen is open so it can start or stop screen-scoped polling.
    // Both have to happen together, from the rail and from the keyboard alike.
    public function go(screen: string) {
        // The palette is a detour, not a place. Arriving somewhere means it has
        // done its job.
        SearchState.open = false;
        SearchState.query = "";
        root.screen = screen;
        Actions.navigate(screen);
    }

    // Keyboard shortcuts, and the switch that turns focus rings on.
    //
    // # Why this ENCLOSES the interface rather than sitting beside it
    //
    // Slint delivers a key to the focused element first and offers it to an
    // ANCESTOR only when that element rejects it. A scope declared as a sibling
    // would never see a key at all; one declared as an ancestor sees exactly
    // what nothing else wanted. So a text field keeps every character somebody
    // types, and only the command-modified keys and Escape reach here — a
    // grabbing scope would eat the letter `l` out of a passphrase.
    //
    // Nothing in here can spend or reveal anything. `⌘L` locks, which is the
    // safe direction; there is deliberately no shortcut that unlocks, sends, or
    // shows a recovery phrase.
    // Whether the wallet's own screens are showing, as opposed to the unlock
    // form or the backup screen.
    //
    // Watched rather than merely used, because the swap DESTROYS whatever had
    // focus — the passphrase field, on the way in — and Slint responds to a
    // focused item disappearing by setting focus to nothing at all. From that
    // moment there is no chain for a key to travel up and no shortcut works,
    // which is exactly what unlocking used to do to them.
    property <bool> shell-showing: WalletState.exists && !WalletState.locked
        && SeedState.step == "";
    changed shell-showing => {
        root.focus-shortcuts();
    }

    // Called from Rust after the window is shown — see `main`. There is no way
    // to reach a nested element from outside the component, so the component
    // has to offer one.
    public function focus-shortcuts() {
        shortcuts.focus();
    }

    // How big the window is, remembered.
    //
    // Debounced, because a drag produces a resize event per frame and each one
    // would otherwise be a message to the core and a row written to SQLite.
    // Half a second after somebody stops dragging is the same answer for a
    // fraction of the writes.
    //
    // Size only, never position. A window restored to coordinates from a
    // different monitor arrangement opens off-screen, and this application has
    // no way to ask what monitors exist — so the failure mode is a wallet
    // nobody can see, in exchange for a convenience nobody asks for.
    remember := Timer {
        interval: 500ms;
        running: false;
        triggered => {
            self.running = false;
            Actions.remember-window(root.width / 1px, root.height / 1px);
        }
    }
    changed width => {
        // Both things a width change means, in one handler because Slint allows
        // exactly one per property. The rail is decided immediately; the size is
        // written down once the dragging stops.
        root.nav-expanded = root.width > 1000px;
        remember.running = false;
        remember.running = true;
    }
    changed height => {
        remember.running = false;
        remember.running = true;
    }

    shortcuts := FocusScope {
        width: 100%;
        height: 100%;

        // Focused at startup so the shortcuts work before anything has been
        // clicked. Focus moves away the moment a field or a button takes it,
        // and the shortcuts keep working because keys bubble back up here.
        //
        // `init` alone is not enough in a real window. It runs when the
        // component is built, and the windowing backend sets up focus when the
        // window is *shown* — which is afterwards, and which leaves nothing
        // focused. With no focus item Slint's delivery loop has no chain to
        // walk, so no scope sees a key at all; Tab still works because the
        // window handles that itself, after the loop. That is exactly the shape
        // of "only Tab does anything".
        init => { shortcuts.focus(); }

        // Any click that lands on nothing else puts keyboard focus back here.
        //
        // Declared FIRST, so it is underneath everything: later siblings get a
        // pointer event before earlier ones, and a click on a button or a field
        // never reaches this. Only a click on bare background does.
        //
        // It exists because focus can end up nowhere — the window can be active
        // with no focus item, and Slint's key delivery starts at the focused
        // item and walks up, so with none there is no chain and no scope hears
        // anything. Rather than reason about every route into that state, any
        // click on the window puts it back.
        TouchArea {
            clicked => {
                InputMode.keyboard = false;
                shortcuts.focus();
            }
        }

        key-pressed(event) => {
            // The first key press is what says a keyboard is in use. From here
            // focus rings render, until a pointer press says otherwise.
            InputMode.keyboard = true;

            // Both, and on macOS that is not belt-and-braces.
            //
            // Slint's winit backend swaps them on Apple platforms — Command
            // arrives as `control` and the physical Control key as `meta`,
            // deliberately, to match Qt. So `control` is the ⌘ case there and
            // the Ctrl case everywhere else, which is exactly the primary
            // modifier on each. Checking only `meta` would have made every
            // shortcut here dead on a Mac.
            if (event.modifiers.control || event.modifiers.meta) {
                // In rail order, so the number is what somebody counts down to
                // rather than a second arrangement to learn.
                if (event.text == "1") { root.go("dashboard"); return EventResult.accept; }
                if (event.text == "2") { root.go("markets"); return EventResult.accept; }
                if (event.text == "3") { root.go("convert"); return EventResult.accept; }
                if (event.text == "4") { root.go("send"); return EventResult.accept; }
                if (event.text == "5") { root.go("receive"); return EventResult.accept; }
                if (event.text == "6") { root.go("activity"); return EventResult.accept; }
                if (event.text == "7") { root.go("nodes"); return EventResult.accept; }
                if (event.text == "8") { root.go("identities"); return EventResult.accept; }
                if (event.text == "9") { root.go("currencies"); return EventResult.accept; }
                if (event.text == ",") { root.go("settings"); return EventResult.accept; }
                // Slint reports the character produced, and `⌘L` without shift
                // produces a lower-case `l`.
                if (event.text == "l") { Actions.lock(); return EventResult.accept; }
                if (event.text == "r") { Actions.refresh(); return EventResult.accept; }
                // ⌘K. Opens empty every time — a palette that reopens holding
                // the last search is answering a question from a minute ago.
                if (event.text == "k") {
                    SearchState.query = "";
                    SearchState.search("");
                    SearchState.open = true;
                    return EventResult.accept;
                }
            }

            // Escape closes whatever is over the screen, innermost first.
            if (event.text == Key.Escape) {
                // Before everything else, because it is in front of everything
                // else.
                if (SearchState.open) {
                    SearchState.open = false;
                    SearchState.query = "";
                    return EventResult.accept;
                }
                // First of all, because it is opened from a form that Escape
                // also closes — and shutting the form out from under the picker
                // would leave the picker writing into a row nobody can see.
                if (CurrencyState.picking-reserve >= 0) {
                    CurrencyState.picking-reserve = -1;
                    CurrencyState.choices-query = "";
                    return EventResult.accept;
                }
                if (ConvertState.picking != "") {
                    ConvertState.picking = "";
                    return EventResult.accept;
                }
                if (TxState.txid != "") {
                    TxState.txid = "";
                    return EventResult.accept;
                }
                if (IdentityState.address != "") {
                    Actions.close-identity();
                    return EventResult.accept;
                }
                // Below the sheet in this chain, because a sheet opened from
                // this screen sits on top of the form and Escape should shut
                // what is in front. Not offered while a claim is running: the
                // panel is not a form to dismiss, it is a deadline.
                if (IdentityState.claiming && IdentityState.reg-step == "") {
                    IdentityState.claiming = false;
                    // Back to the first question, and with the second one
                    // unanswered. A form reopened later must not start halfway
                    // through somebody else's answers — and least of all with
                    // the authority step already ticked.
                    IdentityState.claim-step = "name";
                    IdentityState.claim-authority = "";
                    return EventResult.accept;
                }
                if (CurrencyState.defining) {
                    CurrencyState.defining = false;
                    // Back to the first question, with the one that has no
                    // default unanswered. A form reopened later must not start
                    // halfway through somebody else's answers — and least of all
                    // on the review.
                    CurrencyState.form-step = "kind";
                    CurrencyState.new-authority = "";
                    return EventResult.accept;
                }
                if (SendState.step != "form") {
                    SendState.step = "form";
                    return EventResult.accept;
                }
            }

            return EventResult.reject;
        }

        if !WalletState.exists || WalletState.locked: Onboarding {
            restoring <=> root.restoring;
            mode: WalletState.exists ? "unlock" : "create";
            wallet-name: WalletState.name;
            busy: WalletState.busy;
            problem: WalletState.problem;
        }

        // And before the shell too: a phrase on screen is the only thing that
        // should be on screen. Nothing behind it is worth the risk of a stray
        // click landing somewhere else while 24 words are visible.
        if WalletState.exists && !WalletState.locked && SeedState.step != "": BackupScreen {}

        if WalletState.exists && !WalletState.locked && SeedState.step == "": HorizontalLayout {
            NavRail {
                items: root.nav;
                active: root.screen;
                // Below ~1000px the rail collapses to icons so the content column
                // keeps its shape rather than being squeezed. See `nav-expanded`.
                expanded: root.nav-expanded;
                // The first name these keys control, which is what the design
                // draws at the foot of the rail. Empty until there is one — and
                // it stays empty for a wallet that has never claimed a name,
                // rather than showing a placeholder identity that does not
                // exist.
                account: IdentityState.rows.length > 0 ? IdentityState.rows[0].name : "";
                account-state: NetworkState.node-state;
                selected(id) => { root.go(id); }
            }

            VerticalLayout {
                TitleBar {
                    // Read out of `nav` rather than repeated.
                    //
                    // This was its own eight-way chain of the same eight words,
                    // which is two places to write every screen name and two
                    // places for them to drift. Translating the rail and not
                    // this is exactly how it was found: the navigation went
                    // German and the title bar stayed English.
                    //
                    // Slint has no way to search an array in an expression, so
                    // the *ids* are still listed here — but an id is matched by
                    // code and never translated, and the words now exist once.
                    title: root.nav-index >= 0 ? root.nav[root.nav-index].label
                        : root.screen;
                    network: NetworkState.effective;
                    node-state: NetworkState.node-state;
                    mock-mode: NetworkState.mock-mode;
                    busy: WalletState.busy;
                    can-refresh: true;
                    toggle-theme => { Actions.toggle-theme(); }
                    lock => { Actions.lock(); }
                    refresh => { Actions.refresh(); }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.bg-base;
                    clip: true;

                    // Activity brings its own scroller — see `ActivityScreen`.
                    // Beside the shared one rather than inside it, because two
                    // scrollers stacked over the same area fight over the wheel
                    // and the outer one wins.
                    if root.screen == "activity": ActivityScreen {}

                    if root.screen != "activity": Flickable {
                        viewport-height: content.preferred-height;

                        content := VerticalLayout {
                            padding: Sp.screen-pad;
                            // Caps line length on a wide display. Cards that
                            // stretch to 2000px read as a dashboard, not a product.
                            max-width: Sp.content-max;

                            if root.screen == "dashboard": DashboardScreen {
                                navigate(screen) => { root.go(screen); }
                            }
                            if root.screen == "send": SendScreen {}
                            if root.screen == "identities": IdentitiesScreen {}
                            if root.screen == "currencies": CurrenciesScreen {}
                            if root.screen == "markets": MarketsScreen {}
                            if root.screen == "convert": ConvertScreen {}
                            if root.screen == "receive": ReceiveScreen {}
                            if root.screen == "settings": SettingsScreen {
                                tab <=> root.settings-tab;
                            }
                            if root.screen == "nodes": NodesScreen {}
                            // Derived, not listed.
                            //
                            // This was a chain of eight `!=`, one per built
                            // screen, and adding Markets made it nine — which I
                            // duly forgot, so the new screen rendered with "Not
                            // built yet" underneath it.
                            //
                            // `nav-index` already answers the question: a screen
                            // in the rail is a screen that exists, and one that
                            // is not is `-1`. Rail entries for unbuilt areas are
                            // `enabled: false` and cannot be navigated to, so
                            // the two cannot disagree.
                            if root.nav-index < 0: ComingSoon {
                                title: @tr("Not built yet");
                                body: @tr("This part of the wallet is still being written.");
                            }
                        }
                    }
                }

                // Pinned under the scroller, above the status bar, and only
                // while a form that spends money is open. Outside the
                // `Flickable` on purpose — see `ActionBar`.
                if root.screen == "currencies" && WalletState.exists && !WalletState.locked
                    && CurrencyState.defining: ActionBar {
                    // What it costs, always, on every step — the figure that
                    // decides whether to go on should not appear only on the
                    // screen where it is too late to matter. On the path that
                    // claims a name this is two fees charged by two
                    // transactions, and naming one of them would understate the
                    // press by the larger half.
                    cost: CurrencyState.fee == ""
                        ? @tr("The fee is not known yet")
                        : CurrencyState.claiming && CurrencyState.new-name-fee != ""
                            ? @tr("The name costs {0} {1} and the launch {2} {1}",
                                  CurrencyState.new-name-fee, WalletState.ticker, CurrencyState.fee)
                            : @tr("{0} {1} · half of it burned",
                                  CurrencyState.fee, WalletState.ticker);
                    // Why the button is off, per step, because per step there is
                    // exactly one answer missing. Only the last two steps quote a
                    // count: by then the sentences are on screen beside the
                    // fields they are about, and repeating one here would put
                    // half a problem in two places.
                    note: CurrencyState.form-step == "kind"
                        ? @tr("Nothing is spent yet.")
                        : CurrencyState.form-step == "under"
                            ? (CurrencyState.claiming
                                ? (CurrencyState.new-name == ""
                                    ? @tr("Type a name to continue")
                                    : CurrencyState.new-name-problem != ""
                                        ? CurrencyState.new-name-problem
                                        : @tr("Nothing is spent yet."))
                                : CurrencyState.identity == ""
                                    ? @tr("Choose an identity, or claim a new name.")
                                    : @tr("Nothing is spent yet."))
                            : CurrencyState.form-step == "authority"
                                ? (CurrencyState.new-authority == ""
                                    ? @tr("Choose one. This cannot be changed for free later.")
                                    : CurrencyState.new-authority == "other"
                                        && CurrencyState.new-recovery == ""
                                        ? @tr("Name the recovery authority, or choose the other answer.")
                                        : @tr("Nothing is spent yet."))
                                : CurrencyState.blocking-count > 0
                                    ? @tr("{n} thing to fix, above"
                                          | "{n} things to fix, above"
                                          % CurrencyState.blocking-count)
                                    : CurrencyState.form-step == "setup"
                                        ? @tr("Nothing is spent yet.")
                                        // Not the same sentence on both paths.
                                        // Under an identity that exists, the
                                        // next screen is a review and nothing
                                        // has been spent when it appears.
                                        // Claiming a name broadcasts a
                                        // registration on this press — "nothing
                                        // is blocking it" is true and reads as
                                        // reassurance, which is the wrong note
                                        // above a button that spends a hundred
                                        // coins.
                                        : CurrencyState.claiming
                                            ? @tr("This press claims the name and pays for it. The launch is reviewed after.")
                                            : @tr("Nothing is blocking it. The next screen is a review — nothing is spent yet.");
                    note-bad: CurrencyState.form-step == "under"
                        ? (CurrencyState.claiming
                            ? CurrencyState.new-name-problem != ""
                            : false)
                        : CurrencyState.form-step == "authority"
                            ? CurrencyState.new-authority == ""
                            : CurrencyState.blocking-count > 0;
                    back-text: CurrencyState.form-step == "kind" ? @tr("Cancel") : @tr("Back");
                    // Three different last presses, because they commit to
                    // different things. Under an identity that exists the last
                    // one signs and shows a review, and nothing has been spent
                    // when it appears. Claiming a name **broadcasts a
                    // registration** — real money, immediately. A button that
                    // said the same word for both would be describing the safe
                    // one.
                    primary-text: CurrencyState.form-step != "review"
                        ? @tr("Next")
                        : CurrencyState.claiming
                            ? @tr("Claim the name and start")
                            : @tr("Review the launch");
                    // Each step gates on its own answer. The last two gate on
                    // the core's verdict — warnings do not count, they are
                    // things to read rather than things to fix.
                    primary-enabled: CurrencyState.form-step == "kind"
                        ? true
                        : CurrencyState.form-step == "under"
                            ? (CurrencyState.claiming
                                ? (CurrencyState.new-name != "" && CurrencyState.new-name-problem == "")
                                : CurrencyState.identity != "")
                            : CurrencyState.form-step == "authority"
                                ? (CurrencyState.new-authority == "none"
                                    || (CurrencyState.new-authority == "other"
                                        && CurrencyState.new-recovery != ""))
                                : CurrencyState.ready
                                    && (!CurrencyState.claiming
                                        || CurrencyState.new-name-problem == "");
                    back => {
                        if (CurrencyState.form-step == "review") {
                            CurrencyState.form-step = "setup";
                        } else if (CurrencyState.form-step == "setup") {
                            CurrencyState.form-step = CurrencyState.claiming ? "authority" : "under";
                        } else if (CurrencyState.form-step == "authority") {
                            CurrencyState.form-step = "under";
                        } else if (CurrencyState.form-step == "under") {
                            CurrencyState.form-step = "kind";
                        } else {
                            CurrencyState.defining = false;
                            CurrencyState.new-authority = "";
                        }
                    }
                    primary => {
                        if (CurrencyState.form-step == "kind") {
                            CurrencyState.form-step = "under";
                        } else if (CurrencyState.form-step == "under") {
                            CurrencyState.form-step = CurrencyState.claiming ? "authority" : "setup";
                        } else if (CurrencyState.form-step == "authority") {
                            CurrencyState.form-step = "setup";
                        } else if (CurrencyState.form-step == "setup") {
                            CurrencyState.form-step = "review";
                            // The review reads the preview, the fee and the
                            // transaction list off the last check. Asked again
                            // on the way in so that a debounce still in flight
                            // cannot leave a stale figure on the one screen that
                            // exists to be read.
                            Actions.check-currency();
                        } else if (CurrencyState.claiming) {
                            Actions.start-currency-from-new-name();
                        } else {
                            Actions.prepare-launch();
                        }
                    }
                }

                // The same bar, for the other form that spends money. Three
                // questions, and only the last press costs anything — so the
                // primary says "Next" until it does not.
                if root.screen == "identities" && WalletState.exists && !WalletState.locked
                    && IdentityState.claiming && IdentityState.reg-step == "": ActionBar {
                    cost: IdentityState.name-fee == ""
                        ? @tr("The fee is not known yet")
                        : @tr("{} {} · in two transactions",
                              IdentityState.name-fee, WalletState.ticker);
                    note: IdentityState.claim-step == "name"
                        ? (IdentityState.name-draft == ""
                            ? @tr("Type a name to continue")
                            : IdentityState.name-problem != ""
                                ? IdentityState.name-problem
                                : @tr("Nothing is spent yet."))
                        : IdentityState.claim-step == "authority"
                            ? (IdentityState.claim-authority == ""
                                ? @tr("Choose one. This cannot be changed for free later.")
                                : IdentityState.claim-authority == "other"
                                    && IdentityState.recovery-draft == ""
                                    ? @tr("Name the recovery authority, or choose the other answer.")
                                    : @tr("Nothing is spent yet."))
                            : @tr("This press signs and sends the first transaction.");
                    note-bad: IdentityState.claim-step == "name"
                        ? IdentityState.name-problem != ""
                        : IdentityState.claim-step == "authority" && IdentityState.claim-authority == "";
                    back-text: IdentityState.claim-step == "name" ? @tr("Cancel") : @tr("Back");
                    primary-text: IdentityState.claim-step == "review"
                        ? (IdentityState.reg-busy ? @tr("Working…") : @tr("Claim this name"))
                        : @tr("Next");
                    primary-enabled: IdentityState.claim-step == "name"
                        ? (IdentityState.name-draft != "" && IdentityState.name-problem == "")
                        : IdentityState.claim-step == "authority"
                            ? (IdentityState.claim-authority == "none"
                                || (IdentityState.claim-authority == "other"
                                    && IdentityState.recovery-draft != ""))
                            : !IdentityState.reg-busy;
                    back => {
                        if (IdentityState.claim-step == "review") {
                            IdentityState.claim-step = "authority";
                        } else if (IdentityState.claim-step == "authority") {
                            IdentityState.claim-step = "name";
                        } else {
                            IdentityState.claiming = false;
                            IdentityState.claim-authority = "";
                        }
                    }
                    primary => {
                        if (IdentityState.claim-step == "name") {
                            IdentityState.claim-step = "authority";
                        } else if (IdentityState.claim-step == "authority") {
                            IdentityState.claim-step = "review";
                        } else {
                            Actions.start-registration(
                                IdentityState.name-draft,
                                IdentityState.revocation-draft,
                                IdentityState.recovery-draft,
                            );
                        }
                    }
                }

                StatusBar {
                    tip: NetworkState.tip;
                    latency: NetworkState.latency;
                    endpoint: NetworkState.endpoint;
                    sdk-rev: AppInfo.sdk-rev;
                    syncing: NetworkState.syncing;
                }
            }
        }

        // Over everything, including the nav rail: a detail sheet that left the
        // rail clickable would let someone navigate away from a transaction they
        // are in the middle of reading.
        if WalletState.exists && !WalletState.locked && SeedState.step == ""
            && TxState.txid != "": TxSheet {}

        // Same rule as the transaction sheet: open exactly when the address is
        // non-empty, over everything including the nav rail — navigating away
        // from an identity somebody is reading is not a thing to allow by
        // accident.
        if WalletState.exists && !WalletState.locked && SeedState.step == ""
            && IdentityState.address != "": IdentitySheet {}

        // Above the sheet: the last moment before something irreversible.
        if WalletState.exists && !WalletState.locked && IdentityState.change-ticket != 0:
            IdentityChangeReview {}

        if WalletState.exists && !WalletState.locked && CurrencyState.launch-ticket != 0:
            LaunchReview {}

        // Above the form it writes into, and below nothing: it is opened from
        // the form and it is the only thing being decided while it is up.
        if WalletState.exists && !WalletState.locked && CurrencyState.picking-reserve >= 0:
            ReservePicker {}

        if WalletState.exists && !WalletState.locked && ConvertState.picking != "":
            ConvertPicker {}

        // Under the toasts and over everything else. It is a detour rather
        // than a state, so it never survives a screen change — see `go`.
        //
        // Not offered while the wallet is locked or absent: there is nothing
        // to search, and a palette over the unlock form is a way to lose the
        // field somebody was typing a passphrase into.
        if SearchState.open && WalletState.exists && !WalletState.locked: palette := CommandPalette {
            width: 100%;
            height: 100%;
            dismissed => {
                SearchState.open = false;
                SearchState.query = "";
            }
            init => { palette.take-focus(); }
        }

        // Above even the phrase screen. A recovery phrase being on screen does
        // not make a rejected payment less worth knowing about, and the toast
        // sits in a corner rather than over the words.
        if ToastState.rows.length > 0: ToastHost {
            width: 100%;
            height: 100%;
        }
    }
}
