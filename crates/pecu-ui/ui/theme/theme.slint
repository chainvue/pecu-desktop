// The two font families this interface is drawn in, embedded rather than
// assumed.
//
// `import "…ttf"` compiles the file into the binary and registers the family
// globally, so there is nothing to install and nothing to be missing. That is
// the whole point: the previous arrangement named "Menlo", which ships with
// macOS and exists nowhere else, so the design quietly forked per platform and
// nobody on this machine could ever see it happen.
//
// Both are SIL OFL 1.1 and redistributable. The licences sit beside them in
// `ui/fonts/` — the OFL requires them to travel with the fonts, and a licence
// somebody has to go and find is one that will not be there in the next copy.
import "../fonts/Inter-Regular.ttf";
import "../fonts/Inter-Medium.ttf";
import "../fonts/Inter-SemiBold.ttf";
import "../fonts/IBMPlexMono-Regular.ttf";
import "../fonts/IBMPlexMono-Medium.ttf";

// Design tokens. No call site anywhere else writes a raw hex value or a pixel
// constant — if you find yourself typing `#1A1D22` in a screen, add a token.
//
// Named `Theme`, not `Palette`: `Palette` is already exported by
// `std-widgets.slint` and the two collide.

export global Theme {
    // The only switch. Everything below derives from it, so a theme change is
    // one property write and every binding re-evaluates.
    in-out property <bool> dark: true;

    // ── Surfaces ────────────────────────────────────────────────────────
    // A three-step ladder, not a flat plane. `#0B0C0E` rather than pure black:
    // black kills the perception of soft radii and makes shadows invisible, so
    // a "premium dark" UI painted on #000 reads as cheap.
    out property <brush> bg-base:    dark ? #0B0C0E : #FBFBFC;
    out property <brush> bg-sunken:  dark ? #08090A : #F4F5F7;
    out property <brush> bg-surface: dark ? #121316 : #FFFFFF;
    out property <brush> bg-raised:  dark ? #17191D : #FFFFFF;
    out property <brush> bg-hover:   dark ? #1B1E22 : #F4F5F7;
    out property <brush> bg-active:  dark ? #212429 : #EDEEF1;
    out property <brush> bg-inset:   dark ? #0E0F12 : #F7F8F9;

    // Dark leans on hairlines, light leans on shadow. Using both in both
    // themes is what makes a UI look muddy.
    out property <brush> border-subtle:  dark ? #1F2227 : #EBECEF;
    out property <brush> border-default: dark ? #2A2E35 : #DDDFE4;
    out property <brush> border-strong:  dark ? #3A3F48 : #C3C7CE;
    out property <bool>  card-shadow: !dark;

    // ── Text ────────────────────────────────────────────────────────────
    // Never pure white on dark — #F2F3F5 is the ceiling. `tertiary` is the
    // contrast floor; nothing dimmer than it carries text.
    //
    // # The floor is measured now, not asserted
    //
    // This comment used to claim "roughly 4.6:1" for `tertiary`. It was not
    // true in either theme, and it was materially worse in light: the old
    // `#878D97` on `#FBFBFC` measures **3.27:1**, well under the 4.5:1 that
    // WCAG AA asks of normal text — and `tertiary` is not a rare colour here.
    // It carries the address under every list row, the whole status bar, and
    // most captions.
    //
    // Recomputed against each theme's own base, both now just over 4.6:1:
    //
    //   dark   #757B86 on #0B0C0E → 4.60:1
    //   light  #6E747E on #FBFBFC → 4.63:1
    //
    // `disabled` is deliberately below the floor and stays there — it is the
    // one role WCAG exempts, and raising it would make an inert control look
    // live.
    out property <brush> text-primary:   dark ? #F2F3F5 : #101114;
    out property <brush> text-secondary: dark ? #A0A5AE : #5C626C;
    out property <brush> text-tertiary:  dark ? #757B86 : #6E747E;
    out property <brush> text-disabled:  dark ? #4A4F58 : #AEB3BB;
    out property <brush> text-on-accent: #FFFFFF;

    // ── Accent ──────────────────────────────────────────────────────────
    // One accent, used sparingly. Tuned per theme: the same blue that reads
    // well on near-black is too pale on white.
    out property <brush> accent:        dark ? #4D7CFE : #2D62E8;
    out property <brush> accent-hover:  dark ? #6A92FF : #1F51D4;
    out property <brush> accent-active: dark ? #3C68E0 : #1A46B8;
    out property <brush> accent-soft:   dark ? #4D7CFE1F : #2D62E814;
    out property <brush> accent-ring:   dark ? #4D7CFE73 : #2D62E866;

    // ── Semantic ────────────────────────────────────────────────────────
    // Deliberately desaturated. #35C083 reads as information; #00FF88 reads as
    // a trading terminal, which is the thing this wallet is not.
    //
    // The dark set measures 6:1 to 9:1 and was always fine. The light set was
    // tuned by eye against a dark-first design and all three fell short of
    // 4.5:1 on white — warning worst at 3.7:1, which is the colour the maturing
    // balance is printed in. Darkened until each clears it:
    //
    //   positive #0F7B50 → 5.17:1   negative #C9333F → 5.09:1
    //   warning  #9F6413 → 4.77:1
    //
    // The `-soft` fills are backgrounds, not text, and keep their hue.
    out property <brush> positive:      dark ? #35C083 : #0F7B50;
    out property <brush> positive-soft: dark ? #35C0831F : #0F7B5014;
    out property <brush> negative:      dark ? #F0616D : #C9333F;
    out property <brush> negative-soft: dark ? #F0616D1F : #C9333F14;
    out property <brush> warning:       dark ? #E5A544 : #9F6413;
    out property <brush> warning-soft:  dark ? #E5A5441F : #9F641314;

    // ── The chart ───────────────────────────────────────────────────────
    // A `color`, not a `brush`, and that is load-bearing: `.with-alpha()` is a
    // method on `color`, and the area under the line is the accent faded to
    // nothing. A `brush` here would compile and then fail at the gradient.
    out property <color> chart-line: dark ? #4D7CFE : #2D62E8;
    // The line has to stay readable against the fill directly beneath it, so
    // the fill never gets close to the stroke's own weight.
    out property <color> chart-grid: dark ? #FFFFFF : #101114;
}

// 4px grid. If a value is not on it, it is a mistake or it needs a name.
export global Sp {
    out property <length> s1:  2px;
    out property <length> s2:  4px;
    out property <length> s3:  8px;
    out property <length> s4:  12px;
    out property <length> s5:  16px;
    out property <length> s6:  20px;
    out property <length> s7:  24px;
    out property <length> s8:  32px;
    out property <length> s9:  40px;
    out property <length> s10: 48px;
    out property <length> s11: 64px;

    out property <length> card-pad:    20px;
    out property <length> screen-pad:  32px;
    out property <length> section-gap: 32px;
    // Caps line length on a wide display. Cards that stretch to 2000px are
    // what make an app read as a "dashboard" rather than a product.
    out property <length> content-max: 1160px;
}

export global R {
    out property <length> xs:  4px;
    out property <length> sm:  6px;
    out property <length> md:  10px;
    out property <length> lg:  14px;
    out property <length> xl:  20px;
    out property <length> xxl: 28px;
    out property <length> full: 999px;
}

export global Typo {
    // The UI face. Bundled, so the interface is the same drawing on every
    // platform rather than SF Pro here and something else there.
    out property <string> ui: "Inter";

    // Money, addresses, txids and block heights are set in a MONOSPACE family,
    // and that is not decoration. Slint exposes no OpenType feature control, so
    // tabular figures cannot be requested on a proportional face — and with
    // proportional digits the balance jitters as it changes and amounts do not
    // line up in a column. A mono family solves both structurally.
    //
    // This said "Menlo" until the fonts were bundled. Menlo ships with macOS
    // and exists nowhere else, so every amount in this wallet rendered in some
    // other face on Linux and Windows — a difference invisible from here, which
    // is exactly the kind that survives to a release.
    out property <string> mono: "IBM Plex Mono";

    out property <length> hero:    44px;   // dashboard balance
    out property <length> title1:  28px;
    out property <length> title2:  22px;
    out property <length> title3:  17px;
    out property <length> body-lg: 16px;
    out property <length> body:    14px;
    out property <length> caption: 12px;
    out property <length> micro:   11px;

    out property <length> num-lg: 20px;
    out property <length> num:    14px;
    out property <length> num-sm: 12px;

    out property <int> w-regular:  400;
    out property <int> w-medium:   500;
    out property <int> w-semibold: 600;
}

// How the person in front of the window is driving it.
//
// # Why focus rings are conditional
//
// A focus ring is essential and it is also noise, depending entirely on who is
// looking. Someone navigating by keyboard cannot use the interface without one.
// Someone clicking has already said where they are with the pointer, and a ring
// left behind on the last thing they clicked reads as a stuck state.
//
// So the ring follows the *input mode* rather than the focus: `keyboard` goes
// true on the first key press and false on the next pointer press, and rings
// render only while it is true. Focus itself is never removed — only its
// decoration.
export global InputMode {
    in-out property <bool> keyboard: false;
}

export global Motion {
    // The reduce-motion master switch. Every `animate` block in this UI carries
    // `enabled: Motion.enabled;` — Slint 1.17 added that property, and it is
    // the whole mechanism: one line per animation, no duplicate code paths.
    in-out property <bool> enabled: true;

    out property <duration> instant: 80ms;    // press
    out property <duration> fast:    140ms;   // hover, focus ring
    out property <duration> base:    220ms;   // state change
    out property <duration> slow:    320ms;   // sheets, modals
    out property <duration> count:   900ms;   // balance count-up
    out property <duration> draw:    1100ms;  // chart draw-in
}
