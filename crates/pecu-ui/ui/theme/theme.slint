// The two font families this interface is drawn in, embedded rather than
// assumed.
//
// `import "…ttf"` compiles the file into the binary and registers the family
// globally, so there is nothing to install and nothing to be missing. That is
// the whole point: naming a face that ships with one operating system and
// nowhere else forks the design per platform, and the fork is invisible from
// the machine the design was drawn on.
//
// Both are SIL OFL 1.1 and redistributable. The licences sit beside them in
// `ui/fonts/` — the OFL requires them to travel with the fonts, and a licence
// somebody has to go and find is one that will not be there in the next copy.
//
// # Why the monospace is the "NL" cut
//
// JetBrains Mono ships two cuts. The default one carries the code ligatures the
// typeface is known for, in a `calt` feature with a 25 KB `GSUB` table — and
// `calt` is on by default in the shaper, so they are not opt-in. `JetBrainsMono
// NL` has **no `GSUB` table at all**; that was measured, not assumed.
//
// This interface prints node URLs, addresses, transaction ids and amounts in
// mono, and asks people to check them character by character. `://` and `//`
// are among the sequences the default cut contextually merges into a single
// glyph. A wallet that draws two characters as one, in the field somebody is
// verifying, has made the one mistake this typeface choice existed to avoid.
//
// Nothing else changes: the ligatures only fire on symbol runs, so digits,
// base58 and hex are the same drawing in both cuts.
import "../fonts/JetBrainsMonoNL-Regular.ttf";
import "../fonts/JetBrainsMonoNL-Medium.ttf";
import "../fonts/JetBrainsMonoNL-Bold.ttf";
import "../fonts/SpaceGrotesk-Regular.ttf";
import "../fonts/SpaceGrotesk-Medium.ttf";
import "../fonts/SpaceGrotesk-Bold.ttf";

// Design tokens. No call site anywhere else writes a raw hex value or a pixel
// constant — if you find yourself typing `#14181D` in a screen, add a token.
//
// Named `Theme`, not `Palette`: `Palette` is already exported by
// `std-widgets.slint` and the two collide.
//
// # Where these come from, and where they depart
//
// The values are `docs/design/pecu-tokens.json`. The dark set is taken as
// delivered — it was measured and every role clears WCAG AA. The light set is
// not: four of its colours fall under 4.5:1, and the worst of them is the label
// on the primary button. Each of those four is darkened along its own hue until
// it clears, and no further, so it is the same colour rather than a new one.
// The measurements are written beside the values; `docs/design/REVIEW.md` has
// the originals.
//
// Every ratio below was computed against the **worst** surface the colour
// actually sits on, which is not the same one in both themes: in dark that is
// the raised surface (lighter than the base), in light it is the base (darker
// than the surface).

export global Theme {
    // The only switch. Everything below derives from it, so a theme change is
    // one property write and every binding re-evaluates.
    in-out property <bool> dark: true;

    // ── Surfaces ────────────────────────────────────────────────────────
    // Ink, and a short ladder above it. The rail sits on the base rather than
    // below it — in this design it is separated by a hairline, not by a
    // different plane.
    out property <brush> bg-base:    dark ? #0B0D10 : #F4F6F8;
    out property <brush> bg-sunken:  dark ? #0B0D10 : #EEF1F4;
    out property <brush> bg-surface: dark ? #14181D : #FFFFFF;
    out property <brush> bg-raised:  dark ? #191E24 : #FFFFFF;
    out property <brush> bg-hover:   dark ? #1C222A : #EEF1F4;
    out property <brush> bg-active:  dark ? #232A32 : #E4E8EF;
    out property <brush> bg-inset:   dark ? #0F1216 : #EEF1F4;

    out property <brush> border-subtle:  dark ? #1A1F26 : #EDF0F4;
    out property <brush> border-default: dark ? #232A32 : #E4E8EF;
    out property <brush> border-strong:  dark ? #333C47 : #CDD4DE;

    // The design is explicit: "no shadows inside app UI; separation via surface
    // color + hairline borders only". The previous theme used shadow in light
    // and hairlines in dark; this one uses hairlines in both, so `card-shadow`
    // is false rather than `!dark`. Kept as a property because the overlay
    // scrim still asks the question.
    out property <bool> card-shadow: false;

    // ── Text ────────────────────────────────────────────────────────────
    //
    // `primary` is pure white on dark, which the previous theme deliberately
    // avoided. That was a defensible call and this is the design's, taken
    // knowingly: it measures 19.46:1 and the wordmark it sits beside is drawn
    // in the same white.
    //
    // `secondary` is the design's `textSub`, unchanged in both themes.
    // `tertiary` is the contrast floor — the dimmest thing that still carries
    // text, and it carries the address under every list row and most of the
    // status bar, so it is measured against the surface it is worst on:
    //
    //   dark   #7A838F on #14181D → 4.64:1   (on the base it is 5.07:1)
    //   light  #66707E on #F4F6F8 → 4.63:1   (on a card it is 5.02:1)
    //
    //   dark   #8B95A3 on #14181D → 5.88:1
    //   light  #5B6470 on #F4F6F8 → 5.54:1
    //
    // `disabled` is deliberately below the floor and stays there — it is the
    // one role WCAG exempts, and raising it would make an inert control look
    // live.
    out property <brush> text-primary:   dark ? #FFFFFF : #0B0D10;
    out property <brush> text-secondary: dark ? #8B95A3 : #5B6470;
    out property <brush> text-tertiary:  dark ? #7A838F : #66707E;
    out property <brush> text-disabled:  dark ? #4A525E : #A9AFB8;

    // What sits ON the accent, and it is not white in both themes. Neon mint
    // is bright enough that white on it measures 1.6:1; the design puts deep
    // ink there instead, at 8.28:1.
    out property <brush> text-on-accent: dark ? #062A24 : #FFFFFF;

    // ── Accent ──────────────────────────────────────────────────────────
    //
    // Neon mint on dark, taken as delivered at 10.47:1 on the base and 9.59:1
    // on a card.
    //
    // The light accent is the one value in this file that had to satisfy two
    // requirements at once, and the design's #0FA38A satisfied neither: it is
    // the fill under a white button label **and** the colour of accent text on
    // a light background. Darkened along its own hue (170°, 91% saturation)
    // until both clear:
    //
    //   #0C7E6B on #F4F6F8 → 4.60:1     white on #0C7E6B → 4.99:1
    //   (#0FA38A was 2.93:1 and 3.17:1)
    out property <brush> accent:        dark ? #12D6B4 : #0C7E6B;
    out property <brush> accent-hover:  dark ? #3AE0C4 : #0A6E5D;
    out property <brush> accent-active: dark ? #0FBCA0 : #085B4D;
    out property <brush> accent-soft:   dark ? #12D6B41F : #0C7E6B14;
    out property <brush> accent-ring:   dark ? #12D6B473 : #0C7E6B66;

    // ── Semantic ────────────────────────────────────────────────────────
    //
    // `positive` is the accent, and that is the design's call rather than an
    // oversight: a gain and the primary action are the same mint. The dark set
    // is delivered and clears comfortably (negative 6.54:1, warning 11.68:1).
    //
    // Light was tuned by eye against a dark-first design and both fell short.
    // Each darkened along its own hue to the first value that clears, and no
    // further, so the coral is still coral and the amber is still amber:
    //
    //   negative #E5484D → #C73E43   3.61:1 → 4.62:1
    //   warning  #B98900 → #8E6900   2.92:1 → 4.65:1
    //
    // The `-soft` fills are backgrounds, not text, and keep their hue.
    out property <brush> positive:      dark ? #12D6B4 : #0C7E6B;
    out property <brush> positive-soft: dark ? #12D6B41F : #0C7E6B14;
    out property <brush> negative:      dark ? #FF5C7A : #C73E43;
    out property <brush> negative-soft: dark ? #FF5C7A1F : #C73E4314;
    out property <brush> warning:       dark ? #FDBE3B : #8E6900;
    out property <brush> warning-soft:  dark ? #FDBE3B1F : #8E690014;

    // ── The chart ───────────────────────────────────────────────────────
    // A `color`, not a `brush`, and that is load-bearing: `.with-alpha()` is a
    // method on `color`, and the area under the line is the accent faded to
    // nothing. A `brush` here would compile and then fail at the gradient.
    out property <color> chart-line: dark ? #12D6B4 : #0C7E6B;
    // The line has to stay readable against the fill directly beneath it, so
    // the fill never gets close to the stroke's own weight.
    out property <color> chart-grid: dark ? #FFFFFF : #0B0D10;
}

// 4px grid. If a value is not on it, it is a mistake or it needs a name.
export global Sp {
    out property <length> s1:  2px;
    out property <length> s2:  4px;
    out property <length> s3:  8px;
    out property <length> s4:  12px;
    out property <length> s5:  16px;
    out property <length> s6:  20px;
    out property <length> s7:  24px;
    out property <length> s8:  32px;
    out property <length> s9:  40px;
    out property <length> s10: 48px;
    out property <length> s11: 64px;

    out property <length> card-pad:    20px;
    out property <length> screen-pad:  24px;
    out property <length> section-gap: 28px;
    // Caps line length on a wide display. Cards that stretch to 2000px are
    // what make an app read as a "dashboard" rather than a product.
    out property <length> content-max: 1160px;
}

// The design's radius ladder. Kept under size names rather than role names
// (`button`, `input`, `card`, `sheet`) because the roles do not partition the
// 45 places these are used, and renaming would have meant judging each one —
// a large, silent opportunity to put the wrong corner on something. The values
// are the design's:
//
//   sm  9px   buttons
//   md  10px  inputs
//   lg  12px  cards
//   xl  16px  sheets and modals
//
// `xs` and `xxl` are gone. Nothing used them, and the design has no step there.
export global R {
    out property <length> sm:   9px;
    out property <length> md:   10px;
    out property <length> lg:   12px;
    out property <length> xl:   16px;
    out property <length> full: 999px;
}

export global Typo {
    // The UI face. Bundled, so the interface is the same drawing on every
    // platform rather than SF Pro here and something else there.
    out property <string> ui: "Space Grotesk";

    // Money, addresses, txids and block heights are set in a MONOSPACE family,
    // and that is not decoration. Slint exposes no OpenType feature control, so
    // tabular figures cannot be requested on a proportional face — and with
    // proportional digits the balance jitters as it changes and amounts do not
    // line up in a column. A mono family solves both structurally.
    //
    // "NL" is the no-ligature cut. See the note above the font imports: it is a
    // correctness choice about addresses, not a stylistic one.
    out property <string> mono: "JetBrains Mono NL";

    // # Why these are not the design's numbers
    //
    // `pecu-tokens.json` asks for body 12.5, labels 10 and section headers 9,
    // against a 1060×640 reference. That is a phone scale that was placed in a
    // desktop window: at 9px on a display without HiDPI — which is most Windows
    // and Linux machines — a label is guessed at rather than read.
    //
    // The proportions are the design's; the absolute sizes are moved up one
    // step and the window moved with them. Premium on a desktop comes from
    // whitespace and stillness, not from small type.
    out property <length> hero:    40px;   // dashboard balance
    out property <length> title1:  24px;
    out property <length> title2:  19px;
    out property <length> title3:  16px;
    out property <length> body-lg: 15px;
    out property <length> body:    14px;
    out property <length> caption: 12px;
    out property <length> micro:   11px;

    out property <length> num-lg: 20px;
    out property <length> num:    14px;
    out property <length> num-sm: 12px;

    // Section headers are mono, uppercase and tracked out. 0.08em of 11px is
    // where this number comes from.
    out property <length> tracking-wide: 0.88px;

    // 400 / 500 / 700, and there is no 600 — the design asks for 700 and the
    // bundled Space Grotesk has no SemiBold cut, so a request for 600 would be
    // silently rounded to one of its neighbours by the font matcher.
    out property <int> w-regular: 400;
    out property <int> w-medium:  500;
    out property <int> w-bold:    700;
}

// How the person in front of the window is driving it.
//
// # Why focus rings are conditional
//
// A focus ring is essential and it is also noise, depending entirely on who is
// looking. Someone navigating by keyboard cannot use the interface without one.
// Someone clicking has already said where they are with the pointer, and a ring
// left behind on the last thing they clicked reads as a stuck state.
//
// So the ring follows the *input mode* rather than the focus: `keyboard` goes
// true on the first key press and false on the next pointer press, and rings
// render only while it is true. Focus itself is never removed — only its
// decoration.
export global InputMode {
    in-out property <bool> keyboard: false;
}

export global Motion {
    // The reduce-motion master switch. Every `animate` block in this UI carries
    // `enabled: Motion.enabled;` — Slint 1.17 added that property, and it is
    // the whole mechanism: one line per animation, no duplicate code paths.
    in-out property <bool> enabled: true;

    // The wordmark's cursor, and it is deliberately **not** governed by
    // `enabled` above.
    //
    // The design is explicit that the blink survives reduce-motion: it is the
    // brand rather than a transition, it runs at under 3Hz, and WCAG's flashing
    // threshold is three. Tying it to the reduce-motion switch would have been
    // the tidy thing and the wrong one.
    //
    // What it *is* for is determinism. A blinking element makes a rendered
    // frame depend on when it was rendered, so `snapshot.rs` turns this off and
    // the reference images get a cursor that is always there. Without it the
    // visual test would fail at random, which is worse than no test.
    in-out property <bool> cursor-blink: true;

    // The design's four durations and two curves.
    out property <duration> instant: 80ms;    // press
    out property <duration> fast:    150ms;   // hover, focus ring
    out property <duration> base:    220ms;   // state change
    out property <duration> slow:    320ms;   // sheets, modals
    out property <duration> count:   400ms;   // balance count-up
    out property <duration> draw:    600ms;   // chart draw-in
}
