// Every struct that crosses the Rust↔Slint boundary is declared here and
// nowhere else.
//
// `slint-build` generates a matching Rust type for each of these, so
// `impl From<protocol::NodeVm> for NodeRow` in `src/vm.rs` stops compiling the
// moment either side drifts. That is the main reason this project uses
// `slint-build` rather than the `slint!` macro.
//
// Money is a `string` throughout, and that is not laziness: Slint's `int` is an
// `i32` and its `float` is an `f32`. A Verus balance counts satoshis at 1e8 per
// coin, so 21.5 coins already overflows `i32` and `f32` cannot hold a satoshi
// count exactly past ~16.7 million. Either type would silently render a wrong
// number on a screen whose whole job is to be right about money.

// One VerusID in the list.
// A sentence the interface writes, named by the core. Mirrors `NoteVm`.
//
// The core decides *what is true* — that an address will not parse, that an
// amount is above the balance — and names it. The words are here, in `@tr`,
// where they can be translated and where the side that knows how much room the
// line has gets to choose them.
export struct Note {
    // A stable identifier, never shown. Empty means say nothing.
    code: string,
    // Values the sentence needs, already formatted by the core. Money is
    // spelled in exactly one place and this is not it.
    args: [string],
}

// `Note` is first because Slint resolves types in declaration order and half
// the structs below carry one. Moving it down is a compile error rather than
// a subtle one, which is the only reason this comment is short.

export struct NavItem {
    id: string,
    label: string,
    // The name of an icon in `components/icons.slint`. This was a glyph until
    // the icons became paths — see that file for why a character was never a
    // safe way to draw one.
    icon: string,
    // Phases 5+ appear here greyed out with a badge rather than being hidden.
    // Reserving the space visibly is a promise; hiding it is a surprise later.
    enabled: bool,
    badge: string,
    // Built, and deliberately kept out of the rail for now.
    //
    // Distinct from `enabled: false`, which reserves visible space for
    // something unbuilt. This is the opposite case: the screen works, and is
    // not part of the wallet being shown yet.
    //
    // It is a field rather than a shorter `nav` list because `nav` is also
    // what says a screen exists at all — see `nav-index` and the `ComingSoon`
    // fallback in `app.slint`. Dropping an entry would put "Not built yet"
    // underneath a screen that is built.
    hidden: bool,
}

export struct NodeRow {
    id: int,
    label: string,
    url: string,
    // "unknown" | "probing" | "online" | "degraded" | "offline"
    status: string,
    // What the node itself reported. Empty until it has answered — this is
    // never guessed from the URL.
    network: string,
    tip: string,
    latency: string,
    note: Note,
    builtin: bool,
    active: bool,
}

// One word of a recovery phrase.
//
// Deliberately a row in a model rather than a slice of one long string. A
// joined phrase is the single object that turns one stray log line or one
// accidental clipboard write into a total loss — per-word means no such object
// is ever built on this side of the boundary.
//
// `word` holds "••••••" whenever the phrase is concealed, which is nearly all
// of the time. Concealing is Rust overwriting each row in place, not the model
// being emptied: the grid keeps its shape, and no real word is left in a
// `SharedString` that merely stopped being visible.
export struct SeedWord {
    index: int,
    word: string,
}

// One key in the vault.
//
// Note what is absent: anything secret. An address is public, and having it
// while the wallet is locked is what lets the key list — and a receive address —
// work without a passphrase.
export struct KeyRow {
    label: string,
    address: string,
    // "generated" | "phrase" | "wif". Decides whether a recovery phrase exists
    // to show: a key imported as a WIF never had one, and the backup screen has
    // to say so rather than offer a button that cannot work.
    origin: string,
    // This address has appeared in a transaction. Drives the "unused" hint.
    used: bool,
    // The phrase has been shown and proved written down. Always true for a WIF
    // import, which had no phrase to write down.
    backed-up: bool,
    // The key the wallet currently sends from and receives to.
    active: bool,
}

// An address this wallet has paid, or been given a name for.
//
// On screen because a wallet that quietly keeps a list of who you paid, and
// never shows it, is keeping a secret from its owner. Everything here is
// already on the chain — what is private is the NAME, which is this wallet's
// note and nobody else's.
export struct KnownAddressRow {
    address: string,
    // Empty until somebody names it.
    label: string,
    // What the chain calls it, for a VerusID. Shown in preference to the
    // address, which for an identity is twenty bytes nobody recognises.
    name: string,
    // "3 payments · last 2 days ago", or "never paid".
    summary: string,
}



// Something the wallet said, waiting to be read.
//
// It exists because most of what this wallet has to say had nowhere to appear.
// Notices were routed to a per-screen string, and every code without a screen
// of its own fell through to one that is rendered only on the unlock form — so
// while the wallet was open, a refused spend, a payment that could not be
// recorded, a history that would not load and a node that failed over all
// happened in silence.
export struct ToastRow {
    // The category, for logs and for a support conversation.
    code: string,
    // What happened, as a named reason. The words are in `note.slint` — see
    // `NoticeTitle` and `NoticeBody`.
    //
    // De-duplication keys on **this** rather than on `code` above: one category
    // carries several different messages — `currency_launch` alone has seven —
    // and collapsing them onto one card would hide six of them behind a count.
    note: Note,
    // What only the machine can say: a node's own error text. Never translated,
    // because these are a daemon's words rather than the wallet's.
    detail: string,
    // "info" | "warning" | "danger"
    severity: string,
    // How many times this has been said. Shown from two upwards.
    count: int,
}


// One currency in the markets table. Mirrors `MarketRowVm`.
//
// Every figure is a formatted string rather than a number: the core owns how
// money is spelled, and `—` is a value the interface has to be able to show.
// There is no number that means "the wallet does not know".
export struct MarketRow {
    name: string,
    address: string,
    price: string,
    change: string,
    // "positive" | "negative" | "unknown" — chooses the colour, and is not
    // inferred from the sign, because a dash has no sign.
    tone: string,
    // What could be taken out before the price moves 2%.
    depth: string,
}

// One pool a currency trades in. Mirrors `VenueVm`.
export struct Venue {
    name: string,
    state: string,
    price: string,
    change: string,
    tone: string,
    depth: string,
}

// One labelled figure on the currency detail. Mirrors `StatVm`.
export struct Stat {
    label: Note,
    value: string,
}

// One result in the command palette. Mirrors `SearchHitVm`.
export struct SearchHit {
    // "address" | "currency" — chooses the icon and the screen to open.
    kind: string,
    // A saved address's label, or a currency's name. An address nobody has
    // named falls back to the address itself: the row is two lines tall
    // whatever it holds, and a blank top line reads as broken rather than
    // unnamed.
    label: string,
    // The address, shown under the name so two similar rows can be told
    // apart by the thing that actually differs.
    sub: string,
    // The i-address again, as the thing to act on. What is shown and what is
    // opened are allowed to diverge later.
    target: string,
}

export struct IdentityRow {
    // `name.parent@` where the parent is known, otherwise the bare name.
    name: string,
    // The i-address. The one thing about an identity that never changes, and
    // the identifier to prefer for anything destructive.
    address: string,
    // "Active" | "Locked" | "Unlocking" | "Revoked" — four, not two. A wallet
    // that renders only active-or-revoked cannot say the two things that
    // actually stop somebody: that the funds are held, and that the clock
    // releasing them is already running.
    status: string,
    // The pill colour, in the same vocabulary the node list uses.
    tone: string,
    // What the status means, in a sentence. Empty for the ordinary case.
    note: Note,
    // Whether this wallet holds keys for it. A fact about the wallet, not about
    // the identity — and what decides which actions are offered.
    mine: bool,
}

// One currency this wallet's identities define.
//
// A currency's address IS the address of the identity of the same name — they
// are one object on the chain wearing two hats — which is why this list is read
// through the identity list rather than fetched on its own.
export struct CurrencyRow {
    // As the chain spells it, dotted with its parent. NO trailing `@`: that
    // suffix belongs to identities, and no currency on VRSCTEST carries one.
    name: string,
    address: string,
    // "Token" | "Basket" | "NFT", read off the options bitfield rather than
    // guessed from which fields happen to be filled in.
    kind: string,
    tone: string,
    // What the kind means, for somebody who did not define it. Empty for a
    // plain token, where the label already says everything.
    note: Note,
    // Whether the supply can still grow. A permanent property, and a different
    // promise to whoever holds it.
    mintable: bool,
    start-block: string,
    // Whether it has reached that block. False for the window between the
    // definition being mined and the currency beginning — where a freshly
    // launched one sits, doing nothing, for twenty-odd minutes.
    started: bool,
}

// An identity that could define a currency, and whether it still can.
//
// Rows with a `refusal` are shown rather than hidden: the commonest reason is
// permanent — an identity may define one currency, once — and a name missing
// from a picker with no explanation reads as a bug to the person who registered
// it for exactly this.
export struct EligibleIdentity {
    name: string,
    address: string,
    // Empty when it may be used. Otherwise why not, in a sentence.
    refusal: Note,
}

// One slice of a proportional bar: a reserve's weight, or a share of supply.
//
// `percent` is a number rather than a string, which is the exception to this
// crate's rule that figures cross pre-formatted. It is not an amount — nobody
// reads it — it is what the layout multiplies a width by. The string beside it
// is the one a person reads, and core computes both so the picture and the
// caption cannot disagree.
export struct CurrencySlice {
    label: string,
    percent: float,
    // Where it starts along the bar, 0–100. Carried rather than accumulated
    // here — see `CurrencySliceVm`, and see `ProportionBar` for why the slices
    // are placed by hand rather than laid out.
    offset-percent: float,
    percent-display: string,
    // "accent" | "positive" | "warning" | "neutral", cycled so two adjacent
    // slices never share a colour.
    tone: string,
}

// One reserve of a basket, as typed. Editable, so it lives in an `in-out`
// model the form writes back into.
// One currency somebody could pick as a reserve. See `CurrencyPickVm`.
export struct CurrencyPick {
    // Fully qualified, the way the chain spells it.
    name: string,
    // Its i-address, which is what the definition carries.
    address: string,
    kind: string,
    // Something worth knowing before it is used as a reserve, or empty.
    note: Note,
}

export struct ReserveEntry {
    // The reserve's i-address. Chosen from the chain's list rather than typed:
    // a definition carries the address, and a name in this field failed the
    // build after the launch had already been agreed to.
    currency: string,
    // What that address is called, for reading. Nobody can check an i-address
    // by eye against the currency they meant.
    name: string,
    // A percentage, as typed. A string because the constraint on it is a sum:
    // consensus wants the set to add to exactly one whole, and a value rounded
    // on the way through would move the total off by a satoshi.
    weight: string,
}

// One preallocation, as typed.
export struct PreallocEntry {
    // An identity — consensus pays a preallocation to a name, not an address.
    recipient: string,
    amount: string,
}

// One line of the definition preview.
export struct CurrencyField {
    label: Note,
    value: string,
    // …and the sentence, when the value is one. Exactly one is set.
    value-note: Note,
    // Cannot be changed after the launch. The mark is the whole reason this
    // panel is on screen — everything else here is also in the form above it.
    permanent: bool,
}

// Something wrong with a draft, or something permanent about to happen.
export struct CurrencyProblem {
    // True stops the launch. False only has to be read.
    blocking: bool,
    text: Note,
}

// One step of the launch, for the diagram that says what happens next.
export struct FlowStep {
    label: Note,
    // "done" | "now" | "later"
    state: string,
    // Whether reaching this step spends money. Marked, because two of the four
    // do and a diagram that treats them all alike is a diagram that lied about
    // the one somebody wanted to stop before.
    costs: bool,
}

// One published value in an identity's content map.
//
// Flattened: one row per value, and the key fields are filled only on the first
// row of each key. Same shape as `ActivityRow.group`, and for the same reason —
// grouping needs to see the row before this one, which a `for` over a model
// cannot do. Core does it, once.
export struct ContentEntry {
    // The VDXF key as the i-address the map is keyed by. Empty on continuation
    // rows.
    key: string,
    // The URI this key hashes from, when the wallet knows one that does.
    //
    // Empty is PERMANENT, not pending. A VDXF key is a one-way hash of a name:
    // for a key somebody else published, the name cannot be recovered, and
    // without it there is nothing to say how the value is encoded.
    name: string,
    // True on the first row of a key, so the heading is drawn once.
    first: bool,
    // The bytes as text, when reading them that way is defensible. Empty
    // otherwise — and then `hex` is what to show.
    text: string,
    hex: string,
    // "12 bytes", for values that are not text.
    size: string,
    // The daemon's own rendering, when it recognised the key. It cannot be
    // turned back into bytes, so it stands beside them rather than replacing
    // them.
    structured: string,
}

export struct AssetRow {
    name: string,
    amount: string,
    secondary: string,
    native: bool,
}

export struct ActivityRow {
    txid: string,
    // The same id, head and tail. Sixty-four hex characters elided to fit a row
    // are indistinguishable from each other; a head and a tail are not.
    txid-short: string,
    // "in" | "out" | "self"
    direction: string,
    amount: string,
    when: Note,
    pending: bool,
    // 0 while unconfirmed. Confirmations are DERIVED in the UI from this and a
    // single `tip` property, so a new block updates one integer instead of
    // rewriting every row.
    height: int,
    // "payment" | "convert" | "login" | "identity" — what the filters act on.
    // Carried rather than inferred: a declined login and an identity update
    // both move nothing, and telling those apart by their emptiness is not
    // telling them apart.
    kind: string,
    // The line under the title. "via Bridge.vETH", "as robert.VRSCTEST@".
    // Never the counterparty of a payment: history comes from address deltas
    // and a delta names nobody.
    note: string,
    // Non-empty when this row starts a new day: the heading to draw above it.
    // Computed in core, which can see the row before this one — something a
    // `for` loop over a model cannot.
    group: Note,
}

// One output of the transaction that was actually built and signed.
//
// Decoded from the signed bytes in `pecu_core::send::review`, never echoed
// back from the form — which is the entire reason the review step exists.
export struct ReviewOutput {
    // Empty when the script could not be decoded. That is shown as such rather
    // than guessed at: an unreadable output in a transaction about to be signed
    // is not something a review may present as ordinary.
    address: string,
    // What kind of output this is, as a named reason — see `note.slint`.
    kind: Note,
    amount: string,
    is-change: bool,
}

// A transaction handed to a node whose outcome nobody knows.
//
// It exists because a transport failure during a broadcast is genuinely
// ambiguous — the node may have accepted and relayed it before the connection
// dropped. The signed bytes are on disk, and the only safe resolution is to ask
// whether it confirmed and, if it truly never arrived, to send THOSE bytes
// again. Never a rebuild.
export struct PendingRow {
    id: int,
    txid: string,
    to-address: string,
    amount: string,
    // "uncertain" | "absent" | "resent"
    state: string,
    checks: int,
}
