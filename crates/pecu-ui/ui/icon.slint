// The application icon, drawn rather than imported.
//
// # Why it is a Slint component and not a PNG somebody exported
//
// Because it is made of the same things the interface is made of — the accent
// colour and the bundled monospace — and a bitmap in a folder is a second copy
// of those that nothing keeps in step. `examples/render_icon.rs` renders this at
// every size macOS asks for, with the same software renderer the reference
// images use, so the icon is reproducible from source.
//
// # The mark
//
// `@` and a cursor, which is the wordmark reduced to its two halves. The design
// package delivers this as `icons/master.svg` and **that file cannot be used**:
// it draws the `@` as an SVG `<text>` element naming "JetBrains Mono", so on any
// machine without that font installed it renders whatever the system falls back
// to. As a scalable Linux icon that is a different glyph on every desktop.
//
// Here the font is not a dependency but a fact: `JetBrainsMonoNL-Bold.ttf` is
// compiled into this binary by `theme/theme.slint`, so the glyph this draws is
// the glyph that ships. Hinting is not a concern at these sizes — it is a
// small-size mechanism and the small sizes are drawn small rather than shrunk.
//
// Geometry follows `master.svg`, expressed against the shape rather than the
// canvas: the glyph is half the square, the cursor is 0.15 of it wide and the
// same height as the glyph, with a 0.106 gap. Those are `410`, `123` and `87`
// over `824` in the original.
//
// # The colours are the brand's, not the theme's
//
// Ink and neon mint, always. An application icon is a file: it does not follow
// the system theme, and one that changed colour depending on which mode the
// person packaging the build happened to have set would be a different icon per
// release. `render_icon.rs` therefore renders in the **dark** palette, which is
// the pair this mark is defined on — the light theme's mint is a corrected,
// darker colour that exists for text contrast and has no business here.
//
// # The geometry is Apple's, not a guess
//
// A macOS app icon is **not** masked by the system the way an iOS one is: the
// rounded shape has to be in the file. Apple's template for Big Sur and later
// puts an 824×824 rounded square inside a 1024×1024 canvas, with a corner radius
// of 185.4px. The empty margin is what the drop shadow and the hover growth use,
// and an icon drawn edge to edge sits visibly larger than every other icon in
// the dock.
//
// This is also what `docs/design/REVIEW.md` records as wrong with the delivered
// PNGs: they are full-bleed squares, and macOS would draw them as hard squares
// beside every other icon that is not one.
//
// # Why the fill is flat
//
// It was a gradient, and **the software renderer drops `border-radius` when the
// fill is a gradient** — measured, by rendering it: the corners came out square
// while everything else was right. A flat fill rounds correctly.

import { Theme, Typo } from "theme/theme.slint";

export component AppIcon inherits Window {
    // The canvas. Set per render: every size in the iconset is drawn at its own
    // size rather than shrunk from one big one — see `examples/render_icon.rs`.
    in property <length> canvas: 1024px;
    // The shape inside it, at Apple's proportion.
    property <length> side: root.canvas * 824 / 1024;

    // Below this the cursor comes off.
    //
    // The design states the rule: under 32px the cursor is dropped, under 24px
    // only the `@` remains — which here is the same instruction twice, since the
    // cursor is the only other thing in the mark. At 16px the bar would be under
    // a pixel wide, and a stroke the renderer drops is worse than one that was
    // never asked for.
    property <bool> simplified: root.canvas < 32px;

    width: root.canvas;
    height: root.canvas;
    // Nothing behind the shape. macOS composites the icon over whatever is
    // under it — a dock, a Finder row, a dark background — and an opaque canvas
    // would be a square with the icon painted on it.
    background: transparent;

    Rectangle {
        width: root.side;
        height: root.side;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: root.side * 185.4 / 824;
        background: Theme.bg-base;

        HorizontalLayout {
            alignment: center;
            spacing: root.simplified ? 0px : root.side * 0.106;

            if !root.simplified: Text {
                text: "@";
                font-family: Typo.mono;
                font-size: root.side * 0.5;
                font-weight: Typo.w-bold;
                color: Theme.accent;
                vertical-alignment: center;
            }

            // The same mark with the spiral taken out, for the sizes the glyph
            // cannot survive.
            //
            // Rendered at 16 and looked at, pixel for pixel: the `@` from the
            // font is an amorphous blob there. It is not a rendering fault and
            // no amount of scaling fixes it — the glyph has a counter inside a
            // counter, and below about ten pixels there are no pixels left to
            // put them in. Enlarging it to fill the square was tried first and
            // produced a larger blob.
            //
            // So at these sizes it is an `@` reduced to a ring broken on the
            // right with a tail — and the honest report is that **at 16px the
            // break and the tail do not survive either**. What lands is a clean,
            // crisp ring. That is a legible mark instead of a smudge, which is
            // the trade worth making, but it is not recognisably an `@`.
            //
            // The design package expects this: its Windows spec asks for
            // "16/24px: nur @ ohne Cursor (Pixel-Hinting)" — hand-hinted pixel
            // art, drawn for the grid rather than scaled onto it. That is a
            // designer's job and it has not been done. Until it is, 16px is a
            // ring. See `docs/design/REVIEW.md`.
            if root.simplified: Path {
                commands: "M 18.2 17.6 A 9 9 0 1 1 20.4 9.4 M 20.4 9.4 L 20.4 16.2";
                viewbox-width: 24;
                viewbox-height: 24;
                width: root.side * 0.78;
                height: root.side * 0.78;
                fill: transparent;
                stroke: Theme.accent;
                stroke-width: root.side * 0.78 * 2.6 / 24;
                stroke-line-cap: round;
            }

            if !root.simplified: Rectangle {
                width: root.side * 0.149;
                height: root.side * 0.5;
                y: (parent.height - self.height) / 2;
                background: Theme.accent;
            }
        }
    }
}
