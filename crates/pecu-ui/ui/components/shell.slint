import { Theme, Sp, R, Typo, Motion, InputMode } from "../theme/theme.slint";
import { StatusPill } from "base.slint";
import { Icon } from "icons.slint";
import { Wordmark } from "brand.slint";
import { NavItem } from "../vm/structs.slint";

// The left rail.
//
// Items for later phases are present and disabled rather than absent: reserving
// the space visibly is a promise about where things will be, whereas hiding
// them means the layout jumps the day they arrive.
export component NavRail inherits Rectangle {
    in property <[NavItem]> items;
    in property <string> active;
    in property <bool> expanded: true;
    // Who this wallet is, shown at the foot of the rail. Empty until there is
    // an identity to name — the design draws a signed-in account there, and an
    // empty pill saying nothing would be worse than the space.
    in property <string> account;
    in property <string> account-state: "unknown";
    callback selected(string);

    // 170px in the design. This is a step wider because the type is: the design
    // sets labels at 10px against a 1060px window and this interface uses 14 in
    // a 1240 one, so the rail is scaled with them rather than left to crowd.
    width: root.expanded ? 188px : 72px;
    background: Theme.bg-sunken;
    animate width { duration: Motion.base; easing: cubic-bezier(0.2, 0, 0, 1); enabled: Motion.enabled; }

    // A hairline instead of a border, so the rail reads as a plane rather than
    // a box.
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.border-subtle;
    }

    VerticalLayout {
        padding: Sp.s4;
        padding-top: Sp.s6;
        // No `spacing`: each nav row carries its own, so a collapsed one
        // leaves no seam. See the `for` below.

        // The wordmark sits in the rail rather than in the title bar, which is
        // where the design puts it and where it stops competing with the screen
        // name for the same corner.
        // An explicit height, and not for spacing.
        //
        // `Wordmark` inherits a layout, and a layout nested in a layout did not
        // report a preferred height here — the wrapper collapsed to nothing and
        // the mark was simply absent. A fixed box is what gives it room.
        Rectangle {
            height: 40px;
            HorizontalLayout {
                // The same inset the nav items use, so the wordmark and the
                // icons share a left edge rather than missing it by four pixels.
                padding-left: Sp.s4;
                alignment: start;
            if root.expanded: Wordmark { size: 16px; }
            // Collapsed there is no room for four letters and a cursor, and the
            // icon rule applies: what is left is the `@`.
            if !root.expanded: Wordmark { size: 16px; cursor: false; }
            }
        }

        // A hidden entry collapses rather than being absent from the list.
        //
        // `root.items` is also what tells `app.slint` which screens exist, so
        // it stays whole and the row takes no space instead.
        //
        // The gap between rows lives in the row, not in the layout's
        // `spacing`. With `spacing`, two collapsed rows still contributed
        // their two gaps and left a 4px seam above Settings that nothing had
        // asked for. Carried by the row, a collapsed row costs nothing.
        for item[i] in root.items: Rectangle {
            visible: !item.hidden;
            height: item.hidden ? 0px : 40px + Sp.s1;

            pill := Rectangle {
                height: 40px;
                y: 0;
                border-radius: R.md;
                background: root.active == item.id ? Theme.accent-soft
                    : (item.enabled && touch.has-hover) ? Theme.bg-hover
                    : transparent;
                animate background { duration: Motion.fast; enabled: Motion.enabled; }

                HorizontalLayout {
                    padding-left: Sp.s4;
                    padding-right: Sp.s4;
                    spacing: Sp.s4;

                    Icon {
                        name: item.icon;
                        size: 18px;
                        y: (parent.height - self.height) / 2;
                        tone: !item.enabled ? Theme.text-disabled
                            : root.active == item.id ? Theme.accent
                            : Theme.text-secondary;
                    }

                    if root.expanded: Text {
                        text: item.label;
                        font-size: Typo.body;
                        font-weight: root.active == item.id ? Typo.w-medium : Typo.w-regular;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        color: !item.enabled ? Theme.text-disabled
                            : root.active == item.id ? Theme.text-primary
                            : Theme.text-secondary;
                    }

                    if root.expanded && item.badge != "": Rectangle {
                        width: badge.preferred-width + Sp.s4;
                        height: 18px;
                        y: (parent.height - self.height) / 2;
                        border-radius: R.full;
                        background: Theme.bg-inset;
                        badge := Text {
                            text: item.badge;
                            font-size: Typo.micro;
                            color: Theme.text-tertiary;
                        }
                    }
                }

                touch := TouchArea {
                    enabled: item.enabled;
                    mouse-cursor: item.enabled ? MouseCursor.pointer : MouseCursor.default;
                    clicked => { root.selected(item.id); }
                }
            }

            accessible-role: button;
            accessible-label: item.label;
        }

        Rectangle { vertical-stretch: 1; }

        // The account, at the foot. Only when there is one to name.
        if root.expanded && root.account != "": Rectangle {
            height: 46px;
            border-radius: R.md;
            background: Theme.bg-surface;
            border-width: 1px;
            border-color: Theme.border-default;

            HorizontalLayout {
                padding-left: Sp.s3;
                padding-right: Sp.s3;
                spacing: Sp.s3;

                // The avatar is the mark again, at list size.
                Rectangle {
                    width: 26px;
                    height: 26px;
                    y: (parent.height - self.height) / 2;
                    border-radius: self.width / 2;
                    background: Theme.accent;
                    Text {
                        text: "@";
                        font-family: Typo.mono;
                        font-size: Typo.caption;
                        font-weight: Typo.w-bold;
                        color: Theme.text-on-accent;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    horizontal-stretch: 1;
                    Text {
                        text: root.account;
                        font-family: Typo.mono;
                        font-size: Typo.micro;
                        font-weight: Typo.w-bold;
                        color: Theme.text-primary;
                        overflow: elide;
                    }
                    StatusPill {
                        state: root.account-state;
                        text: root.account-state == "online" ? @tr("connected")
                            : root.account-state == "offline" ? @tr("offline")
                            : @tr("connecting");
                    }
                }
            }
        }
    }
}

// The bar above the content. Carries the app identity and the one fact a wallet
// user always wants visible: which chain am I on.
export component TitleBar inherits Rectangle {
    in property <string> title;
    in property <string> network;
    in property <string> node-state: "unknown";
    in property <bool> mock-mode: false;
    callback toggle-theme();
    callback lock();
    callback refresh();
    in property <bool> busy: false;
    in property <bool> can-refresh: false;

    height: 52px;
    background: Theme.bg-base;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border-subtle;
    }

    HorizontalLayout {
        padding-left: Sp.s8;
        padding-right: Sp.s8;
        spacing: Sp.s5;

        Text {
            text: root.title;
            font-size: Typo.title3;
            font-weight: Typo.w-bold;
            color: Theme.text-primary;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        // Mock mode says so loudly and permanently. A demo build that looks
        // like the real thing is how someone eventually trusts a fake balance.
        if root.mock-mode: Rectangle {
            width: mocklabel.preferred-width + Sp.s6;
            height: 22px;
            y: (parent.height - self.height) / 2;
            border-radius: R.full;
            background: Theme.warning-soft;
            mocklabel := Text {
                text: @tr("MOCK DATA");
                font-size: Typo.micro;
                font-weight: Typo.w-bold;
                letter-spacing: 0.6px;
                color: Theme.warning;
            }
        }

        StatusPill {
            state: root.node-state;
            text: root.network == "" ? @tr("Not connected") : root.network;
            y: (parent.height - self.height) / 2;
        }

        if root.can-refresh: Rectangle {
            width: refreshlabel.preferred-width + Sp.s5;
            height: 26px;
            y: (parent.height - self.height) / 2;
            border-radius: R.sm;
            background: refreshtouch.has-hover ? Theme.bg-hover : transparent;
            animate background { duration: Motion.fast; enabled: Motion.enabled; }

            refreshlabel := Text {
                // No spinner: the word changing IS the feedback, and a spinner
                // that appears for 200ms reads as a flicker rather than
                // progress.
                text: root.busy ? @tr("Reading…") : @tr("Refresh");
                font-size: Typo.caption;
                font-weight: Typo.w-medium;
                color: root.busy ? Theme.text-tertiary
                    : refreshtouch.has-hover ? Theme.text-primary
                    : Theme.text-secondary;
                vertical-alignment: center;
            }

            // The title bar's three controls are hand-rolled rather than `Btn`,
            // because they are chrome and want a quieter shape. That is fine
            // for the drawing and was not fine for anything else: they had a
            // touch area and an accessible label and nothing else, so Refresh,
            // Lock and the theme toggle — the controls on **every** screen of
            // this wallet — could not be reached by Tab and did nothing when a
            // screen reader activated them.
            refreshfocus := FocusScope {
                enabled: !root.busy;
                key-pressed(event) => {
                    if (event.text == "\n" || event.text == " ") {
                        root.refresh();
                        return EventResult.accept;
                    }
                    return EventResult.reject;
                }
            }
            refreshtouch := TouchArea {
                enabled: !root.busy;
                mouse-cursor: root.busy ? MouseCursor.default : MouseCursor.pointer;
                clicked => { root.refresh(); }
            }
            // The ring: outside the shape, and only while the keyboard is
            // driving — the rule `Btn` states and these three did not follow.
            // Drawn on the control's own bounds it sat on top of the label and
            // the hover surface, and shown on mouse focus it stayed lit after
            // every click, which is what read as a smeared glow.
            if refreshfocus.has-focus && InputMode.keyboard: Rectangle {
                x: -3px;
                y: -3px;
                width: parent.width + 6px;
                height: parent.height + 6px;
                border-radius: R.sm + 3px;
                border-width: 2px;
                border-color: Theme.accent-ring;
            }
            accessible-role: button;
            accessible-label: @tr("Refresh balances");
            accessible-enabled: !root.busy;
            accessible-action-default => {
                if (!root.busy) {
                    root.refresh();
                }
            }
        }

        // Locking has to be reachable in one click from anywhere, not buried in
        // a settings page. It is the action someone reaches for when they are
        // already walking away from the machine.
        //
        // A word, not a glyph. The padlock characters the system font is
        // willing to draw are colour emoji, and the monochrome ones it is not:
        // `◍` rendered as nothing at all here, which is the failure mode this
        // file has hit twice already and which is invisible in the source.
        Rectangle {
            width: locklabel.preferred-width + Sp.s5;
            height: 26px;
            y: (parent.height - self.height) / 2;
            border-radius: R.sm;
            background: locktouch.has-hover ? Theme.bg-hover : transparent;
            animate background { duration: Motion.fast; enabled: Motion.enabled; }

            locklabel := Text {
                text: @tr("Lock");
                font-size: Typo.caption;
                font-weight: Typo.w-medium;
                color: locktouch.has-hover ? Theme.text-primary : Theme.text-secondary;
                vertical-alignment: center;
            }

            lockfocus := FocusScope {
                key-pressed(event) => {
                    if (event.text == "\n" || event.text == " ") {
                        root.lock();
                        return EventResult.accept;
                    }
                    return EventResult.reject;
                }
            }
            locktouch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.lock(); }
            }
            // The ring: outside the shape, and only while the keyboard is
            // driving — the rule `Btn` states and these three did not follow.
            // Drawn on the control's own bounds it sat on top of the label and
            // the hover surface, and shown on mouse focus it stayed lit after
            // every click, which is what read as a smeared glow.
            if lockfocus.has-focus && InputMode.keyboard: Rectangle {
                x: -3px;
                y: -3px;
                width: parent.width + 6px;
                height: parent.height + 6px;
                border-radius: R.sm + 3px;
                border-width: 2px;
                border-color: Theme.accent-ring;
            }
            accessible-role: button;
            accessible-label: @tr("Lock the wallet");
            accessible-action-default => { root.lock(); }
        }

        Rectangle {
            width: themelabel.preferred-width + Sp.s5;
            height: 26px;
            y: (parent.height - self.height) / 2;
            border-radius: R.sm;
            background: themetouch.has-hover ? Theme.bg-hover : transparent;
            animate background { duration: Motion.fast; enabled: Motion.enabled; }
            themelabel := Text {
                // Named for what pressing it gives you, not for the state it
                // is in — and a word rather than a symbol, because `☀` drew
                // nothing in the light theme. The dark one rendered fine, so
                // this was invisible until a light reference image existed.
                text: Theme.dark ? @tr("Light") : @tr("Dark");
                font-size: Typo.caption;
                font-weight: Typo.w-medium;
                color: themetouch.has-hover ? Theme.text-primary : Theme.text-secondary;
                vertical-alignment: center;
            }
            themefocus := FocusScope {
                key-pressed(event) => {
                    if (event.text == "\n" || event.text == " ") {
                        root.toggle-theme();
                        return EventResult.accept;
                    }
                    return EventResult.reject;
                }
            }
            themetouch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toggle-theme(); }
            }
            // The ring: outside the shape, and only while the keyboard is
            // driving — the rule `Btn` states and these three did not follow.
            // Drawn on the control's own bounds it sat on top of the label and
            // the hover surface, and shown on mouse focus it stayed lit after
            // every click, which is what read as a smeared glow.
            if themefocus.has-focus && InputMode.keyboard: Rectangle {
                x: -3px;
                y: -3px;
                width: parent.width + 6px;
                height: parent.height + 6px;
                border-radius: R.sm + 3px;
                border-width: 2px;
                border-color: Theme.accent-ring;
            }
            accessible-role: button;
            accessible-label: @tr("Toggle light and dark theme");
            accessible-action-default => { root.toggle-theme(); }
        }
    }
}

// The footer. Block height and latency belong here rather than in a dialog:
// they are the two numbers that tell you whether what you are looking at is
// current.
export component StatusBar inherits Rectangle {
    in property <string> tip;
    in property <string> latency;
    in property <string> endpoint;
    in property <string> sdk-rev;
    // The node answers, but from behind the chain.
    //
    // The wallet has computed this since the node manager was written, carried
    // it through the protocol and set it on a global — and then **nothing read
    // it**. The one place it appeared was a note on a row of the network
    // screen, which is not where somebody looking at a balance is.
    //
    // It belongs beside the block height, because the block height is the thing
    // that is stale, and every figure on screen was read against it.
    in property <bool> syncing;

    // 32px rather than 28: at 28 the 11px text sits hard against the window
    // edge with no breathing room. Only visible in a screenshot.
    height: 32px;
    background: Theme.bg-sunken;

    Rectangle {
        height: 1px;
        background: Theme.border-subtle;
    }

    HorizontalLayout {
        padding-left: Sp.s8;
        padding-right: Sp.s8;
        spacing: Sp.s5;

        Text {
            text: root.tip == "" ? @tr("no block height") : @tr("{} blocks", root.tip);
            font-family: Typo.mono;
            font-size: Typo.micro;
            color: root.syncing ? Theme.warning : Theme.text-tertiary;
            vertical-alignment: center;
        }

        // In words as well as in colour, which is the rule everywhere else in
        // this interface: a reader without colour vision gets the same warning.
        if root.syncing: Text {
            text: @tr("node is behind the chain");
            font-size: Typo.micro;
            color: Theme.warning;
            vertical-alignment: center;
        }

        if root.latency != "": Text {
            text: root.latency;
            font-family: Typo.mono;
            font-size: Typo.micro;
            color: Theme.text-tertiary;
            vertical-alignment: center;
        }

        Text {
            text: root.endpoint;
            font-size: Typo.micro;
            color: Theme.text-tertiary;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        Text {
            text: "sdk " + root.sdk-rev;
            font-family: Typo.mono;
            font-size: Typo.micro;
            color: Theme.text-disabled;
            vertical-alignment: center;
        }
    }
}
