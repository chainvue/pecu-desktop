import { Theme, Sp, R, Typo, Motion, InputMode } from "../theme/theme.slint";
import { NoteText } from "note.slint";
import { Icon } from "icons.slint";
import { Note } from "../vm/structs.slint";

// A button.
//
// `variant` is a string rather than an enum so that adding one is a one-word
// change here and at the call site, with no generated-type churn.
// "primary" | "secondary" | "ghost" | "destructive"
export component Btn inherits Rectangle {
    in property <string> text;
    in property <string> variant: "secondary";
    in property <bool> enabled: true;
    in property <bool> busy: false;
    callback clicked();

    property <bool> is-primary: root.variant == "primary";
    property <bool> is-ghost: root.variant == "ghost";
    property <bool> is-danger: root.variant == "destructive";

    height: 36px;
    horizontal-stretch: 0;
    min-width: label.preferred-width + Sp.s7 * 2;
    border-radius: R.md;
    border-width: root.is-ghost ? 0px : 1px;

    // A disabled button loses its colour entirely. Keeping the accent border
    // under greyed-out text reads as "this is the button you want" attached to
    // something that does not respond, which is worse than either.
    border-color: !root.enabled ? Theme.border-subtle
        : root.is-primary ? Theme.accent
        : root.is-danger ? Theme.negative
        : Theme.border-default;

    background: !root.enabled ? Theme.bg-inset
        : root.is-primary ? (touch.pressed ? Theme.accent-active : touch.has-hover ? Theme.accent-hover : Theme.accent)
        : root.is-danger ? (touch.has-hover ? Theme.negative-soft : transparent)
        : root.is-ghost ? (touch.has-hover ? Theme.bg-hover : transparent)
        : (touch.pressed ? Theme.bg-active : touch.has-hover ? Theme.bg-hover : Theme.bg-surface);

    // Press feedback is a scale, not a colour jump: it reads as physical.
    // Everything here is gated on Motion.enabled — one line per animation is
    // the entire reduce-motion mechanism.
    animate background { duration: Motion.fast; enabled: Motion.enabled; }
    animate border-color { duration: Motion.fast; enabled: Motion.enabled; }

    label := Text {
        text: root.busy ? "…" : root.text;
        font-size: Typo.body;
        font-weight: Typo.w-medium;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: !root.enabled ? Theme.text-disabled
            : root.is-primary ? Theme.text-on-accent
            : root.is-danger ? Theme.negative
            : Theme.text-primary;
    }

    // Every button is reachable by keyboard. Without this the entire interface
    // could only be operated with a pointer — the single largest accessibility
    // failure a desktop application can have, and one that is invisible to
    // anyone testing it with a mouse.
    //
    // Declared before the touch area so that a pointer press still lands on the
    // touch area: later siblings receive input first.
    focus := FocusScope {
        enabled: root.enabled && !root.busy;
        key-pressed(event) => {
            // Return and space, which is what every platform's button does.
            if (event.text == "\n" || event.text == " ") {
                root.clicked();
                return EventResult.accept;
            }
            return EventResult.reject;
        }
    }

    // The ring, drawn OUTSIDE the button's own border so it never covers the
    // shape it is pointing at. Only while the keyboard is driving — see
    // `InputMode`.
    if focus.has-focus && InputMode.keyboard: Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: R.md + 3px;
        border-width: 2px;
        border-color: Theme.accent-ring;
    }

    touch := TouchArea {
        enabled: root.enabled && !root.busy;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            // The pointer has said where it is, so the ring is noise from here
            // until a key says otherwise.
            InputMode.keyboard = false;
            focus.focus();
            root.clicked();
        }
    }

    accessible-role: AccessibleRole.button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    // What happens when a screen reader activates it.
    //
    // # This was missing everywhere, and it is not a detail
    //
    // Announcing a role and a label tells VoiceOver that a button is there and
    // what it is called. Pressing it is a separate contract — the default
    // action — and nothing in this interface declared one. So every button in
    // this wallet was announced correctly and **did nothing at all** when
    // somebody using a screen reader activated it.
    //
    // `tests/accessibility.rs` did not catch it because it checks that controls
    // have names, which it says plainly. A name on a control that cannot be
    // operated is the more complete version of the failure it was written for.
    //
    // Guarded on `enabled` rather than relying on the caller: an accessibility
    // action does not pass through the touch area, so a disabled button would
    // otherwise be pressable by exactly the route that has no other way in.
    accessible-action-default => {
        if (root.enabled && !root.busy) {
            root.clicked();
        }
    }
}

// A row of mutually exclusive choices.
//
// The thumb animates both `x` and `width`, so it slides *and* resizes between
// options of different lengths rather than jumping. That one detail is most of
// the difference between this and three buttons.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> index: 0;
    callback changed(int);

    height: 34px;
    background: Theme.bg-inset;
    border-radius: R.md;
    border-width: 1px;
    border-color: Theme.border-subtle;
    clip: true;

    // Behind the labels, so the text is never drawn under a moving surface.
    Rectangle {
        x: root.index * (root.width / max(1, root.options.length));
        width: root.width / max(1, root.options.length);
        height: parent.height - 6px;
        y: 3px;
        background: Theme.bg-raised;
        border-radius: R.sm;
        border-width: 1px;
        border-color: Theme.border-default;
        animate x { duration: Motion.base; easing: cubic-bezier(0.2, 0, 0, 1); enabled: Motion.enabled; }
        animate width { duration: Motion.base; easing: cubic-bezier(0.2, 0, 0, 1); enabled: Motion.enabled; }
    }

    HorizontalLayout {
        for option[i] in root.options: Rectangle {
            Text {
                text: option;
                font-size: Typo.caption;
                font-weight: root.index == i ? Typo.w-medium : Typo.w-regular;
                color: root.index == i ? Theme.text-primary : Theme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }

            // A focus ring, because a control that can be reached by keyboard
            // and shows nothing when it is reached cannot be operated by
            // keyboard in practice.
            //
            // **Inset, unlike every other ring in this file.** The rule
            // elsewhere is to draw outside the shape so the ring never covers
            // what it points at — but this root sets `clip: true` for the
            // sliding highlight, so an outside ring on the first or last
            // segment is sliced off at the control's edge and the two ends stop
            // matching. Inside, and clear of the highlight's own 1px border by
            // enough that the two do not stack into a smear.
            //
            // And only while the keyboard is driving. Shown on mouse focus it
            // stayed lit on whichever segment was last clicked — which is
            // always the selected one, so the control looked like it had a
            // permanent halo rather than a focus state.
            if focus.has-focus && InputMode.keyboard: Rectangle {
                x: 5px;
                y: 5px;
                width: parent.width - 10px;
                height: parent.height - 10px;
                border-radius: R.sm;
                border-width: 2px;
                border-color: Theme.accent-ring;
            }

            // Keyboard, which this had none of.
            //
            // Every `Btn` in this interface carries a focus scope and answers
            // Return and space. This did not — it was a `TouchArea` and an
            // accessible label, which is enough for a screen reader to announce
            // a control and not enough for anybody to press it. So the restore
            // form's phrase/text/key picker, the content viewer's two views and
            // (once Settings grew tabs) whole sections of the wallet were
            // reachable with a pointer and no other way.
            //
            // The arrow keys move between segments as well, which is what a
            // person expects of a row of tabs and what makes a five-option
            // control bearable without a mouse.
            focus := FocusScope {
                key-pressed(event) => {
                    if (event.text == "\n" || event.text == " ") {
                        root.index = i;
                        root.changed(i);
                        return EventResult.accept;
                    }
                    if (event.text == Key.LeftArrow && root.index > 0) {
                        root.index = root.index - 1;
                        root.changed(root.index);
                        return EventResult.accept;
                    }
                    if (event.text == Key.RightArrow
                        && root.index < root.options.length - 1) {
                        root.index = root.index + 1;
                        root.changed(root.index);
                        return EventResult.accept;
                    }
                    return EventResult.reject;
                }
            }

            // Declared after the focus scope so a pointer press still lands
            // here: later siblings receive input first. Same ordering as `Btn`.
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    focus.focus();
                    root.index = i;
                    root.changed(i);
                }
            }

            accessible-role: AccessibleRole.button;
            accessible-label: option;
            accessible-action-default => {
                root.index = i;
                root.changed(i);
            }
        }
    }
}

// A surface. In dark mode cards are hairline-led; in light mode shadow-led.
// Using both in both themes is what makes a UI look muddy.
export component Card inherits Rectangle {
    in property <bool> interactive: false;
    // A card that floats over the interface rather than sitting in it: the
    // transaction sheet, the identity sheet, the confirmation over that, the
    // notice stack.
    //
    // # Why an overlay breaks the theme's own rule
    //
    // "Dark leans on hairlines, light leans on shadow" is right for a card on a
    // page — a shadow under every card in a dark theme is what makes an
    // interface look muddy. It is wrong for a card on a scrim. A hairline
    // against a dimmed copy of the page underneath is almost no separation at
    // all, so a modal read as part of the thing it was covering.
    //
    // So an overlay climbs the surface ladder instead of relying on its edge —
    // `bg-raised`, a stronger border — and takes a shadow in **both** themes,
    // because this is the one place in the interface where something is
    // genuinely in front of something else.
    in property <bool> elevated: false;
    callback clicked();

    background: root.elevated ? Theme.bg-raised : Theme.bg-surface;
    border-radius: R.lg;
    border-width: 1px;
    border-color: root.elevated ? Theme.border-default
        : root.interactive && touch.has-hover ? Theme.border-default
        : Theme.border-subtle;
    drop-shadow-blur: root.elevated ? 40px : Theme.card-shadow ? 12px : 0px;
    drop-shadow-offset-y: root.elevated ? 10px : Theme.card-shadow ? 2px : 0px;
    drop-shadow-color: root.elevated ? (Theme.dark ? #00000099 : #1011142E)
        : Theme.card-shadow ? #10111412
        : transparent;

    animate border-color { duration: Motion.fast; enabled: Motion.enabled; }

    touch := TouchArea {
        enabled: root.interactive;
        mouse-cursor: root.interactive ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }

    @children
}

// An eyebrow label: 11px, uppercase, tracked out. Used above every figure.
export component Eyebrow inherits Text {
    font-size: Typo.micro;
    font-weight: Typo.w-medium;
    letter-spacing: 0.6px;
    color: Theme.text-tertiary;
}

// Where you are, and the one step back.
//
// # Two levels, not a trail
//
// Because two levels is what this application has. Everything else that goes
// deeper is a sheet over the screen — `TxSheet`, `IdentitySheet` — which comes
// back by closing rather than by climbing. A general breadcrumb would be a
// component built for a hierarchy nobody has.
//
// # Why the root is a button and the leaf is not
//
// The leaf is where you already are, so it is a label. Rendering it as a link
// would offer a journey to the place you are standing, which is the small lie
// that makes people stop trusting breadcrumbs.
export component Breadcrumb inherits HorizontalLayout {
    // The place to go back to — "Markets".
    in property <string> root-text;
    // The place you are — the name of the thing being shown.
    in property <string> leaf-text;
    callback back();

    spacing: Sp.s3;
    alignment: start;

    back-link := Rectangle {
        width: label.width + Sp.s3 * 2;
        height: label.height + Sp.s2 * 2;
        border-radius: R.sm;
        background: touch.has-hover ? Theme.bg-hover : transparent;
        animate background { duration: Motion.fast; enabled: Motion.enabled; }

        label := Text {
            text: root.root-text;
            font-size: Typo.caption;
            font-weight: Typo.w-medium;
            // Secondary rather than accent: this is a way back, not the thing
            // on the screen worth pressing. It brightens on hover, which is
            // where it says it can be pressed at all.
            color: touch.has-hover ? Theme.text-primary : Theme.text-secondary;
            animate color { duration: Motion.fast; enabled: Motion.enabled; }
        }

        // The same ring every other control uses, and only for somebody
        // navigating by keyboard — see `InputMode`.
        if InputMode.keyboard && focus.has-focus: Rectangle {
            border-radius: parent.border-radius;
            border-width: 2px;
            border-color: Theme.accent-ring;
        }

        focus := FocusScope {
            key-pressed(event) => {
                if (event.text == "\n" || event.text == " ") {
                    root.back();
                    return EventResult.accept;
                }
                return EventResult.reject;
            }
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                InputMode.keyboard = false;
                root.back();
            }
        }
    }

    // An icon, not a `›`. That character is in neither bundled face — see the
    // top of `icons.slint` — so it draws nothing or falls through to the host,
    // which is the per-platform fork bundling fonts exists to prevent.
    Icon {
        name: "chevron";
        size: 12px;
        tone: Theme.text-disabled;
        y: (parent.height - self.height) / 2;
    }

    Text {
        text: root.leaf-text;
        font-family: Typo.mono;
        font-size: Typo.caption;
        font-weight: Typo.w-bold;
        color: Theme.text-primary;
        vertical-alignment: center;
        overflow: elide;
    }

    // Announced as the button it is. A label on its own would pass the
    // screen-reader name check and still leave the control impossible to
    // operate — see `a_screen_reader_can_actually_press_a_button`.
    accessible-role: button;
    accessible-label: @tr("Back to {}", root.root-text);
    accessible-action-default => { root.back(); }
}

// The ONLY element allowed to render an amount.
//
// One place owns sign colouring and the monospace family, so a screen cannot
// accidentally render money in a proportional font — where the digits would
// not align in a column and the balance would visibly jitter as it counts up.
export component Money inherits HorizontalLayout {
    in property <string> amount;
    // No default chain, for the reason `WalletState.ticker` gives at length.
    // Thirteen of the eighteen call sites pass `WalletState.ticker`; the other
    // five all set `show-currency: false`, so this literal was never drawn —
    // but `accessible-label` below is not conditioned on `show-currency`, and
    // it read those five amounts out as VRSC on every chain. That is the
    // issue's own failure, heard rather than seen. The label now degrades to
    // the bare amount, which is #15's subject on the Activity screen and is
    // not fixed here.
    in property <string> currency: "";
    // Announced as one thing. Two adjacent texts would otherwise be read as
    // two unrelated items, and an amount without its currency is not an
    // amount.
    accessible-role: AccessibleRole.text;
    accessible-label: @tr("{} {}", root.amount, root.currency);
    in property <length> size: Typo.num;
    // "neutral" | "positive" | "negative" | "muted"
    //
    // `muted` is for an amount that is on screen to make the arithmetic add up
    // rather than to be read — transaction change, and nothing else so far. It
    // is deliberately not a colour with meaning: green and red already say
    // which way money moved, and a third meaning would make the palette a
    // language nobody was taught.
    in property <string> tone: "neutral";
    in property <bool> show-currency: true;
    // Monospace keeps a column of amounts aligned and stops the balance
    // jittering as it counts up — but at hero size Menlo's slashed zero reads
    // as a terminal rather than a wallet. So the big number opts out until a
    // proper text face with tabular figures (JetBrains Mono NL) is bundled, and
    // every amount in a list keeps it, where alignment matters more than
    // character.
    in property <bool> mono: true;

    // Without this the layout stretches to its parent and the currency drifts
    // to the far edge of the window, disconnected from the number it belongs
    // to. `start` keeps the pair together as one reading unit.
    alignment: start;
    spacing: Sp.s3;

    Text {
        text: root.amount;
        font-family: root.mono ? Typo.mono : "";
        font-size: root.size;
        color: root.tone == "positive" ? Theme.positive
            : root.tone == "negative" ? Theme.negative
            : root.tone == "muted" ? Theme.text-tertiary
            : Theme.text-primary;
        vertical-alignment: center;
    }

    if root.show-currency: Text {
        text: root.currency;
        font-family: root.mono ? Typo.mono : "";
        font-size: root.size * 0.62;
        color: Theme.text-tertiary;
        vertical-alignment: center;
    }
}

// A status dot plus text. Colour is never the only signal — the text is always
// there too, which is what makes this readable without colour vision.
export component StatusPill inherits HorizontalLayout {
    // "online" | "degraded" | "offline" | "pending" | "probing" | "unknown"
    in property <string> state: "unknown";
    in property <string> text;

    // The dot carries no information a screen reader can reach, and the text
    // beside it is often just the chain name. Saying both is what makes the
    // colour redundant rather than load-bearing.
    accessible-role: AccessibleRole.text;
    accessible-label: @tr("{}, {}", root.text, root.state);

    property <brush> tone: root.state == "online" ? Theme.positive
        : root.state == "degraded" || root.state == "pending" || root.state == "probing" ? Theme.warning
        : root.state == "offline" ? Theme.negative
        : Theme.text-tertiary;

    spacing: Sp.s3;

    Rectangle {
        width: 7px;
        height: 7px;
        border-radius: 4px;
        background: root.tone;
        y: (parent.height - self.height) / 2;
        animate background { duration: Motion.base; enabled: Motion.enabled; }
    }

    Text {
        text: root.text;
        font-size: Typo.caption;
        color: Theme.text-secondary;
        vertical-alignment: center;
    }
}

// A loading placeholder at the exact dimensions of the thing it stands in for,
// so nothing shifts when the real content arrives.
export component Skeleton inherits Rectangle {
    in property <length> radius: R.sm;
    // A placeholder has nothing to say. Announcing it would put "group, group,
    // group" between the reader and the content they are waiting for.
    accessible-role: AccessibleRole.none;
    background: Theme.bg-inset;
    border-radius: root.radius;
    opacity: 0.7;
}

// Empty states are built in the same commit as the happy path, not added as
// polish. A wallet showing a blank card while fetching reads as broken.
export component EmptyState inherits VerticalLayout {
    in property <string> glyph: "○";
    in property <string> title;
    in property <string> body;
    in property <string> action-text;
    callback action();

    alignment: center;
    spacing: Sp.s4;

    // Optional. Several of the shapes that would suit an empty state — a wave,
    // an arc, a chart glyph — render as nothing in the fonts this build has,
    // which is worse than no glyph at all because it silently takes the space
    // of one. Where there is no character that both fits and exists, the state
    // goes without.
    if root.glyph != "": Text {
        text: root.glyph;
        // Mono, and not for looks: these marks are absent from Space Grotesk and
        // present in JetBrains Mono NL. Left to the UI face they fall through to
        // whatever the system offers, which is the per-platform fork that
        // bundling fonts exists to prevent.
        font-family: Typo.mono;
        font-size: 32px;
        color: Theme.text-tertiary;
        opacity: 0.5;
        horizontal-alignment: center;
    }

    Text {
        text: root.title;
        font-size: Typo.title3;
        font-weight: Typo.w-bold;
        color: Theme.text-primary;
        horizontal-alignment: center;
    }

    if root.body != "": Text {
        text: root.body;
        font-size: Typo.body;
        color: Theme.text-secondary;
        horizontal-alignment: center;
        wrap: word-wrap;
        max-width: 320px;
    }

    if root.action-text != "": HorizontalLayout {
        alignment: center;
        Btn {
            text: root.action-text;
            variant: "primary";
            clicked => { root.action(); }
        }
    }
}

// One row in a list. Fixed height, because uniform rows are what let Slint's
// ListView virtualize cleanly and keep the scrollbar geometry honest.
export component ListRow inherits Rectangle {
    in property <string> glyph;
    in property <brush> glyph-tone: Theme.text-secondary;
    in property <string> title;
    // Set when the TITLE is an identifier rather than a name — an address on a
    // row nobody has named. Same reasoning as `subtitle-mono`: a base58 string
    // set in a proportional font reads as prose.
    in property <bool> title-mono: false;
    in property <string> subtitle;
    // The same line, when what goes there is a **named reason** rather than a
    // string — a relative time, mostly, which the core cannot spell because
    // "2 hours ago" has a plural in it. Exactly one of the two is ever set.
    in property <Note> subtitle-note;
    // Every subtitle in this application is either prose or an identifier — a
    // URL, an address, a transaction id — and an identifier set in a
    // proportional font reads as prose. Mono says "this is a thing you compare
    // character by character" before anybody reads a character of it.
    in property <bool> subtitle-mono: false;
    in property <bool> selected: false;
    in property <bool> interactive: true;
    callback clicked();

    height: 64px;
    background: root.selected ? Theme.accent-soft
        : (root.interactive && touch.has-hover) ? Theme.bg-hover
        : transparent;
    border-radius: R.md;

    animate background { duration: Motion.fast; enabled: Motion.enabled; }

    HorizontalLayout {
        padding-left: Sp.s5;
        padding-right: Sp.s5;
        spacing: Sp.s5;

        if root.glyph != "": Rectangle {
            width: 34px;
            height: 34px;
            y: (parent.height - self.height) / 2;
            border-radius: R.full;
            background: Theme.bg-inset;
            Text {
                text: root.glyph;
                font-family: Typo.mono;
                font-size: 15px;
                color: root.glyph-tone;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                font-family: root.title-mono ? Typo.mono : "";
                font-size: root.title-mono ? Typo.num : Typo.body;
                font-weight: root.title-mono ? Typo.w-regular : Typo.w-medium;
                color: Theme.text-primary;
                overflow: elide;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                font-family: root.subtitle-mono ? Typo.mono : "";
                font-size: root.subtitle-mono ? Typo.num-sm : Typo.caption;
                color: Theme.text-tertiary;
                overflow: elide;
            }
            // Inside the title's column, not beside it. Put one line out of
            // that layout and the relative time floats above the row instead of
            // sitting under the word it qualifies.
            if root.subtitle-note.code != "": NoteText {
                note: root.subtitle-note;
                font-size: Typo.caption;
                color: Theme.text-tertiary;
                overflow: elide;
            }
        }

        @children
    }

    touch := TouchArea {
        enabled: root.interactive;
        clicked => { root.clicked(); }
    }

    // A row that does something is a button, and it is announced by what it
    // says rather than by what it looks like. The subtitle is included because
    // in this application it is always the thing that tells two otherwise
    // identical rows apart — an address, a URL, a transaction id.
    // The role has to be a constant, so a row is always announced as a button
    // and `accessible-enabled` carries whether it can actually be pressed —
    // which is the distinction a reader needs anyway.
    accessible-role: AccessibleRole.button;
    accessible-enabled: root.interactive;
    accessible-label: root.subtitle == "" ? root.title : @tr("{}, {}", root.title, root.subtitle);
    // Opening a row — a transaction, an identity, a node — from a screen
    // reader. Same omission as `Btn`: announced as a button and inert.
    accessible-action-default => {
        if (root.interactive) {
            root.clicked();
        }
    }
}

// A square control that is a picture rather than a word.
//
// # Why this is a component and not another hand-rolled rectangle
//
// Because it is a shape this interface has already got wrong. The title bar's
// Refresh, Lock and theme controls were a `TouchArea` and an `accessible-label`
// and nothing else — announced correctly, unreachable by Tab, and inert when a
// screen reader activated them — and `shell.slint` records fixing all three.
// The copy button beside a transaction id was the same shape with the same
// three defects, and there are now two of these on the card rather than one.
// Hand-rolling the second one would have been a second chance to leave one of
// the three out.
//
// # Why the confirmation is the icon and not a word
//
// A copy that gives no sign it happened gets pressed three times. That sign
// used to be the word "Copied" appearing further down the card, which said
// exactly enough while there was one thing on the card to copy. There are two
// now, and a word in a third place says that *something* was copied without
// saying which. The glyph turning into a tick, in the button that was pressed,
// says both — and it changes no widths, so nothing on the card moves under the
// pointer that is still resting on it.
export component IconButton inherits Rectangle {
    in property <string> icon;
    // Shown in place of `icon` for a moment after a press, or empty for a
    // control whose effect is visible on its own. A copy has no visible effect
    // — the clipboard is somewhere else — which is the whole reason this
    // exists.
    in property <string> confirm-icon;
    // Required, and the reason this is not just an `Icon` in a `TouchArea`:
    // the control carries no text, so this is the only thing a screen reader
    // has to announce it with.
    in property <string> label;
    callback clicked();

    width: 32px;
    height: 32px;
    border-radius: R.sm;
    background: touch.has-hover ? Theme.bg-hover : transparent;
    animate background { duration: Motion.fast; enabled: Motion.enabled; }

    property <bool> confirming: root.confirm-icon != "" && confirmed.running;

    // Both the press paths and the keyboard one end here, so the confirmation
    // cannot be attached to two of the three and forgotten on the third.
    function press() {
        root.clicked();
        confirmed.running = root.confirm-icon != "";
    }

    Icon {
        name: root.confirming ? root.confirm-icon : root.icon;
        size: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        tone: root.confirming ? Theme.accent : Theme.text-secondary;
    }

    confirmed := Timer {
        interval: 1400ms;
        running: false;
        triggered => { self.running = false; }
    }

    // Declared before the touch area so that a pointer press still lands on
    // the touch area: later siblings receive input first. The rule `Btn`
    // states, followed here rather than restated.
    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == "\n" || event.text == " ") {
                root.press();
                return EventResult.accept;
            }
            return EventResult.reject;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.press(); }
    }

    // Outside the control's own bounds, and only while the keyboard is
    // driving. Drawn on the bounds it would sit on top of a 16px glyph in a
    // 32px box and cover the picture that is the entire label.
    if focus.has-focus && InputMode.keyboard: Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: R.sm + 3px;
        border-width: 2px;
        border-color: Theme.accent-ring;
    }

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.press(); }
}

// A transaction id, readable, with everything anybody wants to do to one.
//
// # Why this is a component
//
// Because the send and convert screens both end here, with the same card and
// the same two questions — "what is the id" and "where do I look at it" — and
// the version written twice was wrong in the same way twice: a bare `TextInput`
// stretched across the card, so a 64-character id broke after 63 and left a
// single digit alone on the second line.
//
// The transaction sheet over Activity asked those two questions as well, in its
// own hand-written third copy, and answered the second one differently: it
// offered the link to copy and refused to open it, while these two offered to
// open it and did not hand it over. That is issue #18, and the fix is not a
// third arrangement — it is this component being the only one, used by all
// three, so that "identical on both screens" is a fact about the tree rather
// than a promise two files make separately.
//
// # The arrangement, and why this one
//
// Two boxes with the same shape, each holding a value somebody came here to
// take away, each with the same copy icon at its right-hand end. Copying is
// what the maintainer asked to be an icon and it is the right weight for it:
// it is cheap, it is reversible, and it wants to be *beside its own value*
// rather than in a row of buttons where the reader has to work out which one
// acts on what. Two values, two icons, one convention.
//
// Opening is the one that gets words. It is not a second copy button and
// should not look like one: it hands a transaction id to a third party this
// wallet did not choose, over a network the person may not have wanted to use
// for this, and a bare glyph would be an unlabelled control for the one action
// on the card with a consequence outside the window. So it sits under the
// link, in the accent colour, saying what it does.
//
// Which is also why the URL is on screen at all rather than hidden behind the
// word "open". The sheet showed it and the send screens did not; keeping it is
// the half of the sheet's old position that survives the decision to open as
// well as copy. Somebody about to press "open" can see which host they are
// about to tell, before they tell it, on every screen that offers it — and
// issue #18 is right that this matters *more* on the send screens, where the
// transaction is minutes old and its timing is the correlation worth avoiding.
//
// Nothing here is hover-revealed. Both icons and the link are drawn at rest.
// A secondary action that appears under the pointer is a reasonable trade in a
// dense list of rows and a bad one here: three controls on a card is not
// density to protect, and hover-reveal would take from the keyboard and the
// screen reader the discovery it buys the mouse.
//
// The Activity *rows* get nothing, for the same reason. The id came off those
// rows deliberately — sixty-four hex characters elided to eight made every row
// look like every other, and `activity.slint` records putting it in the sheet
// instead — so hanging two icon buttons off each row would put the identity
// chrome back on the list a previous change took it off, and give a row that
// has one job three competing targets.
export component TxId inherits VerticalLayout {
    in property <string> txid;
    // Where to look it up, or empty on a chain with no explorer this build
    // knows about — in which case nothing about looking it up is offered
    // rather than a dead box and a dead link.
    in property <string> explorer;
    callback open-link(string);

    spacing: Sp.s5;

    VerticalLayout {
        spacing: Sp.s3;
        Eyebrow { text: @tr("TRANSACTION ID"); }

        Rectangle {
            background: Theme.bg-inset;
            border-radius: R.md;
            border-width: 1px;
            border-color: Theme.border-subtle;
            // Its own content's height. See `Notice` for what happens without it.
            height: idbody.preferred-height;

            idbody := HorizontalLayout {
                padding: Sp.s4;
                spacing: Sp.s4;

                field := TextInput {
                    text: root.txid;
                    read-only: true;
                    horizontal-stretch: 1;
                    font-family: Typo.mono;
                    font-size: Typo.num-sm;
                    color: Theme.text-primary;
                    // By character, because a hash has no words in it and
                    // word-wrap leaves the whole thing on one overflowing line.
                    wrap: char-wrap;
                    // A `TextInput` here only so the characters can be
                    // selected; announcing it as a field to type in would be a
                    // lie. Named because `tests/accessibility.rs` is right that
                    // an unnamed one is announced as "text field" and nothing
                    // else.
                    accessible-role: AccessibleRole.text;
                    accessible-label: @tr("Transaction id");
                    accessible-value: root.txid;
                }

                IconButton {
                    y: 0;
                    icon: "copy";
                    confirm-icon: "check";
                    label: @tr("Copy the transaction id");
                    clicked => {
                        field.select-all();
                        field.copy();
                    }
                }
            }
        }
    }

    if root.explorer != "": VerticalLayout {
        spacing: Sp.s3;
        Eyebrow { text: @tr("LOOK IT UP"); }

        Rectangle {
            background: Theme.bg-inset;
            border-radius: R.md;
            border-width: 1px;
            border-color: Theme.border-subtle;
            height: linkbody.preferred-height;

            linkbody := HorizontalLayout {
                padding: Sp.s4;
                spacing: Sp.s4;

                link := TextInput {
                    text: root.explorer;
                    read-only: true;
                    horizontal-stretch: 1;
                    font-family: Typo.mono;
                    font-size: Typo.num-sm;
                    // Quieter than the id above it. The id is the fact; this
                    // is one place that happens to know about it.
                    color: Theme.text-secondary;
                    wrap: char-wrap;
                    accessible-role: AccessibleRole.text;
                    accessible-label: @tr("Link to this transaction in the block explorer");
                    accessible-value: root.explorer;
                }

                IconButton {
                    y: 0;
                    icon: "copy";
                    confirm-icon: "check";
                    label: @tr("Copy the link to this transaction");
                    clicked => {
                        link.select-all();
                        link.copy();
                    }
                }
            }
        }

        // Accent-coloured at rest, not on hover. It is a link, and a link that
        // only looks like one once the pointer is already on it has not helped
        // anybody find it.
        HorizontalLayout {
            alignment: start;

            // No hover fill behind it, unlike the copy buttons. A fill needs
            // padding to look like anything, and padding is what pushed the eye
            // four pixels right of the left edge every other thing in this
            // component starts at — the eyebrow, both boxes, the id. A link
            // that is already accent-coloured, already changes weight and
            // already turns the cursor does not need a fifth signal badly
            // enough to sit crooked for it.
            Rectangle {
                width: openrow.preferred-width;
                height: openrow.preferred-height;

                openrow := HorizontalLayout {
                    spacing: Sp.s2;

                    Icon {
                        // Looking it up, not a market. `markets` is a trend
                        // arrow and reads as a price on a screen that has
                        // nothing to do with one.
                        name: "eye";
                        size: 13px;
                        y: (parent.height - self.height) / 2;
                        tone: Theme.accent;
                    }

                    Text {
                        text: @tr("Open in the block explorer");
                        font-size: Typo.caption;
                        font-weight: opentouch.has-hover ? Typo.w-medium : Typo.w-regular;
                        color: Theme.accent;
                        vertical-alignment: center;
                    }
                }

                openfocus := FocusScope {
                    key-pressed(event) => {
                        if (event.text == "\n" || event.text == " ") {
                            root.open-link(root.explorer);
                            return EventResult.accept;
                        }
                        return EventResult.reject;
                    }
                }

                opentouch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open-link(root.explorer); }
                }

                if openfocus.has-focus && InputMode.keyboard: Rectangle {
                    x: -5px;
                    y: -4px;
                    width: parent.width + 10px;
                    height: parent.height + 8px;
                    border-radius: R.sm + 3px;
                    border-width: 2px;
                    border-color: Theme.accent-ring;
                }

                accessible-role: button;
                accessible-label: @tr("Open this transaction in the block explorer");
                accessible-action-default => { root.open-link(root.explorer); }
            }
        }
    }
}
