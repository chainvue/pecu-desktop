import { Theme } from "../theme/theme.slint";

// The interface's icons, as vector paths.
//
// # Why these are not characters
//
// They used to be: `◆`, `≡`, `⊙` and a dozen more, set in whatever the UI face
// was. That works exactly as long as the shipped font happens to contain them,
// and it stopped working the moment the faces changed — every one of those
// marks is in JetBrains Mono NL and in none of the three Space Grotesk weights,
// so they drew nothing at all or fell through to the host system, which is the
// per-platform fork that bundling fonts exists to prevent. `app.slint` records
// being caught by that four separate times.
//
// A path cannot be missing. It is in this file.
//
// # Where they come from
//
// `docs/design/design-kit/Pecu Design Kit.html`, converted rather than
// transcribed: the kit draws them with `<path>`, `<circle>`, `<line>`,
// `<polyline>` and `<rect>`, and those were mechanically rewritten to path
// commands on the same 24-unit grid. Two marks the kit does not ship —
// `network` and `currency` — are drawn here in the same idiom.
//
// A few icons have a filled dot as well as an outline (`wallet`, `shielded`,
// `warning`). One `Path` carries one stroke and one fill, so those are two
// elements, and the commands are kept in two properties rather than two dozen
// conditional blocks.
export component Icon inherits Rectangle {
    // The design's names, lower-cased. An unknown name draws nothing, on
    // purpose: a missing icon should be a hole, not a wrong picture.
    in property <string> name;
    in property <length> size: 15px;
    in property <brush> tone: Theme.text-secondary;

    width: root.size;
    height: root.size;

    // The design's stroke is 2 units on a 24-unit grid.
    //
    // `stroke-width` is in **screen pixels**, not in the path's coordinates —
    // measured, after the first attempt passed `2px` straight through and drew
    // a set of blobs: at a 17px icon that is the weight the grid intends at
    // 24px, so a 4-unit head became a filled dot and the gear became a smear.
    // Scaling it by the rendered size is what keeps the drawing the design's at
    // every size the interface asks for.
    property <float> weight: 2.0;
    property <length> stroke-w: root.size * root.weight / 24;

    property <string> stroked:
        root.name == "chat" ? "M21 12a8 8 0 0 1-8 8H4l2.3-2.9A8 8 0 1 1 21 12z"
      : root.name == "check" ? "M 3.0 12.0 A 9.0 9.0 0 1 0 21.0 12.0 A 9.0 9.0 0 1 0 3.0 12.0 Z M 8 12.5 L 11 15.5 L 16 9.5"
      : root.name == "convert" ? "M17 3l4 4-4 4 M21 7H7 M7 21l-4-4 4-4 M3 17h14"
      : root.name == "copy" ? "M 11.0 9.0 H 19.0 A 2.0 2.0 0 0 1 21.0 11.0 V 19.0 A 2.0 2.0 0 0 1 19.0 21.0 H 11.0 A 2.0 2.0 0 0 1 9.0 19.0 V 11.0 A 2.0 2.0 0 0 1 11.0 9.0 Z M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
      : root.name == "currency" ? "M 12 3 A 9 9 0 1 0 12 21 A 9 9 0 1 0 12 3 Z M 9 12 A 3 3 0 1 0 15 12 A 3 3 0 1 0 9 12 Z"
      : root.name == "declined" ? "M 3.0 12.0 A 9.0 9.0 0 1 0 21.0 12.0 A 9.0 9.0 0 1 0 3.0 12.0 Z M 9 9 L 15 15 M 15 9 L 9 15"
      : root.name == "eye" ? "M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z M 9.0 12.0 A 3.0 3.0 0 1 0 15.0 12.0 A 3.0 3.0 0 1 0 9.0 12.0 Z"
      : root.name == "history" ? "M 3.0 12.0 A 9.0 9.0 0 1 0 21.0 12.0 A 9.0 9.0 0 1 0 3.0 12.0 Z M 12 7 L 12 12 L 15.5 14"
      : root.name == "login" ? "M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4 M 10 17 L 15 12 L 10 7 M 15 12 L 3 12"
      : root.name == "markets" ? "M 3 17 L 9 11 L 13 14 L 21 6 M 15 6 L 21 6 L 21 12"
      : root.name == "network" ? "M 12 3 A 9 9 0 1 0 12 21 A 9 9 0 1 0 12 3 Z M 3 12 H 21 M 12 3 A 4.5 9 0 0 1 12 21 A 4.5 9 0 0 1 12 3 Z"
      : root.name == "plus" ? "M 12 5 L 12 19 M 5 12 L 19 12"
      : root.name == "profile" ? "M 8.0 8.0 A 4.0 4.0 0 1 0 16.0 8.0 A 4.0 4.0 0 1 0 8.0 8.0 Z M4 21c1.5-3.5 4.5-5 8-5s6.5 1.5 8 5"
      : root.name == "receive" ? "M 12 5 L 12 19 M 5 12 L 12 19 L 19 12"
      : root.name == "scan" ? "M3 7V5a2 2 0 0 1 2-2h2 M17 3h2a2 2 0 0 1 2 2v2 M21 17v2a2 2 0 0 1-2 2h-2 M7 21H5a2 2 0 0 1-2-2v-2 M 7 12 L 17 12"
      : root.name == "search" ? "M 4.0 11.0 A 7.0 7.0 0 1 0 18.0 11.0 A 7.0 7.0 0 1 0 4.0 11.0 Z M 21 21 L 16.5 16.5"
      : root.name == "seed" ? "M 5.0 11.0 H 19.0 A 2.0 2.0 0 0 1 21.0 13.0 V 19.0 A 2.0 2.0 0 0 1 19.0 21.0 H 5.0 A 2.0 2.0 0 0 1 3.0 19.0 V 13.0 A 2.0 2.0 0 0 1 5.0 11.0 Z M7 11V7a5 5 0 0 1 10 0v4"
      : root.name == "send" ? "M 12 19 L 12 5 M 5 12 L 12 5 L 19 12"
      : root.name == "settings" ? "M 9.0 12.0 A 3.0 3.0 0 1 0 15.0 12.0 A 3.0 3.0 0 1 0 9.0 12.0 Z M12 2v3M12 19v3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M2 12h3M19 12h3M4.9 19.1L7 17M17 7l2.1-2.1"
      : root.name == "shielded" ? "M12 3l7 3v5c0 5-3.5 8-7 10-3.5-2-7-5-7-10V6z"
      : root.name == "wallet" ? "M20 7H5a2 2 0 0 1 0-4h13v4 M3 5v13a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1V8a1 1 0 0 0-1-1"
      : root.name == "warning" ? "M12 3l10 18H2z M 12 10 L 12 14"
      : "";

    property <string> filled:
        root.name == "shielded" ? "M 10.0 11.0 A 2.0 2.0 0 1 0 14.0 11.0 A 2.0 2.0 0 1 0 10.0 11.0 Z"
      : root.name == "wallet" ? "M 15.2 13.5 A 1.3 1.3 0 1 0 17.8 13.5 A 1.3 1.3 0 1 0 15.2 13.5 Z"
      : root.name == "warning" ? "M 11.2 17.0 A 0.8 0.8 0 1 0 12.8 17.0 A 0.8 0.8 0 1 0 11.2 17.0 Z"
      : "";

    if root.stroked != "": Path {
        commands: root.stroked;
        viewbox-width: 24;
        viewbox-height: 24;
        width: root.size;
        height: root.size;
        // Explicit rather than omitted. Several of these outlines close into
        // shapes a fill rule would flood, and the default is not worth relying
        // on for a set of drawings whose whole job is to be outlines.
        //
        // (This was added while chasing a wallet icon that looked solid. It was
        // not — that was a blurred upscale of an 18px crop, and the icon had
        // been correct all along. The line stays because the reason above is
        // real; the bug it was written for was not.)
        fill: transparent;
        stroke: root.tone;
        stroke-width: root.stroke-w;
        // The design asks for round caps and round joins, and both are
        // properties here rather than something to approximate.
        stroke-line-cap: round;
        stroke-line-join: round;
    }

    if root.filled != "": Path {
        commands: root.filled;
        viewbox-width: 24;
        viewbox-height: 24;
        width: root.size;
        height: root.size;
        fill: root.tone;
    }
}
