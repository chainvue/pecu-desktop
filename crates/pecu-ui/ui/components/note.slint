import { Theme, Typo, R, Sp } from "../theme/theme.slint";
import { Note } from "../vm/structs.slint";

// The words for the reasons the core names.
//
// # Why this file exists
//
// `pecu-core` used to return finished English prose — "More than the 12.5 you
// can spend now." — and around a hundred and forty of those are scattered
// through it. Two problems, and the smaller one is the translation:
//
//   * `@tr` reaches `.slint` and nothing else, so every sentence written in
//     Rust was permanently English however many `.po` files the project grew;
//   * and deciding *how to say it* was never the core's job. It owns the
//     address rules and the fee rules, so it knows what is wrong. It does not
//     know how wide the line is, what is beside it, or what language it is in.
//
// So the core names the reason and supplies the values. The words are here.
//
// # An unknown code shows itself
//
// Rather than rendering as nothing. A code with no sentence is a bug — somebody
// added a refusal and did not write it down — and a blank line beside a refused
// field hides it until a person hits that case in the wild. The code is ugly on
// screen, which is the point.
export component NoteText inherits Text {
    in property <Note> note;
    // What the sentence is *about*, when a caller wants the tone to say so.
    in property <bool> problem: false;

    // The month a day heading names, from the index the core sent. Twelve
    // words that would otherwise be twelve untranslatable strings in Rust.
    property <string> month:
          root.note.args.length < 2 ? ""
        : root.note.args[1] == "0" ? @tr("January")
        : root.note.args[1] == "1" ? @tr("February")
        : root.note.args[1] == "2" ? @tr("March")
        : root.note.args[1] == "3" ? @tr("April")
        : root.note.args[1] == "4" ? @tr("May")
        : root.note.args[1] == "5" ? @tr("June")
        : root.note.args[1] == "6" ? @tr("July")
        : root.note.args[1] == "7" ? @tr("August")
        : root.note.args[1] == "8" ? @tr("September")
        : root.note.args[1] == "9" ? @tr("October")
        : root.note.args[1] == "10" ? @tr("November")
        : root.note.args[1] == "11" ? @tr("December")
        : root.note.args[1];

    // Positional, because a translated sentence puts its values in its own
    // order — German moves them and English does not, and `{0}` is what lets a
    // catalogue do that without the core knowing.
    text: root.note.code == "" ? ""

        // ── The recipient field ─────────────────────────────────────────
        : root.note.code == "address-transparent" ? @tr("Transparent address")
        : root.note.code == "address-verusid" ? @tr("VerusID")
        : root.note.code == "address-script" ? @tr("Script address")
        : root.note.code == "address-unparsable"
            ? @tr("Not a Verus address. They start with R for a key, or i for a VerusID.")

        // ── What a node said about a name ───────────────────────────────
        : root.note.code == "verusid-resolving" ? @tr("Looking this VerusID up…")
        : root.note.code == "verusid-unknown" ? @tr("No VerusID by that name on this chain.")
        : root.note.code == "verusid-resolved"
            ? @tr("VerusID {0} · {1}", root.note.args[0], root.note.args[1])
        : root.note.code == "verusid-revoked"
            ? @tr("{0} has been revoked. This wallet will not pay it.", root.note.args[0])
        : root.note.code == "verusid-moved"
            ? @tr("{0} now points at {1} — it was {2}. Check this before sending.",
                  root.note.args[0], root.note.args[1], root.note.args[2])

        // ── The amount field ────────────────────────────────────────────
        : root.note.code == "amount-zero" ? @tr("Enter an amount above zero.")
        : root.note.code == "amount-above-spendable"
            ? @tr("More than the {0} you can spend now.", root.note.args[0])
        : root.note.code == "amount-unparsable"
            ? @tr("Not an amount. Up to eight decimal places, like 1.5 or 0.00000001.")

        // ── What an output is ───────────────────────────────────────────
        : root.note.code == "output-payment" ? @tr("Payment")
        : root.note.code == "output-to-public-key" ? @tr("Payment to a public key")
        : root.note.code == "output-to-verusid" ? @tr("Payment to a VerusID")
        : root.note.code == "output-token" ? @tr("Token output")
        // The address beside this one is the delivery address inside the
        // payload, not the script's own — see `send::describe`. A conversion
        // output pays a protocol constant that belongs to nobody, and putting
        // that on a review would be an address somebody could not check.
        : root.note.code == "output-conversion" ? @tr("Conversion · delivered to the address above")
        : root.note.code == "output-unreadable" ? @tr("Could not be read")
        : root.note.code == "output-unrecognised"
            ? @tr("An output this build cannot read: {0}", root.note.args[0])

        // ── When something happened ─────────────────────────────────────
        //
        // A relative time and a day heading, both built from a code and a
        // count. The core cannot spell either: "2 hours ago" has a plural in
        // it, and "12 March" puts the day before the month in about half the
        // languages this will be translated into and after it in the rest.
        : root.note.code == "when-pending" ? @tr("pending")
        : root.note.code == "when-just-now" ? @tr("just now")
        : root.note.code == "when-yesterday" ? @tr("yesterday")
        : root.note.code == "when-minutes"
            ? @tr("{n} minute ago" | "{n} minutes ago" % root.note.args[0].to-float())
        : root.note.code == "when-hours"
            ? @tr("{n} hour ago" | "{n} hours ago" % root.note.args[0].to-float())
        : root.note.code == "when-days"
            ? @tr("{n} day ago" | "{n} days ago" % root.note.args[0].to-float())
        : root.note.code == "when-months"
            ? @tr("{n} month ago" | "{n} months ago" % root.note.args[0].to-float())

        : root.note.code == "day-pending" ? @tr("Pending")
        : root.note.code == "day-unknown" ? @tr("Unknown date")
        : root.note.code == "day-today" ? @tr("Today")
        : root.note.code == "day-yesterday" ? @tr("Yesterday")
        // The month arrives as an index, so the name is chosen here and the
        // order of the two is the sentence's to decide.
        : root.note.code == "day-this-year" ? @tr("{0} {1}", root.note.args[0], root.month)
        : root.note.code == "day-other-year"
            ? @tr("{0} {1} {2}", root.note.args[0], root.month, root.note.args[2])

        // ── The bar above a form, saying why the button is off ──────────
        //
        // The interface's own sentences, in the same table as the core's. They
        // are here rather than inline because the bar's note is sometimes the
        // **core's** refusal instead — a name the registrar will not take —
        // and a property that is a sentence on one branch and a reason on the
        // next cannot be either.
        : root.note.code == "bar-nothing-spent" ? @tr("Nothing is spent yet.")
        : root.note.code == "bar-type-a-name" ? @tr("Type a name to continue")
        : root.note.code == "bar-choose-identity" ? @tr("Choose an identity, or claim a new name.")
        : root.note.code == "bar-choose-authority"
            ? @tr("Choose one. This cannot be changed for free later.")
        : root.note.code == "bar-name-recovery"
            ? @tr("Name the recovery authority, or choose the other answer.")
        : root.note.code == "bar-claims-and-pays"
            ? @tr("This press claims the name and pays for it. The launch is reviewed after.")
        : root.note.code == "bar-nothing-blocking"
            ? @tr("Nothing is blocking it. The next screen is a review — nothing is spent yet.")
        : root.note.code == "bar-first-transaction"
            ? @tr("This press signs and sends the first transaction.")
        : root.note.code == "bar-things-to-fix"
            // The count arrives as a string, because that is what a `Note`
            // carries; `to-float` hands it back to the plural form, which is
            // the only thing in Slint that can choose between one and many in
            // a language that has more than two cases.
            ? @tr("{n} thing to fix, above" | "{n} things to fix, above"
                  % root.note.args[0].to-float())

        // ── What this wallet can do with a VerusID ──────────────────────
        : root.note.code == "control-none"
            ? @tr("This wallet holds none of the keys. You can read this identity but not change it.")
        : root.note.code == "control-enough"
            ? @tr("This wallet holds {0} of the {1} signatures needed.",
                  root.note.args[0], root.note.args[1])
        : root.note.code == "control-short"
            ? @tr("This wallet holds {0} of the {1} signatures needed — not enough on its own.",
                  root.note.args[0], root.note.args[1])

        // ── A timelock, in the words that do not overpromise ────────────
        : root.note.code == "timelock-held"
            ? @tr("Locked. The funds cannot be spent, and nothing is counting down yet — unlocking publishes a height {0} blocks out and the wait starts then.",
                  root.note.args[0])
        : root.note.code == "timelock-counting"
            ? @tr("Counting down. The funds stay held until block {0}; the transaction that started this did not end the lock.",
                  root.note.args[0])
        : root.note.code == "timelock-revoked"
            ? @tr("Revoked. Only its recovery authority can bring it back.")
        : root.note.code == "timelock-none" ? @tr("Not locked.")

        // ── What a change will do, before it is signed ──────────────────
        : root.note.code == "change-nothing" ? @tr("Nothing to change.")
        : root.note.code == "change-revocation"
            ? @tr("Points revocation to {0} — after this, only they can take that action, and this wallet cannot take it back.",
                  root.note.args[0])
        : root.note.code == "change-recovery"
            ? @tr("Points recovery to {0} — after this, only they can take that action, and this wallet cannot take it back.",
                  root.note.args[0])
        : root.note.code == "change-both-authorities"
            ? @tr("Points revocation to {0} and recovery to {1} — after this, only they can take those actions, and this wallet cannot take them back.",
                  root.note.args[0], root.note.args[1])
        : root.note.code == "change-lock"
            ? @tr("Holds the funds. Nothing counts down until somebody asks to unlock, and then the wait is {0} blocks.",
                  root.note.args[0])
        : root.note.code == "change-unlock"
            ? @tr("Starts the countdown. It does not unlock the identity: the funds stay held until the chain reaches the height this publishes, and that height is measured from this transaction rather than from now.")
        : root.note.code == "change-revoke"
            ? @tr("Revokes the identity. It can no longer be updated or spent from by its own keys, and only its recovery authority can bring it back — so if that authority is the identity itself, nothing can.")
        : root.note.code == "change-recover"
            ? @tr("Clears the revocation and hands the identity back to its primary addresses.")

        // ── Claiming a name: the deadline, and the name itself ──────────
        : root.note.code == "claim-deadline"
            ? @tr("Must confirm before block {0} — about {1} minutes",
                  root.note.args[0], root.note.args[1])
        : root.note.code == "claim-deadline-passed"
            ? @tr("The deadline passed at block {0}", root.note.args[0])
        : root.note.code == "name-too-long" ? @tr("Too long — 64 characters at most.")
        : root.note.code == "name-bad-characters"
            ? @tr("Only lowercase letters, digits, _ and -. Remove: {0}", root.note.args[0])
        : root.note.code == "name-taken" ? @tr("That name is already registered.")
        : root.note.code == "name-unchecked" ? @tr("Could not check whether that name is free.")
        : root.note.code == "verusid-unreadable"
            ? @tr("Could not read it: {0}", root.note.args[0])

        // ── The definition preview, line by line ────────────────────────
        : root.note.code == "field-kind" ? @tr("Kind")
        : root.note.code == "field-defined-under" ? @tr("Defined under")
        : root.note.code == "field-its-address" ? @tr("Its address")
        : root.note.code == "field-starts-at-block" ? @tr("Starts at block")
        : root.note.code == "field-supply-can-grow" ? @tr("Supply can grow")
        : root.note.code == "field-mintable-yes" ? @tr("Yes — this identity may mint more")
        : root.note.code == "field-mintable-no" ? @tr("No — fixed at launch, forever")
        : root.note.code == "field-reserves" ? @tr("Reserves")
        : root.note.code == "field-starting-supply" ? @tr("Starting supply")

        // ── What a currency is, and what a draft gets wrong ─────────────
        : root.note.code == "kind-basket" ? @tr("Holds reserves and converts between them.")
        : root.note.code == "kind-nft" ? @tr("A single indivisible unit.")
        : root.note.code == "currency-starts-at" ? @tr("Starts at block {0}", root.note.args[0])
        : root.note.code == "draft-pick-identity"
            ? @tr("Choose the identity this currency will be defined under, or claim a new name for it. A currency cannot exist without one.")
        : root.note.code == "draft-two-names"
            ? @tr("This draft names both {0} and a new name, {1}. It can only be defined under one.",
                  root.note.args[0], root.note.args[1])
        : root.note.code == "draft-basket-no-reserves"
            ? @tr("A basket needs at least one reserve. Without one it holds nothing and converts nothing.")
        : root.note.code == "draft-reserve-no-currency" ? @tr("A reserve has no currency.")
        : root.note.code == "draft-reserve-twice"
            ? @tr("{0} is listed twice. Each reserve appears once, with one weight.", root.note.args[0])
        : root.note.code == "draft-reserve-no-weight"
            ? @tr("{0} has no weight. Every reserve needs a share of the basket.", root.note.args[0])
        : root.note.code == "draft-weights-wrong"
            ? @tr("The weights add up to {0}, not 100%. Consensus reads them as shares of one whole.",
                  root.note.args[0])
        : root.note.code == "draft-nft-no-reserves"
            ? @tr("An NFT holds no reserves. It is a single indivisible unit, and that is the whole of it.")
        : root.note.code == "draft-nft-one-holder" ? @tr("An NFT is one unit and can go to one holder.")
        : root.note.code == "draft-nft-never-sent"
            ? @tr("No NFT has ever been accepted by a node from this wallet's SDK. The transaction is built correctly against two live examples, and has never been sent.")
        : root.note.code == "draft-token-no-reserves"
            ? @tr("A token holds no reserves. Add them and it becomes a basket, which is a different thing.")
        : root.note.code == "draft-supply-none-ever"
            ? @tr("This would launch a currency with no supply that can never be minted — it could never hold anything, and that cannot be undone.")
        : root.note.code == "draft-supply-mint-later"
            ? @tr("No starting supply. Nothing exists until it is minted, which only this identity can do.")
        : root.note.code == "draft-alloc-no-recipient" ? @tr("A preallocation has no recipient.")
        : root.note.code == "draft-alloc-nothing" ? @tr("{0} is allocated nothing.", root.note.args[0])
        : root.note.code == "draft-start-needed"
            ? @tr("Choose how many blocks ahead it starts. Consensus refuses a currency that begins at or before the current block.")
        : root.note.code == "draft-start-far"
            ? @tr("That is {0} blocks away — roughly {1} days. Nothing happens until then.",
                  root.note.args[0], root.note.args[1])
        : root.note.code == "draft-start-past-chain" ? @tr("That start is beyond the end of the chain.")

        // ── Which identity may define a currency ────────────────────────
        : root.note.code == "eligible-already-defines"
            ? @tr("Already defines {0}. An identity can define one currency, and only once.",
                  root.note.args[0])
        : root.note.code == "eligible-unknown"
            ? @tr("The node would not say whether this already defines a currency.")
        : root.note.code == "eligible-cannot-sign"
            ? @tr("This wallet does not hold the keys that sign for it.")
        : root.note.code == "eligible-revoked" ? @tr("Revoked. A revoked identity cannot define a currency.")
        : root.note.code == "eligible-timelocked"
            ? @tr("Timelocked. Its output cannot be spent until the lock passes.")

        // ── A VerusID's condition ───────────────────────────────────────
        : root.note.code == "identity-locked"
            ? @tr("Funds held. Unlocking starts a {0}-block wait.", root.note.args[0])
        : root.note.code == "identity-unlocking" ? @tr("Unlocks at block {0}", root.note.args[0])
        : root.note.code == "identity-revoked" ? @tr("Only its recovery authority can bring it back.")

        // ── Claiming a name ─────────────────────────────────────────────
        : root.note.code == "claim-signed-not-sent"
            ? @tr("Signed and written down. Nothing has been sent yet.")
        : root.note.code == "claim-on-its-way" ? @tr("The claim is on its way. Waiting for it to be mined.")
        : root.note.code == "claim-waiting"
            ? @tr("The claim is on the chain with {0} confirmations. One is enough to register.",
                  root.note.args[0])
        : root.note.code == "claim-confirmed" ? @tr("The claim has confirmed. The name can be registered now.")
        : root.note.code == "claim-reorged"
            ? @tr("The chain moved underneath the claim: {0}", root.note.args[0])
        : root.note.code == "claim-gone"
            ? @tr("The claim is no longer on the chain. Its fee is spent and the name was not registered.")
        : root.note.code == "claim-expired"
            ? @tr("The claim expired at block {0}. Its fee is spent, the name was not registered, and the same claim cannot be sent again — the expiry is inside the bytes it was signed with.",
                  root.note.args[0])
        : root.note.code == "claim-unrecognised"
            ? @tr("The node reported something this build does not recognise.")
        : root.note.code == "claim-registered" ? @tr("The identity exists on the chain.")

        // ── Launching, and reading the chain's currency list ────────────
        : root.note.code == "launch-defines-once"
            ? @tr("Defines {0} under this identity. An identity can define one currency, and only once — this cannot be undone or repeated.",
                  root.note.args[0])
        : root.note.code == "launch-name-ready"
            ? @tr("{0} exists and nothing has been defined under it. It can never be used for a different currency.",
                  root.note.args[0])
        : root.note.code == "launch-name-claiming"
            ? @tr("Claiming {0} first. The currency is defined once the name is on the chain.",
                  root.note.args[0])
        : root.note.code == "catalog-no-node"
            ? @tr("No node is connected, so the chain's currencies cannot be listed.")
        : root.note.code == "catalog-unreadable"
            ? @tr("The chain's currencies could not be listed. {0}", root.note.args[0])

        // ── What a node is doing ────────────────────────────────────────
        : root.note.code == "node-catching-up"
            ? @tr("catching up — {0} of {1} blocks", root.note.args[0], root.note.args[1])
        : root.note.code == "node-other-chain" ? @tr("this node is on {0}", root.note.args[0])
        : root.note.code == "node-refused-method" ? @tr("refused {0}", root.note.args[0])
        : root.note.code == "node-offline" ? root.note.args[0]

        // ── The figures over a history ──────────────────────────────────
        : root.note.code == "stat-transactions-30d" ? @tr("Transactions · 30d")
        : root.note.code == "stat-sent-30d" ? @tr("Sent · 30d")
        : root.note.code == "stat-received-30d" ? @tr("Received · 30d")
        : root.note.code == "stat-signins-30d" ? @tr("Sign-ins · 30d")

        // ── The steps a flow is made of ─────────────────────────────────
        //
        // Both the interface's own breadcrumb — which question you are on — and
        // the core's plan of what the chain will be asked to do. Two different
        // lists, one vocabulary: a form that said "Check and launch" over a
        // plan that said "Review the launch" would be describing two products.
        : root.note.code == "step-choose-the-name" ? @tr("Choose the name")
        : root.note.code == "step-choose-a-name" ? @tr("Choose a name")
        : root.note.code == "step-who-can-take-it-back" ? @tr("Who can take it back")
        : root.note.code == "step-check-and-claim" ? @tr("Check and claim")
        : root.note.code == "step-check-and-launch" ? @tr("Check and launch")
        : root.note.code == "step-kind" ? @tr("Kind")
        : root.note.code == "step-identity" ? @tr("Identity")
        : root.note.code == "step-name" ? @tr("Name")
        : root.note.code == "step-set-it-up" ? @tr("Set it up")
        : root.note.code == "step-claim-the-name" ? @tr("Claim the name")
        : root.note.code == "step-register-the-identity" ? @tr("Register the identity")
        : root.note.code == "step-register-it" ? @tr("Register it")
        : root.note.code == "step-wait-to-confirm" ? @tr("Wait for it to confirm")
        : root.note.code == "step-define-the-currency" ? @tr("Define the currency")

        // ── The figures beside a market ─────────────────────────────────
        : root.note.code == "stat-exit-depth" ? @tr("Exit @2% · {0}", root.note.args[0])
        : root.note.code == "stat-supply" ? @tr("Supply")
        : root.note.code == "stat-reserves" ? @tr("Reserves")
        : root.note.code == "stat-venues" ? @tr("Venues")
        : root.note.code == "stat-quoted-in" ? @tr("Quoted in")

        // ── Where a price came from ─────────────────────────────────────
        : root.note.code == "price-from-notarization"
            ? @tr("Mid price from reserve state notarized at block {0}, before the conversion fee.",
                  root.note.args[0])
        : root.note.code == "price-no-pool"
            ? @tr("No started pool holds both {0} and {1}.",
                  root.note.args[0], root.note.args[1])

        // ── Converting ──────────────────────────────────────────────────
        : root.note.code == "convert-pick-both"
            ? @tr("Choose what to pay with and what to receive.")
        : root.note.code == "convert-same-currency"
            ? @tr("Those are the same currency.")
        : root.note.code == "convert-no-route"
            ? @tr("No started basket holds both {0} and {1}, so there is no single conversion between them.",
                  root.note.args[0], root.note.args[1])
        : root.note.code == "convert-above-holding"
            ? @tr("More than the {0} {1} this wallet holds.",
                  root.note.args[0], root.note.args[1])
        : root.note.code == "convert-slippage-high"
            ? @tr("This is a large share of the pool. The price moves as the conversion goes through and the estimate already accounts for it — {0} of it. A smaller amount, or a different route, would lose less.",
                  root.note.args[0])
        : root.note.code == "convert-unpriced"
            ? @tr("The node could not price this conversion. Nothing has been sent.")
        : root.note.code == "convert-bad-recipient"
            ? @tr("A conversion can only be delivered to an R-address. Nothing has been signed.")
        : root.note.code == "convert-bad-currency"
            ? @tr("One of those is not a currency this wallet can identify. Nothing has been signed.")
        : root.note.code == "convert-below-floor"
            ? @tr("The price moved while this was being prepared: the node now expects {0}, and {1} was the least this was worth doing at. Nothing has been signed.",
                  root.note.args[0], root.note.args[1])
        : root.note.code == "convert-unusable-tokens"
            ? @tr("This wallet holds that currency in outputs that also carry another one, and a single conversion cannot spend those without destroying what else is in them.")
        : root.note.code == "convert-build-failed"
            ? @tr("The conversion could not be built. Nothing has been signed.")
        // The one that will be seen most, for as long as the network has
        // conversions paused. It says the node refused — not the wallet — and
        // the node's own sentence is in the toast beside it.
        : root.note.code == "convert-refused-by-node"
            ? @tr("The network refused this conversion. Nothing was spent.")

        // ── What the protocol has switched off ──────────────────────────
        //
        // The **effect**, never the switch's name. `disabledefi` means nothing
        // to anybody; "conversions are halted" does.
        : root.note.code == "halt-conversions"
            ? @tr("The network has conversions switched off. Prices are still published, and nothing can be traded at them — a conversion signed now would be rejected before it reached a block.")
        : root.note.code == "halt-pbaas-bridge"
            ? @tr("Transfers between Verus chains are switched off. Conversions on this chain are unaffected.")
        : root.note.code == "halt-eth-gateway"
            ? @tr("The Ethereum bridge is switched off. Conversions on this chain are unaffected.")
        : root.note.code == "chain-housekeeping"
            ? @tr("The protocol has a routine change in force. Nothing you can do here is affected.")
        : root.note.code == "halt-unrecognised"
            ? @tr("The protocol has a change in force that this build does not recognise: {0}", root.note.args[0])
        : root.note.code == "halt-unreadable"
            ? @tr("The chain published something about a protocol change that this build could not read.")
        : root.note.code == "halt-unknown"
            ? @tr("Could not check whether the network is taking conversions. It may not be.")
        : root.note.code == "halt-unconfigured"
            ? @tr("This build does not know where this chain announces protocol changes, so it cannot say whether conversions are being taken.")

        // A code nobody wrote a sentence for. Visible on purpose.
        : root.note.code;

    font-size: Typo.caption;
    color: root.problem ? Theme.negative : Theme.text-tertiary;
    wrap: word-wrap;
}

// What the wallet said, in a headline.
//
// # Why this is a second chain rather than a field on the first
//
// Because a toast has two lines with different jobs — what happened, and what
// to do about it — and only some codes have both. Keeping them apart lets a
// code carry a headline alone, which most of them do, without every entry in
// the table having to write an empty string for the half it does not use.
//
// The codes are the same ones `NoteText` renders. A refusal that reaches a
// field and a refusal that reaches a toast are the same fact, and the day one
// of them is shown in the other place it should not need a second sentence.
export component NoticeTitle inherits Text {
    in property <Note> note;
    // How many times this has been said. The suffix is here rather than around
    // the component so the sentence and its count stay one string — a count in
    // a second `Text` beside it would wrap onto its own line at the width this
    // card actually has.
    in property <int> count: 1;

    property <string> sentence: root.note.code == "" ? ""

        // ── The wallet, the vault, the passphrase ───────────────────────
        : root.note.code == "wallet-create-failed" ? @tr("Could not create the wallet")
        : root.note.code == "passphrase-wrong"
            ? @tr("That is not the passphrase this wallet is using")
        : root.note.code == "passphrase-changed" ? @tr("Passphrase changed")
        : root.note.code == "wallet-locked" ? @tr("The wallet is locked")
        : root.note.code == "backup-record-failed" ? @tr("Could not record the backup")
        : root.note.code == "backup-in-progress"
            ? @tr("Finish writing down the current recovery phrase first")

        // ── Importing a key ─────────────────────────────────────────────
        : root.note.code == "import-not-a-verus-key"
            ? @tr("That is not a private key Pecu can read")
        : root.note.code == "import-failed" ? @tr("Could not import that key")
        : root.note.code == "phrase-mismatch"
            ? @tr("That does not match the phrase we showed you. Check what you wrote down.")
        : root.note.code == "phrase-checksum"
            ? @tr("There is a typo in that phrase — one word is wrong or out of order.")
        : root.note.code == "phrase-unknown-word"
            ? @tr("Word {0} is not a recovery word. Check its spelling.", root.note.args[0])
        : root.note.code == "phrase-word-count"
            ? @tr("That is {0} words, and a recovery phrase has 12, 15, 18, 21 or 24.",
                  root.note.args[0])
        : root.note.code == "phrase-refused"
            ? @tr("That phrase cannot be used: {0}", root.note.args[0])

        // ── Keys ────────────────────────────────────────────────────────
        : root.note.code == "key-name-taken"
            ? @tr("There is already a key called {0}", root.note.args[0])
        : root.note.code == "key-name-rules" ? @tr("That key name cannot be used")
        : root.note.code == "key-not-here" ? @tr("That key is not in this wallet")
        : root.note.code == "key-change-failed" ? @tr("Could not change that key")

        // ── Nodes and chains ────────────────────────────────────────────
        : root.note.code == "node-unreachable" ? @tr("Could not reach that node")
        : root.note.code == "mock-chain-failed" ? @tr("The scripted chain could not be built")
        : root.note.code == "node-duplicate" ? @tr("That endpoint is already in the list")
        : root.note.code == "node-store-unavailable" ? @tr("Pecu cannot save a node right now")
        : root.note.code == "node-not-saved" ? @tr("That node could not be saved")
        : root.note.code == "node-added" ? @tr("Node added")
        : root.note.code == "node-failover" ? @tr("Switched to another node")
        : root.note.code == "node-url-insecure" ? @tr("That address is not encrypted")
        : root.note.code == "node-url-unusable" ? @tr("That is not an address Pecu can use")
        : root.note.code == "read-wrong-chain"
            ? @tr("This node is on {0}, not {1}", root.note.args[0], root.note.args[1])
        : root.note.code == "chain-switched"
            ? @tr("Now on {0}. The wallet is locked.", root.note.args[0])
        : root.note.code == "chain-switch-busy" ? @tr("A payment is on its way")

        // ── Reading the chain ───────────────────────────────────────────
        : root.note.code == "history-unreadable" ? @tr("Could not read this wallet's activity")
        : root.note.code == "history-older-unreadable" ? @tr("Could not read older transactions")
        : root.note.code == "identities-unreadable" ? @tr("Could not read your VerusIDs")
        : root.note.code == "markets-unreadable" ? @tr("Could not read what things are worth")

        // ── Spending ────────────────────────────────────────────────────
        : root.note.code == "mainnet-confirm" ? @tr("Type the word mainnet to turn this on")
        : root.note.code == "spend-no-node" ? @tr("No node is selected")
        : root.note.code == "spend-chain-unknown"
            ? @tr("The node has not said which chain it is on yet")
        : root.note.code == "spend-wrong-chain"
            ? @tr("This node is on {0}, but the wallet is set to {1}",
                  root.note.args[0], root.note.args[1])
        : root.note.code == "spend-mainnet-off" ? @tr("Spending on mainnet is turned off")
        : root.note.code == "spend-node-syncing"
            ? @tr("The node is still catching up — {0} of {1} blocks",
                  root.note.args[0], root.note.args[1])
        : root.note.code == "spend-node-not-ready"
            ? @tr("The node is not ready to be spent through")
        : root.note.code == "send-not-enough-spendable" ? @tr("Not enough spendable coins")
        : root.note.code == "send-build-failed" ? @tr("Could not build this payment")
        : root.note.code == "broadcast-rejected" ? @tr("The network rejected this transaction")
        : root.note.code == "pending-unsaved"
            ? @tr("Could not record the payment before sending it, so it was not sent")
        : root.note.code == "resend-unconfirmed" ? @tr("That payment still could not be confirmed")

        // ── Converting ──────────────────────────────────────────────────
        //
        // Headlines, not the paragraphs `NoteText` carries for the same codes.
        // These appear on the review — under a card that has already explained
        // itself — and in a toast, and both want the fact rather than the
        // reasoning.
        //
        // The first will be the most-seen line in this build for as long as the
        // network has conversions paused. It says the **network** refused, not
        // that the wallet failed, because those call for different next moves
        // and the difference is invisible from here otherwise.
        : root.note.code == "convert-refused-by-node"
            ? @tr("The network refused this conversion — nothing was spent")
        : root.note.code == "halt-conversions"
            ? @tr("Conversions are switched off on this chain")
        : root.note.code == "halt-pbaas-bridge" ? @tr("Transfers between chains are switched off")
        : root.note.code == "halt-eth-gateway" ? @tr("The Ethereum bridge is switched off")
        : root.note.code == "chain-housekeeping" ? @tr("A routine protocol change is in force")
        : root.note.code == "halt-unrecognised" ? @tr("An unrecognised protocol change is in force")
        : root.note.code == "halt-unreadable" ? @tr("A protocol change could not be read")
        : root.note.code == "halt-unknown" ? @tr("Could not check the network's status")
        : root.note.code == "halt-unconfigured" ? @tr("This chain's status cannot be checked")
        : root.note.code == "convert-below-floor"
            ? @tr("The price moved: the node now expects {0}, and {1} was required",
                  root.note.args[0], root.note.args[1])
        : root.note.code == "convert-build-failed" ? @tr("Could not build this conversion")
        : root.note.code == "convert-unpriced" ? @tr("The node could not price this conversion")
        : root.note.code == "convert-bad-recipient"
            ? @tr("A conversion can only be delivered to an R-address")
        : root.note.code == "convert-bad-currency"
            ? @tr("One of those is not a currency Pecu can identify")
        : root.note.code == "convert-unusable-tokens"
            ? @tr("That currency sits in outputs a single conversion cannot spend")

        // ── VerusIDs ────────────────────────────────────────────────────
        : root.note.code == "identity-change-failed" ? @tr("Could not build that change")
        : root.note.code == "identity-change-rejected" ? @tr("The change was not accepted")
        : root.note.code == "identity-revoke-confirm" ? @tr("Type the word to confirm")
        : root.note.code == "name-claim-failed" ? @tr("Could not claim that name")
        : root.note.code == "name-claim-unsaved"
            ? @tr("Could not save the claim before sending it, so it was not sent")
        : root.note.code == "name-claim-uncertain" ? @tr("We could not confirm the claim was sent")
        : root.note.code == "name-register-failed" ? @tr("Could not finish registering that name")
        : root.note.code == "name-claim-busy" ? @tr("A name is already being registered")

        // ── Currencies ──────────────────────────────────────────────────
        : root.note.code == "launch-draft-invalid" ? @tr("That currency cannot be launched yet")
        : root.note.code == "launch-identity-not-yours"
            ? @tr("That identity is not in this wallet")
        : root.note.code == "launch-identity-unknown"
            ? @tr("That identity is not in this wallet yet")
        : root.note.code == "launch-chain-unknown"
            ? @tr("The chain has not said what its own currency is")
        : root.note.code == "launch-build-failed" ? @tr("Could not build that launch")
        : root.note.code == "launch-rejected" ? @tr("The launch was not accepted")
        : root.note.code == "launch-busy" ? @tr("A currency is already being made")
        : root.note.code == "launch-on-its-way"
            ? @tr("{0} is on its way", root.note.args[0])

        // A code nobody wrote a headline for. Visible on purpose.
        : root.note.code;

    text: root.count > 1 ? @tr("{} ({}×)", root.sentence, root.count) : root.sentence;

    // Size, weight and colour are the caller's. This component's job is the
    // sentence: the same reason appears in a toast at body weight and beside a
    // field at caption size in red, and baking either in would make one of the
    // two wrong.
}

// …and what to do about it, where there is something to say.
//
// Empty for most codes. A toast whose second line repeats the first in more
// words is a toast people stop reading, so this only speaks where the answer is
// not already in the headline.
export component NoticeBody inherits Text {
    in property <Note> note;

    text: root.note.code == "backup-in-progress"
            ? @tr("A key is only as safe as its phrase, and showing two at once is how the wrong one gets written down.")
        : root.note.code == "import-not-a-verus-key"
            ? @tr("Verus keys start with a U; a key from another chain is refused rather than silently reinterpreted.")
        : root.note.code == "phrase-word-count"
            ? @tr("If it is not a recovery phrase, choose Free text.")
        : root.note.code == "key-name-rules"
            ? @tr("A key name can use lowercase letters, digits, - and _, and has to start with a letter or a digit.")
        : root.note.code == "node-duplicate"
            ? @tr("Two entries for one node would probe identically and could never disagree about anything worth knowing.")
        : root.note.code == "node-store-unavailable"
            ? @tr("The wallet database could not be opened, so a node added now would be gone at the next start.")
        : root.note.code == "node-not-saved"
            ? @tr("It has not been added, because a node the wallet cannot write down would disappear at the next start.")
        : root.note.code == "node-failover"
            ? @tr("The node Pecu was using stopped answering, so it moved to one that is. Nothing about your wallet changed.")
        : root.note.code == "read-wrong-chain"
            ? @tr("Pecu is not reading balances from it. The addresses in this wallet do not exist on that chain, so anything it reported would be a figure about somebody else's — or about nothing at all. Choose a node on the right chain.")
        : root.note.code == "chain-switch-busy"
            ? @tr("Wait for it to finish before changing chains.")
        : root.note.code == "mainnet-confirm"
            ? @tr("Spending real coins is off by default, and turning it on is deliberately a little awkward.")
        : root.note.code == "spend-wrong-chain"
            ? @tr("Pecu will not sign against a chain you did not choose.")
        : root.note.code == "send-not-enough-spendable"
            ? @tr("Mined coins need 100 confirmations, and coins held by a VerusID cannot be moved by this key.")
        : root.note.code == "identity-revoke-confirm"
            ? @tr("A revocation cannot be undone without the recovery authority, and an identity that is its own cannot be revoked at all.")
        : root.note.code == "name-claim-uncertain"
            ? @tr("It may already be on its way. Pecu saved it and is checking. Do not start the same name again — that would spend a second fee.")
        : root.note.code == "name-claim-busy"
            ? @tr("Finish or abandon it before starting another. A claim expires about twenty blocks after it is signed.")
        : root.note.code == "launch-draft-invalid"
            ? @tr("Something in the definition is still wrong.")
        : root.note.code == "launch-identity-not-yours"
            ? @tr("Choose one of your own identities to define it under.")
        : root.note.code == "launch-identity-unknown"
            ? @tr("Refresh the identities and try again.")
        : root.note.code == "launch-chain-unknown"
            ? @tr("Refresh and try again.")
        : root.note.code == "launch-busy"
            ? @tr("Finish or abandon that one first — each carries a name claim with its own deadline.")
        : root.note.code == "launch-on-its-way"
            ? @tr("It begins at block {0}. Until then it exists and does nothing.", root.note.args[0])
        : "";

    // Most codes have no second line, and a Text with nothing in it still takes
    // a row and the spacing around it — which put a blank gap between the
    // headline and the node's words on every toast that had only one of them.
    visible: self.text != "";
    height: self.text == "" ? 0px : self.preferred-height;

    // Styling is the caller's here too, for the same reason.
}

// A tinted box with a headline and a paragraph in it.
//
// # Why this is a component and not four lines at each call site
//
// Because those four lines were wrong at every one of them, in a way that only
// shows up at some widths. A `Rectangle` in a `VerticalLayout` does not take
// its height from a `VerticalLayout` inside it — so a paragraph that wraps to
// one more line than the parent guessed renders **outside the tint**, on top of
// whatever comes next.
//
// It was live on the send review: "…nothing can undo the payment." sat below
// its own background and overlapped the PAID FROM heading, in the shipped
// build and in the reference image, which is a reminder that a picture nobody
// looks closely at is not a test.
//
// The fix is one line — `height: body.preferred-height` — and the reason it
// belongs in a component is that there are a dozen of these boxes and the next
// one written by hand would have the same bug.
export component Notice inherits Rectangle {
    in property <string> headline;
    in property <string> body;
    // "warning" · "negative" · "accent". Decides the tint and the headline's
    // colour; the paragraph stays secondary text in all three, because it is
    // the explanation rather than the alarm.
    in property <string> tone: "warning";

    background: root.tone == "negative" ? Theme.negative-soft
        : root.tone == "accent" ? Theme.accent-soft
        : Theme.warning-soft;
    border-radius: R.md;
    // The line this component exists for.
    height: inner.preferred-height;

    inner := VerticalLayout {
        padding: Sp.s5;
        spacing: Sp.s2;

        Text {
            text: root.headline;
            font-size: Typo.body;
            font-weight: Typo.w-medium;
            color: root.tone == "negative" ? Theme.negative
                : root.tone == "accent" ? Theme.accent
                : Theme.warning;
            wrap: word-wrap;
        }

        // Absent rather than empty when there is nothing to say: a blank Text
        // still takes a row and the spacing around it.
        if root.body != "": Text {
            text: root.body;
            font-size: Typo.caption;
            color: Theme.text-secondary;
            wrap: word-wrap;
        }
    }
}
