# Build output. 19 GB of it, mostly the pinned SDK and Slint.
/target

# Snapshot diffs, written beside the references when the visual test fails.
# The references themselves ARE committed — they are the test's expectations.
crates/chainvue-ui/tests/snapshots/*.diff.png

# Wallet data never lives here — it is under
# ~/Library/Application Support/com.chainvue.wallet — but a vault or a pending
# broadcast that ends up in the tree by accident must not be committable.
vault.json
vault.json.*
pending-broadcast.json
pending-broadcast.json.*

.DS_Store
